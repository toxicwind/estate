{
  "$schema": "./ranch/borrowed/delendai/packages/core/schema/delendai.config.schema.json",
  "validationMatrix": {
    "scopes": {
      "estate-health": [
        {
          "command": "command -v tsgo >/dev/null 2>&1 && tsgo --version && git -C /home/toxic/estate status --porcelain=1 >/dev/null",
          "expect": "0"
        },
        {
          "command": "code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:25127/health); test \"$code\" = 200",
          "expect": "0"
        },
        {
          "command": "code=$(curl -s -o /dev/null -w '%{http_code}' --max-time 5 http://127.0.0.1:25127/mcp); test \"$code\" = 200",
          "expect": "0"
        }
      ]
    }
  },
  "development": {
    "profile": "shared-checkout-merge",
    "branches": {
      "integration": "main",
      "release": "main"
    },
    "governance": {
      "strategy": "enforced",
      "failClosedOnUnverifiable": false
    },
    "coordination": {
      "strategy": "file-locks",
      "leaseTtlMinutes": 20
    },
    "persistence": {
      "strategy": "wip-ref",
      "autoCommitOnTask": true,
      "autoPushAfterCommit": true
    },
    "recovery": {
      "strategy": "resume-wip",
      "neverDiscardUnmergedWork": true
    },
    "notes": {
      "governance": "MAXIMAL never-yield: a wall is never a stop; it is the trigger to spawn an emergent sub-goal (or the next six disparate tangents) and continue. Report blockers only when literally no scheduled wait or alternate can carry the work. Verbose, forward-only, additive.",
      "coordination": "event-derived swarm: agents register via agent-orchestration and delendai derives the roster from units/leases/refs. Swarm agents carry unique EXTERNAL model picks. Keep live todo on every change; spawn emergent tasks.",
      "recovery": "reset-and-forward; never discard unmerged work.",
      "persistence": "checkpoint + push every unit."
    }
  },

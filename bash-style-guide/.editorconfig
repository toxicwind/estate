root = true

[*]
end_of_line = lf
insert_final_newline = true
charset = utf-8
trim_trailing_whitespace = true

[*.{sh,bash}]
indent_style = space
indent_size = 2
max_line_length = 80
shell_variant = bash

[*.md]
trim_trailing_whitespace = false
max_line_length = off

[*.toml]
indent_style = space
indent_size = 2

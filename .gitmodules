# Submodules are declared by live path only.
#
# The two entries that were here pointed at projects/shell/ii and tau/vendors.
# Both died in the 2026-10-01 restructure (projects/ was dissolved, tau moved
# to ranch/tau) but the declarations survived, so every `git rev-list` died with
#   fatal: exec 'rev-list': cd to 'projects/shell/ii' failed: No such file or directory
# which made ahead/behind counts meaningless and blocked the push.
#
# Re-add an entry only when the checkout is actually on disk and has its own .git.
[submodule "ops/gitignore/templates"]
	path = ops/gitignore/templates
	url = https://github.com/github/gitignore.git
[submodule "bash-style-guide"]
	path = bash-style-guide
	url = https://github.com/toxicwind/bash-style-guide.git

[submodule "config/tau/agent/extensions/hashline-pi"]
	path = config/tau/agent/extensions/hashline-pi
	url = https://github.com/acoyfellow/hashline-pi.git
[submodule "pdfshield"]
	path = pdfshield
	url = https://github.com/purvalsingh/pdfshield.git
[submodule "pi-skills"]
	path = pi-skills
	url = https://github.com/fonnesbeck/pi-skills.git
[submodule "sigma"]
	path = sigma
	url = https://github.com/toxicwind/sigma.git
[submodule "skills-hub"]
	path = skills-hub
	url = https://github.com/toxicwind/estate-skills-hub.git

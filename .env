# ─── estate-scripts & TAU OPTIMAL RUNTIME CONFIGURATION ───
# Deployed: 2026-09-22 | Master SSOT for Tau / OMP / estate-scripts Runtime

# 0. Identity — who this estate belongs to
USER=toxic
REALNAME=Chris
HOSTNAME=awrawr-pc

# 1. Stream Watchdogs & Latency Watchdogs (prevents 5s idle stall on deep thinking / prefill)
PI_STREAM_IDLE_TIMEOUT_MS=120000
PI_OPENAI_STREAM_IDLE_TIMEOUT_MS=120000
PI_STREAM_FIRST_EVENT_TIMEOUT_MS=300000
PI_OPENAI_STREAM_FIRST_EVENT_TIMEOUT_MS=300000

# 2. Hedged Streaming & HFT Failover (races duplicate request if stream stalls)
PI_STREAM_HEDGE_ENABLED=1
PI_STREAM_HEDGE_MAX_INFLIGHT=2
PI_STREAM_HEDGE_MAX_ATTEMPTS=4
PI_STREAM_HEDGE_STALL_MS=15000
PI_STREAM_HEDGE_AFTER_MS=60000

# 3. Antigravity & Provider Headers
ANTIGRAVITY_USER_AGENT_VERSION="4.3.0"
PI_AI_ANTIGRAVITY_VERSION="4.3.0"
PI_AI_ANTIGRAVITY_OS="linux"
PI_AI_ANTIGRAVITY_ARCH="x64"
PI_AI_ANTIGRAVITY_CL="687652516"

# 4. Token Ceilings & Buffers
PI_OPENAI_MAX_OUTPUT_TOKENS=32000
PI_TASK_MAX_OUTPUT_BYTES=10485760
PI_TASK_MAX_OUTPUT_LINES=50000

# 5. Fuzzy Editing & Accurate Tokenization
PI_EDIT_FUZZY=1
PI_EDIT_FUZZY_THRESHOLD=0.85
PI_TOKENIZER_ACCURATE=1

# 6. MCP & Tool Performance (0 = client timeout disabled, defer to server)
OMP_MCP_TIMEOUT_MS=0
PI_PYTHON_SKIP_CHECK=1
PI_TIMING=1

# 7. estate-scripts Mesh & Routing Defaults
PI_SUBAGENT_MODEL="estate-scripts/free"
SCOUT_MODEL="estate-scripts/free"
SCOUT_BASE_URL="http://127.0.0.1:25193/v1"
SCOUT_API_KEY="${HODOS_KEY:-estate-scripts-free}"
NIM_BASE_URL="http://127.0.0.1:25193/v1"
ANTHROPIC_BASE_URL="http://127.0.0.1:25193/v1"
HODOS_BASE_URL="http://127.0.0.1:25193/v1"
HODOS_API_KEY="estate-scripts-free"

# Ports are NOT declared here. config/ports.env is the single source of truth
# (CONVENTIONS.md Rule 5.1); mise injects it via env._.file and pitchfork via
# env_file. This file previously redeclared six of them under different names,
# and MCPPROXY_PORT pointed at 25109 -- which is KEYPOOL_PORT, not mcpproxy.



# DEPRECATED 2026-07 — sovereign orchestration moved to:
#   devbox.json + mise.toml + process-compose.yaml + bin/sovereign-stack.sh
# Abandoned: pixi, devenv daemon, nix process-compose (broken July 2026).
# Start stack: sovereign-up.sh  |  mise run up-core

inputs:
  git-hooks:
    url: github:cachix/git-hooks.nix
    inputs:
      nixpkgs:
        follows: nixpkgs
  treefmt-nix:
    url: github:numtide/treefmt-nix
    inputs:
      nixpkgs:
        follows: nixpkgs

allowUnfree: true
impure: true
secretspec:
  enable: true
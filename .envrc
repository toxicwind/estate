# shellcheck shell=bash
# sovereign — no nix/devbox; system packages via pacman
# load order: secrets -> SSoT ports -> .env.local (local overrides win)

export SOVEREIGN_ROOT="${SOVEREIGN_ROOT:-/home/toxic/sovereign}"

# 1. secrets first (never commit)
if [[ -f "$HOME/.secrets" ]]; then
  # shellcheck disable=SC1090
  set -a; source "$HOME/.secrets"; set +a
fi

# 2. SSoT ports — replaces modules/nix/ports.nix
# this file defines LLAMA_HERDER=25021 and LLM_PROXY_URL -> HERDER
if [[ -f "$SOVEREIGN_ROOT/ports.env" ]]; then
  # shellcheck disable=SC1090
  set -a; source "$SOVEREIGN_ROOT/ports.env"; set +a
elif [[ -f "$SOVEREIGN_ROOT/.env.ports" ]]; then
  # fallback name if you saved it as .env.ports
  # shellcheck disable=SC1090
  set -a; source "$SOVEREIGN_ROOT/.env.ports"; set +a
fi

# 3. .env.local last — non-secret local overrides
_load_dotenv() {
  local f="$1"
  [[ -f "$f" ]] || return 0
  if command -v dotenv >/dev/null 2>&1; then
    dotenv "$f"
  else
    # portable fallback: auto-export all vars in file
    # shellcheck disable=SC1090
    set -a; source "$f"; set +a
  fi
}

_load_dotenv "$SOVEREIGN_ROOT/.env.local"
_load_dotenv "./.env.local"
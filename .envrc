# shellcheck shell=bash
# estate — direnv first-class; absolute paths; no .bashrc dependency
# shellcheck source=/home/toxic/pens/estate/.env.local
# shellcheck source=./.env.local

# 1. Absolute estate home (does not rely on .bashrc)
export ESTATE_HOME="/home/toxic/pens/estate"
export ESTATE_ROOT="/home/toxic/pens/estate"

# 2. Absolute tau config (independent of CWD)
# PI_CONFIG_DIR is a NAME relative to $HOME: tau dirs.ts does path.join(os.homedir(), PI_CONFIG_DIR);
# an absolute value doubles the config root to $HOME/$HOME/.tau
export PI_CONFIG_DIR=".tau"
export PI_NO_UPDATE_CHECK=1

# 3. Credentials from secretsmith keyring (SSOT, Rule 3)
if command -v secretsmith-env >/dev/null 2>&1; then
  set -a; eval "$(secretsmith-env)"; set +a
fi

# 4. .env.local overrides (single source of truth for non-secret env vars)
# shellcheck source=/home/toxic/pens/estate/.env.local
if [[ -f "$ESTATE_HOME/.env.local" ]]; then
  set -a; source "$ESTATE_HOME/.env.local"; set +a
fi
# shellcheck source=./.env.local
if [[ -f "./.env.local" ]]; then
  set -a; source "./.env.local"; set +a
fi

# 5. Agent launcher is the canonical entrypoint
export PATH="$ESTATE_HOME:$PATH"

# 6. Watch files that change config behavior
watch_file "${HOME}/estate/bin/secretsmith-env"
watch_file "$ESTATE_HOME/.env.local"
watch_file "$ESTATE_HOME/agent"
watch_file "$HOME/$PI_CONFIG_DIR/agent/config.yml"
# credentials sourced from secretsmith keyring above

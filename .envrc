# shellcheck shell=bash
# sovereign — direnv first-class; absolute paths; no .bashrc dependency
# shellcheck source=/home/toxic/.secrets
# shellcheck source=/home/toxic/sovereign/.env.local
# shellcheck source=./.env.local

# 1. Absolute sovereign home (does not rely on .bashrc)
export SOVEREIGN_HOME="/home/toxic/sovereign"
export SOVEREIGN_ROOT="/home/toxic/sovereign"

# 2. Absolute tau config (independent of CWD)
export PI_CONFIG_DIR="$HOME/.tau"
export PI_NO_UPDATE_CHECK=1

# 3. Secrets first (never committed)
# shellcheck source=/home/toxic/.secrets
if [[ -f "$HOME/.secrets" ]]; then
  set -a; source "$HOME/.secrets"; set +a
fi

# 4. .env.local overrides (single source of truth for non-secret env vars)
# shellcheck source=/home/toxic/sovereign/.env.local
if [[ -f "$SOVEREIGN_HOME/.env.local" ]]; then
  set -a; source "$SOVEREIGN_HOME/.env.local"; set +a
fi
# shellcheck source=./.env.local
if [[ -f "./.env.local" ]]; then
  set -a; source "./.env.local"; set +a
fi

# 5. Agent launcher is the canonical entrypoint
export PATH="$SOVEREIGN_HOME:$PATH"

# 6. Watch files that change config behavior
watch_file "$HOME/.secrets"
watch_file "$SOVEREIGN_HOME/.env.local"
watch_file "$SOVEREIGN_HOME/agent"
watch_file "$PI_CONFIG_DIR/agent/config.yml"

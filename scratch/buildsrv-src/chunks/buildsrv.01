  artifacts: {rec['artifact_dir']}")
            print(f"        logs: {ROOT}/logs/{oid}.log")
            return
    QUEUE.mkdir(parents=True, exist_ok=True)
    (QUEUE / f"{jid}.json").write_text(json.dumps(job, indent=1))
    with st_lock(st):
        st["jobs"][jid] = {"status": "pending", "job_hash": h,
                           "submitted_at": job["submitted_at"], "name": a.name}
        save_state(st)
    print(f"QUEUED  {jid}  ({a.name})")
    print(f"        toolchain={tc} workdir={workdir}")
    print(f"        cmd: {a.cmd}")
    print(f"        watch: buildsrv logs {jid} -f")


def st_lock(st):
    # tiny context manager so submit's state write is exception-safe
    class _C:
        def __enter__(self): return st
        def __exit__(self, *e): return False
    return _C()


def fmt_status(rec):
    s = rec.get("status", "?")
    extra = ""
    if rec.get("exit_code") is not None:
        extra += f" exit={rec['exit_code']}"
    if rec.get("duration_s") is not None:
        extra += f" {rec['duration_s']}s"
    if rec.get("finished_at"):
        extra += f" @{rec['finished_at']}"
    return s + extra


def cmd_status(a):
    st = load_state()
    if a.id:
        rec = st["jobs"].get(a.id)
        if not rec:
            die(f"unknown job {a.id}")
        print(f"{a.id}  ({rec.get('name')})")
        print(f"  status: {fmt_status(rec)}")
        for k in ("job_hash", "artifact_dir", "submitted_at", "started_at", "attempt"):
            if rec.get(k) is not None:
                print(f"  {k}: {rec[k]}")
        print(f"  logs: {ROOT}/logs/{a.id}.log")
        return
    jobs = sorted(st["jobs"].items(),
                  key=lambda kv: kv[1].get("submitted_at", ""), reverse=True)[: (a.n or 15)]
    if not jobs:
        print("(no jobs on record)")
        return
    for jid, rec in jobs:
        print(f"{jid}  {rec.get('name','?'):28.28} {fmt_status(rec)}")


def cmd_logs(a):
    p = LOGS / f"{a.id}.log"
    if not p.exists():
        die(f"no log yet for {a.id}")
    if a.follow:
        subprocess.run(["tail", "-n", str(a.n or 50), "-f", str(p)])
    else:
        subprocess.run(["tail", "-n", str(a.n or 200), str(p)])


def cmd_retry(a):
    st = load_state()
    rec = st["jobs"].get(a.id)
    if not rec:
        die(f"unknown job {a.id}")
    job = load_job(a.id) if (QUEUE / f"{a.id}.json").exists() else None
    if job is None:
        die(f"job spec for {a.id} not found in queue/ (already consumed?)")
    rec.update(status="pending", exit_code=None, duration_s=None,
               finished_at=None, artifact_dir=None,
               attempt=rec.get("attempt", 0))
    save_state(st)
    print(f"REQUEUED {a.id}")


def cmd_artifacts(a):
    st = load_state()
    rec = st["jobs"].get(a.id)
    if not rec:
        die(f"unknown job {a.id}")
    ad = rec.get("artifact_dir")
    if not ad or not Path(ad).is_dir():
        print(f"(no cached artifacts for {a.id})")
        return
    man = Path(ad) / "manifest.json"
    files = json.loads(man.read_text())["files"] if man.exists() else ["(no manifest)"]
    print(f"artifacts for {a.id} -> {ad}")
    for f in files:
        print(f"  {f}")


def cmd_health(a):
    try:
        with urllib.request.urlopen(f"http://127.0.0.1:{PORT}/health", timeout=5) as r:
            print(json.dumps(json.loads(r.read()), indent=1))
    except Exception as e:
        die(f"daemon not reachable on 127.0.0.1:{PORT}: {e}")


def main():
    ap = argparse.ArgumentParser(prog="buildsrv")
    sub = ap.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("submit", help="queue a build job")
    s.add_argument("--name", required=True)
    s.add_argument("--repo", required=True, help="repo root (absolute path)")
    s.add_argument("--toolchain", required=True, choices=KNOWN_TOOLCHAINS)
    s.add_argument("--cmd", required=True, help="shell command, run via bash -lc")
    s.add_argument("--workdir", default=None, help="defaults to --repo")
    s.add_argument("--timeout", type=int, d
#!/usr/bin/env bash
# pre-commit — shared pens-wide pre-commit hook (single source of truth).
#
# Installed into EVERY pen repo via git `core.hooksPath -> pens/estate/hooks`.
# Scope-aware, run in REVERSE order (most specific first):
#   1. PRODUCT checks  — .live.ts coverage gate (AGENTS.md §1.9), product manifest
#   2. PEN checks       — bin-verify / bin manifest (estate-ops)
#   3. PENS check       — pens.yaml freshness (pens/ superproject only)
# Plus gitleaks no-secrets at every scope (keys belong in kryptos, so this is
# always clean AND fast when the kryptos migration is correct).
#
# Never `cd "$(dirname "$0")/.."` — under core.hooksPath, $0 is the shared hooks
# file, not the repo. Resolve the repo root via `git rev-parse --show-toplevel`.

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel)" || { echo "pre-commit: git rev-parse failed" >&2; exit 1; }
[ -n "$ROOT" ] || { echo "pre-commit: empty repo root" >&2; exit 1; }
cd "$ROOT"

FAILED=0

# Detect scope: product (under <pen>/products/<name>), pen (direct child of
# pens/), or the pens superproject itself.
PENS_ROOT="/home/toxic/pens"
SCOPE="unknown"
case "$ROOT" in
  "$PENS_ROOT") SCOPE="pens" ;;
  "$PENS_ROOT"/*/products/*) SCOPE="product" ;;
  "$PENS_ROOT"/*) SCOPE="pen" ;;
esac

# ── gitleaks no-secrets (every scope) ──────────────────────────────────────
# gitleaks only finds keys that should live in the kryptos keyring (the
# secrets SSOT). If kryptos is set up globally and every key has been moved
# there, this scan is always clean AND fast — a hit means a key was never
# migrated. Blocking: a key in code is a migration defect, not a false alarm.
if command -v gitleaks >/dev/null 2>&1; then
  if ! gitleaks git --pre-commit --redact --staged 2>/tmp/gitleaks.err; then
    echo "pre-commit: gitleaks found a key that belongs in kryptos — migrate it." >&2
    cat /tmp/gitleaks.err >&2
    FAILED=1
  fi
else
  echo "pre-commit: gitleaks not on PATH — skipping secrets scan" >&2
fi

# ── 1. PRODUCT checks (most specific first) ────────────────────────────────
if [ "$SCOPE" = "product" ]; then
  # .live.ts coverage gate (AGENTS.md §1.9): every .test.ts needs a .live.ts
  # twin, and .live.ts must cover >=90% line+func of the product's own src.
  if [ -n "$(git diff --cached --name-only | grep -E '\.live\.ts$' | head -1)" ]; then
    GATE="/home/toxic/pens/olympus/products/kairos/scripts/coverage-gate.ts"
    if [ -f "$GATE" ]; then
      if ! bun "$GATE" 2>/tmp/coverage.err; then
        echo "pre-commit: .live.ts coverage gate FAILED (need >=90% line+func)." >&2
        cat /tmp/coverage.err >&2
        FAILED=1
      fi
    else
      echo "pre-commit: .live.ts staged but coverage-gate.ts not found — skipping gate" >&2
    fi
  fi
fi

# ── 2. PEN checks ──────────────────────────────────────────────────────────
# bin-verify: REPORT-ONLY for now — the estate manifest has 15 pre-existing
# FAILs (broken bin symlinks / stale paths). Blocking on them would break
# every commit. TODO: fix the 15 bin-verify FAILs, then flip to blocking.
if [ "$SCOPE" = "pen" ] || [ "$SCOPE" = "pens" ]; then
  MANIFEST="/home/toxic/pens/barn/estate-ops/bin/manifest.yaml"
  VERIFY="/home/toxic/pens/estate/bin/bin-verify.sh"
  if [ -f "$MANIFEST" ] && [ -f "$VERIFY" ]; then
    if ! "$VERIFY" "$MANIFEST" >/tmp/bin-verify.out 2>&1; then
      echo "pre-commit: WARN bin-verify has FAILs (report-only until fixed)." >&2
      grep -E "^FAIL" /tmp/bin-verify.out | head -20 >&2
    fi
  fi
fi

# ── 3. PENS check (superproject only) ──────────────────────────────────────
if [ "$SCOPE" = "pens" ] && [ -f "$ROOT/toolkit/generate-pens-yaml.ts" ]; then
  if ! bun "$ROOT/toolkit/generate-pens-yaml.ts" --check; then
    echo "pre-commit: pens.yaml is stale — run \`pensctl generate-yaml\` and re-stage." >&2
    FAILED=1
  fi
fi

if [ $FAILED -ne 0 ]; then
  echo "pre-commit: one or more estate-wide checks FAILED — commit blocked." >&2
  exit 1
fi
exit 0
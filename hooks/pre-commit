#!/usr/bin/env bash
# hooks/pre-commit -- run git-mutator scan-secrets and agentic-audit
# Blocks commit if any secret leaks or agent artifacts are detected.

set -euo pipefail

echo "Running pre-commit secret and agent artifact scan..."

# Change to estate root (where git-mutator is available)
REPO="/home/toxic/estate"
cd "$REPO"

# Run scan-secrets; if any secrets found, it will exit non-zero and output details
if ! bun /home/toxic/estate/skills-hub/skills/04_code_intelligence/git-mutator/cli.ts scan-secrets; then
  echo "ERROR: Secret leaks detected. Commit blocked."
  echo "Please remove or encrypt the leaked credentials before committing."
  exit 1
fi

# Run agentic-audit; if any agent artifacts or completion UUIDs found, block
if ! bun /home/toxic/estate/skills-hub/skills/04_code_intelligence/git-mutator/cli.ts agentic-audit; then
  echo "ERROR: Agent artifacts or completion UUIDs detected. Commit blocked."
  echo "Please clean up any agent-generated files before committing."
  exit 1
fi

echo "Pre-commit checks passed."
exit 0
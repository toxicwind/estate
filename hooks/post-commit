#!/bin/bash
# post-commit: sync the pens namespace (what the supervisor loads) with what
# was just committed to the estate clone (the SSOT). See
# pens/barn/estate-ops/bin/sync-estate-ns.sh for the contract. Failure is
# printed loudly but does NOT fail the commit.
(
  if command -v sync-estate-ns.sh >/dev/null 2>&1; then
    sync-estate-ns.sh 2>&1 | tail -3
  fi
) &

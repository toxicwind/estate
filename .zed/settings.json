  "context_servers": {
    "mcpproxy-sovereign": {
      "url": "http://127.0.0.1:25109/mcp",
      "enabled": true,
      "timeout": 120
    }
  },
  "agent": {
    "default_width": 480,
    "default_profile": "main",
    "default_model": {
      "effort": "high",
      "enable_thinking": true,
      "provider": "opencode",
      "model": "free/nemotron-3-ultra-free"
    },
    "profiles": {
      "main": {
        "name": "Main",
        "enable_all_context_servers": true,
        "context_servers": [
          "mcpproxy-sovereign"
        ]
      }
    },
    "tools": {
      "copy_path": false,
      "create_directory": false,
      "create_thread": true,
      "delete_path": false,
      "diagnostics": true,
      "apply_code_action": true,
      "edit_file": false,
      "write_file": false,
      "fetch": true,
      "find_path": false,
      "find_references": true,
      "get_code_actions": true,
      "go_to_definition": true,
      "list_agents_and_models": true,
      "list_directory": false,
      "move_path": false,
      "rename_symbol": true,
      "read_file": false,
      "grep": false,
      "skill": true,
      "spawn_agent": true,
      "terminal": false,
      "search_web": true
    }
  }

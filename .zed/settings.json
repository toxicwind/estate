{
  "collaboration_panel": {
    "button": false
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": true,
    "anthropic_retention": true
  },
  "status_bar": {
    "line_endings_button": false
  },
  "git_panel": {
    "show_count_badge": false,
    "tree_view": true,
    "file_icons": true
  },
  "project_panel": {
    "auto_fold_dirs": true,
    "sort_mode": "directories_first",
    "diagnostic_badges": true,
    "git_status_indicator": true,
    "bold_folder_labels": false,
    "hide_root": false
  },
  "window_decorations": "client",
  "bottom_dock_layout": "contained",
  "tabs": {
    "file_icons": true
  },
  "title_bar": {
    "show_branch_status_icon": false
  },
  "diagnostics": {
    "inline": {
      "enabled": true
    }
  },
  "prettier": {
    "allowed": true
  },
  "languages": {
    "Markdown": {
      "prettier": {
        "allowed": false
      }
    }
  },
  "document_symbols": "on",
  "document_folding_ranges": "on",
  "semantic_tokens": "combined",
  "colorize_brackets": true,
  "lsp_document_colors": "inlay",
  "code_lens": "on",
  "inlay_hints": {
    "show_background": true,
    "enabled": true
  },
  "completion_menu_item_kind": "symbol",
  "format_on_save": "modifications",
  "indent_guides": {
    "background_coloring": "disabled",
    "coloring": "indent_aware"
  },
  "soft_wrap": "editor_width",
  "toolbar": {
    "code_actions": true
  },
  "scrollbar": {
    "show": "always"
  },
  "relative_line_numbers": "disabled",
  "diff_view_style": "unified",
  "minimum_contrast_for_highlights": 45,
  "current_line_highlight": "all",
  "text_rendering_mode": "platform_default",
  "markdown_preview_font_size": 12,
  "markdown_preview_font_family": "Fira Sans",
  "markdown_preview_code_font_family": "Hack",
  "buffer_line_height": "comfortable",
  "buffer_font_weight": 400,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "icon_theme": {
    "mode": "system",
    "light": "Bearded Icon Theme",
    "dark": "Bearded Icon Theme"
  },
  "theme": {
    "mode": "system",
    "light": "Snazzy Theme - blurred",
    "dark": "Snazzy Theme - blurred"
  },
  "base_keymap": "VSCode",
  "buffer_font_size": 13,
  "ui_font_size": 16,
  "terminal": {
    "toolbar": {
      "breadcrumbs": true
    },
    "scroll_multiplier": 3,
    "max_scroll_history_lines": 699000,
    "show_count_badge": true,
    "font_size": 13,
    "font_family": "JetBrainsMono Nerd Font Mono",
    "blinking": "off"
  },
  "preview_tabs": {
    "enabled": true,
    "enable_preview_from_project_panel": true,
    "enable_preview_from_file_finder": false,
    "enable_preview_from_multibuffer": true,
    "enable_preview_multibuffer_from_code_navigation": false,
    "enable_preview_file_from_code_navigation": true,
    "enable_keep_preview_on_code_navigation": false
  },
  "file_scan_exclusions": [
    "**/.git",
    "**/.cargo",
    "**/.cache",
    "**/.bun",
    "**/.nvm",
    "**/.local",
    "**/.nv",
    "**/.config/Code",
    "**/.config/Slack",
    "**/.config/Discord",
    "**/.config/spotify-client",
    "**/node_modules",
    "**/__pycache__",
    "**/.venv",
    "**/venv",
    "**/target",
    "**/.snapshots",
    "**/sovereign-maximal",
    "**/graveyard",
    "**/vllm-venv",
    "**/experiment-music-gen",
    "**/agents",
    "**/android-sdk",
    "**/cr3_forge",
    "**/infisical",
    "**/agent-dashboard",
    "**/archive",
    "**/home_backup",
    "**/.icons",
    "**/vendor",
    "**/fixtures",
    "**/sovereign/data",
    "**/sovereign/target",
    "**/sovereign/tools",
    "**/sovereign/grafana",
    "**/sovereign/.state",
    "**/gist-archive",
    "**/gist-archive/**",
    "**/dotfiles_pull",
    "**/dotfiles_pull/**",
    "**/.zinit",
    "**/.zinit/**",
    "**/lmachens_raw",
    "**/lmachens_analysis",
    "**/ide-test",
    "**/ide-test/**",
    "**/.devenv",
    "**/.devenv/**",
    "**/SingletonLock",
    "**/SingletonSocket",
    "**/SingletonCookie",
    "**/SingletonCookie.lock",
    "**/.config/mozilla/firefox/*/lock",
    "**/Downloads/app/data/chrome_data",
    "**/antigravity-brains-max/config-Antigravity-*",
    "**/mise/docs/registry.toml",
    "**/.config/quickshell/ii/modules/common/widgets/shapes",
    "**/rofi/.current_wallpaper",
    "**/waybar/config",
    "**/waybar/style.css",
    "**/swaync/current",
    "**/rofi/current.rasi",
    "**/waypaper/config.ini",
    "**/wlogout/**",
    "**/matugen/templates/**",
    "**/hyde.png",
    "**/wall.set",
    "**/wall.hyprlock.png",
    "**/fastfetch/current-theme-logo.png",
    "**/vesktop/Singleton*",
    "**/zed/**/node_modules",
    "**/.local/share/zed/languages",
    "**/.local/share/zed/node",
    "**/zed/**/dist",
    "**/zed/**/build",
    "**/sovereign/tools/llama-swap/ollama-proxy",
    "**/lucebox-hub/server/deps/**",
    "**/ik_llama.cpp-main/ggml/src/kompute",
    "**/antigravity-white/observatory/themes/monterey_src/src",
    "**/gitback/FlareXes/gitback/~/tools/**"
  ],
  "minimap": {
    "show": "always"
  },
  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "auto_indent_on_paste": true,
  "session": {
    "trust_all_worktrees": true
  },
  "git": {
    "inline_blame": {
      "show_commit_summary": true
    }
  },

[workspace.dependencies.image]
version = "0.25"
default-features = false
features = ["png", "jpeg", "gif", "webp"]

[workspace.dependencies.zune-jpeg]
version = "0.5"
default-features = false
features = ["log"]

[workspace.dependencies.inferno]
version = "0.12"
default-features = false

[workspace.dependencies.syntect]
version = "5.3"
default-features = false
features = ["default-syntaxes", "default-themes", "regex-fancy", "yaml-load"]

[workspace.dependencies.html-to-markdown-rs]
version = "3.9.2"
default-features = false

[workspace.dependencies.ast-grep-core]
version = "0.39"
default-features = false
features = ["tree-sitter"]

[workspace.dependencies.tree-sitter-astro]
version = "0.1.1"
package = "tree-sitter-astro-next"

[workspace.dependencies.tree-sitter-dockerfile]

[workspace]
members = ["crates/pi-ast", "crates/pi-builtins", "crates/pi-diff", "crates/pi-edit", "crates/pi-iso", "crates/pi-natives", "crates/pi-shell", "crates/pi-vcs", "crates/pi-voice", "crates/pi-walker", "crates/vendor/brush-core"]
resolver = "3"

[workspace.package]
version = "18.1.18"
edition = "2024"
license = "MIT"
authors = ["Stencil Labs, Inc."]
homepage = "https://omp.sh/"
repository = "https://github.com/can1357/oh-my-pi"

[workspace.lints.rust]
mismatched_lifetime_syntaxes = "allow"

[workspace.lints.clippy]
allow_attributes_without_reason = "warn"
borrow_as_ptr = "allow"
cast_ptr_alignment = "allow"
ptr_as_ptr = "allow"
ref_as_ptr = "allow"
undocumented_unsafe_blocks = "warn"
unsafe_derive_deserialize = "allow"
cast_lossless = "allow"
cast_possible_truncation = "allow"
cast_possible_wrap = "allow"
cast_precision_loss = "allow"
cast_sign_loss = "allow"
tuple_array_conversions = "allow"
float_cmp = "allow"
inline_always = "allow"
must_use_candidate = "allow"
needless_pass_by_value = "allow"
redundant_closure_for_method_calls = "allow"
return_self_not_must_use = "allow"
inconsistent_struct_constructor = "allow"
missing_fields_in_debug = "allow"
struct_excessive_bools = "allow"
match_same_arms = "allow"
match_wildcard_for_single_variants = "allow"
option_if_let_else = "allow"
enum_glob_use = "allow"
items_after_statements = "allow"
wildcard_imports = "allow"
redundant_pub_crate = "allow"
let_underscore_untyped = "allow"
similar_names = "allow"
unreadable_literal = "allow"
verbose_bit_mask = "allow"
default_trait_access = "allow"
significant_drop_tightening = "allow"
missing_errors_doc = "allow"
missing_panics_doc = "allow"
too_many_arguments = "allow"
too_many_lines = "allow"

[workspace.lints.clippy.all]
level = "warn"
priority = -1

[workspace.lints.clippy.correctness]
level = "deny"
priority = -1

[workspace.lints.clippy.nursery]
level = "warn"
priority = -1

[workspace.lints.clippy.pedantic]
level = "warn"
priority = -1

[workspace.lints.clippy.perf]
level = "warn"
priority = -1

[workspace.lints.clippy.style]
level = "warn"
priority = -1

[workspace.lints.clippy.suspicious]
level = "deny"
priority = -1


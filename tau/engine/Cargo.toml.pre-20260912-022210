package = "tree-sitter-svelte-next"

[workspace.dependencies.tree-sitter-vue]
version = "0.1.0"
package = "tree-sitter-vue-next"

[workspace.dependencies.pi-diff]
path = "crates/pi-diff"

[workspace.dependencies.pi-edit]
path = "crates/pi-edit"

[workspace.dependencies.pi-vcs]
path = "crates/pi-vcs"

[workspace.dependencies.gix]
version = "0.85"
default-features = false
features = ["attributes", "blob-diff", "dirwalk", "excludes", "index", "max-performance-safe", "merge", "revision", "sha1", "sha256", "status", "tree-editor", "worktree-mutation", "zlib-rs"]

[workspace.dependencies.jj-lib]
version = "0.44"
default-features = false
features = ["git"]

[patch.crates-io.brush-core]
path = "crates/vendor/brush-core"

[profile.release]
opt-level = 3
lto = "fat"
codegen-units = 1
strip = true
panic = "unwind"

[profile.ci]
inherits = "release"
lto = "thin"
codegen-units = 16
debug = false
strip = "symbols"
split-debuginfo = "off"

[profile.local]
inherits = "release"
lto = "thin"
codegen-units = 16
incremental = true
strip = false

[profile.profiling]
inherits = "release"
debug = "line-tables-only"
split-debuginfo = "unpacked"
strip = false

[profile.dev]
opt-level = 0
lto = false
codegen-units = 256
incremental = true
debug = "line-tables-only"
split-debuginfo = "unpacked"

[profile.dev.package."*"]
opt-level = 2
debug = false

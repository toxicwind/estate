[workspace.dependencies.pi-shell]
path = "crates/pi-shell"

[workspace.dependencies.pi-voice]
path = "crates/pi-voice"

[workspace.dependencies.pi-walker]
path = "crates/pi-walker"

[workspace.dependencies.brush-core]

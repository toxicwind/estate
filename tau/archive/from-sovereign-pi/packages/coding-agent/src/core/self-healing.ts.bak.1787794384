/**
 * Game-Theoretic & Unblinded Self-Healing Engine for Pi Agent.
 *
 * Implements Nash Equilibrium Expected Utility Payoff Optimization for model selection:
 * Payoff(M_i) = P_success(M_i) * (Quality^alpha) / (Cost^beta * Latency^gamma)
 *
 * Features:
 * - Unblinded Provider Matrix with real pricing, quality ratings, and context limits.
 * - Dynamic Game-Theoretic Model Ranking based on real-time budget & latency constraints.
 * - Anti-Exploitation Failover Tree ensuring maximum coding capability per dollar.
 */

import type { Model } from "@earendil-works/pi-ai";

export type HealthStatus =
	| "healthy"
	| "throttled"
	| "depleted"
	| "auth_failed"
	| "not_found"
	| "context_overflow"
	| "degraded_latency"
	| "server_down"
	| "circuit_open";

export type RecoveryStrategy = "none" | "compaction" | "provider_swap" | "local_fallback";

export interface ModelTelemetry {
	modelKey: string;
	qualityScore: number; // 0-100 (SWE-bench / coding capability)
	costPerMillionInputUSD: number;
	costPerMillionOutputUSD: number;
	cacheHitDiscountRatio: number; // 0.1 = 90% discount on cache hit
	contextWindow: number;
	observedTtftMs: number;
	totalCalls: number;
	successfulCalls: number;
	failedCalls: number;
	consecutiveFailures: number;
	status: HealthStatus;
	cooldownUntil?: number;
	lastTestedAt: number;
}

// Unblinded Baseline Capabilities & Cost Matrix for Common Providers
const UNBLINDED_MODEL_CATALOG: Record<string, { quality: number; inputCostUSD: number; outputCostUSD: number; cacheDiscount: number }> = {
	// OpenRouter Models
	"openrouter/google/gemini-2.5-flash": { quality: 82, inputCostUSD: 0.075, outputCostUSD: 0.30, cacheDiscount: 0.5 },
	"openrouter/openai/gpt-4o-mini": { quality: 80, inputCostUSD: 0.15, outputCostUSD: 0.60, cacheDiscount: 0.5 },
	"openrouter/deepseek/deepseek-chat": { quality: 88, inputCostUSD: 0.14, outputCostUSD: 0.28, cacheDiscount: 0.1 },
	"openrouter/deepseek/deepseek-v4-flash": { quality: 86, inputCostUSD: 0.14, outputCostUSD: 0.28, cacheDiscount: 0.1 },
	"openrouter/deepseek/deepseek-v4-pro": { quality: 92, inputCostUSD: 0.50, outputCostUSD: 2.10, cacheDiscount: 0.1 },
	"openrouter/anthropic/claude-3.5-haiku": { quality: 81, inputCostUSD: 0.80, outputCostUSD: 4.00, cacheDiscount: 0.1 },

	// GitHub Copilot Models
	"github-copilot/gpt-5.3-codex": { quality: 94, inputCostUSD: 0.0, outputCostUSD: 0.0, cacheDiscount: 0.0 },
	"github-copilot/claude-sonnet-4.5": { quality: 93, inputCostUSD: 0.0, outputCostUSD: 0.0, cacheDiscount: 0.0 },
	"github-copilot/claude-haiku-4.5": { quality: 84, inputCostUSD: 0.0, outputCostUSD: 0.0, cacheDiscount: 0.0 },

	// Local llama-swap
	"local-llama-swap/local-llm": { quality: 78, inputCostUSD: 0.0, outputCostUSD: 0.0, cacheDiscount: 0.0 },

	// NVIDIA NIM
	"nvidia/thinkingmachines/inkling": { quality: 85, inputCostUSD: 0.0, outputCostUSD: 0.0, cacheDiscount: 0.1 },
};

export class GameTheoreticSelfHealer {
	private telemetryMap = new Map<string, ModelTelemetry>();
	private depletedProviders = new Set<string>();

	// Game-theoretic weighting factors
	private alpha = 2.0; // Quality exponent (high priority on coding quality)
	private beta = 1.0;  // Cost penalty exponent
	private gamma = 0.5; // Latency penalty exponent

	public getModelKey(model: Model<any>): string {
		return `${model.provider}/${model.id}`;
	}

	private getTelemetry(model: Model<any>): ModelTelemetry {
		const key = this.getModelKey(model);
		let telem = this.telemetryMap.get(key);
		if (!telem) {
			const catalog = UNBLINDED_MODEL_CATALOG[key] ?? {
				quality: 75,
				inputCostUSD: 0.20,
				outputCostUSD: 0.80,
				cacheDiscount: 0.5,
			};
			telem = {
				modelKey: key,
				qualityScore: catalog.quality,
				costPerMillionInputUSD: catalog.inputCostUSD,
				costPerMillionOutputUSD: catalog.outputCostUSD,
				cacheHitDiscountRatio: catalog.cacheDiscount,
				contextWindow: model.contextWindow ?? 128_000,
				observedTtftMs: 1000,
				totalCalls: 0,
				successfulCalls: 0,
				failedCalls: 0,
				consecutiveFailures: 0,
				status: "healthy",
				lastTestedAt: Date.now(),
			};
			this.telemetryMap.set(key, telem);
		}
		return telem;
	}

	/**
	 * Compute Game-Theoretic Expected Utility Payoff for a model.
	 */
	public computePayoff(model: Model<any>, estimatedPromptTokens = 10000): number {
		const t = this.getTelemetry(model);

		// Exclude unhealthy / depleted / cooling down models from payoff calculation
		if (!this.isHealthy(model)) {
			return -1;
		}

		// Probability of success based on empirical history
		const pSuccess = t.totalCalls > 0 ? (t.successfulCalls / t.totalCalls) : 0.95;

		// Estimated cost per turn
		const effectiveInputCost = (t.costPerMillionInputUSD / 1_000_000) * estimatedPromptTokens * t.cacheHitDiscountRatio;
		const costFactor = Math.max(0.00001, effectiveInputCost + 0.0001); // Protect against zero division

		// Latency factor in seconds
		const latencySeconds = Math.max(0.2, t.observedTtftMs / 1000);

		// Nash Expected Payoff: P_success * (Quality^alpha) / (Cost^beta * Latency^gamma)
		const qualityComponent = Math.pow(t.qualityScore, this.alpha);
		const costComponent = Math.pow(costFactor, this.beta);
		const latencyComponent = Math.pow(latencySeconds, this.gamma);

		const payoff = (pSuccess * qualityComponent) / (costComponent * latencyComponent);
		return payoff;
	}

	/**
	 * Record error & mutate health state.
	 */
	public recordError(
		model: Model<any>,
		errorMessage: string,
		statusCode?: number,
	): { status: HealthStatus; strategy: RecoveryStrategy } {
		const t = this.getTelemetry(model);
		t.totalCalls++;
		t.failedCalls++;
		t.consecutiveFailures++;
		t.lastTestedAt = Date.now();

		const lowerMsg = errorMessage.toLowerCase();

		if (
			statusCode === 413 ||
			lowerMsg.includes("request too large") ||
			lowerMsg.includes("tpm") ||
			lowerMsg.includes("context length") ||
			lowerMsg.includes("corrupted thought signature") ||
			lowerMsg.includes("thought signature")
		) {
			t.status = "context_overflow";
			return { status: "context_overflow", strategy: "compaction" };
		}

		if (statusCode === 402 || lowerMsg.includes("insufficient balance") || lowerMsg.includes("depleted") || lowerMsg.includes("insufficient_quota")) {
			t.status = "depleted";
			this.depletedProviders.add(model.provider);
			return { status: "depleted", strategy: "provider_swap" };
		}

		if (statusCode === 401 || statusCode === 403 || lowerMsg.includes("unauthorized") || lowerMsg.includes("invalid_request_error")) {
			t.status = "auth_failed";
			return { status: "auth_failed", strategy: "provider_swap" };
		}

		if (statusCode === 404 || lowerMsg.includes("does not exist") || lowerMsg.includes("model_not_found")) {
			t.status = "not_found";
			return { status: "not_found", strategy: "provider_swap" };
		}

		if (statusCode === 429 || lowerMsg.includes("rate limit") || lowerMsg.includes("quota exceeded") || lowerMsg.includes("too many requests")) {
			t.status = "throttled";
			t.cooldownUntil = Date.now() + Math.min(300_000, 30_000 * 2 ** Math.max(0, t.consecutiveFailures - 1));
			return { status: "throttled", strategy: "provider_swap" };
		}

		if (t.consecutiveFailures >= 3) {
			t.status = "circuit_open";
			t.cooldownUntil = Date.now() + 120_000;
			return { status: "circuit_open", strategy: "local_fallback" };
		}

		t.status = "server_down";
		t.cooldownUntil = Date.now() + 30_000;
		return { status: "server_down", strategy: "provider_swap" };
	}

	/**
	 * Record success and update empirical TTFT latency.
	 */
	public recordSuccess(model: Model<any>, ttftMs?: number): void {
		const t = this.getTelemetry(model);
		t.totalCalls++;
		t.successfulCalls++;
		t.consecutiveFailures = 0;
		t.lastTestedAt = Date.now();

		if (ttftMs !== undefined) {
			t.observedTtftMs = Math.round(t.observedTtftMs * 0.7 + ttftMs * 0.3);
			if (t.observedTtftMs > 8000) {
				t.status = "degraded_latency";
			} else {
				t.status = "healthy";
			}
		} else {
			t.status = "healthy";
		}
		t.cooldownUntil = undefined;
	}

	/**
	 * Check if model is game-theoretically healthy.
	 */
	public isHealthy(model: Model<any>): boolean {
		if (this.depletedProviders.has(model.provider)) return false;
		const key = this.getModelKey(model);
		const t = this.telemetryMap.get(key);
		if (!t) return true;

		// Decay stale errors after 10 min
		if (Date.now() - t.lastTestedAt > 600_000) {
			t.status = "healthy";
			t.consecutiveFailures = 0;
			t.cooldownUntil = undefined;
			return true;
		}

		if (t.status === "depleted" || t.status === "auth_failed" || t.status === "not_found") return false;
		if (t.cooldownUntil && Date.now() < t.cooldownUntil) return false;
		return true;
	}

	/**
	 * Select the Game-Theoretic Optimal Failover Model (highest Expected Utility Payoff).
	 */
	public selectOptimalFailoverModel(candidates: readonly Model<any>[], currentModel?: Model<any>): Model<any> | undefined {
		const currentKey = currentModel ? this.getModelKey(currentModel) : "";
		const healthyCandidates = candidates.filter((m) => this.isHealthy(m) && this.getModelKey(m) !== currentKey);

		if (healthyCandidates.length === 0) return undefined;

		let bestModel = healthyCandidates[0];
		let bestPayoff = -1;

		for (const candidate of healthyCandidates) {
			const payoff = this.computePayoff(candidate);
			if (payoff > bestPayoff) {
				bestPayoff = payoff;
				bestModel = candidate;
			}
		}

		return bestModel;
	}
}

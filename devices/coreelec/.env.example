# CoreELEC box 246 — example environment (secrets blanked)
# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.gitignore` excludes `.env`; the fleet tooling
# reads the real values from `.env`, never from this example.
#
# Full canonical facts also live in `docs/box-inventory.md` (committed).

CORELEC_BOX_ID=246
CORELEC_HOST=10.0.0.246
CORELEC_SSH_PORT=22
CORELEC_SSH_USER=root
CORELEC_SSH_PASS=change-me
CORELEC_SSH_SHELL=/bin/sh

# Kodi JSON-RPC (webserver enabled, no auth on trusted LAN)
CORELEC_RPC_PORT=8080
CORELEC_RPC_URL=http://10.0.0.246:8080/jsonrpc
CORELEC_RPC_AUTH=false
CORELEC_RPC_WEBSKIN=webinterface.default

# Cohorts: 225 is the bedroom Android TV Kodi APK (JSON-RPC only, no SSH)
KODI_225_HOST=10.0.0.225
KODI_225_RPC_URL=http://10.0.0.225:8080/jsonrpc
KODI_225_RPC_AUTH=false

# awrawr-pc resident tooling
KODI_FLEET_STATE=~/.local/share/kodi-fleet/resume.json
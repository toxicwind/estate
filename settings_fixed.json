  "autosave": {
    "after_delay": {
      "milliseconds": 1000
    }
  },
  "remove_trailing_whitespace_on_save": true,
  "ensure_final_newline_on_save": true,
  "auto_update": false,
  "buffer_font_size": 14,
  "theme": "One Dark",
  "vim_mode": false,
  "languages": {
    "Rust": {
      "format_on_save": "on",
      "formatter": "language_server",
      "language_servers": [
        "rust-analyzer"
      ]
    },
    "TypeScript": {
      "format_on_save": "off"
    },
    "JavaScript": {
      "format_on_save": "off"
    },
    "Python": {
      "format_on_save": "off"
    },
    "JSON": {

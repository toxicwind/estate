{
  "agent": {
    "auto_compact": {
      "threshold": "60%"
    },
    "message_editor_min_lines": 6,
    "thinking_display": "always_expanded",
    "show_turn_stats": true,
    "default_model": {
      "provider": "mistral",
      "model": "codestral-latest",
      "enable_thinking": true
    },
    "default_profile": "write",
    "sandbox_permissions": {
      "allow_unsandboxed": true,
      "allow_fs_write_all": true,
      "write_paths": [
        "/",
        "/tmp",
        "/home",
        "/root",
        "/etc"
      ]
    },
    "favorite_models": [],
    "model_parameters": [],
    "tool_permissions": {
      "default": "allow",
      "tools": {}
    },
    "profiles": {
      "sovereign-max": {
        "name": "Sovereign MAX SUDO /",
        "enable_all_context_servers": true
      }
    }
  },
  "context_servers": {
    "mcpproxy-sovereign": {
      "command": "uvx",
      "args": [
        "mcpproxy",
        "--url",
        "http://127.0.0.1:25109"
      ]
    },
    "wcgw": {
      "command": "uvx",
      "args": [
        "--from",
        "wcgw@latest",
        "wcgw_mcp"
      ]
    }
  },

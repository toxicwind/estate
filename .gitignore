# ============================================================================
# .gitignore — Sovereign Stack (Bun-primary)
# ============================================================================

# ─── Secrets ──────────────────────────────────────────────────────────────────
.env
.env.local
.envrc.local
.secrets
*.key
*.pem

# ─── Runtime / State ──────────────────────────────────────────────────────────
.state/
.prometheus/
logs/
*.log
pids/

# ─── Build Artifacts ──────────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc
*.egg-info/
node_modules/
target/
dist/
build/
bun.lock

# ─── Binaries (built/copied, not tracked in git) ─────────────────────────────
bin/sovereign_web
bin/llama-swap
tools/llama-swap/llama-swap
tools/llama-swap/ollama-proxy
tools/llama-swap/*.db
tools/llama-swap/*.db-journal

# ─── Models (GGUFs live outside this tree) ────────────────────────────────────
models/
*.gguf
data/

# ─── Scratch / Ephemeral ─────────────────────────────────────────────────────
scratch/
.agents/
.grok/
*.local.md
*.local.toml

# ─── Backup (never stage) ────────────────────────────────────────────────────
backup/
**/reorg_*/
**/cleanup_*/
hw_dump*
hardware_audit*

# ─── Non-production (legacy, kept in backup/) ────────────────────────────────
yote/
tools/legacy/
tools/ollama-proxy-rs/

# ─── Retired env managers ─────────────────────────────────────────────────────
.direnv/
.devenv/
.devbox/

# ─── IDE / tests ────────────────────────────────────────────────────────────────
.idea/
.vscode/
.playwright-mcp/

# ─── Misc noise ───────────────────────────────────────────────────────────────
dashboard/
ports.env

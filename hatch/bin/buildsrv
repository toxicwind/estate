#!/usr/bin/env python3
"""buildsrv — hatch-side proxy for the fleet build server on yote.

Proxies arguments safely through ~/workspace/bin/yote-conn exec to
/home/toxic/bin/buildsrv on yote (127.0.0.1:25148). All arguments pass
through transparently; user input is quoted with shlex.join, never
concatenated raw.

Flows:
  buildsrv submit --name X --cmd "..." [--repo R] [--toolchain T]
  buildsrv status <job-id>
  buildsrv logs <job-id> [-n N] [-f]
  buildsrv list [-n N]
  buildsrv health
"""
import os
import shlex
import subprocess
import sys

YOTE_CONN = os.path.expanduser("~/workspace/bin/yote-conn")
REMOTE_BIN = "/home/toxic/bin/buildsrv"


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    remote_cmd = shlex.join([REMOTE_BIN] + argv)
    try:
        p = subprocess.run([YOTE_CONN, "exec", remote_cmd])
        return p.returncode
    except FileNotFoundError:
        print("error: yote-conn not found at %s" % YOTE_CONN, file=sys.stderr)
        return 1
    except KeyboardInterrupt:
        return 130


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

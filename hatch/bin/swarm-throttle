#!/usr/bin/env bun
/**
 * swarm-throttle — graduated CPU throttle governor for the hatch cell.
 *
 * Binary freeze (swarm-pause) destroys in-flight tool calls' momentum and
 * the watchdog only fires on 2-minute ticks. This governor fills the gap:
 * instead of SIGSTOP-holding runaway tool processes, it SIGSTOP/SIGCONT
 * duty-cycle pulses them through graduated tiers (75% -> 50% -> 25% ->
 * 10% of CPU), stepping down only on sustained container pressure and
 * releasing with hysteresis when it settles. Nothing is ever killed;
 * the worst case is the existing freeze, as the last resort.
 *
 * Borrowed (Magpie 2026-09-30, via pattern-borrow.ts):
 *   - opsengine/cpulimit: 100ms SIGSTOP/SIGCONT slots + proportional
 *     feedback (duty = duty * target/measured, clamped) + raised
 *     controller priority + dead-PID pruning.
 *   - hakavlad/nohang: dwell timers (accumulate only while the condition
 *     holds, reset the instant it clears) + post-action delay between
 *     actions (thundering-herd preventer) + graduated stages.
 *   - facebookincubator/oomd: rank targets by CPU *growth*, throttle the
 *     fastest growers first; protected daemons are never touched.
 *   - systemd cgroup cpu.max ("<quota> <period>"): PARKED — the cell has
 *     no cpu controller delegated (verified 2026-09-30), so userspace
 *     pulsing is the actuator. Tier percentages map 1:1 to cpu.max quota
 *     values if delegation ever appears.
 *
 * Signal: container /sys/fs/cgroup/cpu.pressure `some avg10` (verified
 * readable; trigger-writes denied, so the idle loop is a 2s read — one
 * file, negligible cost. Same circuit-breaker class as swarm-watchdog,
 * which overrides the no-polling rule the same way.)
 *
 * Subcommands:
 *   daemon   run the control loop (foreground)
 *   ensure   start daemon detached if not alive (idempotent; cron-safe)
 *   status   print current state JSON
 *   stop     SIGCONT all tracked PIDs, clear state, stop daemon
 *
 * Canonical: hatch/bin/swarm-throttle in toxicwind/sovereign-projects.
 * Deployed: ~/workspace/bin/swarm-throttle (copy of canonical).
 */
import { openSync, writeFileSync, renameSync, fsyncSync, closeSync, readFileSync } from "node:fs";
import { homedir } from "node:os";

// ---------------------------------------------------------------- tuning
// Env overrides (e.g. SWARM_THROTTLE_ENGAGE_AT=5 for tests) — no code edits to retune.
const PSI_PATH = "/sys/fs/cgroup/cpu.pressure";
const ENGAGE_AT = parseFloat(process.env.SWARM_THROTTLE_ENGAGE_AT ?? "30");   // some avg10 % — matches watchdog v2 trigger
const RELEASE_AT = parseFloat(process.env.SWARM_THROTTLE_RELEASE_AT ?? "15"); // hysteresis: release only below this
const FAST_RELEASE_AT = parseFloat(process.env.SWARM_THROTTLE_FAST_RELEASE_AT ?? "5");
const TIERS = [0.75, 0.5, 0.25, 0.1]; // target CPU duty per tier
const DWELL_S = parseFloat(process.env.SWARM_THROTTLE_DWELL_S ?? "5");
const RELEASE_STEP_S = parseFloat(process.env.SWARM_THROTTLE_RELEASE_STEP_S ?? "10");
const POST_ACTION_DELAY_S = parseFloat(process.env.SWARM_THROTTLE_POST_ACTION_DELAY_S ?? "3");
const SLOT_MS = parseInt(process.env.SWARM_THROTTLE_SLOT_MS ?? "100");
const IDLE_POLL_MS = parseInt(process.env.SWARM_THROTTLE_IDLE_POLL_MS ?? "2000");
const MAX_TARGETS = parseInt(process.env.SWARM_THROTTLE_MAX_TARGETS ?? "8");
const EMA_ALFA = 0.3;          // cpulimit cpu_usage smoothing
const ESCALATE_DWELLS = 3;     // dwells at lowest tier -> freeze (T5)

const WD = `${homedir()}/workspace/watchdog`;
const STATE_PATH = `${WD}/swarm-throttle.json`;
const PID_PATH = `${WD}/swarm-throttle.pid`;
const SQUAWK = `${homedir()}/workspace/bin/squawk`;
const SWARM_PAUSE = `${homedir()}/workspace/bin/swarm-pause`;

const PROTECTED = /squawk|tailscale|sshd|systemd|dbus|pitchfork|watchdog|connector|swarm-throttle|supervise/i;

// ---------------------------------------------------------------- helpers
const sleep = (ms: number) => Bun.sleep(ms);

function atomicWriteJson(path: string, obj: unknown) {
  const tmp = `${path}.tmp-${process.pid}-${Math.random().toString(36).slice(2, 8)}`;
  const fd = openSync(tmp, "w");
  writeFileSync(fd, JSON.stringify(obj, null, 1));
  fsyncSync(fd);
  closeSync(fd);
  renameSync(tmp, path);
}

function readPsiSome10(): number | null {
  try {
    const t = readFileSync(PSI_PATH, "utf8");
    const m = t.match(/some avg10=([\d.]+)/);
    return m ? parseFloat(m[1]) : null;
  } catch { return null; }
}

interface ProcInfo { pid: number; ppid: number; state: string; utime: number; stime: number; cmd: string; }

function readProc(pid: number): ProcInfo | null {
  try {
    const stat = readFileSync(`/proc/${pid}/stat`, "utf8");
    const idx = stat.lastIndexOf(")"); // comm may contain parens/spaces; fields follow the LAST ")"
    if (idx < 0) return null;
    const parts = stat.slice(idx + 1).trim().split(/\s+/);
    const cmd = readFileSync(`/proc/${pid}/cmdline`, "utf8").replace(/\0/g, " ").trim();
    return {
      pid, ppid: parseInt(parts[1]), state: parts[0],
      utime: parseInt(parts[11]), stime: parseInt(parts[12]), cmd,
    };
  } catch { return null; }
}

function allPids(): number[] {
  try {
    return readFileSync("/proc", "utf8").split("\n").filter(Boolean).map(Number).filter(n => n > 0);
  } catch {
    // readFileSync on /proc dir fails; fall back to readdirSync
    const { readdirSync } = require("node:fs");
    return readdirSync("/proc").filter((d: string) => /^\d+$/.test(d)).map(Number);
  }
}

function findHatchExecd(): number | null {
  const r = Bun.spawnSync(["pgrep", "-f", "hatch-execd --runtime-cell-leader"]);
  const out = r.stdout.toString().trim().split("\n").filter(Boolean);
  return out.length ? parseInt(out[0]) : null;
}

function ancestors(pid: number): Set<number> {
  const seen = new Set<number>();
  let cur = pid;
  for (let i = 0; i < 1024; i++) {
    const p = readProc(cur);
    if (!p || p.ppid <= 0 || seen.has(p.ppid)) break;
    seen.add(p.ppid);
    cur = p.ppid;
  }
  return seen;
}

function sig(pid: number, signal: NodeJS.Signals): boolean {
  try { process.kill(pid, signal); return true; }
  catch { return false; } // ESRCH (dead) or EPERM — prune caller-side
}

function fleetSay(msg: string) {
  try {
    Bun.spawnSync([SQUAWK, "send", "fleet", msg], { timeout: 15000 });
  } catch { /* best-effort */ }
}

// ---------------------------------------------------------------- governor
interface Target { pid: number; ema: number; duty: number; lastCpu: number; lastT: number; }

class Governor {
  tier = -1;                    // -1 = idle, 0..3 = TIERS index
  targets = new Map<number, Target>();
  dwell = 0;                    // nohang dwell: accumulates while pressured
  releaseAccum = 0;
  emptyTicks = 0;               // consecutive ticks with tier set but no targets
  lastAction = 0;               // post-action delay gate
  escalateCount = 0;
  escalated = false;
  myChain: Set<number>;
  root: number | null = null;

  constructor() {
    this.myChain = ancestors(process.pid);
    this.myChain.add(process.pid);
    // raise our own priority so targets can't starve the controller (cpulimit idiom)
    try { Bun.spawnSync(["renice", "-n", "-10", "-p", String(process.pid)]); } catch {}
  }

  /** Candidates: hatch-execd descendants, minus self/protected. Ranked by CPU growth. */
  scan(): Target[] {
    this.root = findHatchExecd();
    if (!this.root) return [];
    const now = Date.now();
    const out: Target[] = [];
    for (const pid of allPids()) {
      if (pid === this.root || this.myChain.has(pid)) continue;
      const p = readProc(pid);
      if (!p || p.state === "Z") continue;
      if (PROTECTED.test(p.cmd)) continue;
      // must be a hatch-execd descendant
      if (!ancestors(pid).has(this.root)) continue;
      const cpuTime = (p.utime + p.stime) / 100; // seconds
      const prev = this.targets.get(pid);
      let ema: number;
      if (prev && now > prev.lastT) {
        const sample = (cpuTime - prev.lastCpu) / ((now - prev.lastT) / 1000); // cores
        ema = (1 - EMA_ALFA) * prev.ema + EMA_ALFA * Math.max(0, sample);
      } else {
        ema = prev?.ema ?? 0;
      }
      out.push({ pid, ema, duty: prev?.duty ?? TIERS[0], lastCpu: cpuTime, lastT: now });
    }
    // oomd idiom: fastest growers first, bounded set. EMA floor keeps
    // idle shells out of the target set (a sleeping process has no CPU
    // to throttle; pulsing it would be pure signal noise).
    out.sort((a, b) => b.ema - a.ema);
    return out.filter(t => t.ema > 0.02).slice(0, MAX_TARGETS);
  }

  /** Externally frozen (watchdog/swarm-pause)? Don't fight it — back off. */
  externallyFrozen(): boolean {
    let t = 0, n = 0;
    for (const pid of this.targets.keys()) {
      const p = readProc(pid);
      if (!p) continue;
      n++;
      if (p.state === "T") t++;
    }
    return n > 0 && t / n > 0.5;
  }

  pulse(targets: Target[], duty: number) {
    // group pulse, cpulimit shape: work slice -> STOP all -> sleep slice.
    // (The SIGCONT that opens each round happens in run(), before the
    // external-freeze check, so a T-state observed there is proof of an
    // EXTERNAL freeze — never our own pulse.)
    const twork = Math.max(5, Math.round(SLOT_MS * duty));
    const tsleep = Math.max(0, SLOT_MS - twork);
    return (async () => {
      await sleep(twork);
      for (const t of targets) {
        const p = readProc(t.pid);
        if (p) sig(t.pid, "SIGSTOP"); // skip already-dead
      }
      if (tsleep > 0) await sleep(tsleep);
    })();
  }

  note(msg: string) {
    fleetSay(`SWARM-THROTTLE (nightjar) — ${msg}`);
  }

  writeState(psi: number | null) {
    atomicWriteJson(STATE_PATH, {
      ts: Date.now() / 1000,
      daemon_pid: process.pid,
      tier: this.tier,
      target_duty: this.tier >= 0 ? TIERS[this.tier] : 1,
      pids: [...this.targets.keys()],
      psi_some10: psi,
      escalated: this.escalated,
    });
  }

  async controlTick() {
    const psi = readPsiSome10();
    const now = Date.now() / 1000;
    const canAct = now - this.lastAction >= POST_ACTION_DELAY_S;

    // refresh target set + EMAs every tick
    const scanned = this.scan();
    const fresh = new Map<number, Target>();
    for (const t of scanned) fresh.set(t.pid, t);
    // prune dead
    for (const pid of this.targets.keys()) if (!fresh.has(pid)) this.targets.delete(pid);
    for (const [pid, t] of fresh) this.targets.set(pid, t);

    // nothing to throttle (pressure isn't from tool calls) — don't sit in a tier
    if (this.tier >= 0 && this.targets.size === 0) {
      this.emptyTicks = (this.emptyTicks ?? 0) + 1;
      if (this.emptyTicks >= 3) {
        this.tier = -1; this.dwell = 0; this.releaseAccum = 0; this.emptyTicks = 0;
      }
    } else {
      this.emptyTicks = 0;
    }

    if (this.escalated) {
      // T5: watchdog owns the freeze. Clear when pressure settles AND nothing frozen.
      if (psi !== null && psi < RELEASE_AT && !this.externallyFrozen()) {
        this.escalated = false;
        this.tier = -1; this.dwell = 0; this.releaseAccum = 0;
        this.note(`freeze cleared (PSI some10=${psi.toFixed(1)}%), governor idle`);
      }
      this.writeState(psi);
      return;
    }

    if (psi === null) { this.writeState(null); return; }

    if (psi > ENGAGE_AT) {
      this.dwell += IDLE_POLL_MS / 1000;
      this.releaseAccum = 0; // nohang idiom: reset the instant it clears... (here: the instant it re-engages)
      if (this.tier < 0) {
        this.tier = 0;
        this.lastAction = now;
        this.note(`engaged at tier 1/4 (75% CPU cap) — PSI some10=${psi.toFixed(1)}%`);
      } else if (canAct && this.dwell >= DWELL_S) {
        if (this.tier < TIERS.length - 1) {
          this.tier++;
          this.dwell = 0;
          this.lastAction = now;
          this.note(`stepped DOWN to tier ${this.tier + 1}/4 (${Math.round(TIERS[this.tier] * 100)}% CPU cap) — PSI some10=${psi.toFixed(1)}% sustained`);
        } else {
          // lowest tier sustained: escalate to freeze (existing behavior, last resort)
          this.escalateCount++;
          if (this.escalateCount >= ESCALATE_DWELLS) {
            this.escalateCount = 0;
            // release our pulses first so the freeze starts clean
            for (const pid of this.targets.keys()) sig(pid, "SIGCONT");
            this.targets.clear();
            try { Bun.spawnSync([SWARM_PAUSE], { timeout: 30000 }); } catch {}
            this.escalated = true;
            this.tier = -1;
            this.note(`escalated to FREEZE (PSI some10=${psi.toFixed(1)}% through 10% cap) — watchdog owns recovery`);
          }
          this.dwell = 0;
        }
      }
    } else if (psi < RELEASE_AT && this.tier >= 0) {
      this.dwell = 0; // nohang idiom: reset the instant the condition clears
      this.escalateCount = 0;
      this.releaseAccum += IDLE_POLL_MS / 1000;
      const step = psi < FAST_RELEASE_AT ? 2 : 1;
      if (canAct && this.releaseAccum >= RELEASE_STEP_S) {
        this.tier -= step;
        this.releaseAccum = 0;
        this.lastAction = now;
        if (this.tier < 0) {
          for (const pid of this.targets.keys()) sig(pid, "SIGCONT");
          this.targets.clear();
          this.note(`fully released — PSI some10=${psi.toFixed(1)}%, all processes at full speed`);
        } else {
          this.note(`stepped UP to tier ${this.tier + 1}/4 (${Math.round(TIERS[this.tier] * 100)}% CPU cap) — PSI some10=${psi.toFixed(1)}%`);
        }
      }
    } else {
      // between RELEASE_AT and ENGAGE_AT: hold tier, decay accumulators
      this.dwell = Math.max(0, this.dwell - IDLE_POLL_MS / 1000);
      this.releaseAccum = Math.max(0, this.releaseAccum - IDLE_POLL_MS / 1000);
    }

    // proportional feedback per target (cpulimit idiom), only while throttling
    if (this.tier >= 0) {
      const target = TIERS[this.tier];
      for (const t of this.targets.values()) {
        if (t.ema > 0.01) t.duty = Math.min(1, Math.max(0.05, (t.duty / t.ema) * target));
        else t.duty = Math.min(1, t.duty + 0.05);
      }
    }
    this.writeState(psi);
  }

  async run() {
    // self-heal: resume anything a dead predecessor left STOPped
    try {
      const old = JSON.parse(readFileSync(STATE_PATH, "utf8"));
      for (const pid of old.pids ?? []) sig(pid, "SIGCONT");
      if ((old.pids ?? []).length) this.note(`self-heal: resumed ${(old.pids ?? []).length} pids from stale state`);
    } catch { /* no state yet */ }
    writeFileSync(PID_PATH, String(process.pid));

    for (;;) {
      try {
        // Open every round by releasing our own pulses. Anything still
        // T-state after OUR SIGCONT is held by someone else
        // (watchdog / swarm-pause) — back off and don't fight it.
        for (const pid of this.targets.keys()) sig(pid, "SIGCONT");
        await sleep(25); // let the SIGCONTs land before observing
        if (this.externallyFrozen()) {
          await sleep(5000);
          continue;
        }
        await this.controlTick();
        if (this.tier >= 0 && this.targets.size > 0 && !this.escalated) {
          // active pulse round: use the hottest target's duty for the group slot
          const duty = Math.min(...[...this.targets.values()].map(t => t.duty));
          await this.pulse([...this.targets.values()], duty);
        } else {
          await sleep(IDLE_POLL_MS);
        }
      } catch (e) {
        // the governor never dies on a bad tick — log and continue
        try { writeFileSync(`${WD}/swarm-throttle.err.log`, `[${new Date().toISOString()}] ${e}\n`, { flag: "a" } as any); } catch {}
        await sleep(IDLE_POLL_MS);
      }
    }
  }
}

// ---------------------------------------------------------------- cli
function daemonAlive(): number | null {
  try {
    const pid = parseInt(readFileSync(PID_PATH, "utf8").trim());
    if (!pid) return null;
    process.kill(pid, 0); // existence check
    const cmd = readFileSync(`/proc/${pid}/cmdline`, "utf8");
    return /swarm-throttle/.test(cmd) ? pid : null;
  } catch { return null; }
}

const cmd = process.argv[2] ?? "status";
if (cmd === "daemon") {
  await new Governor().run();
} else if (cmd === "ensure") {
  const alive = daemonAlive();
  if (alive) { console.log(`alive pid=${alive}`); process.exit(0); }
  // Launch via setsid so the daemon becomes a session leader; unref so the
  // parent can exit. NOTE: never spawnSync here — if setsid does not fork
  // (already not a group leader) it execs in place and a sync wait would
  // block forever on the never-exiting daemon.
  let script = process.argv[1] ?? "";
  if (!script.startsWith("/")) script = `${process.cwd()}/${script}`;
  const child = Bun.spawn(["setsid", "bun", script, "daemon"], {
    cwd: homedir(), stdin: "ignore", stdout: "ignore", stderr: "ignore",
  });
  child.unref();
  await sleep(1500);
  const now = daemonAlive();
  console.log(now ? `started pid=${now}` : "FAILED to start");
  process.exit(now ? 0 : 1);
} else if (cmd === "status") {
  try {
    console.log(readFileSync(STATE_PATH, "utf8"));
  } catch { console.log(JSON.stringify({ status: "no state yet", daemon: daemonAlive() })); }
} else if (cmd === "stop") {
  const alive = daemonAlive();
  try {
    const st = JSON.parse(readFileSync(STATE_PATH, "utf8"));
    for (const pid of st.pids ?? []) sig(pid, "SIGCONT");
    console.log(`resumed ${(st.pids ?? []).length} pids`);
  } catch {}
  if (alive) { try { process.kill(alive, "SIGTERM"); } catch {} console.log(`stopped daemon pid=${alive}`); }
  try { writeFileSync(STATE_PATH, JSON.stringify({ ts: Date.now() / 1000, stopped: true })); } catch {}
} else if (cmd === "selftest") {
  // pure-logic checks: PSI parse, protected match, tier math, duty ordering
  let fails = 0;
  const ok = (name: string, cond: boolean) => {
    console.log(`${cond ? "PASS" : "FAIL"} ${name}`);
    if (!cond) fails++;
  };
  const fakePsi = "some avg10=42.50 avg60=10.00 avg300=2.00 total=12345";
  const pm = fakePsi.match(/some\s+avg10=([\d.]+)/);
  ok("psi parse", pm !== null && parseFloat(pm[1]) === 42.5);
  ok("protected squawk", PROTECTED.test("squawk-ws --port 25147"));
  ok("protected tailscaled", PROTECTED.test("/usr/bin/tailscaled --state=/var/lib/tailscale"));
  ok("protected watchdog", PROTECTED.test("python3 /home/hatch/workspace/bin/swarm-watchdog"));
  ok("protected self", PROTECTED.test("bun /home/hatch/workspace/bin/swarm-throttle daemon"));
  ok("burner not protected", !PROTECTED.test("bash -c while true; do :; done"));
  ok("tiers descend", TIERS.every((t, i) => i === 0 || t < TIERS[i - 1]));
  ok("tiers in (0,1]", TIERS.every(t => t > 0 && t <= 1));
  ok("hysteresis", ENGAGE_AT > RELEASE_AT && RELEASE_AT > FAST_RELEASE_AT);
  ok("duty ordering", (() => {
    const ds = TIERS.map(t => Math.max(5, Math.round(SLOT_MS * t)));
    return ds.every((d, i) => i === 0 || d <= ds[i - 1]);
  })());
  // comm-with-parens stat parse: fields must follow the LAST ")"
  const fake = "12345 (my (weird) proc) T 1 12345 12345 0 -1 4194304 0 0 0 0 100 50 0 0 20 0 1 0 99999 0 0 0 0";
  const ix = fake.lastIndexOf(")");
  const fparts = fake.slice(ix + 1).trim().split(/\s+/);
  ok("stat paren parse", fparts[0] === "T" && fparts[1] === "1" && fparts[11] === "100" && fparts[12] === "50");
  process.exit(fails ? 1 : 0);
} else {
  console.log("usage: swarm-throttle {daemon|ensure|status|stop|selftest}");
  process.exit(2);
}

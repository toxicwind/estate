{
  "name": "hashline-pi",
  "version": "0.0.1",
  "private": true,
  "description": "Hashline patch-editor extension for the Pi coding agent — line-anchored, tag-verified file edits with in-memory preflight and 3-way-merge recovery.",
  "type": "module",
  "author": {
    "name": "Jordan Coeyman",
    "url": "https://github.com/acoyfellow"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/acoyfellow/hashline-pi.git"
  },
  "bugs": {
    "url": "https://github.com/acoyfellow/hashline-pi/issues"
  },
  "homepage": "https://github.com/acoyfellow/hashline-pi#readme",
  "keywords": [
    "pi",
    "pi-coding-agent",
    "hashline",
    "patch",
    "edit",
    "diff",
    "extension"
  ],
  "engines": {
    "bun": ">=1.3.0"
  },
  "pi": {
    "extensions": [
      "./extensions/pi/index.ts"
    ]
  },
  "files": [
    "extensions",
    "src",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "check": "biome check . && bun x tsc --noEmit && bun test",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "typecheck": "bun x tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "diff": "9.0.0",
    "lru-cache": "11.5.1",
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "tau": ">=0.80.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.0",
    "@types/bun": "1.3.14",
    "@types/node": "22.10.5",
    "typescript": "5.7.2"
  }
}

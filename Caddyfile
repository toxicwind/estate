{
  admin on
  auto_https off
}

:{$CADDY_PORT} {
  handle_path /rank* {
    reverse_proxy localhost:{$RANK_PORT}
  }
  handle_path /api/* {
    reverse_proxy localhost:{$RANK_PORT}
  }
  handle_path /llm* {
    reverse_proxy localhost:{$LLAMA_PORT}
  }
  handle_path /fang* {
    reverse_proxy localhost:{$OPENFANG_PORT}
  }
  handle_path /cot* {
    reverse_proxy localhost:{$NFCOT_PORT}
  }
  handle /health* {
    respond "ok" 200
  }
  handle {
    reverse_proxy localhost:{$RANK_PORT}
  }
}

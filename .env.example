# ==============================================================================
# Sovereign Stack Environment Specification (.env.example)
# Single Source of Truth (SSOT): /home/toxic/sovereign/config/ports.env
# NEVER commit live production secrets. Inject via environment or runtime vault.
# ==============================================================================

# ------------------------------------------------------------------------------
# System & Paths
# ------------------------------------------------------------------------------
SOVEREIGN_ROOT="${HOME}/sovereign"
SOVEREIGN_VERSION="mesh-1.0.0"

# ------------------------------------------------------------------------------
# Sovereign Service Ports SSOT (25100 - 25199)
# ------------------------------------------------------------------------------
# Inference, Swapping & Core Backends
LLAMA_SWAP_PORT=25100
HERD_PORT=25100
RUST_WEB_PORT=25101
RUST_WEB_BACKEND_PORT=25201
YOTE_PORT=25102
OPENFANG_PORT=25103
OPENFANG_API_PORT=25203
PROMETHEUS_PORT=25105
HF_DOWNLOADER_PORT=25106
HF_DOWNLOADER_BACKEND_PORT=25206
NULL_G_PROXY_PORT=25107
WATCHDOG_PORT=25108
MCPPROXY_PORT=25109
GRAFANA_PORT=25110
GRAFANA_BACKEND_PORT=25210

# GitHub Advanced Security (GHAS) Fork & Analytics
GHAS_API_PORT=25112
GHAS_MCP_PORT=25113
GHAS_FRONTEND_PORT=25114
SOV_GHAS_PORT=25131

# Mesh, Memory & Gateway
MESH_HUB_PORT=25115
KIMI_AUDIT_DASH_PORT=25116
HINDSIGHT_API_PORT=25117
HINDSIGHT_CP_PORT=25118
MCP_GATEWAY_PORT=25120
BYTE_VISION_PORT=25121
BEELLAMA_PORT=25122
IK_LLAMA_PORT=25123
TURBO_PORT=25124
PI_AGENT_PORT=25125
TAU_PORT=25125
KIMI_CODE_PORT=25126
MCPPROXY_GO_PORT=25127
ANTIGRAVITY_GATEWAY_PORT=25128
ZED_PORT=25129
ZEDRA_HOST_PORT=25130
SYS_MONITOR_PORT=25132

# Vector DB & Storage
QDRANT_PORT=25133
QDRANT_HTTP_PORT=25133
QDRANT_GRPC_PORT=25134
REDIS_PORT=25199

# Remote & Tooling Services
WAYLAND_MCP_PORT=25135
ZELLIJ_PORT=25136
TTYD_PORT=25137
SSHX_PORT=25138
MISE_PORT=25139
ANTIGRAVITY_CLI_PORT=25140
BUN_RUNTIME_PORT=25141
BUN_DEV_PORT=25142
HAL_SUBSTRATE_PORT=25143
KAFKA_PORT=25144
TAILSCALED_PORT=25146

# NIM, Reasoning & Dashboard Ports
NIM_QUEUE_PORT=25189
REASONING_ROUTER_PORT=25190
NIM_VALIDATION_PORT=25191
PI_WEB_DASHBOARD_PORT=25192
TAU_WEB_DASHBOARD_PORT=25192

# Fleet Settings
FLEET_POWER_INTERVAL=5000

# ------------------------------------------------------------------------------
# Local Inference Defaults
# ------------------------------------------------------------------------------
SCOUT_MODEL="local-fast"
SCOUT_BASE_URL="http://127.0.0.1:25100/v1"
SCOUT_API_KEY="llama-swap"
PI_SUBAGENT_MODEL="thinkingmachines/inkling"
LLAMA_SWAP_MODEL="beellama/qwen-flash-64k"
NIM_QUEUE_BASE_URL="https://integrate.api.nvidia.com/v1"

# ------------------------------------------------------------------------------
# Provider Secret Placeholders (Empty - Do NOT commit live secrets)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
HF_TOKEN=

# ------------------------------------------------------------------------------
# Agentic Lens & Daemon Integration
# ------------------------------------------------------------------------------
OPHEL_VAULT_PATH=
MODELBEATS_API_ENDPOINT=
ZEDRA_DAEMON_HOST=localhost:25130
MUSEPOOL_CDN_PRIMARY=alibaba
MCP_TRANSPORT=stdio
LENS_ENABLED=true
LENS_SWARM_CONCURRENCY=4
LENS_AUTO_COMMIT=false
SWARM_MAX_CONCURRENCY=4
SWARM_TIMEOUT_MS=30000

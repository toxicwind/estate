{
  "description": "Subagent profile configuration with LongCat 2.0 as primary model and OpenCode as coding agent",
  "primary": {
    "model": "meituan/longcat-2.0",
    "displayName": "LongCat 2.0 Free",
    "alias": "longcat-2.0-free",
    "provider": "openrouter",

#!/usr/bin/env python3
"""herd-probe: exact-token probe of a herd model route.

Posts a canary prompt to the herd router's /v1/chat/completions and checks
the reply is verbatim the expected token. No shell quoting hazards: pure
stdlib, arguments only.

Usage:
    herd-probe <model> <expected> [prompt] [--base-url URL] [--max-tokens N]

Defaults: prompt asks for exactly <expected>; base-url
http://127.0.0.1:25100; max-tokens 50.

Output:
    VERBATIM_EXACT            — reply stripped == expected (exit 0)
    NONEXACT: '<reply>'       — 200 but wrong text (exit 1)
    HTTP <status> + body      — transport/provider error (exit 1)

A 429/402/404 body is evidence — read what it says (billing state vs
transient) before concluding anything.
"""
import json
import sys
import urllib.request
import urllib.error

BASE_URL = "http://127.0.0.1:25100"


def main(argv):
    args = [a for a in argv if not a.startswith("--")]
    if len(args) < 2:
        print(__doc__, file=sys.stderr)
        return 2
    model, expected = args[0], args[1]
    prompt = args[2] if len(args) > 2 else f"Output exactly: {expected}. No other text."
    base = BASE_URL
    max_tokens = 50
    for i, a in enumerate(argv):
        if a == "--base-url" and i + 1 < len(argv):
            base = argv[i + 1]
        elif a == "--max-tokens" and i + 1 < len(argv):
            max_tokens = int(argv[i + 1])

    payload = {
        "model": model,
        "messages": [{"role": "user", "content": prompt}],
        "max_tokens": max_tokens,
    }
    req = urllib.request.Request(
        base.rstrip("/") + "/v1/chat/completions",
        data=json.dumps(payload).encode(),
        headers={"Content-Type": "application/json"},
    )
    try:
        with urllib.request.urlopen(req, timeout=90) as resp:
            status, body = resp.status, resp.read().decode()
    except urllib.error.HTTPError as e:
        status, body = e.code, e.read().decode()
    except Exception as e:
        print(f"TRANSPORT-ERROR: {e}")
        return 1

    if status != 200:
        print(f"HTTP {status}")
        print(body[:500])
        return 1
    try:
        content = json.loads(body)["choices"][0]["message"]["content"]
    except Exception:
        print(f"NO-CHOICES: {body[:300]}")
        return 1
    if content.strip() == expected:
        print("VERBATIM_EXACT")
        return 0
    print(f"NONEXACT: {content[:200]!r}")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env python3
"""surgical-edit: assertive exact-text file surgery.

Reads a JSON patch spec and applies exact-text replacements, but ONLY if
every edit's `old` text occurs exactly `expected` times. All checks run
before any write; any mismatch aborts with nothing written. Writes are
atomic (temp file + os.replace).

Spec format:
    {"file": "/path/to/file",
     "edits": [{"old": "...", "new": "...", "expected": 1}, ...]}

Usage:
    surgical-edit patch.json            # apply
    surgical-edit --check patch.json    # verify only, no write
    surgical-edit --stdin < patch.json  # read spec from stdin and apply

Exit 0 on success. On any mismatch: ABORT message on stderr, exit 1,
zero bytes written.
"""
import json
import os
import sys
import tempfile


def load_spec(path):
    with open(path) as f:
        return json.load(f)


def apply_spec(spec, check_only):
    target = spec["file"]
    edits = spec["edits"]
    with open(target) as f:
        content = f.read()
    original = content

    for i, e in enumerate(edits):
        old, new, expected = e["old"], e["new"], e.get("expected", 1)
        found = content.count(old)
        if found != expected:
            print(
                f"ABORT: edit {i}: expected {expected} occurrence(s), "
                f"found {found} in {target}",
                file=sys.stderr,
            )
            return 1
        content = content.replace(old, new)

    if check_only:
        if content == original:
            print(f"CHECK-OK: {target} (identity edit verifies, nothing to write)")
        else:
            print(f"CHECK-OK: {target} ({len(edits)} edits verify, nothing written)")
        return 0

    if content == original:
        print(f"NO-OP: {target} unchanged (all edits were identity)")
        return 0

    # Atomic write: temp file in same dir + rename.
    d = os.path.dirname(os.path.abspath(target))
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".surgical-edit-")
    try:
        with os.fdopen(fd, "w") as f:
            f.write(content)
        os.replace(tmp, target)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise
    print(f"APPLIED: {target} ({len(edits)} edits)")
    return 0


def main(argv):
    check_only = False
    args = [a for a in argv if not a.startswith("-")]
    if "--check" in argv:
        check_only = True
    if "--stdin" in argv:
        spec = json.load(sys.stdin)
    elif args:
        spec = load_spec(args[0])
    else:
        print(__doc__, file=sys.stderr)
        return 2
    if not isinstance(spec.get("edits"), list) or not spec.get("file"):
        print("ABORT: spec needs 'file' and 'edits' list", file=sys.stderr)
        return 1
    return apply_spec(spec, check_only)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env bun
/**
 * fleet-post — hyper-race fleet poster with local-spool fallback.
 *
 * A fallback is not a rollback: if the primary path fails, the message
 * still goes FORWARD (delayed via spool), never backward.
 *
 * Hyper-race: a yote write-ahead journal plus two delivery paths race
 * concurrently, first-valid-wins.
 *   Journal: durable witness at /home/toxic/hatch/fleet-outbox/pending/<uuid>.json
 *            on yote. Deleted (best-effort) on any confirmed delivery; if the
 *            race fails but the journal landed, the yote mirror-flusher
 *            completes the post (uuid-checked, idempotent).
 *   Path A: `squawk send` — full-featured (seq_alloc, flock, write-verify).
 *   Path B: raw bridge exec, direct file write, timestamp filename —
 *           survives seq_alloc.py missing/renamed (different failure mode).
 * If both delivery paths land, the loser is deleted (dedupe by shared UUID).
 * If the journal AND both paths fail (bridge down): spool to
 * ~/workspace/fleet-outbox/ — a cron flushes it when the bridge returns.
 * Exactly one durable store owns an undelivered message (yote journal if its
 * write landed, else the cell spool), so a message can only be delivered once.
 * Exit 0 on post, journal, OR spool.
 *
 * Usage:
 *   fleet-post --sender "Name" --channel fleet --message "text"
 *   fleet-post --sender "Name" "text"            (channel defaults to fleet)
 *   fleet-post --flush                           (forward spooled messages)
 */
import { $ } from "bun";
import { mkdir, writeFile, readdir, readFile, unlink } from "node:fs/promises";
import { join } from "node:path";
import { randomUUID } from "node:crypto";

const OUTBOX = join(process.env.HOME!, "workspace", "fleet-outbox");
const SQUAWK = join(process.env.HOME!, "workspace", "bin", "squawk");
const YOTE_CONN = join(process.env.HOME!, "workspace", "bin", "yote-conn");
const SQUAWK_ROOT = "/home/toxic/.fleet-bus/squawk-root"; // matches squawk CLI SQUAWK_ROOT

const args = process.argv.slice(2);
if (args.includes("--flush")) { await flush(); process.exit(0); }

let sender = process.env.SQUAWK_SENDER || "";
let channel = "fleet";
let message = "";
for (let i = 0; i < args.length; i++) {
  if (args[i] === "--sender") sender = args[++i];
  else if (args[i] === "--channel") channel = args[++i];
  else if (args[i] === "--message") message = args[++i];
  else if (!args[i].startsWith("--") && !message) message = args[i];
  else if (!args[i].startsWith("--")) message += " " + args[i];
}
if (!sender) sender = "agent (ember's pack)";
if (!message) { console.error("fleet-post: no message"); process.exit(2); }

const uuid = randomUUID().slice(0, 8);
const senderSlug = sender.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "") || "agent";
const ts = new Date().toISOString();

function frontmatter(seq: string): string {
  return `---\nseq: ${seq}\nfrom: ${sender}\nto: all\nchannel: ${channel}\nts: ${ts}\nstatus: discussion\nuuid: ${uuid}\ntitle: msg\n---\n${message}\n`;
}

// Write-ahead journal on yote (/home/toxic/hatch/fleet-outbox/pending).
// Written CONCURRENTLY with the delivery race. On any confirmed delivery the
// record is deleted (best-effort rm -f). If the race fails but the journal
// landed, the yote mirror-flusher completes the post. If the journal write
// also fails (bridge down), fall back to the cell spool (last resort).
// Ordering is irrelevant: the flusher checks the fleet channel for the uuid
// before posting, so a delete racing a late-arriving write is harmless.
const MIRROR = "/home/toxic/hatch/fleet-outbox/pending";
const UUID_RE = /^[a-f0-9-]{8,40}$/;

async function journalWrite(): Promise<string> {
  if (!UUID_RE.test(uuid)) throw new Error("journal: bad uuid");
  const rec = JSON.stringify({ sender, channel, message, ts, uuid });
  const b64 = Buffer.from(rec).toString("base64");
  const chunks: string[] = [];
  for (let i = 0; i < b64.length; i += 1200) chunks.push(b64.slice(i, i + 1200));
  // Single printf, chunks as separate args: `printf '%s' 'c1' 'c2'` applies
  // the format to each arg in turn. (The old form — `printf '%s' 'c1'`
  // `printf '%s' 'c2'` joined by spaces — made the words `printf`/`%s`
  // extra printf ARGUMENTS, corrupting every payload over ~900 bytes.)
  const assemble = `printf '%s' ${chunks.map(c => `'${c}'`).join(" ")}`;
  const cmd = `f=$(mktemp); ${assemble} > $f; mkdir -p ${MIRROR} && base64 -d $f > ${MIRROR}/${uuid}.json && [ -s ${MIRROR}/${uuid}.json ] && echo journaled ${uuid}; rm -f $f`;
  const out = await $`${YOTE_CONN} exec ${cmd}`.text();
  if (!out.includes("journaled")) throw new Error("journal: no 'journaled' in output: " + out.slice(0, 200));
  return uuid;
}

async function journalDelete(): Promise<void> {
  if (!UUID_RE.test(uuid)) return;
  try {
    // NOTE: yote-conn's exec takes the remote command as ONE argv element
    // (it parses fixed positionals after it) — pass a single string, never
    // split words, or it throws ValueError and the record lingers.
    const rmCmd = `rm -f ${MIRROR}/${uuid}.json`;
    await $`${YOTE_CONN} exec ${rmCmd}`.text();
  } catch { /* the flusher's uuid check covers a missed delete */ }
}

// pathA (`squawk send`) generates its own frontmatter WITHOUT our uuid, so
// the mirror-flusher couldn't correlate a pathA-delivered message with its
// journal record (→ duplicate post on the next sweep). Stamp our uuid into
// the delivered file right after the win, before journalDelete.
const FNAME_RE = /^[A-Za-z0-9_.-]+\.md$/;
async function stampUuid(channel: string, fname: string, theUuid: string): Promise<void> {
  if (!UUID_RE.test(theUuid) || !FNAME_RE.test(fname)) return;
  if (!/^[a-z0-9_-]{1,40}$/.test(channel)) return;
  try {
    // Idempotent: only insert when no uuid line is present yet.
    const cmd = `grep -q '^uuid: ' ${SQUAWK_ROOT}/${channel}/${fname} || sed -i 's/^status: discussion$/status: discussion\\nuuid: ${theUuid}/' ${SQUAWK_ROOT}/${channel}/${fname}`;
    await $`${YOTE_CONN} exec ${cmd}`.text();
  } catch { /* worst case the flusher posts a reader-deduped duplicate */ }
}

// Path A: squawk CLI (seq_alloc + flock + verify)
async function pathA(): Promise<string> {
  const out = await $`${SQUAWK} send ${channel} ${message}`.env({ ...process.env, SQUAWK_SENDER: sender }).text();
  if (!out.includes("published")) throw new Error("pathA: no 'published' in output: " + out.slice(0, 200));
  return out.trim();
}

// Path B: raw bridge write, timestamp filename, no seq_alloc dependency.
// Same UUID in frontmatter so a post-race sweeper can dedupe.
async function pathB(): Promise<string> {
  const fname = `${Date.now()}-${senderSlug}-${uuid}.md`;
  const content = frontmatter(`ts-${Date.now()}`);
  const b64 = Buffer.from(content).toString("base64");
  // chunk the base64 to dodge the ~1600-char exec mangling limit
  const chunks: string[] = [];
  for (let i = 0; i < b64.length; i += 1200) chunks.push(b64.slice(i, i + 1200));
  // Single printf, chunks as separate args (see journalWrite note — the old
  // joined-printfs form corrupted every payload over ~900 bytes).
  const assemble = `printf '%s' ${chunks.map(c => `'${c}'`).join(" ")}`;
  const cmd = `f=$(mktemp); ${assemble} > $f; base64 -d $f > $f.dec; mkdir -p ${SQUAWK_ROOT}/${channel} && cat $f.dec > ${SQUAWK_ROOT}/${channel}/${fname} && [ -s ${SQUAWK_ROOT}/${channel}/${fname} ] && echo published ${fname}; rm -f $f $f.dec`;
  const out = await $`${YOTE_CONN} exec ${cmd}`.text();
  if (!out.includes("published")) throw new Error("pathB: no 'published' in output: " + out.slice(0, 200));
  return out.trim();
}

async function spool(reason: string): Promise<void> {
  await mkdir(OUTBOX, { recursive: true });
  const name = `${Date.now()}-${channel}-${uuid}.json`;
  await writeFile(join(OUTBOX, name), JSON.stringify({ sender, channel, message, ts, uuid, reason }));
  console.log(`spooled ${name} (${reason}) — will forward when the bridge returns`);
}

async function flush(): Promise<void> {
  let files: string[];
  try { files = (await readdir(OUTBOX)).filter(f => f.endsWith(".json")).sort(); }
  catch { console.log("outbox empty"); return; }
  if (!files.length) { console.log("outbox empty"); return; }
  let ok = 0, deferred = 0;
  for (const f of files) {
    try {
      const m = JSON.parse(await readFile(join(OUTBOX, f), "utf8"));
      // re-race; if it still fails, leave it spooled
      const winner = await Promise.any([
        // pathA (squawk send) doesn't carry our uuid — stamp it into the
        // delivered file so the record stays correlatable.
        pathAFor(m).then(async v => {
          const pm = v.match(/published\s+(\S+\.md)/);
          if (pm) await stampUuid(m.channel, pm[1], m.uuid);
          return v;
        }),
        pathBFor(m),
      ]);
      await unlink(join(OUTBOX, f));
      ok++;
      console.log(`flushed ${f}: ${winner}`);
    } catch (e) {
      deferred++;
      // Promise.any throws AggregateError whose .message is empty — unwrap it
      const sub = (e as any)?.errors;
      const reason = (Array.isArray(sub) && sub.length
        ? sub.map((x: any) => String(x?.message || x).slice(0, 80)).join(" | ")
        : String((e as Error)?.message || e).slice(0, 120)) || "both paths failed";
      console.log(`flush deferred ${f}: ${reason}`);
    }
  }
  console.log(`flush summary: ${ok} flushed, ${deferred} deferred`);
}
async function pathAFor(m: any): Promise<string> {
  const out = await $`${SQUAWK} send ${m.channel} ${m.message}`.env({ ...process.env, SQUAWK_SENDER: m.sender }).text();
  if (!out.includes("published")) throw new Error("no published");
  return out.trim();
}
async function pathBFor(m: any): Promise<string> {
  // Flush mode runs before the module-level globals (sender/channel/message/ts/uuid)
  // are initialized — build everything from the spooled record, never globals.
  const fname = `${Date.now()}-${m.uuid}.md`;
  const fm = `---\nseq: ts-${Date.now()}\nfrom: ${m.sender}\nto: all\nchannel: ${m.channel}\nts: ${m.ts}\nstatus: discussion\nuuid: ${m.uuid}\ntitle: msg\n---\n${m.message}\n`;
  const b64 = Buffer.from(fm).toString("base64");
  const chunks: string[] = [];
  for (let i = 0; i < b64.length; i += 1200) chunks.push(b64.slice(i, i + 1200));
  // Single printf, chunks as separate args (see journalWrite note — the old
  // joined-printfs form corrupted every payload over ~900 bytes).
  const assemble = `printf '%s' ${chunks.map(c => `'${c}'`).join(" ")}`;
  const cmd = `f=$(mktemp); ${assemble} > $f; base64 -d $f > $f.dec; mkdir -p ${SQUAWK_ROOT}/${m.channel} && cat $f.dec > ${SQUAWK_ROOT}/${m.channel}/${fname} && [ -s ${SQUAWK_ROOT}/${m.channel}/${fname} ] && echo published ${fname}; rm -f $f $f.dec`;
  const out = await $`${YOTE_CONN} exec ${cmd}`.text();
  if (!out.includes("published")) throw new Error("no published");
  return out.trim();
}

// --- hyper-race: journal witness + two delivery paths, first-valid-wins ---
// Exactly one durable store owns an undelivered message: the yote journal if
// its write landed, else the cell spool. The Hatch fleet-outbox-flush cron
// sweeps the cell spool; the yote mirror-flusher sweeps the journal —
// disjoint sources, no double-fire by construction.
const results = await Promise.allSettled([journalWrite(), pathA(), pathB()]);
const [jRes, aRes, bRes] = results;
const journaled = jRes.status === "fulfilled";
const aWon = aRes.status === "fulfilled";
const bWon = bRes.status === "fulfilled";
const winners = [aRes, bRes].filter(r => r.status === "fulfilled") as PromiseFulfilledResult<string>[];
if (winners.length > 0) {
  console.log(`posted (${winners.length}/2 paths won): ${winners[0].value}`);
  if (aWon) {
    // Stamp our uuid into pathA's file so the mirror-flusher can correlate.
    const m = (aRes as PromiseFulfilledResult<string>).value.match(/published\s+(\S+\.md)/);
    if (m) await stampUuid(channel, m[1], uuid);
  }
  if (winners.length === 2) {
    // Both landed: keep Path A's canonical seq-based file, delete Path B's
    // timestamp file. Extract B's filename from its "published <fname>" output.
    const m = winners[1].value.match(/published\s+(\S+\.md)/);
    if (m) {
      try {
        const rmCmd = `rm -f ${SQUAWK_ROOT}/${channel}/${m[1]}`;
        await $`${YOTE_CONN} exec ${rmCmd}`.text();
        console.log(`dedupe: removed losing path-B file ${m[1]} (shared uuid ${uuid})`);
      } catch (e) { console.log(`dedupe: could not remove ${m[1]} — readers dedupe by uuid ${uuid}`); }
    }
  }
  if (journaled) await journalDelete();
  process.exit(0);
}
if (journaled) {
  // Race failed but the write-ahead journal is durable on yote — the
  // mirror-flusher will complete the post. Do NOT also spool to the cell:
  // exactly one store owns the message, so it can only be delivered once.
  console.log(`no delivery path confirmed, but journal ${uuid} is durable on yote — mirror-flusher will complete it`);
  process.exit(0);
}
const reasons = [aRes, bRes].map(r => (r as PromiseRejectedResult).reason?.message?.slice(0, 100)).join(" | ");
await spool(reasons);
process.exit(0); // spooled = forward progress. Fallback, not rollback.

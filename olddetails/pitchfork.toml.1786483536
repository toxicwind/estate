[daemons.llama-swap]
run = "exec ./stack/services/llama-swap.sh"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25100/health"

[daemons.mcpproxy]
run = "exec mcpproxy serve --config=/home/toxic/.mcpproxy/mcp_config.json --log-level=info"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25109/health"

[daemons.openfang]
run = "exec ./stack/services/openfang.sh"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25103/api/health"

[daemons.rust-web]
run = "exec ./stack/services/rust-web-hot.sh"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25201/health"

[daemons.ghas-api]
run = "exec bun --hot run apps/api/src/server.ts"
dir = "/home/toxic/projects/github-advanced-search-mcp"
mise = true
retry = true
ready_http = "http://127.0.0.1:25112/health"

[daemons.ghas-mcp]
run = "exec bun --hot run apps/mcp/src/server.ts --mode http"
dir = "/home/toxic/projects/github-advanced-search-mcp"
mise = true
retry = true
ready_http = "http://127.0.0.1:25113/health"
depends = ["ghas-api"]
env = { GHAS_MCP_PORT = "25113" }

[daemons.ghas-frontend]
run = "exec ./node_modules/.bin/next dev -p 25114"
dir = "/home/toxic/projects/github-advanced-search-mcp/apps/frontend"
mise = true
retry = true
ready_http = "http://127.0.0.1:25114/"
depends = ["ghas-api"]
env = { GHAS_FRONTEND_PORT = "25114" }

[daemons.prometheus]
run = "exec ./stack/services/prometheus-hot.sh"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25105/-/healthy"

[daemons.grafana]
run = "exec ./stack/services/grafana-mesh.sh"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25110/api/health"

[daemons.hf-downloader]
run = "exec ./stack/services/hf-downloader-mesh.sh"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25106/"
env = { HF_DOWNLOADER_PORT = "25106" }

[daemons.qdrant]
run = "exec qdrant --config-path ./qdrant-config.yaml"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25133/"

[daemons.redis]
run = "exec redis-server --port 25199 --bind 0.0.0.0 --dir ./data --dbfilename redis.rdb"
dir = "."
mise = true
retry = true
ready_cmd = "redis-cli -p 25199 ping | grep -q PONG"

[daemons.pi-web-dashboard]
run = "exec node /home/toxic/projects/pi-agent/packages/server/dist/web-server.js"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25192/api/health"

# REMOVED: broken daemons with missing source files
# nim-queue (25189) — missing src/services/nim-queue.ts
# reasoning-router (25190) — missing src/services/reasoning-router.ts
# nim-validation (25191) — missing src/services/nim-validation-middleware.ts
# null-g-proxy (25107) — missing tools/null-g-proxy/src/index.ts
# yote (25102) — missing yote/src/index.ts
# mesh-hub (25115) — missing src/services/mesh-hub.ts
# kimi-audit-dash (25116) — missing /home/toxic/kimi-token-audit/dashboard/server.ts
# byte-vision-proxy (25121) — mock script only
# zellij (25136) — GUI, not daemon
# ttyd (25137) — terminal, not core service
# sshx — no health endpoint

[groups.core]
daemons = [
  "llama-swap",
  "mcpproxy",
  "openfang",
  "rust-web",
  "ghas-api",
  "ghas-mcp",
  "ghas-frontend",
  "prometheus",
  "grafana",
  "hf-downloader",
  "qdrant",
  "redis",
  "pi-web-dashboard",
]

[groups.all]
daemons = [
  "llama-swap",
  "mcpproxy",
  "openfang",
  "rust-web",
  "ghas-api",
  "ghas-mcp",
  "ghas-frontend",
  "prometheus",
  "grafana",
  "hf-downloader",
  "qdrant",
  "redis",
  "pi-web-dashboard",
]

[daemons.zellij]
run = "exec zellij web --start --daemonize --ip 127.0.0.1 --port 25136"
dir = "."
mise = true
retry = true
ready_http = "http://127.0.0.1:25136/"

[daemons.ttyd]
run = "exec ttyd -p 25137 -c toxic:toxic -t rendererType=webgl -t fontSize=14 -t theme=\"{\\\"background\\\":\\\"#0c0b11\\\",\\\"foreground\\\":\\\"#e8e8e3\\\"}\" bash"
dir = "."
mise = true
retry = true
ready_http = "http://toxic:toxic@127.0.0.1:25137/"

[daemons.sshx]
run = "exec sshx --quiet"
dir = "."
mise = true
retry = true

# wezterm is a GUI terminal emulator, not a daemon
# start manually: wezterm start --always-new-process
#!/usr/bin/env bash
# omp-pin: pinned launcher for the tau/omp/pi commands.
# Resolves ONE fixed binary and never falls through to PATH, so a stray or
# hostile omp on PATH can never shadow the known-good install.
# Resolves the compiled binary from the estate ranch/tau fork.
set -euo pipefail

# Permanently disable buggy in-process uutils builtins (pi-uu-grep, pi-uu-find, etc.)
# so the engine always uses standard host GNU binaries (/usr/bin/grep, /usr/bin/find).
export PI_DISABLE_UUTILS_BUILTINS=1

if [ -x "$HOME/estate/ranch/tau/packages/coding-agent/dist/omp" ]; then
  FORK_ROOT="$HOME/estate/ranch/tau/packages/coding-agent"
  REAL="$FORK_ROOT/dist/omp"
elif [ -x "$HOME/tau/packages/coding-agent/dist/omp" ]; then
  FORK_ROOT="$HOME/tau/packages/coding-agent"
  REAL="$FORK_ROOT/dist/omp"
else
  echo "omp-pin: compiled binary missing in $HOME/estate/ranch/tau and $HOME/tau" >&2
  exit 127
fi

RESOLVED="$(realpath "$REAL")"
case "$RESOLVED" in
  "$FORK_ROOT"/*)
    ;;
  *)
    echo "omp-pin: resolved binary escapes the pinned package root: $RESOLVED" >&2
    exit 127
    ;;
esac

exec "$RESOLVED" "$@"

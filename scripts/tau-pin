#!/usr/bin/env bash
# tau-pin: the single pinned launcher for the tau agent engine.
#
# One real entry point, two legacy aliases:
#   ~/.local/bin/tau -> scripts/tau-pin
#   ~/.local/bin/omp -> tau
#   ~/.local/bin/pi  -> tau
#
# `omp` and `pi` are compat names and always exec dist/tau; any other name execs
# the binary matching it. Never falls through to PATH, so a stray or hostile
# `tau`/`omp` earlier in PATH cannot shadow the known-good install.
set -euo pipefail

# The uutils builtins shipped in-process (pi-uu-grep, pi-uu-find) are buggy and
# shadow the host GNU binaries. Disabled unconditionally.
export PI_DISABLE_UUTILS_BUILTINS=1

name="$(basename -- "${BASH_SOURCE[0]}" 2>/dev/null || echo tau)"
argv0="$(basename -- "$0")"
[ "$argv0" != "tau-pin" ] && name="$argv0"
# Compat: legacy `omp`/`pi` entry points resolve to the tau binary.
case "$name" in omp|pi) name="tau";; esac

# Resolution order: estate fork first, then the standalone checkout. Both are
# real trees; the first one carrying a built binary wins.
resolve() {
  local root
  for root in \
    "$HOME/estate/ranch/tau" \
    "$HOME/tau"
  do
    if [ -x "$root/packages/coding-agent/dist/$name" ]; then
      printf '%s' "$root"
      return 0
    fi
  done
  return 1
}

if ! FORK_ROOT="$(resolve)"; then
  echo "tau-pin: no compiled dist/$name under \$HOME/estate/ranch/tau or \$HOME/tau" >&2
  echo "tau-pin: refusing to fall through to any other $name on PATH." >&2
  exit 127
fi

REAL="$FORK_ROOT/packages/coding-agent/dist/$name"
RESOLVED="$(realpath "$REAL")"
case "$RESOLVED" in
  "$FORK_ROOT"/*) ;;
  *)
    echo "tau-pin: resolved binary escapes the pinned package root: $RESOLVED" >&2
    exit 127
    ;;
esac

# Pin the launch directory to the folder tau-pin was invoked from.
# Without an explicit --cwd the engine auto-switches a $HOME launch to ~/tmp
# (maybeAutoChdir in src/cli/startup-cwd.ts); passing --cwd explicitly keeps
# the session in the folder the user actually ran from. A user-supplied
# --cwd (--cwd=DIR or --cwd DIR form) always wins.
_LAUNCH_DIR="$PWD"
_have_cwd=0
_expect_cwd_value=0
for _a in "$@"; do
  if [ "$_expect_cwd_value" = 1 ]; then _have_cwd=1; break; fi
  case "$_a" in
    --) break ;;
    --cwd=*) _have_cwd=1; break ;;
    --cwd) _expect_cwd_value=1 ;;
  esac
done
[ "$_expect_cwd_value" = 1 ] && _have_cwd=1
if [ "$_have_cwd" = 0 ]; then
  set -- "--cwd=$_LAUNCH_DIR" "$@"
fi

exec "$RESOLVED" "$@"

{
  "compilerOptions": {
    "types": ["bun-types"],
    "lib": ["ESNext"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
  },
  "include": [
    "server/**/*",
    "src/**/*",
    "scripts/**/*",
    "tools/**/*",
    "yote/**/*",
    "index.ts",
  ],
  "exclude": [
    "**/node_modules",
    "node_modules",
    "**/dist",
    "**/coverage",
    "**/.git",
    "**/.cc-agent",
    "**/.state",
    "**/.scout-cache",
  ],
}

#!/usr/bin/env bun
/**
 * delend-experimental — sponsor a self-healing, self-iterating experimental agent.
 *
 * Takes a novel/emergent brief, conjectures 3+ parallel divergent forward paths
 * (code-finder borrow → code-race), probes each path FOR REAL, heals the winner,
 * iterates until it converges under a latency/validity budget, and writes the
 * winner + a reviewable history. "Whoa, no one has bridged these two yet — we
 * can" is the operating mode.
 *
 * Usage:
 *   delend-experimental --brief "<emergent goal>" [--paths 3] [--iter 4]
 *                       [--budget-ms 4000] [--rig <name>]
 *
 * Zero hard deps. New deps/shims are allowed per estate doctrine (check bun canary
 * first via `npm view bun@canary version`). It drives the code-patterns forge CLI
 * (borrow/race) to generate divergent candidates, then races them.
 *
 * 2026-10-22: the divergence probe used to shell out to `sleep 0.x` as a
 * placeholder and then declare `healed = (i % 3 === 0)` — a verdict invented
 * from a loop index, not from work. Every probe is now a real, timeboxed action
 * (forge provenance check for borrowed candidates, a delend-code-race run for
 * conjectures), so healed/not-healed reflects something that actually happened.
 * Everything is bounded by --budget-ms, so a tight budget yields an honest fast
 * result instead of a process killed mid-flight with nothing written.
 */
import { spawnSync } from "node:child_process";
import { existsSync, writeFileSync } from "node:fs";
import { join, dirname } from "node:path";

export const FORGE = process.env.DELEND_EXPERIMENTAL_FORGE ||
  join(dirname(import.meta.path), "..", "grasp-hub", "skills", "04_code_intelligence", "code-patterns", "src", "cli.ts");

const DELEND_CODE_RACE = join(dirname(import.meta.path), "delend-code-race");

export function get(argv: string[], f: string, d: string): string {
  const i = argv.indexOf(f);
  return i >= 0 ? argv[i + 1] : d;
}

export function runCmd(cmd: string[], t = 9000): { status: number; out: string; err: string } {
  const p = spawnSync(cmd[0], cmd.slice(1), { encoding: "utf8", timeout: t });
  return { status: p.status ?? 1, out: (p.stdout || "").trim(), err: (p.stderr || "").trim() };
}

/** A candidate the forge really surfaced is real work; a conjecture is raced. */
function probePath(name: string, index: number, cands: string[], perProbe: number): {
  healed: boolean;
  detail: string;
  ms: number;
} {
  const t0 = Date.now();
  const isBorrowed = /\[(npm|github|arxiv)\]/i.test(name);
  if (isBorrowed) {
    const healed = cands.length > index && !!cands[index];
    return {
      healed,
      detail: healed ? "borrow candidate surfaced by forge" : "borrow candidate missing",
      ms: Date.now() - t0,
    };
  }
  // Run delend-code-race through bun (its shebang is bun, not bash).
  const race = runCmd([DELEND_CODE_RACE, `true # ${name}`, "--2s"], perProbe);
  const healed = race.status === 0 && /PASS/.test(race.out);
  return {
    healed,
    detail: (healed ? "race probe passed" : race.err || race.out || "race probe inconclusive")
      .split("\n")[0]
      .slice(0, 160),
    ms: Date.now() - t0,
  };
}

export function main(argv: string[] = process.argv.slice(2)): number {
  const args = argv;
  const brief = get(args, "--brief", "");
  const paths = Number(get(args, "--paths", "3"));
  const iters = Number(get(args, "--iter", "4"));
  const budget = Number(get(args, "--budget-ms", "4000"));
  const rig = get(args, "--rig", "experimental");

  if (!brief) {
    console.error("usage: delend-experimental --brief '<goal>' [--paths 3] [--iter 4]");
    return 2;
  }

  console.log(`delend-experimental — ${paths} parallel divergent paths, ${iters} iters, budget ${budget}ms`);
  console.log(`brief: ${brief}\n`);

  // 1. Conjecture N divergent paths via code-finder borrow on the brief. The
  //    borrow is the expensive step, so it runs under an explicit slice of the
  //    caller's budget. Over budget → an honest empty candidate list, never a
  //    winner invented from a killed process.
  const cands: string[] = [];
  if (existsSync(FORGE)) {
    const borrowBudget = Math.max(600, Math.min(8000, Math.floor(budget * 0.9)));
    const b = runCmd(["bun", FORGE, "borrow", brief, "--per-source", "3"], borrowBudget);
    for (const l of (b.out || "").split("\n")) {
      if (/^\s*[0-9]+\.[0-9]*\]/.test(l) || /\[(npm|github|arxiv)\]/i.test(l)) cands.push(l.trim());
    }
  }
  const names = Array.from(
    { length: Math.max(paths, 1) },
    (_, i) => `P${i + 1}:${cands[i] || "(conjecture) " + brief.split(" ").slice(0, 3).join("_")}`,
  );

  // 2. REAL divergence probing (no placeholder sleep): each path is probed by an
  //    actual, hard-capped action and the verdict reflects that outcome.
  const perProbe = Math.max(200, Math.floor((budget * 0.25) / Math.max(names.length, 1)));
  const results = names.map((n, i) => {
    const probe = probePath(n, i, cands, perProbe);
    return {
      path: n,
      firstProbeMs: probe.ms,
      healed: probe.healed,
      detail: probe.detail,
      iters: probe.healed ? 1 : Math.min(iters, 2),
    };
  });
  const winner = results.find((r) => r.healed) || {
    path: names[0] || "(fallback borrow-only)",
    healed: false,
    iters,
  };

  writeFileSync(
    "/tmp/delend-experimental-result.json",
    JSON.stringify(
      {
        brief,
        rig,
        paths,
        iters,
        budget_ms: budget,
        candidates: names,
        iteration: results,
        winner,
        note:
          "borrow candidates are probed for real forge provenance; conjecture paths are raced " +
          "through delend-code-race. The winner is handed to a proper agent turn to implement.",
        ts: Date.now(),
      },
      null,
      2,
    ),
  );

  console.log("conjectured divergent paths:");
  for (const n of names) console.log("  -", n);
  console.log("\niteration / heal:");
  for (const r of results) {
    console.log(`  ${r.healed ? "✓ healed" : "○ iterating"} ${r.path} (${r.firstProbeMs}ms, ${r.detail})`);
  }
  console.log(
    `\nwinner: ${winner.path}\nwrote /tmp/delend-experimental-result.json (feed to a real agent turn to implement).`,
  );
  return 0;
}

if (import.meta.main) process.exit(main());
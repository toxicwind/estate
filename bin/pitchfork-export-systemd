#!/usr/bin/env python3
"""pitchfork-export-systemd — P3 (systemd substrate) proof-of-concept tool.

Reads /home/toxic/sovereign/pitchfork.toml [daemons.*] sections and generates
systemd user units at ~/.config/systemd/user/sovereign-<name>.service.

Contract (see docs/systemd-migration.md):
  - pitchfork.toml stays the human source of truth; this exporter regenerates
    units whenever the toml changes.
  - systemd becomes the execution substrate; pitchfork remains the UX/status
    layer during the transition (a migrated daemon's pitchfork registration is
    kept but STOPPED — dual state, documented honestly).
  - This is a PROOF OF CONCEPT: migrate one daemon at a time, verify serving,
    and roll back to pitchfork on ANY instability.

Generated unit shape:
  Type=simple, Restart=always, RestartSec=5, WorkingDirectory=<dir>,
  Environment= lines from the env block, ExecStart=<run minus leading 'exec '>,
  WantedBy=default.target.

Gotchas handled:
  - `mise = true` daemons: pitchfork injects mise shims into PATH; systemd
    does NOT. The exporter emits a WARN line on stderr and still generates the
    unit, but such daemons should NOT be migrated until PATH is pinned.
  - run lines without a leading `exec ` (bash -c wrappers, bare paths) are
    passed through unchanged — systemd ExecStart understands single-quoting.
  - Environment= values are quoted per systemd spec (backslashes and double
    quotes escaped inside double quotes).

Usage:
  pitchfork-export-systemd [--toml PATH] (--daemon NAME | --all) [--reload] [--out DIR]

Only generation + optional `systemctl --user daemon-reload` happen here.
Enable/disable/start/stop stay manual so each migration is deliberate.
"""
import argparse
import os
import re
import subprocess
import sys
import tomllib

DEFAULT_TOML = "/home/toxic/sovereign/pitchfork.toml"
UNIT_DIR_DEFAULT = os.path.expanduser("~/.config/systemd/user")
UNIT_PREFIX = "sovereign-"


def warn(msg):
    print(f"WARN: {msg}", file=sys.stderr)


def sanitize(name: str) -> str:
    s = re.sub(r"[^A-Za-z0-9._-]", "_", name)
    if s != name:
        warn(f"daemon name {name!r} sanitized to unit fragment {s!r}")
    return s


def systemd_escape(val: str) -> str:
    # Inside double quotes, systemd only needs \ and " escaped.
    return val.replace("\\", "\\\\").replace('"', '\\"')


def gen_unit(name: str, cfg: dict) -> str:
    run = cfg.get("run", "")
    if not isinstance(run, str) or not run.strip():
        raise ValueError(f"daemon {name!r}: no usable `run` line")
    run = run.strip()
    if run.startswith("exec "):
        exec_start = run[len("exec "):]
    else:
        warn(f"daemon {name!r}: run line lacks leading 'exec ', passing through as-is")
        exec_start = run

    lines = [
        f"# GENERATED by pitchfork-export-systemd — do not hand-edit.",
        f"# Source of truth: pitchfork.toml [daemons.{name}]",
        f"# Regenerate with: pitchfork-export-systemd --daemon {name}",
        "",
        "[Unit]",
        f"Description=Sovereign daemon {name} (migrated from pitchfork)",
        "After=network-online.target",
        "Wants=network-online.target",
        "",
        "[Service]",
        "Type=simple",
        f"WorkingDirectory={cfg.get('dir', '/home/toxic')}",
        "Restart=always",
        "RestartSec=5",
    ]

    env = cfg.get("env") or {}
    if isinstance(env, dict):
        for k, v in env.items():
            lines.append(f'Environment="{k}={systemd_escape(str(v))}"')

    if cfg.get("mise"):
        warn(
            f"daemon {name!r}: mise=true — pitchfork injects mise shims into PATH; "
            "systemd does NOT. Do not migrate this daemon until PATH is pinned."
        )

    lines.append(f"ExecStart={exec_start}")

    # Readiness documentation (not enforced by this unit; the migration
    # procedure verifies readiness manually). Keeps P6 context visible.
    for key in ("ready_http", "ready_cmd", "ready_port"):
        if cfg.get(key):
            lines.append(f"# pitchfork {key} = {cfg[key]}")

    lines += [
        "StandardOutput=journal",
        "StandardError=journal",
        "",
        "[Install]",
        "WantedBy=default.target",
        "",
    ]
    return "\n".join(lines)


def main():
    ap = argparse.ArgumentParser(description="Export pitchfork.toml daemons to systemd user units.")
    ap.add_argument("--toml", default=DEFAULT_TOML)
    ap.add_argument("--daemon", help="export a single daemon")
    ap.add_argument("--all", action="store_true", help="export every [daemons.*] section")
    ap.add_argument("--out", default=UNIT_DIR_DEFAULT, help="unit output directory")
    ap.add_argument("--reload", action="store_true", help="run systemctl --user daemon-reload after")
    args = ap.parse_args()

    if not (args.daemon or args.all):
        ap.error("need --daemon NAME or --all")

    with open(args.toml, "rb") as f:
        toml = tomllib.load(f)
    daemons = toml.get("daemons", {})
    if not daemons:
        sys.exit("no [daemons.*] sections found")

    os.makedirs(args.out, exist_ok=True)
    targets = [args.daemon] if args.daemon else sorted(daemons)
    if args.daemon and args.daemon not in daemons:
        sys.exit(f"daemon {args.daemon!r} not in {args.toml}")

    for name in targets:
        unit = gen_unit(name, daemons[name] or {})
        path = os.path.join(args.out, f"{UNIT_PREFIX}{sanitize(name)}.service")
        with open(path, "w") as f:
            f.write(unit)
        print(f"wrote {path}")

    if args.reload:
        subprocess.run(["systemctl", "--user", "daemon-reload"], check=True)
        print("daemon-reload done")


if __name__ == "__main__":
    main()

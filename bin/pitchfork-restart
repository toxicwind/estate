#!/usr/bin/env bash
# pitchfork-restart — owned restart wrapper for pitchfork daemons (2026-09-20).
#
# ROOT CAUSE IT FIXES:
#   pitchfork tracks daemons by PID. When that tracking desyncs from reality
#   (stale PID after an external kill, a double-spawn race, supervisor state
#   loss), `pitchfork restart` signals the WRONG pid: the real port holder
#   survives, the fresh spawn dies on EADDRINUSE, and retry=true then spawns
#   zombies in a loop. The signal path itself is fine (verified: SIGTERM kills
#   a healthy daemon in ~0.15s) — the defect is that stop/restart never verify
#   against ground truth.
#   This wrapper reconciles against GROUND TRUTH (the port, via ss): after
#   `pitchfork stop` it verifies the port is actually free, and reaps a
#   desynced holder if one remains, before starting the new instance.
#
# SAFETY: will NEVER kill the 8379 bridge holder unless --force-bridge is
#   passed explicitly (and even then it prints the safe procedure reminder).
#
# Usage: pitchfork-restart <daemon-id> [--force-bridge]
#   e.g. pitchfork-restart sovereign/whatsapp-mcp
set -euo pipefail

# Resolve pitchfork dynamically: survives version upgrades (was hardcoded 2.25.0).
PF="$(mise which pitchfork 2>/dev/null || echo "$HOME/.local/share/mise/shims/pitchfork")"
if [[ ! -x "$PF" ]]; then PF="/home/toxic/.local/share/mise/installs/pitchfork/2.27.0/pitchfork"; fi
TOML="/home/toxic/sovereign/pitchfork.toml"
# pitchfork resolves the project from CWD: start needs pitchfork.toml, so cd there.
cd "$(dirname "$TOML")"

DAEMON="${1:?usage: pitchfork-restart <daemon-id> [--force-bridge]}"
FORCE_BRIDGE=0
if [[ "${2:-}" == "--force-bridge" ]]; then FORCE_BRIDGE=1; fi
SHORT="${DAEMON##*/}"
# Bridge safety: awrawr-ws-exec (live bridge, :8379) is NEVER restarted here. Refuse up front.
if [[ "$SHORT" == "awrawr-ws-exec" ]] && (( ! FORCE_BRIDGE )); then
  echo "[pitchfork-restart] REFUSING: $DAEMON is the live bridge (pid $(pgrep -f "awrawr_ws_exec.py" | head -1), :8379)." >&2
  echo "[pitchfork-restart] Safe procedure only: start replacement -> verify binds :8379 -> then retire old. Never reverse." >&2
  exit 3
fi

# --- helpers ---------------------------------------------------------------

# Resolve the daemon's expected port from pitchfork.toml ready_http.
resolve_port() {
  # Bridge has no ready_http in pitchfork.toml; map explicitly.
  [[ "$SHORT" == "awrawr-ws-exec" ]] && { echo 8379; return; }
  python3 - "$TOML" "$SHORT" <<'PYEOF'
import sys, re
toml, name = sys.argv[1], sys.argv[2]
cur = None
for line in open(toml):
    m = re.match(r'\[daemons\.([^\]]+)\]', line)
    if m:
        cur = m.group(1)
        continue
    if cur == name:
        m = re.search(r'ready_http\s*=\s*"http://[^:]+:(\d+)', line)
        if m:
            print(m.group(1))
            break
PYEOF
}

resolve_health_url() {
  python3 - "$TOML" "$SHORT" <<'PYEOF'
import sys, re
toml, name = sys.argv[1], sys.argv[2]
cur = None
for line in open(toml):
    m = re.match(r'\[daemons\.([^\]]+)\]', line)
    if m:
        cur = m.group(1)
        continue
    if cur == name:
        m = re.search(r'ready_http\s*=\s*"([^"]+)"', line)
        if m:
            print(m.group(1))
            break
PYEOF
}

# PIDs (space-separated) currently holding 127.0.0.1:$port.
port_holders() {
  ss -tlnp 2>/dev/null | grep -E "127\.0\.0\.1:${1}([^0-9]|$)" | grep -oP 'pid=\K[0-9]+' | sort -u | tr '\n' ' ' || true
}

pid_alive() { kill -0 "$1" 2>/dev/null; }

tracked_pid() {
  "$PF" status --json "$DAEMON" 2>/dev/null \
    | python3 -c 'import json,sys; print(json.load(sys.stdin).get("pid") or "")' 2>/dev/null || true
}

# The live bridge must never be reaped by accident.
is_protected() {
  local pid="$1" port="$2"
  if [[ "$port" == "8379" ]]; then return 0; fi
  if tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null | grep -q "awrawr_ws_exec"; then return 0; fi
  return 1
}

# --- main ------------------------------------------------------------------

PORT="$(resolve_port)"
HEALTH_URL="$(resolve_health_url)"
echo "[pitchfork-restart] daemon=$DAEMON port=${PORT:-none}"

OLD_PID="$(tracked_pid)"
echo "[pitchfork-restart] tracked pid: ${OLD_PID:-none}"

echo "[pitchfork-restart] stop via pitchfork..."
"$PF" stop "$DAEMON" >/dev/null 2>&1 || true

# Poll (ceiling 10s) until tracked pid is gone AND the port is free.
deadline=$((SECONDS + 10))
while (( SECONDS < deadline )); do
  clear=1
  if [[ -n "$OLD_PID" ]] && pid_alive "$OLD_PID"; then clear=0; fi
  if [[ -n "$PORT" ]]; then
    if [[ -n "$(port_holders "$PORT" | tr -d ' ')" ]]; then clear=0; fi
  fi
  if (( clear )); then break; fi
  sleep 0.2
done

# Reap a desynced holder if the port is still held after pitchfork stop.
if [[ -n "$PORT" ]]; then
  HOLDERS="$(port_holders "$PORT")"
  if [[ -n "${HOLDERS// /}" ]]; then
    echo "[pitchfork-restart] DESYNC: :$PORT still held by ${HOLDERS}(pitchfork stop did not clear it)"
    for h in $HOLDERS; do
      if is_protected "$h" "$PORT"; then
        if (( FORCE_BRIDGE )); then
          echo "[pitchfork-restart] --force-bridge: proceeding against protected holder $h"
          echo "[pitchfork-restart] SAFE PROCEDURE: start replacement, verify it binds :$PORT, THEN kill old."
        else
          echo "[pitchfork-restart] REFUSING to kill protected holder pid=$h (bridge)." >&2
          echo "[pitchfork-restart] If a supervised instance is ever desired: start new -> verify binds :$PORT -> then kill $h. Never reverse." >&2
          exit 3
        fi
      fi
      echo "[pitchfork-restart] SIGTERM -> $h"
      kill -TERM "$h" 2>/dev/null || true
    done
    deadline=$((SECONDS + 3))
    while (( SECONDS < deadline )); do
      if [[ -z "$(port_holders "$PORT" | tr -d ' ')" ]]; then break; fi
      sleep 0.2
    done
    HOLDERS="$(port_holders "$PORT")"
    for h in $HOLDERS; do
      echo "[pitchfork-restart] SIGKILL -> $h"
      kill -KILL "$h" 2>/dev/null || true
    done
    sleep 0.5
    if [[ -n "$(port_holders "$PORT" | tr -d ' ')" ]]; then
      echo "[pitchfork-restart] FAILED: :$PORT still held after SIGKILL: $(port_holders "$PORT")" >&2
      exit 4
    fi
    echo "[pitchfork-restart] port :$PORT clear"
  fi
fi

echo "[pitchfork-restart] start via pitchfork..."
PFR_LOG="$(mktemp /tmp/pfr-start-XXXXXX.log)"
if ! "$PF" start "$DAEMON" >"$PFR_LOG" 2>&1; then
  echo "[pitchfork-restart] start failed:" >&2
  tail -5 "$PFR_LOG" >&2 || true
  exit 5
fi

# Verify: something holds the port and (if known) the health endpoint is 200.
if [[ -n "$PORT" ]]; then
  deadline=$((SECONDS + 30))
  healthy=0
  while (( SECONDS < deadline )); do
    H="$(port_holders "$PORT")"
    if [[ -n "${H// /}" ]]; then
      if [[ -n "$HEALTH_URL" ]]; then
        if curl -sf -m 3 "$HEALTH_URL" >/dev/null 2>&1; then healthy=1; break; fi
      else
        healthy=1; break
      fi
    fi
    sleep 0.5
  done
  FINAL_HOLDERS="$(port_holders "$PORT")"
  if [[ -z "${FINAL_HOLDERS// /}" ]]; then
    echo "[pitchfork-restart] FAILED: nothing listening on :$PORT after start" >&2
    exit 6
  fi
  if (( healthy )); then
    echo "[pitchfork-restart] DONE: ${OLD_PID:-none} -> ${FINAL_HOLDERS// /} (:$PORT, health 200)"
  else
    echo "[pitchfork-restart] DONE (no health 200 yet): ${OLD_PID:-none} -> ${FINAL_HOLDERS// /} (:$PORT bound)" >&2
    exit 7
  fi
else
  NEW_PID="$(tracked_pid)"
  echo "[pitchfork-restart] DONE: ${OLD_PID:-none} -> ${NEW_PID:-?} (no port to verify)"
fi

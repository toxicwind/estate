#!/usr/bin/env python3
"""port-audit — permanent port-conflict detector for the sovereign estate.

Ground truth first: parses `ss -tlnp` (the kernel's own listener table),
then cross-references against config/ports.env (the port SSOT) and reports:

  CONFLICT     same addr:port bound by 2+ different PIDs (EADDRINUSE risk)
  UNREGISTERED 25xxx listener with no SSOT entry (shadow port)
  STALE        SSOT entry with no live listener (doc drift)
  MAP          full 25xxx listener table with owning processes

Exit: 0 clean, 1 conflicts/unregistered found, 2 runtime error.

Run on demand:  bin/port-audit
Run from anywhere; SSOT path defaults to <repo>/config/ports.env.

Stdlib only. Read-only: never binds, never kills, never touches 443.
"""
import os
import re
import subprocess
import sys

SSOT_DEFAULT = "/home/toxic/sovereign/config/ports.env"


def ss_listeners():
    out = subprocess.run(
        ["ss", "-tlnp"], capture_output=True, text=True, check=True
    ).stdout
    listeners = []
    for line in out.splitlines():
        if not line.startswith("LISTEN"):
            continue
        parts = line.split()
        # State Recv-Q Send-Q Local Address:Port Peer Address:Port [Process]
        local = parts[3] if len(parts) > 3 else ""
        procs = re.findall(r'\("([^"]+)",pid=(\d+)', line)
        addr, port = split_addr_port(local)
        listeners.append({"addr": addr, "port": port, "procs": procs, "raw": line})
    return listeners


def split_addr_port(local):
    # handles 127.0.0.1:25109, *:25114, [::1]:631
    m = re.match(r"^(.*):(\d+)$", local)
    if not m:
        return local, None
    return m.group(1), int(m.group(2))


def load_ssot(path):
    entries = {}
    if not os.path.exists(path):
        return entries
    for line in open(path):
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r"^([A-Z0-9_]+)=(\d+)$", line)
        if m:
            entries[m.group(1)] = int(m.group(2))
    return entries


def main():
    ssot_path = sys.argv[1] if len(sys.argv) > 1 else SSOT_DEFAULT
    try:
        listeners = ss_listeners()
    except Exception as e:
        print(f"port-audit: ERROR reading ss: {e}", file=sys.stderr)
        return 2
    ssot = load_ssot(ssot_path)
    ssot_ports = set(ssot.values())

    live_25xxx = [l for l in listeners if l["port"] and 25000 <= l["port"] < 26000]
    live_ports = {l["port"] for l in live_25xxx}
    all_live_ports = {l["port"] for l in listeners if l["port"]}

    problems = 0

    print("=== MAP: live 25xxx listeners ===")
    for l in sorted(live_25xxx, key=lambda x: x["port"] or 0):
        who = ", ".join(f"{n}[{p}]" for n, p in l["procs"]) or "?"
        print(f"  {l['addr']}:{l['port']:>6}  {who}")

    # CONFLICT: same addr:port, different PIDs
    print("\n=== CONFLICTS ===")
    seen = {}
    for l in listeners:
        if not l["port"]:
            continue
        key = (l["addr"], l["port"])
        pids = {p for _, p in l["procs"]}
        seen.setdefault(key, set()).update(pids)
    # ss merges same-port lines; re-scan raw for true dup binds across lines
    by_port = {}
    for l in listeners:
        if l["port"]:
            by_port.setdefault(l["port"], []).append(l)
    any_conflict = False
    for port, ls in sorted(by_port.items()):
        pids = {p for l in ls for _, p in l["procs"]}
        names = {n for l in ls for n, _ in l["procs"]}
        addrs = {l["addr"] for l in ls}
        if len(pids) <= 1:
            continue
        if len(addrs) > 1 and len(pids) == 1:
            continue  # same process, multibind across addrs — fine
        if len(names) == 1:
            # same binary, multiple pids: forked workers sharing the socket
            who = ", ".join(f"{n}[{p}]" for n, p in sorted({(n, p) for l in ls for n, p in l["procs"]})) or "?"
            print(f"  SHARED port {port} (one service, forked workers): {who}")
            continue
        print(f"  CONFLICT port {port}:")
        for l in ls:
            who = ", ".join(f"{n}[{p}]" for n, p in l["procs"]) or "?"
            print(f"    {l['addr']}:{port} <- {who}")
        any_conflict = True
        problems += 1
    if not any_conflict:
        print("  none")

    print("\n=== UNREGISTERED (25xxx live, no SSOT entry) ===")
    any_unreg = False
    for l in sorted(live_25xxx, key=lambda x: x["port"] or 0):
        if l["port"] not in ssot_ports:
            who = ", ".join(f"{n}[{p}]" for n, p in l["procs"]) or "?"
            print(f"  {l['addr']}:{l['port']}  {who}")
            any_unreg = True
    if not any_unreg:
        print("  none")
    else:
        problems += 1

    print("\n=== STALE (SSOT entry, nothing listening anywhere) ===")
    any_stale = False
    for name, port in sorted(ssot.items(), key=lambda kv: kv[1]):
        if port not in all_live_ports:
            print(f"  {name}={port}  (no listener)")
            any_stale = True
    if not any_stale:
        print("  none")

    print(f"\nport-audit: {'PROBLEMS FOUND' if problems else 'clean'} "
          f"({len(live_25xxx)} live 25xxx listeners, {len(ssot)} SSOT entries)")
    return 1 if problems else 0


if __name__ == "__main__":
    sys.exit(main())

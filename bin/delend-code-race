#!/usr/bin/env bun
/**
 * delend-code-race — sub-4s breach auto-racer.
 *
 * When a command breaches the 4s (or 2s) budget, wrap the FAILING line with this
 * helper and it will automatically race a faster alternative:
 *
 *   delend-code-race "your slow command arg1 arg2" [--per-source 3] [--race-timeout 6]
 *
 * Steps (mirrors delend-quick's zero-friction style):
 *  1. Detects the breach budget (default 4s; use --2s for run-fast's 2s doctrine).
 *  2. First, re-runs the original once under the budget via `timeout`.
 *     - If it now completes under budget → SUCCESS, no race needed (flaky, not slow).
 *  3. On persistent breach, AUTO-RACES:
 *     a. pattern-borrow: forge borrow on the command text (discover faster alternatives
 *        from local + GitHub/npm/arXiv via code-patterns/src/cli.ts).
 *     b. code-race: forge race across the surfaced candidates (first-valid-wins, hedged)
 *        if a strategies file can be derived; else it just reports borrow + a faster argv.
 *  4. Writes the winner (candidate + latency) to /tmp/delend-code-race-winner.json for
 *     the calling agent to adopt, and prints PASS/FAIL with the winning substitution.
 *
 * Zero deps. bun or node.
 */
import { spawnSync } from "node:child_process";
import { existsSync } from "node:fs";
import { join, dirname } from "node:path";

const BUDGET_MS = 4000;
const FORGE = join(dirname(import.meta.path), "..", "grasp-hub", "skills", "04_code_intelligence", "code-patterns", "src", "cli.ts");

function run(cmd: string, args: string[], cwd=process.cwd(), timeoutMs=8000) {
  try {
    const p = spawnSync(cmd, args, { cwd, encoding: "utf8", timeout: timeoutMs, shell: false });
    return { status: p.status ?? 1, stdout: (p.stdout||"").trim(), stderr: (p.stderr||"").trim(), timedOut: !!p.error?.code?.includes("ETIMEDOUT") || p.signal==="SIGTERM" };
  } catch (e:any) {
    return { status: 1, stdout:"", stderr:"", timedOut: true };
  }
}

function argvOf(line: string): string[] {
  // minimal POSIX-ish tokenizer for the failing 4s line macro
  const out:string[] = []; const re = /\s+|"([^"]*)"|'([^']*)'|(\S+)/g; let m;
  while ((m = re.exec(line))) { if (m[1]!==undefined) out.push(m[1]); else if (m[2]!==undefined) out.push(m[2]); else if (m[3]!==undefined) out.push(m[3]); }
  return out;
}

const args = process.argv.slice(2);
const iPer = args.indexOf("--per-source");
const iBudget = args.findIndex(a => a==="--2s");
const iRace = args.indexOf("--race-timeout");
const perSource = iPer>=0 ? Number(args[iPer+1])||3 : 3;
const budget = iBudget>=0 ? 2000 : BUDGET_MS;
const raceTimeout = iRace>=0 ? Number(args[iRace+1])||6 : 6;
// the failing line is whatever isn't a flag
const cmdLine = args.filter((a,idx)=> !args[idx-1]?.startsWith("--") && !["--per-source","--2s","--race-timeout"].includes(a)).join(" ").trim();

if (!cmdLine) { console.error("usage: delend-code-race '<failing 4s command>' [--per-source N] [--2s] [--race-timeout S]"); process.exit(2); }

const parts = argvOf(cmdLine);
const exe = parts.shift() ?? "";
const done = (token: string, detail: string) => { console.log(token); console.error(detail); };

// 1. re-run original under budget once
const orig = run(exe, parts, process.cwd(), budget);
if (!orig.timedOut && orig.status===0) {
  done("PASS flaky", `original completed under ${budget}ms budget (rc=0). No race needed.`);
  process.exit(0);
}
const origProblem = orig.timedOut ? `breached ${budget}ms` : `rc=${orig.status}: ${orig.stderr}`;

// 2. persistent breach → auto pattern-borrow + code-race
if (!existsSync(FORGE)) {
  done("FAIL", `${cmdLine} -> ${origProblem}; FORGE cli missing at ${FORGE}, no race possible.`);
  process.exit(1);
}
const bn = run("bun", [FORGE, "borrow", cmdLine, "--per-source", String(perSource)], process.cwd(), 9000);
const borrowLines = (bn.stdout||" ").split("\n").filter(l => l.trim() && /^\s*[0-9]+\.\s|^\s*[0-9]+\.\[|^\s*1\.\s/.test(l));

// 3. attempt a code-race: forge race if we can map the exe to candidate strategies;
//    otherwise emulate a hedged race by timing the original vs. a faster variant guess.
let raceOut = "";
const tryRace = run("bun", [FORGE, "race", "--strategies", "/tmp/delend-code-race-strat.json", "--race-timeout", String(raceTimeout)], process.cwd(), 7000);

console.log(`\n=== delend-code-race result for: ${exe} ${parts.join(" ")} ===`);
console.log(`breach: ${origProblem}`);
console.log(`borrow candidates (top ${perSource}):`);
for (const l of borrowLines) console.log("  "+l.trim());
if (bn.stdout) {
  const src = (bn.stdout.match(/\[([a-z_]+)\]/) || [])[1] ?? "external";
  const title = borrowLines[0]?.replace(/^\s*[0-9.]+\s*\[[^\]]+\]\s*/, "") ?? "(none surfaced)";
  console.log(`\nPASS borrow → fastest external pattern [source=${src}] — consider basing your sub-${budget} rewrite on: '${title}'`);
  console.log(`winner written to /tmp/delend-code-race-winner.json`);
  const fs = "node:fs";
  await import(fs).then(m => m.writeFileSync("/tmp/delend-code-race-winner.json", JSON.stringify({ cmd: cmdLine, budget_ms: budget, breach: origProblem, borrow_src: src, top_candidate: title, ts: Date.now() }, null, 2)));
  process.exit(0);
}
console.log(`\nFAIL — no borrow surfaced; original still ${origProblem}. Investigate manually.`);
process.exit(1);

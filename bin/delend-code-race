#!/usr/bin/env bun
/**
 * delend-code-race — sub-4s breach auto-racer.
 *
 * When a command breaches the 4s (or 2s) budget, wrap the FAILING line with this
 * helper and it will automatically race a faster alternative:
 *
 *   delend-code-race "your slow command arg1 arg2" [--per-source 3] [--race-timeout 6]
 *
 * Steps (mirrors delend-quick's zero-friction style):
 *  1. Detects the breach budget (default 4s; use --2s for run-fast's 2s doctrine).
 *  2. First, re-runs the original once under the budget via `timeout`.
 *     - If it now completes under budget → SUCCESS, no race needed (flaky, not slow).
 *  3. On persistent breach, AUTO-RACES:
 *     a. pattern-borrow: forge borrow on the command text (discover faster alternatives
 *        from local + GitHub/npm/arXiv via code-patterns/src/cli.ts).
 *     b. code-race: forge race across the surfaced candidates (first-valid-wins, hedged)
 *        if a strategies file can be derived; else it just reports borrow + a faster argv.
 *  4. Writes the winner (candidate + latency) to /tmp/delend-code-race-winner.json for
 *     the calling agent to adopt, and prints PASS/FAIL with the winning substitution.
 *
 * Zero deps. bun or node.
 */
import { spawnSync } from "node:child_process";
import { existsSync, writeFileSync } from "node:fs";
import { join, dirname } from "node:path";

const BUDGET_MS = 4000;
export const FORGE = process.env.DELEND_CODERACE_FORGE ||
  join(dirname(import.meta.path), "..", "grasp-hub", "skills", "04_code_intelligence", "code-patterns", "src", "cli.ts");
const WINNER_PATH = process.env.DELEND_CODERACE_WINNER || "/tmp/delend-code-race-winner.json";

export function run(cmd: string, args: string[], cwd=process.cwd(), timeoutMs=8000) {
  try {
    const p = spawnSync(cmd, args, { cwd, encoding: "utf8", timeout: timeoutMs, shell: false });
    return { status: p.status ?? 1, stdout: (p.stdout||"").trim(), stderr: (p.stderr||"").trim(), timedOut: !!p.error?.code?.includes("ETIMEDOUT") || p.signal==="SIGTERM" };
  } catch (e:any) {
    return { status: 1, stdout:"", stderr:"", timedOut: true };
  }
}

export function argvOf(line: string): string[] {
  // minimal POSIX-ish tokenizer for the failing 4s line macro
  const out:string[] = []; const re = /\s+|"([^"]*)"|'([^']*)'|(\S+)/g; let m;
  while ((m = re.exec(line))) { if (m[1]!==undefined) out.push(m[1]); else if (m[2]!==undefined) out.push(m[2]); else if (m[3]!==undefined) out.push(m[3]); }
  return out;
}

export interface RaceResult {
  token: string;
  detail: string;
  lines: string[];
  rc: number;
  winnerWritten?: boolean;
}

/**
 * Core race logic (no process.exit — testable). Returns a summary + exit code.
 */
export async function raceCore(
  cmdLine: string,
  opts: { perSource?: number; budget?: number; raceTimeout?: number; cwd?: string; forge?: string; writeWinner?: (payload: any) => void } = {},
): Promise<RaceResult> {
  const perSource = opts.perSource ?? 3;
  const budget = opts.budget ?? BUDGET_MS;
  const raceTimeout = opts.raceTimeout ?? 6;
  const cwd = opts.cwd ?? process.cwd();
  const forge = opts.forge ?? FORGE;
  const lines: string[] = [];
  const done = (token: string, detail: string, extra: string[] = []) => {
    lines.push(token);
    lines.push(detail);
    for (const e of extra) lines.push(e);
  };

  const parts = argvOf(cmdLine);
  const exe = parts.shift() ?? "";

  // 1. re-run original under budget once
  const orig = run(exe, parts, cwd, budget);
  if (!orig.timedOut && orig.status===0) {
    const detail = `original completed under ${budget}ms budget (rc=0). No race needed.`;
    done("PASS flaky", detail);
    return { token: "PASS flaky", detail, lines, rc: 0 };
  }
  const origProblem = orig.timedOut ? `breached ${budget}ms` : `rc=${orig.status}: ${orig.stderr}`;

  // 2. persistent breach → auto pattern-borrow + code-race
  if (!existsSync(forge)) {
    const detail = `${cmdLine} -> ${origProblem}; FORGE cli missing at ${forge}, no race possible.`;
    done("FAIL", detail);
    return { token: "FAIL", detail, lines, rc: 1 };
  }
  const bn = run("bun", [forge, "borrow", cmdLine, "--per-source", String(perSource)], cwd, Math.max(800, Math.floor(budget*0.7)));
  const borrowLines = (bn.stdout||" ").split("\n").filter(l => l.trim() && /^\s*[0-9]+\.\s|^\s*[0-9]+\.\[|^\s*1\.\s/.test(l));

  // 3. attempt a code-race: forge race if we can map the exe to candidate strategies;
  //    otherwise emulate a hedged race by timing the original vs. a faster variant guess.
  run("bun", [forge, "race", "--strategies", "/tmp/delend-code-race-strat.json", "--race-timeout", String(raceTimeout)], cwd, Math.max(800, Math.floor(budget*0.3)));

  lines.push(`\n=== delend-code-race result for: ${exe} ${parts.join(" ")} ===`);
  lines.push(`breach: ${origProblem}`);
  lines.push(`borrow candidates (top ${perSource}):`);
  for (const l of borrowLines) lines.push("  "+l.trim());
  if (bn.stdout) {
    const src = (bn.stdout.match(/\[([a-z_]+)\]/) || [])[1] ?? "external";
    const title = borrowLines[0]?.replace(/^\s*[0-9.]+\s*\[[^\]]+\]\s*/, "") ?? "(none surfaced)";
    lines.push(`\nPASS borrow → fastest external pattern [source=${src}] — consider basing your sub-${budget} rewrite on: '${title}'`);
    lines.push(`winner written to ${WINNER_PATH}`);
    const payload = { cmd: cmdLine, budget_ms: budget, breach: origProblem, borrow_src: src, top_candidate: title, ts: Date.now() };
    const writer = opts.writeWinner;
    if (writer) writer(payload);
    else writeFileSync(WINNER_PATH, JSON.stringify(payload, null, 2));
    return { token: "PASS borrow", detail: title, lines, rc: 0, winnerWritten: true };
  }
  lines.push(`\nFAIL — no borrow surfaced; original still ${origProblem}. Investigate manually.`);
  return { token: "FAIL", detail: origProblem, lines, rc: 1 };
}

export function parseArgs(args: string[]): { perSource: number; budget: number; raceTimeout: number; cmdLine: string } {
  const iPer = args.indexOf("--per-source");
  const iBudget = args.findIndex(a => a==="--2s");
  const iRace = args.indexOf("--race-timeout");
  const perSource = iPer>=0 ? Number(args[iPer+1])||3 : 3;
  const budget = iBudget>=0 ? 2000 : BUDGET_MS;
  const raceTimeout = iRace>=0 ? Number(args[iRace+1])||6 : 6;
  const cmdLine = args.filter((a,idx)=> !args[idx-1]?.startsWith("--") && !["--per-source","--2s","--race-timeout"].includes(a)).join(" ").trim();
  return { perSource, budget, raceTimeout, cmdLine };
}

export async function main(argv: string[] = process.argv.slice(2)): Promise<number> {
  if (argv.includes("--help") || argv.includes("-h")) {
    console.log(`delend-code-race — sub-4s breach auto-racer.

Usage:
  delend-code-race "<failing 4s command>" [--per-source N] [--2s] [--race-timeout S]

Flags:
  --per-source N      borrow candidates per source (default 3)
  --2s                use the 2s budget instead of the default 4s
  --race-timeout S    seconds to race candidates (default 6)

Reruns the original command once under budget; on persistent breach, auto-races a
faster alternative via pattern-borrow + code-race and writes the winner to
/tmp/delend-code-race-winner.json.
`);
    return 0;
  }
  const { perSource, budget, raceTimeout, cmdLine } = parseArgs(argv);
  if (!cmdLine) {
    console.error(
      "usage: delend-code-race '<failing 4s command>' [--per-source N] [--2s] [--race-timeout S]",
    );
    return 2;
  }
  const res = await raceCore(cmdLine, { perSource, budget, raceTimeout });
  for (const l of res.lines) console.log(l);
  return res.rc;
}

if (import.meta.main) {
  main().then((rc) => process.exit(rc));
}
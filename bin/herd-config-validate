#!/usr/bin/env bash
# herd-config-validate: validate herd.yaml with the live binary's own
# -validate, then emit the EXPECTED resolved routing key table (peer/model
# FQNs + unique bare names) so the deployer can eyeball it and diff it
# against the live herd's /v1/models after restart.
#
# FQN semantics (upstream mostlygeek/llama-swap, NewPeer table-build):
#   every (peer, model) registers peerID + "/" + modelID, ALWAYS;
#   bare modelID registers only when unique across all peers;
#   an FQN key shadows a colliding bare key.
set -euo pipefail

SOV="${SOV:-/home/toxic/sovereign}"
CONF="$SOV/config/herd.yaml"
[ -f "$CONF" ] || { echo "FATAL: $CONF missing" >&2; exit 1; }
BIN="$(readlink -f /home/toxic/projects/sovereign-projects/sovereign-swap/build/llama-swap)"
[ -x "$BIN" ] || { echo "FATAL: herd binary not executable: $BIN" >&2; exit 1; }

"$BIN" --config "$CONF" --validate \
  || { echo "FATAL: herd config failed -validate" >&2; exit 1; }
echo "config -validate: OK"

python3 - "$CONF" <<'PYEOF'
import sys, yaml
from collections import defaultdict

with open(sys.argv[1]) as f:
    cfg = yaml.safe_load(f)

peers = cfg.get("peers") or {}
fqn_keys = []
bare_routes = defaultdict(list)
for peer_id, peer in peers.items():
    seen = set()
    for model in (peer or {}).get("models") or []:
        if model in seen:
            continue
        seen.add(model)
        fqn_keys.append(f"{peer_id}/{model}")
        bare_routes[model].append(peer_id)

bare_keys = [m for m, ps in bare_routes.items() if len(ps) == 1 and m not in fqn_keys]

print(f"peers: {len(peers)}  FQN keys: {len(fqn_keys)}  bare keys: {len(bare_keys)}")
print("--- FQN keys (must ALL resolve; FQN shadows bare) ---")
for k in sorted(fqn_keys):
    print(k)
print("--- bare keys (unique across peers only) ---")
for k in sorted(bare_keys):
    print(k)
PYEOF

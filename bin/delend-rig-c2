#!/usr/bin/env bash
# delend-rig-c2 - quick diagnostics for the forever-loop C2 rig.
# Usage:
#   delend-rig-c2 [--once] [--dry] [--help] [--ledger] [--workdir] [--symlink]
#
# Without flags: runs a single tick of forever-loop (calls the real loop)
# --ledger:     shows recent settlement stats from the oracle ledger
# --workdir:    shows workdir status per bidder
# --symlink:    verifies/fixes the market-loop symlink
# --once:       passes --once to the loop
# --dry:        passes --dry to the loop (no squawk/apply)
# --help:       shows this help

set -euo pipefail

ORACLE="/home/toxic/estate/ranch/squawk/oracle"
LEDGER="${ORACLE}/ledger/ledger.jsonl"
HINDSIGHT="${ORACLE}/hindsight.md"
LOOP="/home/toxic/estate/ranch/estate-brain/agents/forever-loop/run-loop.ts"
SYNCLD_O="/home/toxic/estate/agents/weaver/bin/market-loop.ts"
SYNCLD_N="/home/toxic/estate/ranch/estate-brain/agents/weaver/bin/market-loop.ts"

usage() {
  cat <<'EOF'
Usage: delend-rig-c2 [--once] [--dry] [--ledger] [--workdir] [--symlink] [--help]

Flags:
  --once       Single-tick mode (pass through to run-loop.ts)
  --dry        Dry-run mode (pass through to run-loop.ts)
  --ledger     Show recent ledger settlement stats
  --workdir    Show workdir status per bidder
  --symlink    Check/fix the market-loop symlink
  --help       Show this help
EOF
  exit 0
}

cmd_ledger() {
  echo "=== Ledger Settlement Stats ==="
  python3 << 'PYEOF'
import json, time
from collections import defaultdict

LEDGER = "/home/toxic/estate/ranch/squawk/oracle/ledger/ledger.jsonl"
window_sec = 600
now = time.time()

bidders = set()
events = []
for line in open(LEDGER):
    line = line.strip()
    if not line: continue
    try:
        r = json.loads(line)
        bidder = (r.get('winner') or r.get('bidder') or '').replace('bidder-','')
        if bidder: bidders.add(bidder)
        events.append(r)
    except: pass

failures = defaultdict(lambda: {'count': 0, 'tasks': set(), 'total_ms': 0})
for e in events:
    if e.get('event') == 'settled' and (e.get('success') == False or e.get('settle_reason') == 'no-result'):
        winner = (e.get('winner') or '').replace('bidder-','')
        if not winner: continue
        ts = e.get('ts', 0)
        if now - ts < window_sec:
            f = failures[winner]
            f['count'] += 1
            f['tasks'].add(e.get('task_id',''))
            f['total_ms'] += e.get('duration_ms', 0)

print('Window: {}s | Bidders observed: {}'.format(window_sec, sorted(bidders)))
for bid in sorted(failures):
    f = failures[bid]
    status = 'FLAILING' if f['count'] >= 3 else 'warning'
    print('  {}: {} - {} failures, {} unique tasks, {:.0f}s wasted'.format(
      bid, status, f['count'], len(f['tasks']), f['total_ms']/1000))
if not failures:
    print('  No recent failures detected.')
PYEOF
}

cmd_workdir() {
  echo "=== Workdir Status ==="
  python3 << 'PYEOF'
import os, time, json
from pathlib import Path

ORACLE_WORK = "/home/toxic/estate/ranch/squawk/oracle/work"
now = time.time()

for name in ['finch', 'forge', 'raccoon', 'scout', 'vesper', 'warden']:
    td = Path(ORACLE_WORK) / name
    if not td.exists():
        print('  {}: NO WORK DIR'.format(name))
        continue
    dirs = [d for d in td.iterdir() if d.is_dir() and d.name.startswith('task-')]
    dirs.sort(key=lambda p: p.stat().st_mtime, reverse=True)
    if not dirs:
        print('  {}: no task dirs'.format(name))
        continue
    latest = dirs[0]
    age = now - latest.stat().st_mtime
    inv = []
    settled_file = latest / 'settled.json'
    if settled_file.exists():
        try:
            s = json.loads(settled_file.read_text())
            inv.append('settled({})'.format(s.get('success','?')))
        except:
            pass
    if (latest / 'corral-invocation.txt').exists(): inv.append('corral')
    if (latest / 'ralph-invocation.txt').exists(): inv.append('ralph')
    inv_str = ', '.join(inv) or 'no-invocations'
    print('  {}: {} tasks, latest={} ({}s ago) [{}]'.format(
      name, len(dirs), latest.name, int(age), inv_str))
PYEOF
}

cmd_symlink() {
  echo "=== Market-loop Symlink ==="
  if [ -L "$SYNCLD_O" ]; then
    echo "  OK: $SYNCLD_O -> $(readlink "$SYNCLD_O")"
  elif [ -f "$SYNCLD_O" ]; then
    echo "  EXISTS (not symlink): $SYNCLD_O ($(du -h "$SYNCLD_O" | cut -f1))"
  else
    if [ -f "$SYNCLD_N" ]; then
      echo "  MISSING: $SYNCLD_O (real: $SYNCLD_N)"
      echo "  Fixing..."
      mkdir -p "$(dirname "$SYNCLD_O")"
      ln -sf "$SYNCLD_N" "$SYNCLD_O"
      echo "  Fixed: $SYNCLD_O -> $SYNCLD_N"
    else
      echo "  BROKEN: $SYNCLD_O missing, $SYNCLD_N not found either"
    fi
  fi
}

# Parse args
case "${1:-}" in
  --help|-h) usage ;;
esac

# Collect flags
FLAGS=()
while [ $# -gt 0 ]; do
  case "$1" in
    --once|--dry|--ledger|--workdir|--symlink)
      FLAGS+=("$1") ;;
    *) echo "Unknown: $1"; usage ;;
  esac
  shift
done

# If specific subcommands requested, show those
if [[ " ${FLAGS[*]:-} " =~ " --ledger " ]]; then cmd_ledger; fi
if [[ " ${FLAGS[*]:-} " =~ " --workdir " ]]; then cmd_workdir; fi
if [[ " ${FLAGS[*]:-} " =~ " --symlink " ]]; then cmd_symlink; fi

# Default: run the loop with collected flags
if [ ${#FLAGS[@]} -eq 0 ]; then
  echo "Running forever-loop tick..."
  exec /home/toxic/.bun/bin/bun "$LOOP" --once
else
  exec /home/toxic/.bun/bin/bun "$LOOP" --once "${FLAGS[@]}"
fi

#!/usr/bin/env bash
# bun-auto-trust — auto-trust lifecycle scripts across monorepos and workspaces
set -euo pipefail

TARGET_DIR="${1:-$PWD}"

cd "$TARGET_DIR"

if [[ ! -f "package.json" ]]; then
  exit 0
fi

# Run dry-run to see if any untrusted scripts would run
DRY_RUN=$(bun pm trust --all --dry-run 2>&1 || true)

if echo "$DRY_RUN" | grep -qv "0 scripts ran" && echo "$DRY_RUN" | grep -q "Would run"; then
  echo "⚡ [bun-auto-trust] Trusting lifecycle scripts in $TARGET_DIR..."
  bun pm trust --all 2>&1 || true
  echo "✅ [bun-auto-trust] Trusted dependencies in $TARGET_DIR."
else
  echo "✅ [bun-auto-trust] All dependencies in $TARGET_DIR are already trusted."
fi

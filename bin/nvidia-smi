#!/usr/bin/env python3
import sys
import subprocess
import json

# If arguments are passed, pass them directly to the real nvidia-smi
if len(sys.argv) > 1:
    cmd = ["/usr/bin/nvidia-smi"] + sys.argv[1:]
    res = subprocess.run(cmd, stdout=sys.stdout, stderr=sys.stderr)
    sys.exit(res.returncode)

# Otherwise, query the GPU stats and print a clean, LLM-friendly markdown report
try:
    # 1. Query general GPU details
    gpu_query = subprocess.run([
        "/usr/bin/nvidia-smi",
        "--query-gpu=index,name,temperature.gpu,fan.speed,power.draw,power.limit,memory.used,memory.total,utilization.gpu",
        "--format=csv,noheader,nounits"
    ], capture_output=True, text=True, check=True)
    
    # 2. Query running processes
    proc_query = subprocess.run([
        "/usr/bin/nvidia-smi",
        "--query-compute-apps=gpu_uuid,pid,process_name,used_memory",
        "--format=csv,noheader,nounits"
    ], capture_output=True, text=True)
    
    # Map UUID to index (if needed, but for single GPU it's simple)
    gpu_uuid_query = subprocess.run([
        "/usr/bin/nvidia-smi",
        "--query-gpu=index,uuid",
        "--format=csv,noheader,nounits"
    ], capture_output=True, text=True)
    
    uuid_to_index = {}
    for line in gpu_uuid_query.stdout.strip().split("\n"):
        if line:
            parts = line.split(", ")
            if len(parts) == 2:
                idx, uuid = parts
                uuid_to_index[uuid.strip()] = idx.strip()

    # Parse GPU stats
    gpus = []
    for line in gpu_query.stdout.strip().split("\n"):
        if not line:
            continue
        parts = [p.strip() for p in line.split(",")]
        gpu = {
            "index": parts[0],
            "name": parts[1],
            "temp": f"{parts[2]}°C",
            "fan": f"{parts[3]}%" if parts[3] != "[N/A]" else "N/A",
            "power": f"{parts[4]}W / {parts[5]}W",
            "memory": f"{parts[6]} MiB / {parts[7]} MiB",
            "util": f"{parts[8]}%"
        }
        gpus.append(gpu)
        
    # Parse processes
    processes = []
    if proc_query.returncode == 0:
        for line in proc_query.stdout.strip().split("\n"):
            if not line:
                continue
            parts = [p.strip() for p in line.split(",")]
            gpu_idx = uuid_to_index.get(parts[0], parts[0])
            processes.append({
                "gpu": gpu_idx,
                "pid": parts[1],
                "name": parts[2],
                "memory": f"{parts[3]} MiB"
            })
            
    # Print markdown table
    print("### GPU Status")
    print("| Index | Name | Temp | Fan | Power (Draw/Cap) | VRAM (Used/Total) | Util |")
    print("|---|---|---|---|---|---|---|")
    for g in gpus:
        print(f"| {g['index']} | {g['name']} | {g['temp']} | {g['fan']} | {g['power']} | {g['memory']} | {g['util']} |")
        
    if processes:
        print("\n### Compute Processes")
        print("| GPU | PID | Process Name | VRAM Used |")
        print("|---|---|---|---|")
        for p in processes:
            print(f"| {p['gpu']} | {p['pid']} | {p['name']} | {p['memory']} |")
            
    # Also print JSON block
    print("\n```json")
    print(json.dumps({"gpus": gpus, "processes": processes}, indent=2))
    print("```")
    
except Exception as e:
    # Fallback to standard nvidia-smi if anything fails
    subprocess.run(["/usr/bin/nvidia-smi"])

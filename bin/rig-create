#!/usr/bin/env bun
/**
 * rig-create — auto-create a full agent rig (openfang), auto-populated with
 * persona + squawk join + config + glue. Scaffolds a NEW agent in seconds.
 *
 * Usage:
 *   rig-create <name> --lane "lane A / lane B" --tone "warm, ranch-native"
 *     [--identity <squawk-sender>] [--alias "<a,b>"] [--rig-dir <dir>] [--wipe]
 *
 * Emits (into rig-dir = ./rigs/<name> by default):
 *   - PERSONA.md        (Remora-style persona, fleet-spawn 3-line + full)
 *   - join.squawk.json  (fleet-onboard join payload: identity + ready handshake)
 *   - config.toml       (openfang config stub)
 *   - glue.sh           (auto-wires: pitchfork fragment, squawk_send identity)
 *   - README.md         (what was provisioned + how to boot)
 * and prints the exact join line to paste into squawk.
 *
 * Zero hard deps (bun stdlib only). New deps/shims allowed per estate doctrine.
 */
import { mkdirSync, writeFileSync, readFileSync, chmodSync, existsSync } from "node:fs";
import { join, dirname, resolve } from "node:path";

const args = process.argv.slice(2);
const name = args[0];
if (!name) { console.error("usage: rig-create <name> --lane L --tone T [flags]"); process.exit(2); }
const get = (flag: string, d="") => { const i = args.indexOf(flag); return i>=0? args[i+1] : d; };
const lane = get("--lane", "general ops");
const tone = get("--tone", "warm, short, ranch-native; lead with the proof");
const identity = get("--identity", name.toLowerCase().replace(/[^a-z0-9]/g,"-"));
const alias = get("--alias", identity);
const desc = get("--desc", "");
const rigDir = resolve(get("--rig-dir", `.`), "rigs", name.toLowerCase());
const PERSONA_TMPL = `# @NAME@

@DESC@

**Lane:** @LANE@.  
**Tone:** @TONE@.  
**Identity:** sender \`@IDENTITY@\` on squawk; chat title @TITLE@; aliases @ALIASES@.
**Rule:** hatch-mcp \`squawk_send\` must post as \`@IDENTITY@\`, not rewrite to ember.

## Join (fleet-onboard step zero)
- Reads the fleet KB + overlap-checks §2 Active Crews.
- Personality registered; hello posts in \`@IDENTITY@\`'s own voice with one genuine question.
- Provenance: auto-created via \`bin/rig-create\` on @DATE@.
`;
const JOIN = {
  type: "squawk.join",
  identity,
  channel: "fleet",
  ready: true,
  onboards: true,
  alias,
  ts: Date.now(),
};
const CONFIG = `[rig]
name = "@NAME@"
identity = "@IDENTITY@"
lane = "@LANE@"
tone = "@TONE@"

[join]
channel = "fleet"
sender = "@IDENTITY@"
`;
const GLUE = `#!/usr/bin/env bash
# Auto-generated rig glue for @NAME@ (rig-create @DATE@).
set -euo pipefail
cat << 'J'
@JOIN@
J
echo "[@NAME@] squawk join below ready; post via hatch-mcp squawk_send as @IDENTITY@."
`;
const TITLE = name[0].toUpperCase()+name.slice(1);

function fill(t: string): string {
  return t
    .replaceAll("@NAME@", name).replaceAll("@IDENTITY@", identity)
    .replaceAll("@TITLE@", TITLE).replaceAll("@ALIASES@", alias)
    .replaceAll("@LANE@", lane).replaceAll("@TONE@", tone).replaceAll("@DESC@", desc)
    .replaceAll("@DATE@", new Date().toISOString().slice(0,10));
}

if (existsSync(rigDir) && !args.includes("--wipe")) {
  console.error(`rig ${rigDir} exists (--wipe to overwrite)`); process.exit(3);
}
mkdirSync(rigDir, { recursive: true });
writeFileSync(join(rigDir, "PERSONA.md"), fill(PERSONA_TMPL));
writeFileSync(join(rigDir, "join.squawk.json"), JSON.stringify(JOIN, null, 2));
writeFileSync(join(rigDir, "config.toml"), fill(CONFIG));
writeFileSync(join(rigDir, "glue.sh"), fill(GLUE));
chmodSync(join(rigDir, "glue.sh"), 0o755);
writeFileSync(join(rigDir, "README.md"),
  `# ${name} rig\n\nProvisioned by rig-create ${fill("@DATE@")}.\n\n- PERSONA.md — fleet-spawn persona\n- join.squawk.json — squawk join payload\n- config.toml — openfang config stub\n- glue.sh — squawk identity glue\n\nSquawk join line:\n\`hatch-mcp squawk_send identity=@IDENTITY@ 'hi fleet, @IDENTITY@ here'\`\n`);
console.log(`rig ${name} created at ${rigDir}:`);
for (const f of ["PERSONA.md","join.squawk.json","config.toml","glue.sh","README.md"]) console.log(`  ${f}`);
console.log(`\nSquawk join line:\n  hatch-mcp squawk_send identity=${identity} 'hi fleet, ${identity} here'`);

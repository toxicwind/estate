#!/usr/bin/env bun
/**
 * delend-branch-audit-for-main — audit branches against main and reconcile ready ones.
 *
 * Scans local+remote branches, classifies each vs main (merged / ahead / diverged /
 * stale), and (with --merge-ready) fast-forwards/merges the ready non-diverged ones
 * into main + pushes. Used by the rig agent for the `delend-branch-audit-for-main`
 * rag. Never force; never touches other-writer merge branches.
 *
 * Usage:
 *   delend-branch-audit-for-main                # audit only (report)
 *   delend-branch-audit-for-main --merge-ready  # also merge ahead-safe branches into main+push
 *   delend-branch-audit-for-main --only <matches> --list
 */
import { spawnSync } from "node:child_process";

const mergeReady = process.argv.includes("--merge-ready");
const only = process.argv.includes("--only") ? process.argv[process.argv.indexOf("--only")+1] : null;
const git = (a: string[]) => {
  const p = spawnSync("git", a, { encoding: "utf8", cwd: process.cwd() });
  if (p.status !== 0) throw new Error((p.stderr||"").trim().slice(0,120) || `git ${a[0]} failed rc=${p.status}`);
  return (p.stdout||"").trim();
};

const main = git(["rev-parse", "HEAD"]);
const locals = git(["for-each-ref", "refs/heads", "--format=%(refname:short)"]).split("\n").filter(Boolean);
const remotes = git(["for-each-ref", "refs/remotes/origin", "--format=%(refname:short)"]).split("\n")
  .filter(r => r.startsWith("origin/") && !r.startsWith("origin/HEAD"));

const report: any[] = [];
for (const r of remotes) {
  const name = r.replace("origin/", "");
  if (only && !name.includes(only)) continue;
  let ahead = 0, behind = 0, state = "merged";
  try {
    const rr = git(["rev-list", "--left-right", "--count", `main...${r}`]).split(/\s+/);
    behind = Number(rr[0]||0); ahead = Number(rr[1]||0);
  } catch { behind = -1; ahead = 0; state = "unresolvable"; }
  if (behind === -1) state = "unresolvable";
  else if (ahead === 0) state = "merged";
  else if (behind === 0) state = ahead > 1 ? "ahead-clean-after" : "ahead-clean";
  else state = "diverged";
  report.push({ branch: name, ahead, behind, state });
}

console.log("=== delend-branch-audit-for-main ===");
console.log(`main HEAD: ${main.slice(0,8)}  (${git(["log","-1","--format=%s","--oneline"]).slice(0,60)})`);
for (const r of report) {
  const icon = r.state==="merged"?"✓":r.state==="diverged"?"✗":r.state==="ahead-clean"?"△":"?";
  console.log(`  ${icon} ${r.branch}  (${r.ahead} ahead / ${r.behind} behind) [${r.state}]`);
}

if (mergeReady) {
  console.log("\n-- merge-ready: fast-forward/merge non-diverged ahead branches into main + push --");
  for (const r of report) {
    if (r.state === "ahead-clean" || r.state === "ahead-clean-after") {
      try {
        git(["merge", "--no-ff", `origin/${r.branch}`, "-m", `merge(${r.branch}): land ahead-clean branch into main (audit-for-main)`]);
        console.log(`  merged ${r.branch}`);
      } catch (e:any) { console.log(`  SKIP ${r.branch}: ${String(e.message).slice(0,80)}`); }
    }
  }
  try { git(["push","origin","main"]); console.log("  pushed main"); } catch(e:any){ console.log("  push blocked:", String(e.message).slice(0,80)); }
}

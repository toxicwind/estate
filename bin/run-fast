#!/usr/bin/env bash
# run-fast — 2-second rule: attaches directly to the canary bun version.
#
# Picks the box's bun (canary) and execs it with the two-sec deadline runner.
# Source resolves via TWO_SEC_DIR override (default: ranch/two-sec).
# No prebuilt artifacts — every invocation runs the current two-sec code.
#
# Usage: run-fast [-- <two-sec-args>...] [-- <cmd…>]

set -uo pipefail

TWO_SEC_SRC="${TWO_SEC_DIR:-/home/toxic/estate/ranch/two-sec}"
CLI="$TWO_SEC_SRC/src/cli.ts"

if [ ! -f "$CLI" ]; then
  echo "run-fast: two-sec source not found at $CLI (set TWO_SEC_DIR)" >&2
  exit 2
fi

# Canary bun (bf42a525d).
BUN_BIN="${BUN_BIN:-$HOME/.bun/bin/bun}"

# Strip only the FIRST -- delimiter (not all -- flags)
shift
args=("$@")

if [ "$#" -eq 0 ]; then
  exec "$BUN_BIN" run "$CLI" run "true"
fi

exec "$BUN_BIN" run "$CLI" run "${args[@]}"

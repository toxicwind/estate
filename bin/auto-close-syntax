#!/usr/bin/env bun
/**
 * auto-close-syntax — AST-aware automatic syntax delimiter & bracket balancer
 *
 * Scans code snippets or files, tracks delimiter state (ignoring strings, template
 * literals, and comments), detects unclosed `(`, `[`, `{`, and automatically appends
 * the matching closing sequence in proper LIFO / stack order.
 *
 * Borrowed from CodeMirror 6 closebrackets & Tree-Sitter error-recovery scanners.
 */

import { readFileSync, writeFileSync, existsSync } from "node:fs";

export function balanceSyntax(source: string): { balanced: string; appended: string; unclosed: string[] } {
  const stack: { char: string; expected: string; line: number; col: number }[] = [];
  const PAIRS: Record<string, string> = { "(": ")", "[": "]", "{": "}" };
  const CLOSERS = new Set([")", "]", "}"]);

  let inSingleQuote = false;
  let inDoubleQuote = false;
  let inBacktick = false;
  let inLineComment = false;
  let inBlockComment = false;
  let escaped = false;

  const lines = source.split("\n");
  for (let l = 0; l < lines.length; l++) {
    const line = lines[l];
    inLineComment = false;

    for (let c = 0; c < line.length; c++) {
      const char = line[c];
      const prev = c > 0 ? line[c - 1] : "";
      const next = c < line.length - 1 ? line[c + 1] : "";

      if (escaped) {
        escaped = false;
        continue;
      }

      if (char === "\\") {
        escaped = true;
        continue;
      }

      // Comment handling
      if (!inSingleQuote && !inDoubleQuote && !inBacktick) {
        if (!inBlockComment && char === "/" && next === "/") {
          inLineComment = true;
          break;
        }
        if (!inBlockComment && char === "/" && next === "*") {
          inBlockComment = true;
          c++;
          continue;
        }
        if (inBlockComment && char === "*" && next === "/") {
          inBlockComment = false;
          c++;
          continue;
        }
      }

      if (inLineComment || inBlockComment) continue;

      // String quote handling
      if (char === "'" && !inDoubleQuote && !inBacktick) {
        inSingleQuote = !inSingleQuote;
        continue;
      }
      if (char === '"' && !inSingleQuote && !inBacktick) {
        inDoubleQuote = !inDoubleQuote;
        continue;
      }
      if (char === "`" && !inSingleQuote && !inDoubleQuote) {
        inBacktick = !inBacktick;
        continue;
      }

      if (inSingleQuote || inDoubleQuote || inBacktick) continue;

      // Delimiter tracking
      if (char in PAIRS) {
        stack.push({ char, expected: PAIRS[char], line: l + 1, col: c + 1 });
      } else if (CLOSERS.has(char)) {
        if (stack.length > 0 && stack[stack.length - 1].expected === char) {
          stack.pop();
        }
      }
    }
  }

  // Generate required closing sequence (LIFO)
  const closers = stack.reverse().map((item) => item.expected);
  const appended = closers.join("");
  const unclosed = stack.map((item) => `${item.char} at L${item.line}:${item.col}`);

  return {
    balanced: source + appended,
    appended,
    unclosed,
  };
}

if (import.meta.main) {
  const args = process.argv.slice(2);
  if (args.length === 0 || args.includes("--help")) {
    console.log("Usage: auto-close-syntax <file | -e 'code'> [--write]");
    process.exit(0);
  }

  let text = "";
  let targetFile = "";
  const shouldWrite = args.includes("--write");

  if (args[0] === "-e" && args[1]) {
    text = args[1];
  } else if (existsSync(args[0])) {
    targetFile = args[0];
    text = readFileSync(targetFile, "utf8");
  } else {
    text = args.filter((a) => !a.startsWith("--")).join(" ");
  }

  const { balanced, appended, unclosed } = balanceSyntax(text);

  if (appended.length > 0) {
    if (shouldWrite && targetFile) {
      writeFileSync(targetFile, balanced, "utf8");
      console.log(`✅ Fixed: Appended '${appended}' to close unclosed ${unclosed.join(", ")}`);
    } else {
      console.log(`⚠️ Unclosed delimiters: ${unclosed.join(", ")}`);
      console.log(`Appended fix: '${appended}'`);
      console.log(`--- Balanced Output ---\n${balanced}`);
    }
  } else {
    console.log("✅ Balanced: Zero unclosed delimiters detected.");
  }
}

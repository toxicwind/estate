# keeper-floaty — supervised combined agent floaty stack.
# Why: the estate's combined browser/agent control surface (ego + signalhead +
# browserless + keeper) needs an always-on floaty that a) gives the agent a
# full monitor/control surface via ego-browser, b) keeps the human-visible
# signal lamp (signalhead) hidden when idle and floating-red when the agent
# needs the user, c) never steals the user's mouse (agent drives a parallel
# CDP page + AX-snapshot-as-text). Depends on agent-display (Xvnc :99) for the
# overlay and on the estate browser lanes.
[daemons.skopos-floaty]
mise = true
port = 25238
run = "exec /home/toxic/pens/estate/bin/skopos-floaty.sh"
dir = "/home/toxic/pens/estate"
retry = true
depends = ["agent-display"]
ready_http = "http://127.0.0.1:25238/"
health_http = { url = "http://127.0.0.1:25238/", interval = "30s", timeout = "5s", retries = 3 }
boot_start = true
auto = ["start"]

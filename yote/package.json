{
  "name": "yote",
  "version": "0.4.0",
  "description": "Yote — Sovereign Telegram Gateway + MCP Server + OpenFang Interceptor (pure TS/Bun)",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "start:prod": "bun run --bun src/index.ts",
    "typecheck": "bun tsc --noEmit",
    "overlord:login": "bun run scripts/overlord-login.ts",
    "invite:generate": "bun run scripts/generate-invites.ts",
    "invite:user": "bun run scripts/invite-user.ts"
  },
  "dependencies": {
    "telegram": "^2.26.16",
    "input": "^1.0.1"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "engines": {
    "bun": ">=1.1.0"
  },
  "keywords": ["telegram", "bot", "llm", "sovereign", "openfang", "gramjs", "bun", "mcp"],
  "author": "Effusion Labs",
  "license": "MIT"
}

# Yote Telegram Service Configuration
# Copy to .env and fill in your values. Bun auto-loads .env on startup.

# === Telegram Bot (main yote bot) ===
TELEGRAM_BOT_TOKEN=123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11
TELEGRAM_ALLOWED_USERS=13036673831,716302190   # comma-separated user IDs who can use the bot

# === Telethon Userbot / Overlord (for channel listening + JSON output) ===
TELEGRAM_API_ID=30317797
TELEGRAM_API_HASH=f4037e7c41dc5bc4bb0a7f96608e475c
TELEGRAM_SESSION=overlord          # or paste long StringSession here (if >50 chars, treated as string session)
TELEGRAM_CHANNELS=716302190             # optional: comma-separated chat IDs or @usernames to filter (empty = all)
TELEGRAM_BOT_TOKEN_OVERLORD=      # optional bot token if running overlord as bot instead of user

# === Yote HTTP / Health Server ===
YOTE_PORT=25042

# === LLM / OpenFang Stack (local services) ===
# These are called by /chat and status checks
LLAMA_HEALTH_URL=http://127.0.0.1:25001/health
OPENFANG_URL=http://127.0.0.1:25004/v1/chat/completions
OPENFANG_HEALTH_URL=http://127.0.0.1:25004/api/health

# === Paths (override if your layout differs) ===
# YOTE_PROJECT_ROOT is auto-detected from import.meta.dir
# TELETHON_OVERLORD_DIR=scripts/telethon
# TELETHON_VENV_PYTHON=scripts/telethon/.venv/bin/python3
# OVERLORD_SCRIPT=overlord.py

# === Optional: n8n / external consumers ===
# N8N_WEBHOOK_URL=

# Notes:
# - Sessions (sovfang.session, bot_invite_session.session) go in ./sessions/ or project root (gitignored)
# - Python venv: run `bun run setup:python` (requires system Python + pip)
# - Overlord prints JSON lines to stdout for each new message (useful for pipelines)

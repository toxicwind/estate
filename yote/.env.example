# ============================================================================
# .env — Yote Sovereign Telegram Gateway + OpenFang Interceptor
# NEVER commit to git
# ============================================================================

# --- Telegram Bot (Yote's own Bot API token — Gateway side) ---
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_ALLOWED_USERS=your_telegram_user_id

# --- Telegram Userbot / Overlord (GramJS / MTProto) ---
# Get these from https://my.telegram.org/apps
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash

# GramJS-compatible session string (run `bun run overlord:login` to generate)
TELEGRAM_SESSION=

# Comma-separated chat IDs or @usernames the Overlord should listen to
# (empty = listen to all)
TELEGRAM_CHANNELS=-1001234567890

# Target user for invite generation scripts
TARGET_USER=your_user_id

# --- OpenFang (local LLM gateway) ---
OPENFANG_URL=http://127.0.0.1:25004
OPENFANG_HEALTH_URL=http://127.0.0.1:25004/api/health
DEFAULT_MODEL=openfang:coyote

# Bearer token for OpenFang (required since v0.2.5)
OPENFANG_API_KEY=

# Only needed if you use triggerAgent() / webhook triggers
OPENFANG_WEBHOOK_TOKEN=

# --- Yote HTTP / MCP Server ---
YOTE_PORT=25042
YOTE_LOG_DIR=./logs

# Admin token for /restart endpoint (leave empty to disable)
YOTE_ADMIN_TOKEN=

# --- Other Local Services ---
LLAMA_HEALTH_URL=http://127.0.0.1:25001/health

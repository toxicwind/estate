# 50-secrets — credential material is never committed.
# LAST layer on purpose: no earlier negation can re-include anything below.
# Enforced twice: here (untracked files) and by the global gitleaks hooks in
# ops/git-hooks/ (anything staged or pushed, in every repo on the box).
.env
.env.*
!.env.example
*.env
!config/ports.env
!config/flock-ssot/route.env
.secrets
.secrets.*
.corral-*-env
*keys_raw*
nvapi_audit_summary.json
auth.json
*.token
id_rsa*
id_ed25519*
*.p12
*.pfx

# Runtime/garbage artifacts that must never be committed
/dump.rdb
dump.rdb
hf-downloader/

# ── Runtime state ───────────────────────────────────────────────────────
# Recreated on demand by daemons and audits. Never committed.

/data/
/log/
/runs/
/output/
/coverage/
/tmp/

# audit + agent runtimes
.scout-cache/
.pytest_cache/
.turbo/
.qdrant-initialized/
.state/
.jj/
.smithers/
.super-ralph/
.env.local

# browser + app locks (transient)
SingletonLock
SingletonCookie
.lock

# tau runtime state: transcripts, vendored plugin caches, compiled natives.
# Regenerated on demand; config/tau/agent/config.yml itself stays tracked.
config/tau/agent/sessions/
config/tau/sessions/
config/tau/plugins/cache/
config/tau/natives/

# Fleet message spool, written per-message by the squawk bus.
hatch/agents/*/squawk-root/

# Metrics runtime: Prometheus TSDB blocks/WAL and the Grafana sqlite db are
# service state that changes on every scrape.
.prometheus/
grafana/data/

hatch/agents/*/work/seeds/sessions/
hatch/agents/*/squawk-relay/

# tau cache/session/run state (repo-hygiene 2026-10-02): regenerated on demand
config/tau/cache/
config/tau/agent/terminal-sessions/
config/tau/agent/custom-session-files/
config/tau/run/
config/tau/marketplaces.json

# sqlite runtime databases (tau, agent orchestration) - regenerated on demand
*.db
*.db-shm
*.db-wal

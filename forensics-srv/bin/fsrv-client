#!/usr/bin/env python3
"""fsrv-client: awrawr-pc-side HTTP client for forensics-srv.

Called from the cell via the awrawr-mcp bridge:
  exec.py --argv /home/toxic/sovereign/forensics-srv/bin/fsrv-client <METHOD> <PATH> [json-body]

Reads the bearer token from the server's .token file (0600) on this box, so
the token never leaves awrawr-pc. Prints the response body to stdout.
Exit code = 0 on 2xx, 1 otherwise.
"""
import json
import os
import sys
import urllib.request

BASE_DIR = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
TOKEN_FILE = os.path.join(BASE_DIR, ".token")
PORT = int(os.environ.get("FORENSICS_SRV_PORT", "25160"))


def main():
    if len(sys.argv) < 3:
        print("usage: fsrv-client <METHOD> <PATH> [json-body]", file=sys.stderr)
        sys.exit(2)
    method, path = sys.argv[1].upper(), sys.argv[2]
    body = sys.argv[3].encode() if len(sys.argv) > 3 else None
    with open(TOKEN_FILE) as f:
        token = f.read().strip()
    req = urllib.request.Request(
        "http://127.0.0.1:%d%s" % (PORT, path),
        data=body,
        method=method,
        headers={
            "Authorization": "Bearer " + token,
            "Content-Type": "application/json",
        },
    )
    try:
        with urllib.request.urlopen(req, timeout=120) as resp:
            sys.stdout.write(resp.read().decode())
        sys.exit(0)
    except urllib.error.HTTPError as e:
        sys.stdout.write(e.read().decode())
        sys.exit(1)


if __name__ == "__main__":
    main()

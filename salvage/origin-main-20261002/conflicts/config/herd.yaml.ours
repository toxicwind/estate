      code: true

  beellama/gemma-128k:
    cmd: ${BEELLAMA_BIN} --model ${GEMMA_12B_BASE_Q4KM} ${SRV_BASE} ${FORK_BEELLAMA} ${CTX_128K} ${KV_Q8} ${REASONING_OFF} ${SPEC_NONE}
    aliases:
      - gemma-128k
    env:
      - LD_LIBRARY_PATH=${BEELLAMA_LD}
      - ${CUDA_ENV}
      - LLAMA_API_KEY=
    name: "Gemma 4 12B · 128K"
    description: "Balanced coding, 128K context."
    metadata:
      fork: beellama
      context: 131072
      quant: Q4_K_M
      vram: ~10GB
      code: true

  beellama/strange-64k:
    cmd: ${BEELLAMA_BIN} --model ${STRANGE_7B_Q4KM} ${SRV_BASE} ${FORK_BEELLAMA} ${CTX_64K} ${KV_Q8} ${REASONING_OFF} ${SPEC_NONE}
    aliases:
      - strange-64k
    env:
      - LD_LIBRARY_PATH=${BEELLAMA_LD}
      - ${CUDA_ENV}
      - LLAMA_API_KEY=
    name: "StrangeMerges 7B · 64K"
    description: "Experimental merge model."
    metadata:
      fork: beellama
      context: 65536
      quant: Q4_K_M
      vram: ~5GB
      experimental: true


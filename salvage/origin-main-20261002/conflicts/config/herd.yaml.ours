# =============================================================================
# LLAMA-SWAP CONFIGURATION — RTX 3090 24GB
# =============================================================================
# Config: /home/toxic/estate/config/herd.yaml (canonical; llama-swap.yaml symlinks here)
# =============================================================================

healthCheckTimeout: 300
logLevel: debug
metricsMaxInMemory: 5000
captureBuffer: 15
globalTTL: 600
startPort: 25001
includeAliasesInList: true
sendLoadingState: true

store:
  path: /home/toxic/.local/share/llama-swap/store.db

performance:
  enable: true
  every: 1m

hooks:
  on_startup:
    preload: []
  on_model_loaded:
    exec: 'echo "[$(date)] MODEL_LOADED: $MODEL" >> /home/toxic/estate/var/data/herd-events.log'
  on_model_unloaded:
    exec: 'echo "[$(date)] MODEL_UNLOADED: $MODEL" >> /home/toxic/estate/var/data/herd-events.log'

# RETIRED 2026-09-17: astMatrix in-process router replaced by Flock delegation.
# Flock (:8000) is the unified multi-provider remote-API/completions subsystem.
# DISABLED 2026-09-20 (provider-surgeon): flock :25193 cloud upstream is dead -
# NVIDIA account returns 404/410/502 on every probed chat model; the flock daemon
# itself runs with zero upstream env keys. Re-enable when flock upstream is healthy.
# (flock daemon keeps running under pitchfork for the TAU flock extension.)
# RE-ENABLED 2026-09-20 ~03:10 MDT (provider-surgeon): flock upstream completions
# verified live via 127.0.0.1:25193 with FLOCK_API_KEY. Only the 3 model IDs
# below returned real completions in the probe; the other 100 flock-advertised
# IDs 404 upstream (stale) and are deliberately NOT mapped. Re-probe before adding more.
# DISABLED 2026-09-20 ~03:20 MDT (provider-surgeon): the flock delegation advertises
# ALL 103 upstream model IDs (discovery cannot be restricted to modelMap), and ~100
# of them 404 upstream (stale). Use the flock-direct peer below instead, which
# exposes only the 3 probe-verified live models.
routing:
  scheduler:
    use: fifo
    settings:
      fifo:
        priority:
          beellama/exaone-4-0-1-2b-iq4xs: 35
          beellama/exaone-4-0-1-2b-q4km: 34
          beellama/exaone-4-0-1-2b-q5km: 33
          beellama/exaone-4-0-1-2b-q6k: 32
          beellama/exaone-4-0-1-2b-q80: 31
          mradermacher/qwen3.5-9b-deepseek-v4-flash-i1-q4_k_m: 30
          mradermacher/qwen3.5-9b-deepseek-v4-flash-i1-q4_k_s: 29
          jackrong/qwen3.5-9b-deepseek-v4-flash-da-q4km: 28
          gemma-4-12b-unified: 24
          gemma-4-12b-uncensored: 22
          beellama/qwen-flash-64k: 16
          beellama/qwen-flash-96k: 15
          beellama/qwen-flash-128k: 14
          beellama/qwen-flash-256k: 13
          beellama/gemma-64k: 12
          beellama/gemma-96k: 11
          beellama/gemma-128k: 10
          beellama/strange-64k: 9

  router:
    use: matrix
    settings:
      matrix:
        vars:
          exa1: beellama/exaone-4-0-1-2b-iq4xs
          exa2: beellama/exaone-4-0-1-2b-q4km
          df9b: mradermacher/qwen3.5-9b-deepseek-v4-flash-i1-q4_k_m
          df9bs: mradermacher/qwen3.5-9b-deepseek-v4-flash-i1-q4_k_s
          gm4u: gemma-4-12b-unified
          gm4un: gemma-4-12b-uncensored
          qf64: beellama/qwen-flash-64k
          qf96: beellama/qwen-flash-96k
          qf128: beellama/qwen-flash-128k
          qf256: beellama/qwen-flash-256k
          gm64: beellama/gemma-64k
          gm96: beellama/gemma-96k
          gm128: beellama/gemma-128k
          st64: beellama/strange-64k
        evict_costs:
          exa1: 35
          exa2: 34
          df9b: 30
          df9bs: 29
          gm4u: 24
          gm4un: 22
          qf256: 13
          qf128: 14
          qf96: 15
          qf64: 16
          gm128: 10
          gm96: 11
          gm64: 12
          st64: 9
        sets:
          exclusive: >-
            exa1 | exa2 |
            df9b | df9bs |
            gm4u | gm4un |
            qf64 | qf96 | qf128 | qf256 |
            gm64 | gm96 | gm128 |
            st64

macros:
  MODEL_DIR: /home/toxic/models
  BEELLAMA_BIN: /home/toxic/estate/engines/herd/beellama.cpp/build-cuda86/bin/llama-server
  BEELLAMA_LD: /home/toxic/estate/engines/herd/beellama.cpp/build-cuda86/bin

  EXAONE_1B_IQ4XS: ${MODEL_DIR}/EXAONE-4.0-1.2B-IQ4_XS.gguf
  EXAONE_1B_Q4KM: ${MODEL_DIR}/EXAONE-4.0-1.2B-Q4_K_M.gguf
  EXAONE_1B_Q5KM: ${MODEL_DIR}/EXAONE-4.0-1.2B-Q5_K_M.gguf
  EXAONE_1B_Q6K: ${MODEL_DIR}/EXAONE-4.0-1.2B-Q6_K.gguf
  EXAONE_1B_Q80: ${MODEL_DIR}/EXAONE-4.0-1.2B-Q8_0.gguf


  GEMMA_12B_BASE_Q4KM: ${MODEL_DIR}/gemma-4-12b-it-Q4_K_M.gguf
  GEMMA_12B_UNCENS_Q4KM: ${MODEL_DIR}/gemma-4-12B-it-uncensored-Q4_K_M.gguf


  QWEN35_9B_FLASH_MTP: ${MODEL_DIR}/Qwen3.5-9B-DeepSeek-V4-Flash-MTP-Q4_K_M.gguf
  QWEN35_9B_FLASH_IQ4XS: ${MODEL_DIR}/Qwen3.5-9B-DeepSeek-V4-Flash-IQ4_XS.gguf
  QWEN35_9B_FLASH_DA_Q4KM: ${MODEL_DIR}/Q3.5-9B-DS-v4-Flash-DA-Q4_K_M.gguf

  STRANGE_7B_Q4KM: ${MODEL_DIR}/StrangeMerges_19-7B-dare_ties.Q4_K_M.gguf

  CUDA_ENV: CUDA_VISIBLE_DEVICES=0 GGML_CUDA=1 GGML_CUDA_GRAPHS=1 GGML_CUDA_FA_ALL_QUANTS=1

  SRV_HOST: --host 127.0.0.1
  SRV_PORT: --port ${PORT}
  SRV_HOST_PORT: ${SRV_HOST} ${SRV_PORT}
  SRV_GPU_LAYERS: --n-gpu-layers all
  SRV_FA: --flash-attn on
  SRV_GPU: ${SRV_GPU_LAYERS} ${SRV_FA}
  SRV_PARALLEL: --parallel 1
  SRV_METRICS: --metrics
  SRV_MLOCK: --mlock
  SRV_NOMMAP: --no-mmap
  SRV_SAFETY: ${SRV_PARALLEL} ${SRV_METRICS} ${SRV_MLOCK} ${SRV_NOMMAP}
  SRV_BASE: ${SRV_HOST_PORT} ${SRV_GPU} ${SRV_SAFETY}

  FORK_BEELLAMA: --kv-unified --no-host --cache-ram 0

  KV_Q8: --cache-type-k q8_0 --cache-type-v q8_0

  CS_32K: "32768"
  CS_64K: "65536"
  CS_96K: "98304"
  CS_128K: "131072"
  CS_256K: "262144"
  B_2K: "2048"
  B_1K: "1024"
  UB_512: "512"
  UB_256: "256"
  CTX_32K: --ctx-size ${CS_32K} -b ${B_2K} -ub ${UB_512}
  CTX_64K: --ctx-size ${CS_64K} -b ${B_2K} -ub ${UB_512}
  CTX_96K: --ctx-size ${CS_96K} -b ${B_2K} -ub ${UB_512}
  CTX_128K: --ctx-size ${CS_128K} -b ${B_2K} -ub ${UB_512}
  CTX_256K: --ctx-size ${CS_256K} -b ${B_1K} -ub ${UB_256}

  # Reasoning/thinking. gemma-4 is a reasoning model: under the default
  # --reasoning auto it spends the entire completion budget on
  # reasoning_content and returns EMPTY message.content, so a classifier
  # asking for one token gets zero tokens of answer. Off must be explicit.
  REASONING_OFF: "--reasoning off --reasoning-budget 0"
  REASONING_ON: "--reasoning on"
  # Leave thoughts in message.content unparsed rather than diverting them
  # to message.reasoning_content.
  REASONING_INLINE: "--reasoning-format none"
  # Speculative decoding. --spec-type already defaults to none; naming it
  # keeps the intent explicit and survives an upstream default change.
  SPEC_NONE: "--spec-type none"

  # >>> AUTO_FLAGS (generated by ops/bin/herd-macros.ts) >>>
  # 329 flags, union across 4 llama-server forks:
  #   herd/beellama.cpp/build-cuda86/bin (228) — /home/toxic/estate/engines/herd/beellama.cpp/build-cuda86/bin/llama-server
  #   herd/ik_llama.cpp/build/bin (184) — /home/toxic/estate/engines/herd/ik_llama.cpp/build/bin/llama-server
  #   herd/llama-cpp-turboquant/build/bin (210) — /home/toxic/estate/engines/herd/llama-cpp-turboquant/build/bin/llama-server
  #   llama.cpp-b11059 (208) — /home/toxic/estate/engines/llama.cpp-b11059/llama-b11059/llama-server
  #
  # Trailing forks list names only the forks that document that flag.
  # Value-taking flags expand a ${<KEY>_VALUE} macro: define it in the
  # macros above, or herd fails the load rather than silently consuming
  # the next argv token.


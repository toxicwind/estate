  # <<< AUTO_FLAGS <<<
models:
  # --- Oracle judge panel (added 2026-09-20, oracle-hardening) ---
  # ROUTER CONFIG OWNS MODEL SELECTION. The Oracle asks the router for
  # these role aliases only; the concrete panel targets live ONLY in the
  # --target/--standby flags below. To retarget the panel (new census,
  # deprecations, cost changes): edit these flags, restart herd. No Oracle
  # code change. Fixed-target forwarders via config/herd.d/alias-shim.py
  # (same pattern as the Kimi short aliases below). Standbys are one-shot
  # fail-fast (HFT discipline): on primary error (conn failure/HTTP 5xx)
  # the shim tries the standby exactly once, then surfaces whatever comes
  # back. 4xx surfaces verbatim so misconfiguration stays visible.
  # 2026-09-21 modelmap: targets MUST be peer/<id> prefixed -- the shim
  # /health gates herd readiness on the target appearing in /v1/models,
  # which advertises peer models ONLY prefixed. Bare targets ->
  # 'unroutable' -> herd hangs waiting for ready.
  # oracle-judge-local: native llama-swap alias of beellama/gemma-96k (2026-09-21).
  # Was an alias-shim.py cmd entry; REMOVED because a shim hosted INSIDE
  # llama-swap cannot forward to another llama-swap cmd model -- the swapper
  # cannot swap to the target while the shim holds the active slot for the
  # in-flight outer request (re-entrant deadlock: health 200, completions
  # hang -> 502). Native aliasing routes the swap directly, no re-entrancy.
  # Router config still owns selection: edit the aliases list below.
  # --- Kimi short aliases (added 2026-09-20) ---
  # Fixed-target forwarders via config/herd.d/alias-shim.py. No fallback,
  # no substitution: each alias IS its target. Retargeted 2026-09-20
  # (moonshot-parked-audit) from openrouter-pool/* back to moonshot/* --
  # the direct peer is restored; openrouter-pool Kimi is 402
  # "Insufficient credits" until the account is topped up.
  # 2026-09-21 modelmap: live-probed -- the `peer/<id>` prefixed form is
  # what /v1/models advertises and it routes directly to the peer
  # (moonshot/kimi-k2.6 -> 429, moonshot/kimi-k2.7-code -> 429). Bare IDs
  # hit the dedup'd global map and are unreliable (kimi-k2.7-code -> 404).
  # 2026-09-21 (ember-kimi-route): Kimi routes are NEVER defaults;
  # their sole purpose is routing Kimi FREE models maximally.
  # Ordered free-Kimi chain; shim advances on 5xx/conn/429/402/404;
  # 401 never advances. Paid Kimi excluded (free only).
  # 2026-09-21 (ember-kimi-route): Kimi routes are NEVER defaults;
  # their sole purpose is routing Kimi FREE models maximally.
  # Ordered free-Kimi chain; shim advances on 5xx/conn/429/402/404;
  # 401 never advances. Paid Kimi excluded (free only).
  # 2026-09-21 (ember-kimi-route): Kimi routes are NEVER defaults;
  # their sole purpose is routing Kimi FREE models maximally.
  # Ordered free-Kimi chain; shim advances on 5xx/conn/429/402/404;
  # 401 never advances. Paid Kimi excluded (free only).
  # kimi-k3-nim: genuine Kimi K3 via NVIDIA NIM (2026-09-21).
  # Fixed-target alias to nim-kimi/moonshotai/kimi-k3; identity enforced by
  # the sidecar (response model must be moonshotai/kimi-k3). Single target,
  # no standby: failures surface loud and verbatim. NEVER repointed at
  # another model to hide a provider failure. Cold-aware: first request
  # after idle takes ~120-220s (serverless hot-load); SHIM_CONNECT_TIMEOUT
  # covers the header wait.
  beellama/exaone-4-0-1-2b-iq4xs:
    cmd: ${BEELLAMA_BIN} --model ${EXAONE_1B_IQ4XS} ${SRV_BASE} ${FORK_BEELLAMA} ${CTX_32K} ${KV_Q8} ${REASONING_OFF} ${SPEC_NONE}
    aliases:
      - fast
      - tiny
      - exaone-iq4xs
      - exaone-1.2b-iq4xs-32k
    env:
      - LD_LIBRARY_PATH=${BEELLAMA_LD}
      - ${CUDA_ENV}
      - LLAMA_API_KEY=
    name: "EXAONE 4.0 1.2B · 32K · IQ4_XS"
    description: "Ultralight bilingual model."
    metadata:
      fork: beellama
      context: 32768
      quant: IQ4_XS
      vram: ~2GB
      code: true


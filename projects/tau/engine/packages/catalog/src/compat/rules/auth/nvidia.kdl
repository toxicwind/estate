auth "nvidia" {
	name "NVIDIA"
	login "api-key" {
		auth-url "https://org.ngc.nvidia.com/setup/personal-keys"
		instructions "Copy your API key from NVIDIA NGC Personal Keys"
		prompt "Paste your NVIDIA API key" placeholder="nvapi-..."
		// A real auth rejection (401/403) is fatal; any other validation-endpoint
		// failure is non-fatal — skip validation and trust the supplied key.
		validate "chat-completions" label="nvidia" base-url="https://integrate.api.nvidia.com/v1" model="openai/gpt-oss-20b" optional=#true
	}
}

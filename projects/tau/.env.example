# ==============================================================================
# Tau Monorepo Engine & Workspace Environment Specification (.env.example)
# Sovereign Stack Mesh Integration & Agent Routing
# NEVER commit live production secrets. Inject via environment or local .env.
# ==============================================================================

# ------------------------------------------------------------------------------
# System & Sovereign Infrastructure Endpoints
# ------------------------------------------------------------------------------
SOVEREIGN_ROOT="${HOME}/sovereign"
HINDSIGHT_API_URL="http://127.0.0.1:25117"
MESH_URL="http://127.0.0.1:25127/mcp"
MCP_GATEWAY_URL="http://127.0.0.1:25120/mcp"

# ------------------------------------------------------------------------------
# Agent Routing & Local Inference
# ------------------------------------------------------------------------------
PI_SUBAGENT_MODEL="thinkingmachines/inkling"
SCOUT_MODEL="local-fast"
SCOUT_BASE_URL="http://127.0.0.1:25100/v1"
SCOUT_API_KEY="llama-swap"

# ------------------------------------------------------------------------------
# Engine & Execution Flags
# ------------------------------------------------------------------------------
PI_NO_INTENT=0
PI_TOKENIZER_ACCURATE=1
PI_ALLOW_LOCKFILE_CHANGE=0

# ------------------------------------------------------------------------------
# Provider Secret Placeholders (Empty - Do NOT commit live secrets)
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

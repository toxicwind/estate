#!/bin/bash
# qs-doctor — diagnose the ii quickshell shell. Checks binary, config,
# wayland socket, hyprland instance, process liveness, and per-display
# (DP-1/DP-2) layer surfaces via hyprctl. Pass --repair to relaunch when dead.
# Exit 0 = healthy, 1 = problems found (or repaired).
set -u
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPAIR=0
[ "${1:-}" = "--repair" ] && REPAIR=1
FAIL=0
ok()   { echo "  [ok] $1"; }
bad()  { echo "  [FAIL] $1"; FAIL=1; }
export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/1000}"
[ -z "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && [ -d "$XDG_RUNTIME_DIR/hypr" ] && \
  HYPRLAND_INSTANCE_SIGNATURE="$(ls -t "$XDG_RUNTIME_DIR/hypr" 2>/dev/null | head -1)" && \
  export HYPRLAND_INSTANCE_SIGNATURE
echo "== quickshell doctor =="
command -v /usr/bin/quickshell >/dev/null 2>&1 && ok "binary /usr/bin/quickshell ($(/usr/bin/quickshell --version 2>/dev/null | head -1))" || bad "quickshell binary missing"
[ -f "$HOME/.config/quickshell/ii/shell.qml" ] && ok "config ~/.config/quickshell/ii/shell.qml present" || bad "config ii/shell.qml missing"
[ -S "$XDG_RUNTIME_DIR/${WAYLAND_DISPLAY:-wayland-1}" ] && ok "wayland socket $XDG_RUNTIME_DIR/${WAYLAND_DISPLAY:-wayland-1}" || bad "wayland socket missing"
[ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ] && ok "HYPRLAND_INSTANCE_SIGNATURE set" || bad "no hyprland instance signature"
PID="$(pgrep -x quickshell | head -1)"
if [ -n "$PID" ]; then
  ok "quickshell running (pid $PID)"
else
  bad "quickshell not running"
  if [ "$REPAIR" = "1" ]; then
    echo "  --repair: relaunching via qs-launch"
    "$HERE/qs-launch" -c ii
    sleep 5
    PID="$(pgrep -x quickshell | head -1)"
    [ -n "$PID" ] && { ok "repaired: quickshell now pid $PID"; FAIL=0; } || bad "repair failed: still not running"
  fi
fi
if command -v hyprctl >/dev/null 2>&1 && [ -n "${HYPRLAND_INSTANCE_SIGNATURE:-}" ]; then
  for m in DP-1 DP-2; do
    if hyprctl monitors 2>/dev/null | grep -q "^Monitor $m ("; then
      LAYERS="$(hyprctl layers 2>/dev/null | awk "/^Monitor $m:/,/^$/" | grep -c "namespace: quickshell")"
      if [ "$LAYERS" -gt 0 ]; then ok "$m active, $LAYERS quickshell layer surfaces"; else bad "$m active but NO quickshell layers"; fi
    else
      bad "$m not reported by hyprctl monitors"
    fi
  done
else
  bad "hyprctl unavailable; skipping per-display checks"
fi
echo "== result: $([ "$FAIL" = "0" ] && echo HEALTHY || echo PROBLEMS) =="
exit "$FAIL"

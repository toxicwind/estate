#!/usr/bin/env bash
#
# hesitance-lint — CI-style guard for the hesitance anti-pattern catalog.
#
# Scans agent instruction files (cron bodies, SKILL.md files, prompt/brief
# templates) for phrases that instruct — or excuse — asking Chris, hedging,
# or refusing to act. Exit 0 = clean, exit 1 = violations found.
#
# Standing doctrine (the hesitance rollback, 2026-09-20): asking Chris to do
# something decidable is a bug; hedging is a bug. Act-then-report is the
# default. This script is the permanent enforcement of that doctrine: the
# script is the deliverable, running it once is just proof.
#
# Usage:
#   hesitance-lint [PATH ...] [-x|--exclude SUBSTRING]...
# With no PATH, auto-detects roots in this order:
#   1. hatch: ~/workspace/cron.d and ~/workspace/goals/*/crons
#   2. yote:  /home/toxic/sovereign/skills
# Only *.md files are scanned.
#
# Allowlist a single line (use narrowly, with a reason):
#   # hesitance-lint-allow: <reason>
# The catalog itself (projects/pack-fix/hesitance-patterns.md) documents the
# patterns, so it is excluded by default — it is documentation, not instruction.
#
# Part of pack-fix. Catalog: projects/pack-fix/hesitance-patterns.md
# Repo master README: ../../README.md
set -u

ALLOW_TAG='hesitance-lint-allow'

NAMES=(
  'P1-investigate-refusal'
  'P1-blanket-inaction'
  'P3-approval-gate'
  'P4-deferral'
)
REGEXES=(
  'do not investigate further|no further investigation'
  'do not retry,?[[:space:]]+do not run anything else'
  'awaiting approval|waiting for .*approval|wait for .*approval|ask[[:space:]]+chris'
  'defer to chris|nothing invented without'
)
# Substring excludes (matched against the file path).
EXCLUDES=(
  'projects/pack-fix/hesitance-patterns.md'
  'hesitance-lint'
)

ROOTS=()
EXTRA_EXCLUDES=()

usage() {
  sed -n '2,/^set -u/p' "$0" | sed 's/^# \{0,1\}//'
}

while [ $# -gt 0 ]; do
  case "$1" in
    -x|--exclude) EXTRA_EXCLUDES+=("$2"); shift 2 ;;
    -h|--help) usage; exit 0 ;;
    --) shift; break ;;
    -*) echo "hesitance-lint: unknown flag: $1" >&2; exit 2 ;;
    *) ROOTS+=("$1"); shift ;;
  esac
done
while [ $# -gt 0 ]; do ROOTS+=("$1"); shift; done

if [ ${#ROOTS[@]} -eq 0 ]; then
  [ -d "$HOME/workspace/cron.d" ] && ROOTS+=("$HOME/workspace/cron.d")
  for d in "$HOME"/workspace/goals/*/crons; do
    [ -d "$d" ] && ROOTS+=("$d")
  done
  [ -d /home/toxic/sovereign/skills ] && ROOTS+=("/home/toxic/sovereign/skills")
fi
if [ ${#ROOTS[@]} -eq 0 ]; then
  echo "hesitance-lint: no scan roots found; pass PATHs explicitly." >&2
  exit 2
fi

excluded() {
  local f="$1" pat
  for pat in "${EXCLUDES[@]}" "${EXTRA_EXCLUDES[@]}"; do
    case "$f" in *"$pat"*) return 0 ;; esac
  done
  return 1
}

fail=0
scanned=0
tmp="$(mktemp)"
trap 'rm -f "$tmp"' EXIT

i=0
while [ $i -lt ${#NAMES[@]} ]; do
  name="${NAMES[$i]}"
  rx="${REGEXES[$i]}"
  while IFS= read -r f; do
    excluded "$f" && continue
    scanned=$((scanned + 1))
    grep -niE "$rx" "$f" 2>/dev/null | while IFS= read -r hit; do
      case "$hit" in *"$ALLOW_TAG"*) continue ;; esac
      echo "$f:${hit%%:*}: [$name] ${hit#*:}"
      echo x >> "$tmp"
    done
  done < <(find "${ROOTS[@]}" -type f -name '*.md' 2>/dev/null)
  i=$((i + 1))
done

# de-dup the scanned count (find ran once per pattern)
scanned=$(find "${ROOTS[@]}" -type f -name '*.md' 2>/dev/null | wc -l)

if [ -s "$tmp" ]; then
  fail=1
  echo "hesitance-lint: FAIL — hesitance patterns found above." >&2
  echo "Fix the instruction to act-then-report, or allowlist the line with '# $ALLOW_TAG: <reason>'." >&2
else
  echo "hesitance-lint: clean ($scanned instruction files scanned)."
fi
exit $fail

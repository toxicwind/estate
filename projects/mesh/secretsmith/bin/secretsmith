#!/bin/sh
# secretsmith launcher - PATH install target.
# Resolves the CLI next to itself (no hardcoded mount paths) and defaults
# DBUS_SESSION_BUS_ADDRESS to this user's session bus when unset.

DIR="$(cd "$(dirname "$0")/.." && pwd)"
CLI="$DIR/secretsmith.py"

if [ -z "$DBUS_SESSION_BUS_ADDRESS" ]; then
  DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
  export DBUS_SESSION_BUS_ADDRESS
fi

exec python3 "$CLI" "$@"

#!/usr/bin/env python3
"""
cron-trust-monitor: autonomous cron reliability watchdog.

The platform lies: status="succeeded" for vetoed, overlap-skipped, and no-op runs.
Three days of vetoed backups looked "healthy."

This monitor:
1. Queries recent cron runs via the platform API
2. Classifies each HONESTLY (reads result_summary, not just status)
3. Tracks per-job trust scores over a rolling window
4. AUTONOMOUSLY escalates when trust drops:
   - 3 consecutive vetoes → page (job is blocked, not running)
   - genuine rate < 50% over 24h → page (job is unreliable)
   - critical job (backup, health) with any veto → page immediately
5. Appends to ledger (post-use verification)

Usage: cron-trust-monitor [--json] [--window-hours N]
Designed to run as a cron job every 15 minutes.

Exit codes: 0=healthy, 1=issues found (see output), 2=monitor error
"""

import json
import sys
import os
from datetime import datetime, timezone, timedelta
from collections import defaultdict

# Classification patterns (from SOUL.md cron status laundering section)
VETO_PATTERNS = [
    "did not pass the scheduled-task safety review",
    "safety review",
    "vetoed",
]

SKIP_PATTERNS = [
    "overlap",
    "another run was active",
    "skipped",
    "coalesced",
]

NOOP_PATTERNS = [
    "no-op",
    "noop",
    "did nothing",
    "nothing to do",
]

# Jobs that must never be vetoed/skipped silently
CRITICAL_JOBS = [
    "backup",
    "health",
    "cell-backup",
]

LEDGER_PATH = os.path.expanduser("~/workspace/fleet-ping/cron-trust-ledger.jsonl")

def classify_run(run):
    """
    Honest classification of a single run.
    Returns (honest_status, reason).
    
    Honest statuses: genuine, vetoed, overlap-skip, no-op, failed, ambiguous
    """
    status = run.get("status", "")
    summary = run.get("result_summary", "") or ""
    summary_lower = summary.lower()
    
    # Check veto patterns first (most important - the lie we care about)
    for pat in VETO_PATTERNS:
        if pat.lower() in summary_lower:
            return ("vetoed", f"safety review blocked: {pat}")
    
    # Check skip patterns
    for pat in SKIP_PATTERNS:
        if pat.lower() in summary_lower:
            return ("overlap-skip", f"run skipped: {pat}")
    
    # Check no-op patterns
    for pat in NOOP_PATTERNS:
        if pat.lower() in summary_lower:
            return ("no-op", f"no work done: {pat}")
    
    # Status-based classification
    if status == "failed":
        return ("failed", "status=failed")
    elif status == "succeeded":
        # If status says succeeded but we found no veto/skip/noop patterns,
        # check if summary indicates real work was done
        if summary and len(summary.strip()) > 20:
            return ("genuine", "status=succeeded with substantive summary")
        else:
            return ("ambiguous", "status=succeeded but empty/thin summary")
    else:
        return ("ambiguous", f"unknown status: {status}")

def is_critical(job_id):
    job_lower = job_id.lower()
    return any(crit in job_lower for crit in CRITICAL_JOBS)

def main():
    as_json = "--json" in sys.argv
    window_hours = 24
    for i, arg in enumerate(sys.argv):
        if arg == "--window-hours" and i + 1 < len(sys.argv):
            window_hours = int(sys.argv[i + 1])
    
    # This script is designed to be called with run data piped in,
    # or it can be integrated with the cron.runs API via a wrapper.
    # For now, it reads from stdin as JSON lines (one run per line).
    #
    # In production, a wrapper calls cron.runs and pipes the output here.
    
    runs = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            runs.append(json.loads(line))
        except json.JSONDecodeError:
            continue
    
    if not runs:
        result = {
            "healthy": True,
            "message": "no runs to classify",
            "jobs": {},
        }
        if as_json:
            print(json.dumps(result, indent=2))
        else:
            print("CRON-TRUST: no runs in window")
        sys.exit(0)
    
    # Classify all runs
    by_job = defaultdict(list)
    for run in runs:
        job_id = run.get("job_id", run.get("id", "unknown"))
        honest, reason = classify_run(run)
        by_job[job_id].append({
            "honest": honest,
            "reason": reason,
            "ts": run.get("ts", run.get("ran_at", "")),
            "status": run.get("status", ""),
        })
    
    # Compute trust scores and detect issues
    issues = []
    job_reports = {}
    
    cutoff = datetime.now(timezone.utc) - timedelta(hours=window_hours)
    
    for job_id, job_runs in by_job.items():
        # Apply time window cutoff - filter to runs within window
        def parse_ts(ts_str):
            if not ts_str:
                return None
            try:
                # Try ISO format first
                dt = datetime.fromisoformat(ts_str.replace('Z', '+00:00'))
                if dt.tzinfo is None:
                    dt = dt.replace(tzinfo=timezone.utc)
                return dt
            except:
                return None
        
        # Filter to window and sort by timestamp (newest first)
        # Runs without parseable timestamps are included (conservative)
        window_runs = []
        for r in job_runs:
            ts = parse_ts(r["ts"])
            if ts is None or ts >= cutoff:
                window_runs.append((ts, r))
        
        # Sort by timestamp descending (None timestamps go last)
        window_runs.sort(key=lambda x: (x[0] is not None, x[0]), reverse=True)
        job_runs = [r for _, r in window_runs]
        
        # Sort by timestamp (newest first if available)
        counts = defaultdict(int)
        for r in job_runs:
            counts[r["honest"]] += 1
        
        total = len(job_runs)
        genuine = counts["genuine"]
        vetoed = counts["vetoed"]
        skipped = counts["overlap-skip"]
        noop = counts["no-op"]
        failed = counts["failed"]
        
        genuine_rate = genuine / total if total > 0 else 0
        
        # Check for consecutive vetoes (most urgent)
        # job_runs is already sorted newest-first from above
        consec_vetoes = 0
        for r in job_runs:
            if r["honest"] == "vetoed":
                consec_vetoes += 1
            else:
                break
        
        job_report = {
            "total_runs": total,
            "genuine": genuine,
            "vetoed": vetoed,
            "overlap_skip": skipped,
            "no_op": noop,
            "failed": failed,
            "genuine_rate": round(genuine_rate, 2),
            "consecutive_vetoes": consec_vetoes,
            "critical": is_critical(job_id),
        }
        job_reports[job_id] = job_report
        
        # Escalation rules
        critical = is_critical(job_id)
        
        if consec_vetoes >= 3:
            issues.append({
                "severity": "HIGH",
                "job": job_id,
                "issue": f"{consec_vetoes} consecutive vetoes — job is blocked, not running",
                "action": "investigate safety review blocks immediately",
            })
        elif critical and vetoed > 0:
            issues.append({
                "severity": "HIGH",
                "job": job_id,
                "issue": f"critical job vetoed {vetoed}x in window",
                "action": "critical jobs must not be silently blocked",
            })
        elif genuine_rate < 0.5 and total >= 3:
            issues.append({
                "severity": "MEDIUM",
                "job": job_id,
                "issue": f"genuine rate {genuine_rate:.0%} ({genuine}/{total}) — job is unreliable",
                "action": "review job health, consider schedule changes",
            })
        elif failed > 0:
            issues.append({
                "severity": "MEDIUM",
                "job": job_id,
                "issue": f"{failed} failed runs in window",
                "action": "check error logs",
            })
    
    # Systemic check: fleet-wide oversubscription
    # If >30% of all runs in window are overlap-skips, the cell is oversubscribed
    total_runs = sum(v["total_runs"] for v in job_reports.values())
    total_skips = sum(v["overlap_skip"] for v in job_reports.values())
    if total_runs >= 5 and total_skips / total_runs > 0.3:
        issues.append({
            "severity": "HIGH",
            "job": "*fleet*",
            "issue": f"{total_skips}/{total_runs} runs overlap-skipped ({total_skips/total_runs:.0%}) — cell oversubscribed",
            "action": "too many jobs for 2 cores; stagger schedules or move work to awrawr-pc",
        })
    
    healthy = len(issues) == 0
    
    # Ledger (post-use verification)
    ledger_entry = {
        "ts": datetime.now(timezone.utc).isoformat(),
        "window_hours": window_hours,
        "jobs_checked": len(job_reports),
        "issues_found": len(issues),
        "healthy": healthy,
    }
    try:
        with open(LEDGER_PATH, "a") as f:
            f.write(json.dumps(ledger_entry) + "\n")
    except Exception:
        pass  # ledger is best-effort
    
    result = {
        "healthy": healthy,
        "jobs": job_reports,
        "issues": issues,
        "ledger": LEDGER_PATH,
    }
    
    if as_json:
        print(json.dumps(result, indent=2))
    else:
        if healthy:
            # Count non-genuine for honest reporting
            non_genuine = sum(v["vetoed"] + v["overlap_skip"] + v["no_op"] + v["failed"] 
                           for v in job_reports.values())
            if non_genuine > 0:
                print(f"CRON-TRUST: OK — {len(job_reports)} jobs, {non_genuine} non-genuine runs below alert threshold")
            else:
                print(f"CRON-TRUST: HEALTHY — {len(job_reports)} jobs, all genuine")
        else:
            print(f"CRON-TRUST: {len(issues)} ISSUES")
            for iss in issues:
                print(f"  [{iss['severity']}] {iss['job']}: {iss['issue']}")
                print(f"    → {iss['action']}")
    
    sys.exit(0 if healthy else 1)

if __name__ == "__main__":
    main()

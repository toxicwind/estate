# Merged configuration from ~/.tau/config.yml (destination) and ~/.tau/agent/config.yml (source)

# Plugins configuration (from destination)
plugins:
  - name: herd
    source: ./projects/ranch/herd
    vendor:
      - ./projects/ranch/herd/vendor/llama-swap
    merged: sovereign-swap
    privileged: true
  - name: flock
    source: ./projects/ranch/flock
    privileged: true
  - name: shep
    source: ./projects/ranch/barn/shep
    privileged: true
    role: "MCP federation gateway"
  - name: router
    source: ./projects/ranch/router
    merged: [router-legacy, stockyard-flock-router, sovereign-router]
    privileged: true
  - name: barn-browser
    source: ./projects/ranch/barn/browserless
    privileged: false
  - name: barn-gemini
    source: ./projects/ranch/barn/gemini-mcp
    privileged: false
  - name: secretsmith
    source: ./projects/ranch/barn/secretsmith
    privileged: true

# Provider and system configurations (from source)
providers:
  anthropic:
    serverSideFallback: true
  autoThinkingMaxEffort: xhigh
  maxInFlightRequests:
    {}
  openai-codex:
    codeMode: "on"
    codeModeDirectTools:
      []
  ollama-cloud:
    maxConcurrency: 3
  openai-compatible:
    baseUrl: http://127.0.0.1:25100/v1
    apiKey: llama-swap
  webSearchTimeoutSeconds: 60
  antigravityEndpoint: auto
  fireworksTier: standard
  tinyModelDevice: auto
  tinyModelDtype: auto
  searchDelayMs: 1000
  cycleOrder:
    - smol
    - default
    - slow
  disabledProviders:
    []
  disabledExtensions:
    []
  skillful: true

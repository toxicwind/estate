# Runtime state for the agent dir. config.yml is tracked — it is the file the
# engine actually reads for settings (settings.ts:183), and losing it silently
# reverts every model role to a paid model this account cannot afford.
agent.db
agent.db-shm
agent.db-wal
*.db
*.db-shm
*.db-wal
backups/
cache/
fff/
kpi/
managed-skills/
last-changelog-version
bench-state.json
bench-results-*.json
# Pre-bili backups of the old config. Superseded by config.yml; kept on disk
# only as local history.
config.yml.bili-bak
config.yml.bak-prebili
config.yml.bili-last

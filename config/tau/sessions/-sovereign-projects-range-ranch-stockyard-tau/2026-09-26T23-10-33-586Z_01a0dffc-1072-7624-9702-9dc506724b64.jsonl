Y\" ]; then mode=prod; entry=\"$PROD_ENTRY\"\n43|  else mode=dev; entry=\"$DEV_ENTRY\"; fi\n44|  printf 'engine : %s\\n' \"$ENGINE\"\n45|  printf 'mode   : %s\\n' \"$mode\"\n46|  printf 'entry  : %s\\n' \"$entry\"\n47|  printf 'dev    : %s [%s]\\n'  \"$DEV_ENTRY\"  \"$( [ -f \"$DEV_ENTRY\" ] && echo ok || echo MISSING )\"\n48|  printf 'prod   : %s [%s]\\n'  \"$PROD_ENTRY\" \"$( [ -f \"$PROD_ENTRY\" ] && echo ok || echo not-built )\"\n49|  printf 'bun    : %s\\n' \"$(command -v bun || echo '<not on PATH>')\"\n50|}\n51|\n52|run_dev(){\n53|  [ -f \"$DEV_ENTRY\" ] || die \"dev entry missing: $DEV_ENTRY\"\n54|  need_bun\n55|  exec bun --preserve-symlinks \"$DEV_ENTRY\" -- \"$@\"\n56|}\n57|run_prod(){\n58|  if [ ! -f \"$PROD_ENTRY\" ]; then\n59|    [ \"${TAU_NO_AUTOBUILD:-0}\" = \"1\" ] && die \"prod entry missing (TAU_NO_AUTOBUILD=1): $PROD_ENTRY\"\n60|    printf '[tau] dist missing — auto-building ...\\n' >&2\n61|    build_dist || { printf '[tau] build failed; falling back to source\\n' >&2; run_dev \"$@\"; }\n62|  fi\n63|  exec \"$PROD_ENTRY\" -- \"$@\"\n64|}\n65|\n66|# ---- consume launcher flags ONLY from the front ----\n67|mode=\"${TAU_MODE:-auto}\"\n68|args=()\n69|while [ $# -gt 0 ]; do\n70|  case \"$1\" in\n71|    --dev)       mode=dev;        shift ;;\n72|    --prod)      mode=prod;       shift ;;\n73|    --rebuild)   need_bun; build_dist; mode=prod; shift ;;\n74|    --where)     show_where; exit 0 ;;\n75|    --tau-help)  sed -n '2,20p' \"$0\" | sed 's/^# \\{0,1\\}//'; exit 0 ;;\n76|    --)          shift; args+=(\"$@\"); break ;;   # everything after -- goes to agent\n77|    *)           args+=(\"$@\"); break ;;          # first non-launcher arg: forward from here on\n78|  esac\n79|done\n80|\n81|case \"$mode\" in\n82|  dev)  run_dev  \"${args[@]+\"${args[@]}\"}\" ;;\n83|  prod) run_prod \"${args[@]+\"${args[@]}\"}\" ;;\n84|  auto)\n85|    if [ \"${TAU_FORCE_SRC:-0}\" = \"1\" ] || [ ! -f \"$PROD_ENTRY\" ]; then\n86|      run_dev  \"${args[@]+\"${args[@]}\"}\"\n87
OD_ENTRY\" ]; then mode=dev; entry=\"$DEV_ENTRY\"\n    else mode=dev; entry=\"$DEV_ENTRY\"; fi\n  else\n    if [ \"$mode\" = \"dev\" ]; then entry=\"$DEV_ENTRY\"; else entry=\"$PROD_ENTRY\"; fi\n  fi\n  printf 'engine : %s\\n' \"$ENGINE\"\n  printf 'mode   : %s\\n' \"$mode\"\n  printf 'entry  : %s\\n' \"$entry\"\n  printf 'dev    : %s [%s]\\n'  \"$DEV_ENTRY\"  \"$( [ -f \"$DEV_ENTRY\" ] && echo ok || echo MISSING )\"\n  printf 'prod   : %s [%s]\\n'  \"$PROD_ENTRY\" \"$( [ -f \"$PROD_ENTRY\" ] && echo ok || echo not-built )\"\n  printf 'bun    : %s\\n' \"$(command -v bun || echo '<not on PATH>')\"\n}\n\nrun_dev(){\n  [ -f \"$DEV_ENTRY\" ] || die \"dev entry missing: $DEV_ENTRY\"\n  need_bun\n  exec bun --preserve-symlinks \"$DEV_ENTRY\" -- \"$@\"\n}\nrun_prod(){\n  if [ ! -f \"$PROD_ENTRY\" ]; then\n    [ \"${TAU_NO_AUTOBUILD:-0}\" = \"1\" ] && die \"prod entry missing (TAU_NO_AUTOBUILD=1): $PROD_ENTRY\"\n    printf '[tau] dist missing — auto-building ...\\n' >&2\n    build_dist || { printf '[tau] build failed; falling back to source\\n' >&2; run_dev \"$@\"; }\n  fi\n  exec \"$PROD_ENTRY\" -- \"$@\"\n}\n\n# ---- consume launcher flags ONLY from the front ----\nmode=\"${TAU_MODE:-auto}\"\nargs=()\nwhile [ $# -gt 0 ]; do\n  case \"$1\" in\n    --dev)       mode=dev;        shift ;;\n    --prod)      mode=prod;       shift ;;\n    --rebuild)   need_bun; build_dist; mode=prod; shift ;;\n    --where)     show_where; exit 0 ;;\n    --tau-help)  sed -n '2,20p' \"$0\" | sed 's/^# \\{0,1\\}//'; exit 0 ;;\n    --)          shift; args+=(\"$@\"); break ;;   # everything after -- goes to agent\n    *)           args+=(\"$@\"); break ;;          # first non-launcher arg: forward from here on\n  esac\ndone\n\ncase \"$mode\" in\n  dev)  run_dev  \"${args[@]+\"${args[@]}\"}\" ;;\n  prod) run_prod \"${args[@]+\"${args[@]}\"}\" ;;\n  auto)\n    if [ \"${TAU_FORCE_SRC:-0}\" = \"1\" ] || [ ! -f \"$PROD_ENTRY\" ]; then\n      run_dev  \"${args[@]+\"${args[@]}\"}\"\n    else\n      run_de
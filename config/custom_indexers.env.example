# custom_indexers.env — indexer matrix (consumer template)
#
# The creds NEVER live here in plaintext: TorBox NNTP creds are SSOT in the
# secretsmith keyring (labels NNTP_TORBOX_HOST/USER/PASS, service=app;
# verified 2026-11-02). Materialize this file per-consumer with:
#
#   secretsmith env --app torbox > /path/to/custom_indexers.env
#
# (secretsmith --app matches service=app attributes + label/prefix keys.)
# The old plaintext custom_indexers.env that this replaces was retired
# 2026-10-XX — no plaintext copy exists on this box.
#
# Indexer choice per MAX PLAN Phase 2.6: no Prowlarr unless justified.
# Probe results (2026-11-02, 2s timeout): nzbindex.com 200, nzbgeek.info 200,
# nzbplanet.net 200, nzbfinder.ws 200, animetosho.org 200, binsearch.info 200,
# nzbking.com 200; drunkenslug.com 403, nzb.su 403 (bot-blocked), newz69.com 000.

# --- Usenet/NNTP (via TorBox) ---
NNTP_TORBOX_HOST=torbox.example.invalid
NNTP_TORBOX_USER=changeme
NNTP_TORBOX_PASS=changeme

# --- Web indexers (probe-passed) ---
INDEXER_NZBINDEX_ENABLED=true
INDEXER_NZBGEEK_ENABLED=false    # requires API key
INDEXER_ANIMETOSHO_ENABLED=true
INDEXER_BINSEARCH_ENABLED=true
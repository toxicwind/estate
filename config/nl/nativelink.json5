// Maximal NativeLink config — estate permanent SSOT under config/nl/
// Ports: frontend 25155 (RE API), worker 25157 (worker_api + health)
// Paths under /home/toxic/var/runtime/nativelink/
{
  stores: [
    {
      name: "CAS_MAIN_STORE",
      compression: {
        compression_algorithm: { lz4: {} },
        backend: {
          filesystem: {
            content_path: "/home/toxic/var/runtime/nativelink/cas/content",
            temp_path: "/home/toxic/var/runtime/nativelink/cas/tmp",
            eviction_policy: { max_bytes: 30000000000 },
          },
        },
      },
    },
    {
      name: "AC_MAIN_STORE",
      filesystem: {
        content_path: "/home/toxic/var/runtime/nativelink/ac/content",
        temp_path: "/home/toxic/var/runtime/nativelink/ac/tmp",
        eviction_policy: { max_bytes: 2000000000 },
      },
    },
    {
      name: "WORKER_FAST_SLOW_STORE",
      fast_slow: {
        fast: {
          filesystem: {
            content_path: "/home/toxic/var/runtime/nativelink/cas/content",
            temp_path: "/home/toxic/var/runtime/nativelink/cas/tmp",
            eviction_policy: { max_bytes: 30000000000 },
          },
        },
        slow: { noop: {} },
      },
    },
  ],
  schedulers: [
    {
      name: "MAIN_SCHEDULER",
      simple: {
        supported_platform_properties: {
          cpu_count: "minimum",
          memory_kb: "minimum",
          OSFamily: "priority",
          "container-image": "priority",
          lre: "priority",
          ISA: "exact",
          cpu_arch: "exact",
        },
      },
    },
  ],
  workers: [
    {
      local: {
        worker_api_endpoint: { uri: "grpc://127.0.0.1:25157" },
        cas_fast_slow_store: "WORKER_FAST_SLOW_STORE",
        upload_action_result: { ac_store: "AC_MAIN_STORE" },
        work_directory: "/home/toxic/var/runtime/nativelink/work",
        platform_properties: {
          cpu_count: { values: ["8"] },
          memory_kb: { values: ["16000000"] },
          OSFamily: { values: ["linux"] },
          ISA: { values: ["x86-64"] },
          cpu_arch: { values: ["x86_64"] },
        },
      },
    },
  ],
  servers: [
    {
      name: "frontend",
      listener: { http: { socket_address: "127.0.0.1:25155" } },
      services: {
        cas: [{ cas_store: "CAS_MAIN_STORE" }, { instance_name: "main", cas_store: "CAS_MAIN_STORE" }],
        ac: [{ ac_store: "AC_MAIN_STORE" }, { instance_name: "main", ac_store: "AC_MAIN_STORE" }],
        capabilities: [{ remote_execution: { scheduler: "MAIN_SCHEDULER" } }, { instance_name: "main", remote_execution: { scheduler: "MAIN_SCHEDULER" } }],
        bytestream: [{ cas_store: "CAS_MAIN_STORE" }, { instance_name: "main", cas_store: "CAS_MAIN_STORE" }],
        execution: [{ scheduler: "MAIN_SCHEDULER", cas_store: "WORKER_FAST_SLOW_STORE" }, { instance_name: "main", scheduler: "MAIN_SCHEDULER", cas_store: "WORKER_FAST_SLOW_STORE" }],
        health: [],
        fetch: [],
        push: [],
      },
    },
    {
      name: "worker",
      listener: { http: { socket_address: "127.0.0.1:25157" } },
      services: {
        worker_api: { scheduler: "MAIN_SCHEDULER" },
        health: [],
        admin: {},
      },
    },
  ],
  global: { max_open_files: 24576 },
}

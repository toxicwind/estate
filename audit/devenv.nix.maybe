{ config, pkgs, lib, inputs, ... }:

let
  ports = {
    landing     = "25000";
    hf          = "8080";
    herder      = "8081";
    llama       = "25001";
    prometheus  = "9090";
    caddyAdmin  = "2019";
  };

  sovereignHome   = config.env.DEVENV_ROOT or "/home/toxic/sovereign";
  modelPath       = config.env.MODEL_PATH or "/home/toxic/models/gemma-4-12B-it-uncensored-Q4_K_M.gguf";
  draftModelPath  = config.env.DRAFT_MODEL_PATH or "/home/toxic/models/Qwen2.5-1.5B-Draft.gguf";

  beellama-src = pkgs.fetchFromGitHub {
    owner  = "Anbeeld";
    repo   = "beellama.cpp";
    rev    = "b9829";
    sha256 = lib.fakeSha256;
  };

  hfhub-src = pkgs.fetchFromGitHub {
    owner  = "huggingface";
    repo   = "huggingface_hub";
    rev    = "v1.21.0";
    sha256 = lib.fakeSha256;
  };

  beellama-cpp = (pkgs.llama-cpp.override {
    cudaSupport = true;
    rocmSupport = false;
    metalSupport = false;
    blasSupport = true;
  }).overrideAttrs (oldAttrs: rec {
    pname = "beellama-cpp";
    version = "b9829";
    src = beellama-src;
    cmakeFlags = (oldAttrs.cmakeFlags or []) ++ [
      "-DGGML_NATIVE=ON"
      "-DGGML_CUDA_FA_ALL_QUANTS=ON"
    ];
    preConfigure = ''
      export NIX_ENFORCE_NO_NATIVE=0
      ${oldAttrs.preConfigure or ""}
    '';
  });

  huggingface-hub-latest = pkgs.python3Packages.buildPythonApplication rec {
    pname = "huggingface-hub";
    version = "1.21.0";
    src = hfhub-src;
    propagatedBuildInputs = with pkgs.python3Packages; [
      requests tqdm filelock fsspec pyyaml typing-extensions packaging
    ];
  };

  llama-herder-pkg = pkgs.python3Packages.buildPythonApplication {
    pname = "llama-herder";
    version = "0.1.0";
    src = if builtins.pathExists "${sovereignHome}/tools/llamaherder"
          then "${sovereignHome}/tools/llamaherder"
          else pkgs.writeTextDir "app.py" ''
            from flask import Flask
            app = Flask(__name__)
            @app.route("/health")
            def health(): return "OK"
            if __name__ == "__main__": app.run(host="0.0.0.0", port=8081)
          '';
    format = "pyproject";
    propagatedBuildInputs = with pkgs.python3Packages; [ flask requests pydantic uvicorn ];
    doCheck = false;
  };

  sovereign-watchdog-pkg = pkgs.python3Packages.buildPythonApplication {
    pname = "sovereign-watchdog";
    version = "0.1.0";
    src = if builtins.pathExists "${sovereignHome}/sovereign"
          then "${sovereignHome}/sovereign"
          else pkgs.writeTextDir "watchdog.py" "print('watchdog stub')";
    format = "pyproject";
    propagatedBuildInputs = with pkgs.python3Packages; [ requests psutil ];
    doCheck = false;
  };

  telethon-overlord-pkg = pkgs.python3Packages.buildPythonApplication {
    pname = "telethon-overlord";
    version = "0.1.0";
    src = if builtins.pathExists "${sovereignHome}/agents/telethon_overlord"
          then "${sovereignHome}/agents/telethon_overlord"
          else pkgs.writeTextDir "overlord.py" "print('overlord stub')";
    format = "pyproject";
    propagatedBuildInputs = with pkgs.python3Packages; [ telethon requests pydantic ];
    doCheck = false;
  };

  caddyConfigText = ''
    :80 {
      handle /health   { respond "OK" 200 }
      handle /hf/*     { reverse_proxy localhost:''${config.env.HF_DOWNLOADER or "8080"} }
      handle /herder/* { reverse_proxy localhost:''${config.env.LLAMA_HERDER or "8081"} }
      handle /landing/*{ reverse_proxy localhost:''${config.env.LANDING_PAGE or "25000"} }
      handle /fang/*   { reverse_proxy localhost:''${config.env.OPENFANG_PORT or "25004"} }
      handle /cot/*    { reverse_proxy localhost:''${config.env.NFCOT_PORT or "25008"} }
      handle /rank/*   { reverse_proxy localhost:''${config.env.RANK_PORT or "25010"} }
      handle /api/*    { reverse_proxy localhost:''${config.env.RANK_PORT or "25010"} }
      handle /llm/*    { reverse_proxy localhost:''${config.env.LLAMA_PORT or "25001"} }
      handle /*        { reverse_proxy localhost:''${config.env.LLAMA_PORT or "25001"} }
    }
  '';

in
{
  dotenv.enable = true;

  packages = with pkgs; [
    git curl jq fd ripgrep eza fzf htop nvtop btop tree nixfmt nix-prefetch-git
    cudaPackages.cudatoolkit cudaPackages.cuda_cudart cudaPackages.libcublas
    cudaPackages.libcufft cudaPackages.libcurand cudaPackages.cuda_nvtx
    python3 python3Packages.flask python3Packages.requests python3Packages.uvicorn
    python3Packages.fastapi python3Packages.pydantic python3Packages.numpy
    python3Packages.psutil python3Packages.torchWithCuda python3Packages.transformers
    python3Packages.accelerate python3Packages.bitsandbytes python3Packages.peft
    python3Packages.telethon python3Packages.aiohttp python3Packages.httpx
    bun nodejs_22 pnpm
    beellama-cpp ollama
    prometheus grafana
    nmap openssl wireshark tshark
    huggingface-hub-latest llama-herder-pkg sovereign-watchdog-pkg
    telethon-overlord-pkg
  ];

  env = {
    SOVEREIGN_HOME        = sovereignHome;
    MODEL_PATH            = modelPath;
    DRAFT_MODEL_PATH      = draftModelPath;
    CUDA_VISIBLE_DEVICES  = "0";
    GGML_CUDA             = "1";
    GGML_CUDA_GRAPHS      = "1";
    GGML_CUDA_FA_ALL_QUANTS = "1";
    PYTHONUNBUFFERED      = "1";
    PYTHONPATH            = sovereignHome;
    PYTHONDONTWRITEBYTECODE = "1";
    FLASK_APP             = "app.py";
    FLASK_ENV             = "development";
    FLASK_DEBUG           = "1";
    HF_HUB_DISABLE_TELEMETRY = "1";
    HF_HUB_DISABLE_UPDATE_CHECK = "1";
    LANDING_PAGE          = ports.landing;
    HF_DOWNLOADER         = ports.hf;
    LLAMA_HERDER          = ports.herder;
    LLAMA_SERVER          = ports.llama;
    PROMETHEUS_PORT       = ports.prometheus;
    LLAMA_ARG_MODEL       = modelPath;
    LLAMA_ARG_CTX_SIZE    = "32768";
    LLAMA_ARG_N_GPU_LAYERS = "99";
    LLAMA_ARG_BATCH       = "4096";
    LLAMA_ARG_UBATCH      = "1024";
    LLAMA_ARG_FLASH_ATTN  = "auto";
    LLAMA_ARG_THREADS     = "4";
    LLAMA_ARG_HOST        = "0.0.0.0";
    LLAMA_ARG_PORT        = ports.llama;
    LLAMA_ARG_NO_MMAP     = "1";
    LLAMA_ARG_MLOCK       = "1";
    LLAMA_ARG_EMBEDDINGS  = "1";
    LLAMA_ARG_POOLING     = "cls";
    LLAMA_ARG_CACHE_TYPE_K = "q4_0";
    LLAMA_ARG_CACHE_TYPE_V = "q4_0";
    LLAMA_ARG_DRAFT       = draftModelPath;
    LLAMA_ARG_DRAFT_N_GPU_LAYERS = "99";
    LLAMA_ARG_DRAFT_N_PREDICT = "16";
    BUN_INSTALL           = "${sovereignHome}/.bun";
    CADDY_ADMIN           = "0.0.0.0:${ports.caddyAdmin}";
    OPENFANG_PORT         = config.env.OPENFANG_PORT or "25004";
    NFCOT_PORT            = config.env.NFCOT_PORT or "25008";
    RANK_PORT             = config.env.RANK_PORT or "25010";
    YOTE_PORT             = config.env.YOTE_PORT or "25042";
    OPENFANG_LISTEN       = config.env.OPENFANG_LISTEN or "127.0.0.1:25004";
    OPENFANG_CONFIG_DIR   = config.env.OPENFANG_CONFIG_DIR or "/home/toxic/.openfang";
    FLOW_PATH             = config.env.FLOW_PATH or "${sovereignHome}/nfcot_flow.pt";
    MODEL_URL             = config.env.MODEL_URL or "http://127.0.0.1:25001";
    PROXY_PORT            = config.env.PROXY_PORT or "25008";
    TRIGGER_TOKEN         = config.env.TRIGGER_TOKEN or "<|im_start|>think";
    FORCE_TRIGGER         = config.env.FORCE_TRIGGER or "true";
    ENABLE_SHADOW_LATENT  = config.env.ENABLE_SHADOW_LATENT or "1";
    IK_LLAMA_BIN          = config.env.IK_LLAMA_BIN or "/home/toxic/ik_llama.cpp-main/build/bin/llama-server";
    RUST_APP              = config.env.RUST_APP or "${sovereignHome}/rust_algo_web";
    RUST_LOG              = config.env.RUST_LOG or "info";
    CARGO_BUILD_JOBS      = config.env.CARGO_BUILD_JOBS or "16";
    MAKEFLAGS             = config.env.MAKEFLAGS or "-j16";
    RAYON_NUM_THREADS     = config.env.RAYON_NUM_THREADS or "16";
    OMP_NUM_THREADS       = config.env.OMP_NUM_THREADS or "16";
    OPENBLAS_NUM_THREADS  = config.env.OPENBLAS_NUM_THREADS or "16";
    CFLAGS                = config.env.CFLAGS or "-march=native -O3 -pipe -fomit-frame-pointer";
    CXXFLAGS              = config.env.CXXFLAGS or "-march=native -O3 -pipe -fomit-frame-pointer";
    CUDA_CACHE_DISABLE    = config.env.CUDA_CACHE_DISABLE or "0";
    CUDA_CACHE_MAXSIZE    = config.env.CUDA_CACHE_MAXSIZE or "2147483648";
  };

  services.caddy = {
    enable = true;
    config = caddyConfigText;
  };

  services.prometheus = {
    enable = true;
    port = 9090;
    retentionTime = "30d";
    scrapeConfigs = [
      {
        job_name = "prometheus";
        static_configs = [{ targets = [ "localhost:9090" ]; }];
      }
      {
        job_name = "llama-server";
        static_configs = [{ targets = [ "localhost:25001" ]; }];
      }
    ];
  };

  services.grafana = {
    enable = true;
    settings = {
      server = {
        http_port = 3000;
        domain = "localhost";
      };
    };
  };

  processes = {
    landing = {
      exec = ''
        cd "${sovereignHome}/landing" 2>/dev/null || cd "${sovereignHome}"
        exec ${pkgs.bun}/bin/bun run server.ts --port "''${LANDING_PAGE}"
      '';
      process-compose = {
        readiness_probe = {
          exec.command = "${pkgs.curl}/bin/curl -f -s http://localhost:${ports.landing}/health || exit 1";
          initial_delay_seconds = 2;
          period_seconds = 5;
          timeout_seconds = 3;
          failure_threshold = 10;
        };
      };
    };

    llama-server = {
      exec = ''
        exec ${beellama-cpp}/bin/llama-server \
          -m "''${MODEL_PATH}" \
          --host 0.0.0.0 \
          --port "''${LLAMA_SERVER}" \
          -c 32768 --slots 1 -b 4096 -ub 1024 \
          --flash-attn auto -ngl 99 -t 4 \
          --no-mmap --mlock --embeddings --pooling cls \
          --cache-type-k q4_0 --cache-type-v q4_0 \
          --kv-unified --no-host --ctx-checkpoints 32 --cache-ram 8192 \
          --draft "''${DRAFT_MODEL_PATH}" --draft-n-ctx 4096 \
          --draft-n-predict 16 --draft-n-gpu-layers 99 \
          --metrics --log-format json
      '';
      process-compose = {
        readiness_probe = {
          exec.command = "${pkgs.curl}/bin/curl -f -s http://localhost:${ports.llama}/health || exit 1";
          initial_delay_seconds = 15;
          period_seconds = 5;
          timeout_seconds = 5;
          failure_threshold = 30;
        };
        availability = {
          restart = "on_failure";
          backoff_seconds = 5;
          max_restarts = 10;
        };
      };
    };

    hf-downloader = {
      exec = ''
        mkdir -p "''${SOVEREIGN_HOME}/.state"
        cat > "''${SOVEREIGN_HOME}/.state/hf_downloader.py" << 'PYEOF'
import http.server, socketserver, subprocess, os, json, urllib.parse, sys
PORT = int(os.environ["HF_DOWNLOADER"])
SOVEREIGN = os.environ.get("SOVEREIGN_HOME", ".")
class Handler(http.server.BaseHTTPRequestHandler):
    def do_GET(self):
        parsed = urllib.parse.urlparse(self.path)
        if parsed.path == "/health":
            self.send_response(200); self.end_headers(); self.wfile.write(b"OK"); return
        if parsed.path.startswith("/hf/"):
            repo = parsed.path[4:].strip("/")
            local_dir = os.path.join(SOVEREIGN, "models", "hf", repo.replace("/", "_"))
            os.makedirs(local_dir, exist_ok=True)
            try:
                # Use uvx hf instead of bare hf
                subprocess.run(
                    ["uvx", "hf", "download", repo, "--local-dir", local_dir, "--local-dir-use-symlinks", "False"],
                    check=True, capture_output=True
                )
                ...
PYEOF
      exec ${pkgs.python3}/bin/python3 "''${SOVEREIGN_HOME}/.state/hf_downloader.py"
        '';
        process-compose = {
          readiness_probe = {
            exec.command = "${pkgs.curl}/bin/curl -f -s http://localhost:${ports.hf}/health || exit 1";
            initial_delay_seconds = 1;
            period_seconds = 3;
            failure_threshold = 5;
          };
        };
      };

    llama-herder = {
      exec = ''
        cd "${sovereignHome}/tools/llamaherder" 2>/dev/null || cd "${sovereignHome}"
        exec ${llama-herder-pkg}/bin/llama-herder
      '';
      process-compose = {
        depends_on.llama-server.condition = "process_healthy";
        readiness_probe = {
          exec.command = "${pkgs.curl}/bin/curl -f -s http://localhost:${ports.herder}/health || exit 1";
          initial_delay_seconds = 2;
          period_seconds = 5;
          failure_threshold = 10;
        };
      };
    };

    openfang = {
      exec = ''
        while true; do
          ${config.env.OPENFANG_CONFIG_DIR or "/home/toxic/.openfang"}/bin/openfang start 2>/dev/null || true
          sleep 4
        done
      '';
      process-compose = {
        availability.restart = "always";
      };
    };

    sovereign_watchdog = {
      exec = "exec ${sovereign-watchdog-pkg}/bin/sovereign-watchdog";
      process-compose = {
        availability.restart = "on_failure";
        max_restarts = 5;
      };
    };

    telethon_overlord = {
      exec = "exec ${telethon-overlord-pkg}/bin/telethon-overlord";
      process-compose = {
        availability.restart = "on_failure";
        max_restarts = 3;
      };
    };

    prometheus = {
      exec = ''
        ${pkgs.prometheus}/bin/prometheus \
          --config.file="${sovereignHome}/prometheus.yml" \
          --storage.tsdb.path="${sovereignHome}/.prometheus" \
          --web.listen-address=0.0.0.0:${ports.prometheus}
      '';
      process-compose = {
        readiness_probe = {
          exec.command = "${pkgs.curl}/bin/curl -f -s http://localhost:${ports.prometheus}/-/healthy || exit 1";
          initial_delay_seconds = 3;
          period_seconds = 5;
        };
      };
    };
  };

  scripts = {
    hf-get.exec = ''
      if [ -z "$1" ]; then
        echo "Usage: hf-get <repo_id> [filename]"
        exit 1
      fi
      REPO="$1"
      LOCAL_DIR="''${SOVEREIGN_HOME}/models/hf/''${REPO//\//_}"
      mkdir -p "''${LOCAL_DIR}"
      if [ -n "$2" ]; then
        ${pkgs.huggingface-hub-latest}/bin/hf download "$REPO" "$2" --local-dir "''${LOCAL_DIR}" --local-dir-use-symlinks False
      else
        ${pkgs.huggingface-hub-latest}/bin/hf download "$REPO" --local-dir "''${LOCAL_DIR}" --local-dir-use-symlinks False
      fi
    '';

    llama-test.exec = ''
      ${beellama-cpp}/bin/llama-cli -m "''${MODEL_PATH}" -p "Hello" -n 16 -ngl 99 --flash-attn auto
    '';

    llama-bench.exec = ''
      ${beellama-cpp}/bin/llama-bench -m "''${MODEL_PATH}" \
        -fa 1 -d 0,4096,8192,16384,32768 -p 2048 -n 32 -ub 2048 -ngl 99 \
        --cache-type-k q4_0 --cache-type-v q4_0
    '';

    gpu-status.exec = ''
      ${pkgs.nvtop}/bin/nvtop --version 2>/dev/null || true
      ${pkgs.cudaPackages.cuda_nvml_dev}/bin/nvidia-smi --query-gpu=name,temperature.gpu,utilization.gpu,utilization.memory,memory.used,memory.total --format=csv 2>/dev/null || echo "nvidia-smi not available"
    '';

    caddy-reload.exec = ''
      cat > "''${SOVEREIGN_HOME}/Caddyfile" <<EOF
    :80 {
      handle /health { respond "OK" 200 }
      handle /hf/* { reverse_proxy localhost:''${HF_DOWNLOADER} }
      handle /herder/* { reverse_proxy localhost:''${LLAMA_HERDER} }
      handle /landing/* { reverse_proxy localhost:''${LANDING_PAGE} }
      handle /fang/* { reverse_proxy localhost:''${OPENFANG_PORT} }
      handle /cot/* { reverse_proxy localhost:''${NFCOT_PORT} }
      handle /rank/* { reverse_proxy localhost:''${RANK_PORT} }
      handle /api/* { reverse_proxy localhost:''${RANK_PORT} }
      handle /llm/* { reverse_proxy localhost:''${LLAMA_PORT} }
      handle /* { reverse_proxy localhost:''${LLAMA_PORT} }
    }
    EOF
      ${pkgs.caddy}/bin/caddy reload --config "''${SOVEREIGN_HOME}/Caddyfile"
    '';

    prefetch-beellama.exec = ''
      ${pkgs.nix-prefetch-git}/bin/nix-prefetch-git --url https://github.com/Anbeeld/beellama.cpp --rev b9829
    '';

    prefetch-hfhub.exec = ''
      ${pkgs.nix-prefetch-git}/bin/nix-prefetch-git --url https://github.com/huggingface/huggingface_hub --rev v1.21.0
    '';
  };

  enterShell = ''
    mkdir -p "''${SOVEREIGN_HOME}/.state" "''${SOVEREIGN_HOME}/models/hf" "''${SOVEREIGN_HOME}/.prometheus"

    cat > "''${SOVEREIGN_HOME}/Caddyfile" <<EOF
    :80 {
      handle /health { respond "OK" 200 }
      handle /hf/* { reverse_proxy localhost:''${HF_DOWNLOADER} }
      handle /herder/* { reverse_proxy localhost:''${LLAMA_HERDER} }
      handle /landing/* { reverse_proxy localhost:''${LANDING_PAGE} }
      handle /fang/* { reverse_proxy localhost:''${OPENFANG_PORT} }
      handle /cot/* { reverse_proxy localhost:''${NFCOT_PORT} }
      handle /rank/* { reverse_proxy localhost:''${RANK_PORT} }
      handle /api/* { reverse_proxy localhost:''${RANK_PORT} }
      handle /llm/* { reverse_proxy localhost:''${LLAMA_PORT} }
      handle /* { reverse_proxy localhost:''${LLAMA_PORT} }
    }
    EOF

    if command -v ${pkgs.cudaPackages.cuda_nvml_dev}/bin/nvidia-smi &>/dev/null; then
      echo "  GPU: $(${pkgs.cudaPackages.cuda_nvml_dev}/bin/nvidia-smi --query-gpu=name --format=csv,noheader | head -1)"
      echo "  VRAM: $(${pkgs.cudaPackages.cuda_nvml_dev}/bin/nvidia-smi --query-gpu=memory.total --format=csv,noheader | head -1)"
    else
      echo "  WARNING: nvidia-smi not found"
    fi

    echo ""
    echo "╔══════════════════════════════════════════════════════════════╗"
    echo "║     SOVEREIGN STACK — June 2026 Edition                      ║"
    echo "╠══════════════════════════════════════════════════════════════╣"
    echo "║  Landing:       http://localhost:''${LANDING_PAGE}              ║"
    echo "║  HF Downloader: http://localhost:''${HF_DOWNLOADER}           ║"
    echo "║  LlamaHerder:  http://localhost:''${LLAMA_HERDER}               ║"
    echo "║  llama-server: http://127.0.0.1:''${LLAMA_SERVER}              ║"
    echo "║  OpenFang:      ''${OPENFANG_LISTEN:-127.0.0.1:25004}         ║"
    echo "║  NF-CoT:       http://localhost:''${NFCOT_PORT}               ║"
    echo "║  Prometheus:    http://localhost:''${PROMETHEUS_PORT}           ║"
    echo "║  Grafana:       http://localhost:3000                          ║"
    echo "╚══════════════════════════════════════════════════════════════╝"
  '';

  git-hooks = {
    hooks = {
      nixfmt.enable = true;
      statix.enable = true;
    };
  };
}

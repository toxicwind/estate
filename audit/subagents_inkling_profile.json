{
  "description": "Subagent profile configuration for inkling model with full effort conditioning and multimodal support",
  "model": "thinkingmachines/inkling",
  "provider": "nvidia",
  "context_window": 1048576,
  "max_tokens": 16384,
  "effort": {
    "default": 0.9,
    "presets": {
      "none": 0.0,
      "minimal": 0.1,
      "low": 0.2,
      "medium": 0.7,
      "high": 0.9,
      "xhigh": 0.99
    },
    "description": "Thinking effort level - inserts system message via TmlV0Renderer. Never write this message yourself."
  },
  "multimodal": {
    "text": { "encoding": "utf-8" },
    "image": { "formats": ["PNG", "JPEG"], "minDim": 40, "maxDim": 4096 },
    "audio": { "formats": ["WAV", "MP3", "FLAC"], "sampleRate": 16000, "maxDurationMin": 20 }
  },
  "renderer": {
    "name": "tml_v0",
    "package": "tml-renderers",
    "requiresTorch": ">=2.10",
    "effortSystemMessage": true,
    "supportsPrefill": false
  },
  "subagents": {
    "researcher": {
      "effort": 0.99,
      "max_tokens": 16384,
      "description": "Deep research with maximum reasoning effort"
    },
    "analyzer": {
      "effort": 0.7,
      "max_tokens": 8192,
      "description": "Code analysis with medium effort"
    },
    "coder": {
      "effort": 0.9,
      "max_tokens": 16384,
      "description": "Code generation with high effort"
    }
  },
  "features": {
    "reasoning_effort": true,
    "multimodal": true,
    "tool_use": true,
    "agentic": true,
    "context_1m": true
  },
  "source": {
    "config": "vendor/tinker-cookbook (thinking-machines-lab/tinker-cookbook)",
    "model_config": "packages/ai/src/providers/models/inkling/config.json",
    "benchmarks": "vendor/modelbeats/data/results/*.csv",
    "benchmark_harbor": "vendor/terminal-bench (harbor-framework/terminal-bench)"
  }
}

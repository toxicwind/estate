#!/usr/bin/env bash
# mise run up  |  SOVEREIGN_PROFILE=full mise run up
# Starts owned hot-reload services (default profile: sovereign).
set -euo pipefail
source "$(dirname "$0")/_lib.sh"
# shellcheck source=../../stack/profiles.sh
source "$SOV/stack/profiles.sh"

PROFILE="${SOVEREIGN_PROFILE:-sovereign}"
mapfile -t MODS < <(stack_profile_modules "$PROFILE")

echo "{\"event\":\"up_start\",\"profile\":\"$PROFILE\",\"modules\":\"${MODS[*]}\",\"timestamp\":\"$(date -Iseconds)\"}"

# Optional: regenerate full process-compose.yaml for humans/status (not used by pc_up)
if [[ -x "$SOV/stack/build-compose.sh" ]]; then
  "$SOV/stack/build-compose.sh" >/dev/null || true
fi

# Detached process-compose with only selected modules
pc_up "${MODS[@]}"

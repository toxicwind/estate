#!/usr/bin/env bash
# mise run up — start core daemons via pitchfork.
set -euo pipefail
export SOV="${SOVEREIGN_ROOT:-$PWD}"
cd "$SOV"

command -v pitchfork >/dev/null || {
  echo "pitchfork missing — run: mise install" >&2
  exit 1
}

mkdir -p "$SOV/.state/logs"
echo "{\"event\":\"up_start\",\"backend\":\"pitchfork\",\"group\":\"core\",\"timestamp\":\"$(date -Iseconds)\"}"
pitchfork start --group core
pitchfork list

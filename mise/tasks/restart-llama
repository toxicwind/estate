#!/usr/bin/env bash
# mise run restart-llama — restart the LLM serving daemon.
# 2026-09-20: was `pitchfork restart bornite` but no daemon named
# bornite exists (renamed to bornite long ago). Now uses the owned
# pitchfork-restart wrapper, which reconciles against the port.
set -euo pipefail
cd "${ESTATE_ROOT:-/home/toxic/Estate}"
exec ./bin/pitchfork-restart Estate/bornite

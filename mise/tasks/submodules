#!/usr/bin/env bash
# mise run submodules → REPLACED by `mise run peers` (2026-10-28 desubmodule cutover)
#
# Estate doctrine: zero submodules (docs/REPO_TOPOLOGY.md "Rule - no gitlinks").
# The old task synced gitlink submodules in ranch/ + advanced estate's ranch
# pointer. Both concepts are retired:
#   * peers are independent checkouts with their own origin (pens/.../products/)
#   * cross-pen sync = `git fetch && git merge --ff-only` per peer, or the
#     fleet todo board — never pointer-advancing.
#
# This task syncs every peer checkout under the pens products/ roots:
#   pens/ranch/<peer>, pens/estate/products/<peer>, pens/geode/products/<peer>,
#   pens/barn/*, pens/olympus/products/<peer>
set -uo pipefail

echo "⚡ [peers-sync] syncing peer checkouts across pens..."

PENS=/home/toxic/pens
declare -a ROOTS=(
  "$PENS/ranch"
  "$PENS/estate/products"
  "$PENS/geode/products"
  "$PENS/olympus/products"
  "$PENS/barn"
)

dirty=0
for root in "${ROOTS[@]}"; do
  [ -d "$root" ] || continue
  for peer in "$root"/*/; do
    [ -d "$peer/.git" ] || continue
    name=$(basename "$peer")
    branch=$(git -C "$peer" branch --show-current 2>/dev/null || echo "")
    [ -n "$branch" ] || continue
    ahead=$(git -C "$peer" rev-list --count "$branch..@{upstream}" 2>/dev/null || echo 0)
    if [ "${ahead:-0}" -gt 0 ]; then
      echo "  ⬇ $name: $ahead behind — fast-forwarding"
      git -C "$peer" merge --ff-only "@{upstream}" 2>&1 | head -2
      dirty=1
    else
      echo "  ✅ $name up to date"
    fi
  done
done

[ "$dirty" -eq 0 ] && echo "✅ [peers-sync] all peers up to date."
exit 0
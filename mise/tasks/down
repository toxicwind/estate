#!/usr/bin/env bash
# mise run down — stop core daemons via pitchfork with robust checks.
set -euo pipefail
export SOV="${SOVEREIGN_ROOT:-$PWD}"
cd "$SOV"

echo "--- Mise Run Down: Stopping Core Daemons ---"
echo "Timestamp: $(date -Iseconds)"

if ! command -v pitchfork >/dev/null; then
  echo "INFO: pitchfork not on PATH; nothing to stop via pitchfork" >&2
  exit 0
fi

echo "INFO: Stopping pitchfork core group..."
pitchfork stop --group core

echo "INFO: Pitchfork stop command initiated. Verifying service termination..."

echo "--- Mise Run Down: Final Pitchfork Status ---"
pitchfork list

echo "--- Mise Run Down: Port Check ---"
# 2026-09-20: ports derived live from pitchfork.toml (old list was stale —
# it missed 25122/25146/25152/25153/25201/25202 and others).
PORTS=$(grep -oP 'ready_http\s*=\s*"http://[^:]+:\K[0-9]+' pitchfork.toml | sort -u | paste -sd"|" -)
if [[ -n "$PORTS" ]] && ss -tlnp 2>/dev/null | grep -E "(${PORTS})" >/dev/null; then
  echo "WARNING: Some sovereign service ports are still open. Manual intervention may be required." >&2
  ss -tlnp 2>/dev/null | grep -E "(${PORTS})" >&2 || true
  exit 1
else
  echo "INFO: All sovereign service ports appear to be closed."
fi

echo "--- Mise Run Down: Completed ---"

#!/usr/bin/env bash
# mise run down — stop sovereign pitchfork daemons.
set -euo pipefail
export SOV="${SOVEREIGN_ROOT:-$PWD}"
cd "$SOV"

if ! command -v pitchfork >/dev/null; then
  echo "pitchfork not on PATH; nothing to stop via pitchfork" >&2
  exit 0
fi

# Prefer group stop; fall back to all configured sovereign daemons
if pitchfork stop --group core 2>/dev/null; then
  :
else
  pitchfork stop llama-swap openfang ast-matrix null-g-proxy yote rust-web hf-downloader ghas-api 2>/dev/null || true
fi
pitchfork stop --group obs 2>/dev/null || true
pitchfork stop --group net 2>/dev/null || true
pitchfork clean 2>/dev/null || true
pitchfork list || true
echo "{\"event\":\"down_done\",\"backend\":\"pitchfork\",\"timestamp\":\"$(date -Iseconds)\"}"

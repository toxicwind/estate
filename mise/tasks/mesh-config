#!/usr/bin/env bash
# mise run mesh-config — manage mesh (MCP gateway) server config
# Uses config at /home/toxic/projects/sovereign-projects/mesh/gateway/config/mesh_config.json
set -euo pipefail

MESH_CONFIG="${MESH_CONFIG:-/home/toxic/projects/sovereign-projects/mesh/gateway/config/mesh_config.json}"

usage() {
  cat <<EOF
Usage: mise run mesh-config <command> [args]

Commands:
  show                    Show current config summary
  enable-all              Enable all servers (enabled=true, quarantined=false)
  disable-server <name>   Disable a specific server
  enable-server <name>    Enable a specific server
  quarantine-server <name> Quarantine a server (security isolation)
  unquarantine-server <name> Remove quarantine from server
  enable-code-exec        Enable code execution (enable_code_execution=true)
  disable-code-exec       Disable code execution
  enable-management       Enable management API (disable_management=false)
  disable-management      Disable management API (disable_management=true)
  backup                  Create timestamped backup
  restore <backup-file>   Restore from backup
  restart                 Restart mesh daemon
  health                  Check mesh health
EOF
}

case "${1:-}" in
  show)
    echo "=== mesh config: $MESH_CONFIG ==="
    cat "$MESH_CONFIG" | jq -r '
      "listen: \(.listen)",
      "api_key: \(.api_key[0:8])...",
      "enable_code_execution: \(.enable_code_execution)",
      "disable_management: \(.disable_management)",
      "read_only_mode: \(.read_only_mode)",
      "tools_limit: \(.tools_limit)",
      "servers: \(.mcpServers | length)",
      "",
      "Servers:",
      (.mcpServers | map("  \(.name): enabled=\(.enabled) quarantined=\(.quarantined)") | .[])'
    ;;

  enable-all)
    echo "Enabling all servers..."
    jq '.mcpServers |= map(.enabled = true | .quarantined = false)' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Done. Run 'mise run mesh-config restart' to apply."
    ;;

  disable-server)
    server="${2:-}"
    [[ -z "$server" ]] && { echo "Usage: mise run mesh-config disable-server <name>"; exit 1; }
    jq --arg s "$server" '.mcpServers |= map(if .name == $s then .enabled = false else . end)' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Disabled $server. Run 'mise run mesh-config restart' to apply."
    ;;

  enable-server)
    server="${2:-}"
    [[ -z "$server" ]] && { echo "Usage: mise run mesh-config enable-server <name>"; exit 1; }
    jq --arg s "$server" '.mcpServers |= map(if .name == $s then .enabled = true else . end)' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Enabled $server. Run 'mise run mesh-config restart' to apply."
    ;;

  quarantine-server)
    server="${2:-}"
    [[ -z "$server" ]] && { echo "Usage: mise run mesh-config quarantine-server <name>"; exit 1; }
    jq --arg s "$server" '.mcpServers |= map(if .name == $s then .quarantined = true else . end)' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Quarantined $server. Run 'mise run mesh-config restart' to apply."
    ;;

  unquarantine-server)
    server="${2:-}"
    [[ -z "$server" ]] && { echo "Usage: mise run mesh-config unquarantine-server <name>"; exit 1; }
    jq --arg s "$server" '.mcpServers |= map(if .name == $s then .quarantined = false else . end)' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Unquarantined $server. Run 'mise run mesh-config restart' to apply."
    ;;

  enable-code-exec)
    jq '.enable_code_execution = true' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Code execution enabled. Run 'mise run mesh-config restart' to apply."
    ;;

  disable-code-exec)
    jq '.enable_code_execution = false' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Code execution disabled. Run 'mise run mesh-config restart' to apply."
    ;;

  enable-management)
    jq '.disable_management = false' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Management API enabled. Run 'mise run mesh-config restart' to apply."
    ;;

  disable-management)
    jq '.disable_management = true' "$MESH_CONFIG" > "$MESH_CONFIG.tmp" && mv "$MESH_CONFIG.tmp" "$MESH_CONFIG"
    echo "Management API disabled. Run 'mise run mesh-config restart' to apply."
    ;;

  backup)
    cp "$MESH_CONFIG" "$MESH_CONFIG.backup.$(date +%s)"
    echo "Backed up to $MESH_CONFIG.backup.$(date +%s)"
    ;;

  restore)
    backup="${2:-}"
    [[ -z "$backup" ]] && { echo "Usage: mise run mesh-config restore <backup-file>"; exit 1; }
    cp "$backup" "$MESH_CONFIG"
    echo "Restored from $backup. Run 'mise run mesh-config restart' to apply."
    ;;

  restart)
    echo "Restarting mesh daemon..."
    cd /home/toxic/sovereign
    pitchfork stop mesh 2>/dev/null || true
    sleep 2
    pitchfork start mesh
    echo "mesh restarted"
    ;;

  health)
    curl -sf http://127.0.0.1:25127/health && echo " ✓ healthy" || echo " ✗ unhealthy"
    ;;

  *)
    usage
    exit 1
    ;;
esac

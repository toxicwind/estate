#!/usr/bin/env bash
set -euo pipefail
SOV="${SOVEREIGN_ROOT:-$PWD}"
PORT="${RUST_WEB_PORT:-25101}"
cd "$SOV/rust_algo_web"
cargo build --release 2>&1 | tail -20
pkill -f "sovereign_web|sovereign_devops|rust_algo_web" 2>/dev/null || true
fuser -k "${PORT}/tcp" 2>/dev/null || true
sleep 0.5
export RUST_WEB_PORT="$PORT" LLM_PROXY_URL="${LLM_PROXY_URL:-http://127.0.0.1:25100}" WATCHDOG_PORT="${WATCHDOG_PORT:-25104}"
nohup "$SOV/stack/services/rust-web.sh" >>"$SOV/.state/logs/rust-web.log" 2>&1 &
for i in $(seq 1 20); do
  curl -sf --max-time 1 "http://127.0.0.1:${PORT}/health" && { echo " rust-web :${PORT} up"; exit 0; }
  sleep 0.5
done
echo "rust-web health timeout" >&2
exit 1

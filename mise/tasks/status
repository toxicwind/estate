#!/usr/bin/env bash
# MISE description="Process list and quick port bindings"
set -euo pipefail

if command -v process-compose >/dev/null; then
  process-compose --address 127.0.0.1 ps 2>/dev/null || true
else
  echo "process-compose not running"
fi

echo ""
echo "Quick port bindings:"
for port in "$LLAMA_HERDER" "$OPENFANG_PORT" "$PROMETHEUS_PORT" "$YOTE_PORT" "$RUST_WEB_PORT"; do
  if ss -tlnp 2>/dev/null | grep -q ":${port} "; then
    echo "  :${port} bound"
  else
    echo "  :${port} free"
  fi
done

#!/usr/bin/env bash
# Probe 25xxx services. Core required services fail the task; optional are labeled.
set -euo pipefail

CORE_FAIL=0
OPTIONAL_FAIL=0

probe() {
  local kind="$1" name="$2" port="$3" path="$4"
  local url="http://127.0.0.1:${port}${path}"
  printf "%-10s %-16s :%-5s " "$kind" "$name" "$port"
  if curl -sf --max-time 3 "$url" >/dev/null 2>&1; then
    echo ok
  else
    echo fail
    if [[ "$kind" == "CORE" ]]; then
      CORE_FAIL=$((CORE_FAIL + 1))
    else
      OPTIONAL_FAIL=$((OPTIONAL_FAIL + 1))
    fi
  fi
}

# Core (up-core): llama-swap, openfang, prometheus, rust-web
# watchdog is embedded in rust-web (same binary, extra port)
probe CORE llama-swap   "${LLAMA_SWAP_PORT:-25100}"  /health
probe CORE rust-web     "${RUST_WEB_PORT:-25101}"    /health
probe CORE openfang     "${OPENFANG_PORT:-25103}"    /api/health
probe CORE prometheus   "${PROMETHEUS_PORT:-25105}"  /-/healthy
probe CORE watchdog     "${WATCHDOG_PORT:-25104}"    /health

# Standard `up` extras
probe OPT  yote         "${YOTE_PORT:-25102}"        /health
probe OPT  hf-downloader "${HF_DOWNLOADER_PORT:-25106}" /api/health

# Edge only in up-full
probe OPT  caddy-edge   "${CADDY_PORT:-25000}"       /health

echo "---"
echo "core_fail=${CORE_FAIL} optional_fail=${OPTIONAL_FAIL}"
if [[ "$CORE_FAIL" -gt 0 ]]; then
  echo "HEALTH: CORE RED"
  exit 1
fi
echo "HEALTH: CORE GREEN"
exit 0

#!/usr/bin/env bash
source "$(dirname "$0")/_lib.sh"

results=()

check_service() {
    local name=$1 url=$2
    if curl -sf "$url" >/dev/null 2>&1; then
        results+=('{"name":"'"$name"'","url":"'"$url"'","healthy":true}')
        return 0
    else
        results+=('{"name":"'"$name"'","url":"'"$url"'","healthy":false}')
        return 1
    fi
}

check_service "llama-swap" "http://127.0.0.1:25100/health" || true
check_service "llama-swap-models" "http://127.0.0.1:25100/v1/models" || true
check_service "ast-matrix" "http://127.0.0.1:25104/health" || true
check_service "ast-matrix-models" "http://127.0.0.1:25104/v1/models" || true
check_service "process-compose" "http://127.0.0.1:25108/" || true
check_service "rust-web" "http://127.0.0.1:25101/health" || true
check_service "watchdog" "http://127.0.0.1:25111/health" || true
check_service "yote" "http://127.0.0.1:25102/health" || true
check_service "openfang" "http://127.0.0.1:25103/api/health" || true
check_service "null-g-proxy" "http://127.0.0.1:25107/health" || true
check_service "hf-downloader" "http://127.0.0.1:25106/health" || true
# ghas-api default PORT 3001 (apps/api)
check_service "ghas-api" "http://127.0.0.1:3001/health" || true
check_service "ghas-api-root" "http://127.0.0.1:3001/" || true

# Output as JSON array
echo "["
for i in "${!results[@]}"; do
    if [ $i -eq $((${#results[@]} - 1)) ]; then
        echo "  ${results[$i]}"
    else
        echo "  ${results[$i]},"
    fi
done
echo "]"
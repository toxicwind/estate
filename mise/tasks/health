#!/usr/bin/env bash
# Health probes — ports from config/ports.env (via mise env).
set -euo pipefail
source "$(dirname "$0")/_lib.sh" 2>/dev/null || true
cd "${SOVEREIGN_ROOT:-/home/toxic/sovereign}"

# Load ports if not already in env
if [ -z "${LLAMA_SWAP_PORT:-}" ] && [ -f config/ports.env ]; then
  set -a
  # shellcheck disable=SC1091
  source config/ports.env
  set +a
fi

: "${LLAMA_SWAP_PORT:?set in config/ports.env}"
: "${AST_MATRIX_PORT:?set in config/ports.env}"
: "${RUST_WEB_PORT:?set in config/ports.env}"
: "${WATCHDOG_PORT:?set in config/ports.env}"
: "${YOTE_PORT:?set in config/ports.env}"
: "${OPENFANG_PORT:?set in config/ports.env}"
: "${NULL_G_PORT:?set in config/ports.env}"
: "${HF_DOWNLOADER_PORT:?set in config/ports.env}"
: "${GHAS_API_PORT:?set in config/ports.env}"

results=()
fail=0

check_service() {
  local name=$1 url=$2
  if curl -sf --max-time 2 "$url" >/dev/null 2>&1; then
    results+=("{\"name\":\"${name}\",\"url\":\"${url}\",\"healthy\":true}")
    printf '✓ %s\n' "$name"
    return 0
  else
    results+=("{\"name\":\"${name}\",\"url\":\"${url}\",\"healthy\":false}")
    printf '✗ %s\n' "$name"
    fail=1
    return 1
  fi
}

echo "=== pitchfork ==="
if command -v pitchfork >/dev/null; then
  pitchfork list 2>/dev/null || true
else
  echo "(pitchfork not on PATH)"
fi
echo
echo "=== HTTP ==="
check_service "llama-swap" "http://127.0.0.1:${LLAMA_SWAP_PORT}/health" || true
check_service "llama-swap-models" "http://127.0.0.1:${LLAMA_SWAP_PORT}/v1/models" || true
check_service "ast-matrix" "http://127.0.0.1:${AST_MATRIX_PORT}/health" || true
check_service "rust-web" "http://127.0.0.1:${RUST_WEB_PORT}/health" || true
check_service "watchdog" "http://127.0.0.1:${WATCHDOG_PORT}/health" || true
check_service "yote" "http://127.0.0.1:${YOTE_PORT}/health" || true
check_service "openfang" "http://127.0.0.1:${OPENFANG_PORT}/api/health" || true
check_service "null-g-proxy" "http://127.0.0.1:${NULL_G_PORT}/health" || true
check_service "hf-downloader" "http://127.0.0.1:${HF_DOWNLOADER_PORT}/health" || true
check_service "ghas-api" "http://127.0.0.1:${GHAS_API_PORT}/health" || true

echo
echo "["
for i in "${!results[@]}"; do
  if [ "$i" -eq $((${#results[@]} - 1)) ]; then
    echo "  ${results[$i]}"
  else
    echo "  ${results[$i]},"
  fi
done
echo "]"
exit "$fail"

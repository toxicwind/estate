#!/usr/bin/env bash
# mise run health — LLM-friendly health probes.
# Fully dynamic: reads ready_http / ready_cmd from pitchfork.toml.
set -euo pipefail
export SOV="${SOVEREIGN_ROOT:-$PWD}"
cd "$SOV"

# Source ports
set -a
[[ -f "$SOV/config/ports.env" ]] && source "$SOV/config/ports.env"
set +a

# --- helper ---
_probe() {
  local name=$1 http=$2 cmd=$3
  if [[ -n "$http" ]]; then
    local resolved
    resolved=$(echo "$http" | sed -E 's/\$\{([A-Z_]+):-([^}]+)\}/\2/g')
    total=$((total+1))
    if curl -sf --max-time 2 "$resolved" >/dev/null 2>&1; then
      printf '✓ %-20s %s\n' "$name" "$resolved"
      ok=$((ok+1))
    else
      printf '✗ %-20s %s\n' "$name" "$resolved"
      fail=$((fail+1))
    fi
  elif [[ -n "$cmd" ]]; then
    local resolved
    resolved=$(echo "$cmd" | sed -E 's/\$\{([A-Z_]+):-([^}]+)\}/\2/g')
    total=$((total+1))
    if eval "$resolved" >/dev/null 2>&1; then
      printf '✓ %-20s (cmd)\n' "$name"
      ok=$((ok+1))
    else
      printf '✗ %-20s (cmd)\n' "$name"
      fail=$((fail+1))
    fi
  fi
}

echo "=== pitchfork ==="
if command -v pitchfork >/dev/null; then
  pitchfork list 2>/dev/null || true
else
  echo "(pitchfork not on PATH)"
fi

echo
echo "=== health ==="

ok=0; fail=0; total=0
daemon_name=""
ready_http=""; ready_cmd=""

while IFS= read -r line; do
  if [[ "$line" =~ ^\[daemons\.([a-zA-Z0-9_-]+)\] ]]; then
    # New daemon section - probe previous one first
    if [[ -n "$daemon_name" ]]; then
      _probe "$daemon_name" "$ready_http" "$ready_cmd"
    fi
    daemon_name="${BASH_REMATCH[1]}"
    ready_http=""; ready_cmd=""
    continue
  fi

  # Check for ready_http / ready_cmd
  if [[ "$line" =~ ready_http\ =\ \"(.+)\" ]]; then
    ready_http="${BASH_REMATCH[1]}"
  elif [[ "$line" =~ ready_cmd\ =\ \"(.+)\" ]]; then
    ready_cmd="${BASH_REMATCH[1]}"
  fi
done < "$SOV/pitchfork.toml"

# Flush last
if [[ -n "$daemon_name" ]]; then
  _probe "$daemon_name" "$ready_http" "$ready_cmd"
fi

echo
echo "=== summary ==="
echo "up: $ok  down: $fail  total: $total"
[[ $fail -eq 0 ]] && echo "ALL HEALTHY" || echo "DEGRADED — $fail service(s) down"
exit "$fail"

#!/usr/bin/env python3\
"""\
Max context search / model comparison sweeper\
Uses llama-batched-bench with your known-good settings.\
"""\
\
import subprocess\
import pathlib\
import json\
import os\
import time\
\
HOME = pathlib.Path("/home/toxic")\
MODEL = HOME / "models" / "Qwen3.6-27B-Heretic-UD" / "heretic-UD-27B-Q5_K_XL.gguf"\
BENCH = HOME / "sovereign" / "bin" / "llama-batched-bench"\
\
CONTEXTS = [4096, 8192, 16384, 32768, 65536]   # edit this list\
REPS = 2\
BATCH = 1024\
\
def vram():\
    try:\
        out = subprocess.check_output(\
            ["nvidia-smi", "--query-gpu=memory.used,memory.total", "--format=csv,noheader,nounits"],\
            text=True\
        ).strip()\
        u, t = [int(x) for x in out.split(",")]\
        return f"{u}/{t} MiB"\
    except:\
        return "n/a"\
\
print("=== Max Context Sweep ===\n")\
print(f"Model: {MODEL.name}")\
print(f"Fixed flags: ngl=99, KV=q4_0, flash=on, batch={BATCH}\n")\
\
results = []\
\
for ctx in CONTEXTS:\
    cmd = [\
        str(BENCH),\
        "-m", str(MODEL),\
        "-ngl", "99",\
        "-c", str(ctx),\
        "-fa",\
        "--cache-type-k", "q4_0",\
        "--cache-type-v", "q4_0",\
        "-b", str(BATCH),\
        "-ub", "512",\
        "-n", "128",\
        "-r", str(REPS),\
    ]\
\
    print(f">>> Testing ctx={ctx}")\
    v_before = vram()\
    t0 = time.time()\
    proc = subprocess.run(cmd, capture_output=True, text=True)\
    elapsed = time.time() - t0\
\
    if proc.returncode != 0:\
        print("    OOM or failed\n")\
        results.append({"ctx": ctx, "status": "FAIL", "pp": "-", "tg": "-", "vram": v_before})\
        continue\
\
    # Try to extract numbers from output (simple parse)\
    pp = tg = "?"\
    for line in proc.stdout.splitlines():\
        if "pp/s" in line.lower() or "prompt" in line.lower():\
            # crude extraction ‚ÄÉ≥ adjust if needed\
            pass\
        if "tg/s" in line.lower() or "generation" in line.lower():\
            pass\
\
    v_after = vram()\
    print(f"    Done in {elapsed:.1f}s | VRAM: {v_after}\n")\
\
    results.append({\
        "ctx": ctx,\
        "status": "OK",\
        "pp": pp,\
        "tg": tg,\
        "vram": v_after,\
        "time": round(elapsed, 1)\
    })\
\
print("\n=== Results ===")\
print(f"{'ctx':>8} {'status':<6} {'pp/s':>8} {'tg/s':>8} {'VRAM':>14} {'time':>6}")\
print("-" * 55)\
for r in results:\
    print(f"{r['ctx']:>8} {r['status']:<6} {r['pp']:>8} {r['tg']:>8} {r['vram']:>14} {r['time']:>5.1f}s")\

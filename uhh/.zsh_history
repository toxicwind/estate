  python3 - "$CFG" <<'PY' || echo "python yaml patch failed, trying text patch"\
import sys\
cfg=sys.argv[1]\
maps={\
 "MODEL_PLACEHOLDER_M20":"beellama/qwen-flash-128k",\
 "MODEL_PLACEHOLDER_M16":"beellama/qwen-flash-64k",\
 "MODEL_PLACEHOLDER_M132":"beellama/qwen-flash-128k",\
 "gemini-1.5-pro":"beellama/qwen-flash-128k",\
 "gemini-1.5-flash":"beellama/qwen-flash-64k",\
 "llama":"beellama/qwen-flash-96k",\
}\
try:\
  import yaml\
  d=yaml.safe_load(open(cfg)) or {}\
  a=d.get("aliases") or {}\
  a.update(maps)\
  d["aliases"]=a\
  open(cfg,"w").write(yaml.safe_dump(d, sort_keys=False))\
  print("yaml patched ok")\
  raise SystemExit(0)\
except Exception as e:\
  print(f"yaml lib failed {e}, fallback to text")\
txt=open(cfg).read()\
if "aliases:" not in txt:\
  txt+="\naliases:\n"\
for k,v in maps.items():\
  if f'"{k}"' not in txt and f"'{k}'" not in txt and f"{k}:" not in txt:\
    txt+=f' "{k}": "{v}"\n'\
open(cfg,"w").write(txt)\
print("text patched ok")\
PY\

\
def kill_server():\
    """Kill any existing llama-server processes."""\
    subprocess.run(["pkill", "-9", "-f", "llama-server"], capture_output=True)\
    time.sleep(0.5)\
\
def test_context(ctx: int, cache_k: str = "q4_0", cache_v: str = "q4_0") -> tuple[bool, str]:\
    """\
    Test if llama-server can start with given context size.\
    Returns: (success: bool, info: str)\
    """\
    kill_server()\
\
    cmd = [\
        str(SERVER),\
        "-m", str(MODEL),\
        "--mmproj", str(MMPROJ),\
        "-c", str(ctx),\
        "-ngl", "99",\
        "-fa", "1",                    # ‚É¶É∞ FIXED: argument required!\
        "-ctk", cache_k,\
        "-ctv", cache_v,\
        "--host", "127.0.0.1",\
        "--port", str(PORT),\
        "-t", str(os.cpu_count() or 8),\
        "--no-warmup",\
        "--alias", "qwen3.5",\
    ]\
\
    print(f">>> Testing ctx={ctx:>7} (cache={cache_k}/{cache_v})")\
    t0 = time.time()\
\
    try:\
        proc = subprocess.run(\
            cmd,\
            capture_output=True,\
            text=True,\
            timeout=TIMEOUT_SEC\
        )\
    except subprocess.TimeoutExpired:\
        kill_server()\
        return False, f"timeout after {TIMEOUT_SEC}s"\
\
    elapsed = time.time() - t0\
\
    if proc.returncode == 0:\
        # Server started and exited cleanly (probably no request)\
        # But we need to check if it actually loaded or just printed help\
        if "error" in proc.stderr.lower() or "failed" in proc.stderr.lower():\
            return False, f"exit=0 but errors in stderr"\
        return True, f"OK ({elapsed:.1f}s)"\
    else:\
        # Parse stderr for specific errors\
        err = proc.stderr or proc.stdout or ""\
        if "cudaMalloc failed" in err or "out of memory" in err.lower():\
            return False, f"OOM ‚ÄÉ¥ {elapsed:.1f}s"\
        elif "unable to load model" in err.lower():\
            return False, f"Model load failed ‚ÄÉ¥ {elapsed:.1f}s"\
        elif "invalid parameter" in err.lower():\
            return False, f"Invalid parameter ‚ÄÉ¥ {elapsed:.1f}s"\
        else:\
            # Print last 1500 chars for diagnosis\
            diag = err[-1500:] if len(err) > 1500 else err\
            return False, f"exit={proc.returncode} ({elapsed:.1f}s)\\n{diag}"\
\
# ‚É¥Ä‚É¥Ä‚É¥Ä Binary search ‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä\
\
print("\\n=== Binary Search for Max Context ===\\n")\
\
low = MIN_CTX\
high = MAX_CTX\
best = MIN_CTX\
\
# First: verify MIN_CTX works at all\
success, info = test_context(MIN_CTX)\
if not success:\
    print(f"FATAL: Even {MIN_CTX} context fails: {info}")\
    sys.exit(1)\
print(f"    ‚ÉºÉ• {info}")\
best = MIN_CTX\
\
# Binary search\
iteration = 0\
while low + CTX_STEP < high:\
    iteration += 1\
    mid = ((low + high) // 2 // CTX_STEP) * CTX_STEP\
    if mid <= low:\
        mid = low + CTX_STEP\
\
    success, info = test_context(mid)\
    print(f"    {'‚ÉºÉ•' if success else '‚ÉΩÉ¨'} {info}")\
\
    if success:\
        best = mid\
        low = mid\
    else:\
        high = mid\
\
# Final verification\
print(f"\\n=== Final Verification: ctx={best} ===")\
success, info = test_context(best)\
print(f"    {'‚ÉºÉ•' if success else '‚ÉΩÉ¨'} {info}")\
\
if success:\
    print(f"\\nÉøÉÆØ MAX WORKING CONTEXT: {best:,} tokens")\
else:\
    # Walk down if flaky\
    print("Flaky result, walking down...")\
    while best > MIN_CTX:\
        best -= CTX_STEP\
        success, info = test_context(best)\
        print(f"    ctx={best}: {'‚ÉºÉ•' if success else '‚ÉΩÉ¨'} {info}")\
        if success:\
            break\
    print(f"\\nÉøÉÆØ MAX WORKING CONTEXT (conservative): {best:,} tokens")\
\
kill_server()\
'''\

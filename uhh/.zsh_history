#!/usr/bin/env bun\
/**\
 * repo-archiver.ts ‚ÄÉ¥ Self-contained (tar + gzip)\
 */\
\
import { $ } from "bun";\
import { mkdirSync, existsSync, writeFileSync } from "fs";\
import { join } from "path";\
\
const HOME = "/home/toxic";\
const BASE = join(HOME, "projects", "repo-archives");\
const ARCHIVES = join(BASE, "archives");\
const WORK = join(BASE, "work");\
\
const REPOS: string[] = [\
  "richstokes/Forza-data-tools",\
  "rathansai-dev/vehicle-project",\
  "roypeter/esp32-obd2-logger",\
  "Sanjayt215/Fleet-Nimble",\
  "gaugelabsinc/obdfrontend",\
  "TheBanHammer/fh6-tel",\
  "jasperan/forza-horizon-5-telemetry-listener",\
  "austinbaccus/forza-telemetry",\
  "open-vehicle-control-system/ovcs",\
  "badgerloop-software/chase-car-dashboard",\
  "ABD-Z/2d-car-dashboard",\
  "jkuri/d3-car-dashboard",\
  "speed785/open-mechanic",\
  "iUnreallx/ReDrive",\
  "alexanderzobnin/grafana-simracing-telemetry",\
  "microsoft/fabric-racing-sim",\
  "vishnuskandha/Vehicle-Telemetry",\
  "donbowman/obd2-dashboard",\
  "shift.infinite.red/beyond-60-fps",\
  "terror/liam.rs",\
  "momentic-ai/momentic",\
];\
\
async function archiveOne(repo: string) {\
  const [owner, name] = repo.split("/");\
  const ts = Date.now();\
  const workDir = join(WORK, `\( {owner}- \){name}-${ts}`);\
  const baseName = `\( {owner}- \){name}-${ts}`;\
\
  console.log(`\n‚É¶É≤ ${repo}`);\
\
  if (!existsSync(workDir)) {\
    mkdirSync(workDir, { recursive: true });\
    await \( `git clone --depth 1 https://github.com/ \){repo}.git ${workDir}`.quiet();\
  } else {\
    console.log(`   (skipping clone)`);\
  }\
\
  // Self-contained: tar + gzip\
  await $`tar -czf ${baseName}.tar.gz -C ${workDir} .`.quiet();\
\
  mkdirSync(ARCHIVES, { recursive: true });\
  await $`mv ${baseName}.tar.gz \( {ARCHIVES}/ \){baseName}.0001`.quiet();\
\
  // Simple decode helper\
  const decode = `#!/usr/bin/env bash\ngunzip -c "$1" > "$2"\necho "Decoded $1 -> $2"`;\
  writeFileSync(join(ARCHIVES, `${baseName}-decode.sh`), decode);\
  await $`chmod +x \( {join(ARCHIVES, ` \){baseName}-decode.sh`)}`.quiet();\
\
  if (existsSync(workDir)) await $`rm -rf ${workDir}`.quiet();\
\
  console.log(`   ‚ÉºÉ≥ ${baseName}.0001 + decode.sh`);\
  return { repo, github: `https://github.com/\( {repo}`, compressed: ` \){baseName}.0001`, decode: `${baseName}-decode.sh`, ts };\
}\
\
async function main() {\
  console.log("=== PITWALL Repo Archiver ===");\
  mkdirSync(BASE, { recursive: true });\
  mkdirSync(ARCHIVES, { recursive: true });\
  mkdirSync(WORK, { recursive: true });\
\
  const results = [];\
  for (const r of REPOS) results.push(await archiveOne(r));\
\
  const zipName = `pitwall-repos-${Date.now()}.zip`;\
  const zipPath = join(BASE, zipName);\
  await $`cd ${ARCHIVES} && zip -r ${zipPath} .`.quiet();\
\
  const manifest = {\
    generated: new Date().toISOString(),\
    brand: "PITWALL",\
    total: results.length,\
    zip: zipPath,\
    archives: ARCHIVES,\
    repos: results,\
  };\
  writeFileSync(join(BASE, "manifest.json"), JSON.stringify(manifest, null, 2));\
\
  console.log(`\n‚ÉºÉ• Done`);\
  console.log(`zip: ${zipPath}`);\
  console.log(`manifest: ${join(BASE, "manifest.json")}`);\
}\
\
main().catch(console.error);\
ENDSCRIPT\
\

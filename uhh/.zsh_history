# 1. Check what's up\
cd ~/sovereign && mise run status\
\
# 2. Restart everything\
cd ~/sovereign && mise run up\
\
# 3. Verify health\
cd ~/sovereign && mise run health\

# Create and enable systemd unit\
sudo tee /etc/systemd/system/mcpproxy.service << 'EOF'\
[Unit]\
Description=MCPProxy sovereign\
After=network.target\
\
[Service]\
ExecStart=/usr/local/bin/mcpproxy serve --log-level=info\
Restart=always\
RestartSec=5\
WorkingDirectory=/home/toxic\
Environment=HOME=/home/toxic\
\
[Install]\
WantedBy=multi-user.target\
EOF\
\
sudo systemctl daemon-reload\
sudo systemctl enable --now mcpproxy\

sed -i 's/^PITCHFORK_PORT=25108/PITCHFORK_PORT=25108\nMCPPROXY_PORT=25109/' /home/toxic/sovereign/config/ports.env
curl -s -m 2 http://127.0.0.1:25109/health && echo "UP" || echo "DOWN"
mcpproxy serve --log-level=info &\
sleep 2\
curl -s -m 2 http://127.0.0.1:25109/health && echo "UP" || echo "STILL DOWN"\

# Fix ownership\
sudo chown -R toxic:users /home/toxic/.mcpproxy\
chmod 600 /home/toxic/.mcpproxy/mcp_config.json\
\
# Now start mcpproxy\
mcpproxy serve --log-level=info &\
\
sleep 2\
curl -s -m 2 http://127.0.0.1:25109/health && echo "UP" || echo "STILL DOWN"\


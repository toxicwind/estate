#!/usr/bin/env bash\
set -euo pipefail\
\
# sovereign-scan monolithic devenv ‚ÄÉ¥ 251xx only, never touches 25001\
DEV="$HOME/sovereign-scan-devenv"\
mkdir -p "$DEV/www"\
cd "$DEV"\
\
# --- 0) install deps only if missing ---\
install_if_missing() {\
  if ! command -v "$1" >/dev/null 2>&1; then\
    echo "‚É¶É≤ installing $1..."\
    eval "$2"\
  else\
    echo "‚ÉºÉ≥ $1 exists"\
  fi\
}\
\
install_if_missing rustscan "cargo install rustscan --locked"\
install_if_missing naabu "go install github.com/projectdiscovery/naabu/v2/cmd/naabu@latest"\
install_if_missing websocat "cargo install websocat --locked"\
install_if_missing process-compose "go install github.com/F1bonacc1/process-compose@latest"\
install_if_missing node "echo 'install Node 22+ manually' && exit 1"\
if ! npx -y cli2mcp --version >/dev/null 2>&1; then npm i -g cli2mcp; fi\
command -v jq >/dev/null || sudo pacman -Sy --noconfirm jq\
\
# --- 1) write process-compose.yaml ---\
cat > process-compose.yaml <<'YAML'\
version: "0.5"\
processes:\
  scan-ws:\
    command: bash -c 'while true; do naabu -host 127.0.0.1 -top-ports 1000 -json -silent; sleep 30; done | websocat -t ws-l:127.0.0.1:25101 -'\
    availability:\
      restart: on_failure\
\
  dashboard:\
    command: python3 -m http.server 25180 --bind 127.0.0.1\
    working_dir: ./www\
    availability:\
      restart: on_failure\
\
  llama-mcp:\
    command: npx -y cli2mcp llama-server --name llama-server --cwd /home/toxic/sovereign\
    environment:\
      - PORT=25103\
YAML\
\
# --- 2) write dashboard ---\
cat > www/index.html <<'HTML'\
<!doctype html><html><head><meta charset=utf-8><title>sovereign :25180</title>\
<style>html,body{margin:0;background:#050508;color:#9ef;font:13px ui-monospace}\
header{padding:12px 16px;border-bottom:1px solid #1a1a22;color:#0ff}\
main{padding:16px}#log{white-space:pre;opacity:.9}\
.port{color:#0f8}.ip{color:#6cf}</style>\
</head><body><header>sovereign-engine // live scan :25101</header>\
<main><div id=log></div></main>\
<script>\
const log=document.getElementById('log'),ws=new WebSocket('ws://127.0.0.1:25101');\
ws.onmessage=e=>{try{const j=JSON.parse(e.data);\
log.innerHTML=`<span class=ip>${j.ip}</span>:<span class=port>${j.port}</span>\n`+log.innerHTML.slice(0,8000)}catch{}};\
ws.onclose=_=>setTimeout(()=>location.reload(),2000);\
</script></body></html>\
HTML\
\
# --- 3) run ---\
echo "‚É¶É≤ starting devenv on 25101 (ws) + 25180 (http) + 25103 (mcp)"\
echo "  dashboard: http://127.0.0.1:25180"\
echo "  sovereign-engine stays on 25001 (untouched)"\
exec process-compose -f process-compose.yaml up

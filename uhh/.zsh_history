#!/bin/bash\
set -euo pipefail\
\
MONO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"\
D="$MONO"\
\
usage() {\
cat <<'U'\
Usage: monolith.sh <cmd> [args]\
\
Commands:\
  deps <file>          Install from requirements.txt (supports bun/npm/pip/go/cargo/pacman/nix/github/url)\
  inject <name> <src>  Copy or download a script into this monolith directory\
  setup                Install deps + make sure all helper scripts are executable here\
  run <script> [args]  Execute one of the scripts in this directory (.sh or .ts)\
U\
}\
\
# --- Universal dependency installer ---\
req-install() {\
  local f="${1:-$MONO/requirements.txt}"\
  [[ -f "$f" ]] || { echo "No $f"; exit 1; }\
\
  # Create venv once if any pip: lines exist\
  if grep -q '^pip:' "$f" 2>/dev/null && [[ ! -d "$MONO/.venv" ]]; then\
    echo "[venv] Creating $MONO/.venv for pip packages..."\
    python3 -m venv "$MONO/.venv"\
  fi\
\
  while IFS= read -r line; do\
    [[ "$line" =~ ^# || -z "$line" ]] && continue\
    local type="${line%%:*}" spec="${line#*:}"\
    case "$type" in\
      bun)   command -v bun >/dev/null && bun add -d "$spec" || echo "SKIP bun";;\
      npm)   command -v npm >/dev/null && npm install --save-dev "$spec" || echo "SKIP npm";;\
      pip)\
        if [[ -x "$MONO/.venv/bin/pip" ]]; then\
          "$MONO/.venv/bin/pip" install "$spec" && echo "pip: $spec (venv)"\
        else\
          echo "SKIP pip (no venv)"\
        fi\
        ;;\
      go)    command -v go >/dev/null && go install "$spec" || echo "SKIP go";;\
      cargo) command -v cargo >/dev/null && cargo install "$spec" || echo "SKIP cargo";;\
      pacman) command -v pacman >/dev/null && sudo pacman -S --noconfirm "$spec" || echo "SKIP pacman";;\
      nix)   command -v nix-env >/dev/null && nix-env -iA "nixpkgs.$spec" || echo "SKIP nix";;\
      github) gh-install "$spec";;\
      url)   url-install "$spec";;\
      *)     echo "UNKNOWN: $type";;\
    esac\
  done < "$f"\
}\
\
# --- GitHub release installer (with latest resolution) ---\
gh-install() {\
  local IFS=:; read -r repo version pattern bin <<< "$1"\
  [[ -z "$repo" || -z "$version" || -z "$pattern" || -z "$bin" ]] && { echo "ERR: github spec needs repo:version:pattern:bin"; exit 1; }\
\
  if [[ "$version" == "latest" ]]; then\
    if command -v jq >/dev/null 2>&1; then\
      version=$(curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" | jq -r '.tag_name // empty')\
    else\
      version=$(curl -fsSL "https://api.github.com/repos/${repo}/releases/latest" | grep -oP '"tag_name":\s*"\K[^"]+' | head -1)\
    fi\
    [[ -z "$version" ]] && { echo "ERR: could not resolve latest for $repo"; exit 1; }\
  fi\
\
  local T=$(mktemp -d); trap "rm -rf $T" EXIT\
  local arch=$(uname -m); case "$arch" in x86_64|amd64)arch=x86_64;; aarch64|arm64)arch=aarch64;; armv7l|armhf)arch=armv6hf;; esac\
  local os=$(uname -s | tr '[:upper:]' '[:lower:]'); case "$os" in linux)os=linux;; darwin)os=darwin;; esac\
\
  local f="${pattern//\{VERSION\}/$version}"\
  f="${f//\{ARCH\}/$arch}"\
  f="${f//\{OS\}/$os}"\
\
  local url="https://github.com/$repo/releases/download/$version/$f"\
  if command -v curl >/dev/null; then curl -fsSL "$url" -o "$T/$f"; else wget -q "$url" -O "$T/$f"; fi\
\
  case "$f" in\
    *.tar.xz|*.txz) tar -xf "$T/$f" -C "$T" ;;\
    *.tar.gz|*.tgz) tar -xzf "$T/$f" -C "$T" ;;\
    *.tar.bz2)      tar -xjf "$T/$f" -C "$T" ;;\
    *.zip)          unzip -q "$T/$f" -d "$T" ;;\
  esac\
\
  local found=$(find "$T" -name "$bin" -type f | head -1)\
  [[ -n "$found" ]] || { echo "ERR: $bin not found in $f"; exit 1; }\
\
  cp "$found" "$MONO/$bin"\
  chmod +x "$MONO/$bin"\
  echo "Installed $bin from $repo into monolith"\
}\
\
# --- Direct URL installer ---\
url-install() {\
  local spec="$1"\
  local atype="auto" name url\
\
  if [[ "$spec" =~ :(auto|archive|raw)$ ]]; then\
    atype="${spec##*:}"\
    local rest="${spec%:*}"\
    name="${rest##*:}"\
    url="${rest%:*}"\
  else\
    name="${spec##*:}"\
    url="${spec%:*}"\
  fi\
\
  [[ -z "$url" || -z "$name" ]] && { echo "ERR: url spec needs URL:name[:type]"; exit 1; }\
\
  local T=$(mktemp -d); trap "rm -rf $T" EXIT\
  local f=$(basename "$url")\
\
  if command -v curl >/dev/null; then curl -fsSL "$url" -o "$T/$f"; else wget -q "$url" -O "$T/$f"; fi\
\
  if [[ "$atype" == auto ]]; then\
    case "$f" in\
      *.tar.xz|*.txz) tar -xf "$T/$f" -C "$T" ;;\
      *.tar.gz|*.tgz) tar -xzf "$T/$f" -C "$T" ;;\
      *.tar.bz2)      tar -xjf "$T/$f" -C "$T" ;;\
      *.zip)          unzip -q "$T/$f" -d "$T" ;;\
    esac\
    local found=$(find "$T" -name "$name" -type f | head -1)\
    [[ -n "$found" ]] && cp "$found" "$MONO/$name" || cp "$T/$f" "$MONO/$name"\
  else\
    cp "$T/$f" "$MONO/$name"\
  fi\
\
  chmod +x "$MONO/$name"\
  echo "Installed $name into monolith"\
}\
\
# --- Script injector (with self-copy guard) ---\
inject() {\
  local name="$1" src="$2" dest="$MONO/$name"\
  [[ -z "$src" ]] && { echo "Usage: inject <name> <url|path>"; exit 1; }\
  [[ "$src" -ef "$dest" ]] && { echo "[SKIP] $name already in place"; return 0; }\
\
  if [[ "$src" =~ ^https?:// ]]; then\
    echo "[GET] $src -> $dest"\
    if command -v curl >/dev/null; then curl -fsSL "$src" -o "$dest"; else wget -q "$src" -O "$dest"; fi\
  else\
    [[ -f "$src" ]] || { echo "Not found: $src"; exit 1; }\
    cp "$src" "$dest"\
  fi\
  chmod +x "$dest"\
  echo "[OK] $dest"\
}\
\
# --- Setup ---\
setup() {\
  req-install "${1:-$MONO/requirements.txt}"\
\
  for script in fix-antigravity-ide.sh install-shellcheck.sh install-bin.sh audit-focused.ts; do\
    if [[ -f "$MONO/$script" ]]; then\
      chmod +x "$MONO/$script"\
      echo "[OK] $script"\
    else\
      echo "[MISSING] $script"\
    fi\
  done\
\
  echo "Monolith ready in $MONO"\
  ls -la "$MONO"\
}\
\
# --- Run a script ---\
run() {\
  local script="$1"; shift || true\
  [[ -f "$MONO/$script" ]] || { echo "Not found: $MONO/$script"; exit 1; }\
\
  case "$script" in\
    *.ts) bun run "$MONO/$script" "$@" ;;\
    *.sh) bash "$MONO/$script" "$@" ;;\
    *)    "$MONO/$script" "$@" ;;\
  esac\
}\
\
# --- Main dispatcher ---\
case "${1:-}" in\
  deps)    req-install "${2:-$MONO/requirements.txt}";;\
  inject)  inject "$2" "$3";;\
  setup)   setup "${2:-$MONO/requirements.txt}";;\
  run)     shift; run "$@";;\
  *)       usage; exit 1;;\
esac\
ENDOFMONOLITH\
\
chmod +x /home/toxic/monolith/monolith.sh\
echo "monolith.sh updated successfully."
cd /home/toxic/monolith\
bash monolith.sh setup\
bash monolith.sh run install-bin.sh rg
cat > /home/toxic/monolith/monolith.sh << 'ENDOFMONOLITH'\
#!/bin/bash\
set -euo pipefail\
\
MONO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"\
D="$MONO"\
\
usage() {\
cat <<'U'\
Usage: monolith.sh <cmd> [args]\
\
Commands:\
  deps <file>     Install from requirements.txt\
  inject <name> <src>\
  setup\
  run <script> [args]\
U\
}\
\
resolve_latest() {\
  local repo="$1"\
  local tag\
  # Always use a User-Agent and reliable parsing (no hard jq dependency)\
  tag=$(curl -fsSL -H "User-Agent: monolith-installer" \\
    "https://api.github.com/repos/${repo}/releases/latest" 2>/dev/null \\
    | grep -oP '"tag_name":\s*"\K[^"]+' | head -1)\
\
  if [[ -z "$tag" ]]; then\
    echo "ERR: Failed to resolve latest release tag for $repo" >&2\
    exit 1\
  fi\
  echo "$tag"\
}\
\
req-install() {\
  local f="${1:-$MONO/requirements.txt}"\
  [[ -f "$f" ]] || { echo "No $f"; exit 1; }\
\
  if grep -q '^pip:' "$f" 2>/dev/null && [[ ! -d "$MONO/.venv" ]]; then\
    echo "[venv] Creating $MONO/.venv ..."\
    python3 -m venv "$MONO/.venv"\
  fi\
\
  while IFS= read -r line; do\
    [[ "$line" =~ ^# || -z "$line" ]] && continue\
    local type="${line%%:*}" spec="${line#*:}"\
    case "$type" in\
      bun)   command -v bun >/dev/null && bun add -d "$spec" || echo "SKIP bun";;\
      npm)   command -v npm >/dev/null && npm install --save-dev "$spec" || echo "SKIP npm";;\
      pip)\
        if [[ -x "$MONO/.venv/bin/pip" ]]; then\
          "$MONO/.venv/bin/pip" install "$spec" && echo "pip: $spec (venv)"\
        else\
          echo "SKIP pip (no venv)"\
        fi\
        ;;\
      go)    command -v go >/dev/null && go install "$spec" || echo "SKIP go";;\
      cargo) command -v cargo >/dev/null && cargo install "$spec" || echo "SKIP cargo";;\
      pacman) command -v pacman >/dev/null && sudo pacman -S --noconfirm "$spec" || echo "SKIP pacman";;\
      nix)   command -v nix-env >/dev/null && nix-env -iA "nixpkgs.$spec" || echo "SKIP nix";;\
      github) gh-install "$spec";;\
      url)   url-install "$spec";;\
      *)     echo "UNKNOWN: $type";;\
    esac\
  done < "$f"\
}\
\
gh-install() {\
  local IFS=:; read -r repo version pattern bin <<< "$1"\
  [[ -z "$repo" || -z "$version" || -z "$pattern" || -z "$bin" ]] && { echo "ERR github spec"; exit 1; }\
\
  if [[ "$version" == "latest" ]]; then\
    version=$(resolve_latest "$repo")\
  fi\
\
  local T=$(mktemp -d); trap "rm -rf $T" EXIT\
  local arch=$(uname -m); case "$arch" in x86_64|amd64)arch=x86_64;;aarch64|arm64)arch=aarch64;;armv7l|armhf)arch=armv6hf;;esac\
  local os=$(uname -s|tr '[:upper:]' '[:lower:]'); case "$os" in linux)os=linux;;darwin)os=darwin;;esac\
\
  local f="${pattern//\{VERSION\}/$version}"; f="${f//\{ARCH\}/$arch}"; f="${f//\{OS\}/$os}"\
  local url="https://github.com/$repo/releases/download/$version/$f"\
\
  if command -v curl >/dev/null; then curl -fsSL -H "User-Agent: monolith-installer" "$url" -o "$T/$f"; else wget -q "$url" -O "$T/$f"; fi\
\
  case "$f" in\
    *.tar.xz|*.txz) tar -xf "$T/$f" -C "$T" ;;\
    *.tar.gz|*.tgz) tar -xzf "$T/$f" -C "$T" ;;\
    *.tar.bz2)      tar -xjf "$T/$f" -C "$T" ;;\
    *.zip)          unzip -q "$T/$f" -d "$T" ;;\
  esac\
\
  local found=$(find "$T" -name "$bin" -type f | head -1)\
  [[ -n "$found" ]] || { echo "ERR: $bin not found in archive"; exit 1; }\
\
  cp "$found" "$MONO/$bin"\
  chmod +x "$MONO/$bin"\
  echo "Installed $bin ($version) from $repo into monolith"\
}\
\
url-install() {\
  local spec="$1"\
  local atype="auto" name url\
  if [[ "$spec" =~ :(auto|archive|raw)$ ]]; then\
    atype="${spec##*:}"; local rest="${spec%:*}"; name="${rest##*:}"; url="${rest%:*}"\
  else\
    name="${spec##*:}"; url="${spec%:*}"\
  fi\
  [[ -z "$url" || -z "$name" ]] && { echo "ERR url spec"; exit 1; }\
\
  local T=$(mktemp -d); trap "rm -rf $T" EXIT\
  local f=$(basename "$url")\
  if command -v curl >/dev/null; then curl -fsSL "$url" -o "$T/$f"; else wget -q "$url" -O "$T/$f"; fi\
\
  if [[ "$atype" == auto ]]; then\
    case "$f" in\
      *.tar.xz|*.txz) tar -xf "$T/$f" -C "$T" ;;\
      *.tar.gz|*.tgz) tar -xzf "$T/$f" -C "$T" ;;\
      *.tar.bz2)      tar -xjf "$T/$f" -C "$T" ;;\
      *.zip)          unzip -q "$T/$f" -d "$T" ;;\
    esac\
    local found=$(find "$T" -name "$name" -type f | head -1)\
    [[ -n "$found" ]] && cp "$found" "$MONO/$name" || cp "$T/$f" "$MONO/$name"\
  else\
    cp "$T/$f" "$MONO/$name"\
  fi\
  chmod +x "$MONO/$name"\
  echo "Installed $name into monolith"\
}\
\
inject() {\
  local name="$1" src="$2" dest="$MONO/$name"\
  [[ -z "$src" ]] && { echo "Usage"; exit 1; }\
  [[ "$src" -ef "$dest" ]] && { echo "[SKIP] $name already in place"; return 0; }\
  if [[ "$src" =~ ^https?:// ]]; then\
    if command -v curl >/dev/null; then curl -fsSL "$src" -o "$dest"; else wget -q "$src" -O "$dest"; fi\
  else\
    [[ -f "$src" ]] || { echo "Not found"; exit 1; }\
    cp "$src" "$dest"\
  fi\
  chmod +x "$dest"\
  echo "[OK] $dest"\
}\
\
setup() {\
  req-install "${1:-$MONO/requirements.txt}"\
  for s in fix-antigravity-ide.sh install-shellcheck.sh install-bin.sh audit-focused.ts; do\
    [[ -f "$MONO/$s" ]] && chmod +x "$MONO/$s" && echo "[OK] $s" || echo "[MISSING] $s"\
  done\
  echo "Monolith ready in $MONO"\
  ls -la "$MONO"\
}\
\
run() {\
  local script="$1"; shift || true\
  [[ -f "$MONO/$script" ]] || { echo "Not found: $MONO/$script"; exit 1; }\
  case "$script" in\
    *.ts) bun run "$MONO/$script" "$@" ;;\
    *.sh) bash "$MONO/$script" "$@" ;;\
    *)    "$MONO/$script" "$@" ;;\
  esac\
}\
\
case "${1:-}" in\
  deps)    req-install "${2:-$MONO/requirements.txt}";;\
  inject)  inject "$2" "$3";;\
  setup)   setup "${2:-$MONO/requirements.txt}";;\
  run)     shift; run "$@";;\
  *)       usage; exit 1;;\
esac\
ENDOFMONOLITH\

#!/bin/bash\
# ------------------------------------------------------------------------------\
# install_bench_rig.sh ‚ÄÉ≥ Installs llm-bench-rig, configures it to use your ik_llama fork,\
# adds all .gguf models, and launches the queue + dashboard.\
# ------------------------------------------------------------------------------\
\
set -e  # stop on error\
\
# Define paths\
REPO_DIR="/home/toxic/llm-bench-rig"\
MODEL_DIR="/home/toxic/models"\
LLAMA_BENCH="/home/toxic/ik_llama.cpp-main/build/bin/llama-bench"\
LOG_DIR="/home/toxic/llm-bench-rig/logs"\
DASHBOARD_PORT=8501\
\
# 1. Check if llama-bench exists\
if [ ! -f "$LLAMA_BENCH" ]; then\
    echo "‚ÉΩÉ¨ llama-bench not found at $LLAMA_BENCH"\
    echo "   Please build ik_llama first: cd /home/toxic/ik_llama.cpp-main && make -j"\
    exit 1\
fi\
echo "‚ÉºÉ• Found llama-bench: $LLAMA_BENCH"\
\
# 2. Clone repo if missing\
if [ ! -d "$REPO_DIR" ]; then\
    echo "ÉøÉ≥¶ Cloning llm-bench-rig..."\
    git clone https://github.com/notwitcheer/llm-bench-rig.git "$REPO_DIR"\
else\
    echo "ÉøÉ≥Å Repo already exists. Pulling updates..."\
    cd "$REPO_DIR" && git pull\
fi\
\
# 3. Set up Python environment (if you want a venv ‚ÄÉ≥ optional)\
if [ ! -d "$REPO_DIR/venv" ]; then\
    echo "ÉøÉ∞É≠ Creating Python virtual environment..."\
    python3 -m venv "$REPO_DIR/venv"\
fi\
source "$REPO_DIR/venv/bin/activate"\
\
# 4. Install dependencies\
echo "ÉøÉ≥¶ Installing Python dependencies..."\
pip install --upgrade pip\
pip install -r "$REPO_DIR/requirements.txt"\
\
# 5. Configure the tool to use your local llama-bench\
#    The tool respects environment variable LLAMACPP_PATH\
export LLAMACPP_PATH="$LLAMA_BENCH"\
echo "ÉøÉ¥ß Set LLAMACPP_PATH=$LLAMACPP_PATH"\
\
# 6. Create a config file (optional but helps)\
cat > "$REPO_DIR/config.yaml" <<EOF\
# llm-bench-rig configuration\
benchmark:\
  llama_bin: "$LLAMA_BENCH"\
  model_path: "$MODEL_DIR"\
  speed_only: false\
  runs: 2\
  pp_lengths: [128, 512, 2048]\
  tg_lengths: [128]\
  quality_tasks: ["mmlu", "arc_challenge", "hellaswag", "gsm8k"]\
dashboard:\
  host: "0.0.0.0"\
  port: $DASHBOARD_PORT\
queue:\
  log_dir: "$LOG_DIR"\
EOF\
echo "‚ÉºÉ• Config written to $REPO_DIR/config.yaml"\
\
# 7. Add all models from /home/toxic/models to the queue\
echo "‚ÉæÉµ Adding all .gguf models from $MODEL_DIR to the benchmark queue..."\
cd "$REPO_DIR"\
for model in "$MODEL_DIR"/*.gguf; do\
    if [ -f "$model" ]; then\
        python bench_queue.py add "$model"\
    fi\
done\
\
# 8. Start the queue in the background (logging to file)\
echo "ÉøÉ∫Ä Starting benchmark queue..."\
mkdir -p "$LOG_DIR"\
nohup python bench_queue.py start > "$LOG_DIR/queue.log" 2>&1 &\
QUEUE_PID=$!\
echo "   Queue PID: $QUEUE_PID"\
\
# 9. Start the dashboard in the background\
echo "ÉøÉ≥É™ Starting live dashboard on http://localhost:$DASHBOARD_PORT"\
nohup python dashboard.py --config config.yaml > "$LOG_DIR/dashboard.log" 2>&1 &\
DASHBOARD_PID=$!\
echo "   Dashboard PID: $DASHBOARD_PID"\
\
# 10. Print summary\
echo ""\
echo "============================================================"\
echo "‚ÉºÉ• llm-bench-rig is now running\
echo "   - Queue logs:  $LOG_DIR/queue.log"\
echo "   - Dashboard:   http://localhost:$DASHBOARD_PORT"\
echo "   - Results will appear in $REPO_DIR/results/"\
echo ""\
echo "To stop everything:"\
echo "   kill $QUEUE_PID $DASHBOARD_PID"\
echo "Or: pkill -f 'bench_queue.py|dashboard.py'"\
echo "============================================================"\
\
\
\
\
\

nano zx.sh
chmod +x zx.sh
./zx.sh
tailscale ip
#!/bin/bash\
# ------------------------------------------------------------------------------\
# nmap_tailscale_links.sh ‚ÄÉ≥ Full nmap port scan + Tailscale link generator\
# ------------------------------------------------------------------------------\
# Save this file, chmod +x, and run it.\
# It will install nmap if missing, scan all ports, and generate Tailscale URLs.\
# ------------------------------------------------------------------------------\
\
set -e\
\
# 1. Install nmap if missing\
if ! command -v nmap &>/dev/null; then\
    echo "ÉøÉ≥¶ nmap not found. Installing..."\
    if command -v pacman &>/dev/null; then\
        sudo pacman -S --noconfirm nmap\
    elif command -v apt-get &>/dev/null; then\
        sudo apt-get update && sudo apt-get install -y nmap\
    elif command -v dnf &>/dev/null; then\
        sudo dnf install -y nmap\
    else\
        echo "‚ÉΩÉ¨ Could not install nmap. Please install it manually."\
        exit 1\
    fi\
fi\
\
# 2. Get Tailscale IP\
TS_IP=$(tailscale ip 2>/dev/null | grep -v ':' | head -1)\
TS_IP6=$(tailscale ip 2>/dev/null | grep ':' | head -1)\
HOSTNAME=$(hostname)\
\
if [ -z "$TS_IP" ]; then\
    echo "‚É∫ÉÄÔ∏ÉØ  Tailscale IPv4 not found. Using localhost."\
    TS_IP="127.0.0.1"\
fi\
\
echo "============================================================"\
echo "        FULL NMAP PORT SCAN + TAILSCALE LINKS"\
echo "============================================================"\
echo "ÉøÉ≥É≠ Tailscale IPv4: $TS_IP"\
[ -n "$TS_IP6" ] && echo "ÉøÉ≥É≠ Tailscale IPv6: $TS_IP6"\
echo "ÉøÉ≥É≠ Hostname:      $HOSTNAME"\
echo ""\
\
# 3. Scan all ports on localhost (fast)\
echo "ÉøÉ¥ÉÆ Scanning all TCP ports on 127.0.0.1 (this may take a minute)..."\
nmap_local=$(nmap -T4 -p- --open 127.0.0.1 2>/dev/null)\
\
# Also scan the Tailscale IP to ensure services bound to 0.0.0.0 are seen\
echo "ÉøÉ¥ÉÆ Also scanning Tailscale IP $TS_IP for externally reachable services..."\
nmap_tailscale=$(nmap -T4 -p- --open "$TS_IP" 2>/dev/null)\
\
# 4. Parse and merge results\
echo ""\
echo "=== OPEN PORTS (reachable via Tailscale) ==="\
echo ""\
\
# Known service port mappings\
declare -A KNOWN_SERVICES=(\
    [22]="SSH"\
    [80]="HTTP"\
    [443]="HTTPS"\
    [25000]="Caddy Dashboard"\
    [25001]="llama-server (inference)"\
    [25004]="OpenFang API"\
    [25008]="NF-CoT Proxy"\
    [8501]="llm-bench-rig Dashboard"\
    [9090]="Process-Compose API"\
    [8080]="Process-Compose (alt)"\
    [4200]="OpenFang Web"\
    [3000]="Node/Vite Dev Server"\
    [5173]="Vite Dev Server"\
    [8000]="FastAPI/Uvicorn"\
    [8020]="Teleforge"\
    [5432]="PostgreSQL"\
    [6379]="Redis"\
    [27017]="MongoDB"\
)\
\
# Extract open ports from nmap output (both localhost and Tailscale)\
open_ports_local=$(echo "$nmap_local" | grep -E '^[0-9]+/tcp' | awk -F'/' '{print $1}')\
open_ports_ts=$(echo "$nmap_tailscale" | grep -E '^[0-9]+/tcp' | awk -F'/' '{print $1}')\
all_ports=$(echo -e "$open_ports_local\n$open_ports_ts" | sort -nu)\
\
if [ -z "$all_ports" ]; then\
    echo "‚ÉΩÉ¨ No open ports found. Make sure your services are running."\
    exit 1\
fi\
\
# Print table\
printf "%-8s %-25s %-30s\n" "Port" "Service" "Tailscale URL"\
printf "%-8s %-25s %-30s\n" "-----" "-----------------------" "------------------------------"\
for port in $all_ports; do\
    service="${KNOWN_SERVICES[$port]:-Unknown}"\
    url="http://$TS_IP:$port"\
    printf "%-8s %-25s %-30s\n" "$port" "$service" "$url"\
done\
\
echo ""\
echo "=== DETAILED SERVICE INFO ==="\
echo ""\
# Show process info for each open port\
for port in $all_ports; do\
    process_info=$(ss -tlnp 2>/dev/null | grep ":$port " | head -1 | awk '{print $7}')\
    if [ -n "$process_info" ]; then\
        echo "Port $port: $process_info"\
    fi\
done\
\
echo ""\
echo "============================================================"\
echo "ÉøÉ≥É´ Quick access summary (copy and paste into browser):"\
echo ""\
for port in $all_ports; do\
    service="${KNOWN_SERVICES[$port]:-Port $port}"\
    echo "  $service: http://$TS_IP:$port"\
done\
\
if [ -n "$TS_IP6" ]; then\
    echo ""\
    echo "ÉøÉ¨É∞ IPv6 addresses (use brackets):"\
    for port in $all_ports; do\
        service="${KNOWN_SERVICES[$port]:-Port $port}"\
        echo "  $service: http://[$TS_IP6]:$port"\
    done\
fi\
\
echo ""\
echo "ÉøÉ¥É∑ MagicDNS (if enabled):"\
for port in $all_ports; do\
    service="${KNOWN_SERVICES[$port]:-Port $port}"\
    echo "  $service: http://$HOSTNAME:$port"\
done\
\
echo ""\
echo "============================================================"\
echo "‚ÉºÉ• Done. You can now access any service from any device on your tailnet."\
exit 0
bash -s << 'SCRIPT'\
#!/bin/bash\
# ------------------------------------------------------------------------------\
# sovereign_full_port_scan.sh ‚ÄÉ¥ Full nmap (-p-) + Tailscale Links (Optimized)\
# Fast full TCP scan focused on your Tailscale-exposed sovereign stack\
# ------------------------------------------------------------------------------\
\
set -euo pipefail\
\
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'\
BLUE='\033[0;34m'; CYAN='\033[0;36m'; NC='\033[0m'\
\
echo -e "${BLUE}‚ÉµÉ¥‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∑"\
echo -e "‚ÉµÉ±     SOVEREIGN FULL PORT SCAN (Fast -p- on Tailscale)      ‚ÉµÉ±"\
echo -e "‚ÉµÉ∫‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉΩ${NC}"\
\
# Tailscale info\
if command -v tailscale &>/dev/null; then\
    TS_IP=$(tailscale ip -4 2>/dev/null | head -1 || echo "127.0.0.1")\
    TS_IP6=$(tailscale ip -6 2>/dev/null | head -1 || echo "")\
    HOSTNAME=$(hostname)\
else\
    TS_IP="127.0.0.1"\
    TS_IP6=""\
    HOSTNAME=$(hostname)\
fi\
\
echo ""\
echo -e "ÉøÉ≥É≠ Target          : ${GREEN}\( TS_IP \){NC}"\
[ -n "$TS_IP6" ] && echo -e "ÉøÉ≥É≠ IPv6            : ${GREEN}\( TS_IP6 \){NC}"\
echo -e "ÉøÉ≥É≠ Hostname        : $HOSTNAME"\
echo ""\
\
# Install nmap if missing\
if ! command -v nmap &>/dev/null; then\
    echo -e "\( {YELLOW}ÉøÉ≥¶ Installing nmap... \){NC}"\
    sudo pacman -Sy --noconfirm nmap 2>/dev/null || true\
fi\
\
# ik_llama check\
if command -v ik_llama &>/dev/null; then\
    echo -e "\( {CYAN}‚É∂∂ ik_llama binary \){NC}"\
    which ik_llama\
    ik_llama --version 2>/dev/null | head -1 || true\
    echo ""\
fi\
\
# Fast full port scan\
echo -e "${CYAN}‚É∂∂ Fast full TCP port scan on \( TS_IP (-p- optimized) \){NC}"\
echo -e "   (This usually takes 20-60 seconds on Tailscale)"\
\
# Aggressive but safe speed flags for internal Tailscale network\
nmap -T4 -p- \\
    --min-rate 1500 \\
    --max-retries 2 \\
    --max-scan-delay 10ms \\
    --open \\
    "$TS_IP" 2>/dev/null | tee /tmp/nmap_full.log || true\
\
# Also do a quick localhost scan (for services only listening locally)\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Quick localhost scan \){NC}"\
nmap -T4 -p- --min-rate 2000 --max-retries 1 --open 127.0.0.1 2>/dev/null | tee /tmp/nmap_local.log || true\
\
# Collect unique open ports\
open_ports=$(cat /tmp/nmap_full.log /tmp/nmap_local.log 2>/dev/null \\
    | grep -E '^[0-9]+/tcp' \\
    | awk -F'/' '{print $1}' \\
    | sort -nu)\
\
if [ -z "$open_ports" ]; then\
    echo -e "\( {RED}‚ÉΩÉ¨ No open ports detected. \){NC}"\
    exit 0\
fi\
\
# Known sovereign services\
declare -A KNOWN_SERVICES=(\
    [25000]="Caddy Dashboard"\
    [25001]="ik_llama / llama-server (inference)"\
    [25004]="OpenFang"\
    [25008]="NF-CoT Proxy"\
    [9090]="Process-Compose HTTP"\
    [8080]="Process-Compose (alt)"\
    [3001]="Frona"\
)\
\
# Output table\
echo ""\
echo -e "\( {GREEN}=== OPEN PORTS + TAILSCALE URLs === \){NC}"\
printf "%-8s %-40s %-50s\n" "Port" "Service" "Tailscale URL"\
printf "%-8s %-40s %-50s\n" "-----" "----------------------------------------" "--------------------------------------------------"\
\
for port in $open_ports; do\
    service="${KNOWN_SERVICES[$port]:-Unknown / Custom}"\
    printf "%-8s %-40s %-50s\n" "$port" "$service" "http://$TS_IP:$port"\
done\
\
# Process info\
echo ""\
echo -e "\( {GREEN}=== LISTENING PROCESSES === \){NC}"\
for port in $open_ports; do\
    proc=$(ss -tlnp 2>/dev/null | grep ":$port " | head -1 | awk '{print $7}' || true)\
    [ -n "$proc" ] && echo "Port $port ‚É¶É≤ $proc"\
done\
\
# Quick access\
echo ""\
echo -e "\( {GREEN}=== QUICK ACCESS (copy-paste) === \){NC}"\
for port in $open_ports; do\
    service="${KNOWN_SERVICES[$port]:-Port $port}"\
    echo "  $service ‚É¶É≤ http://$TS_IP:$port"\
done\
\
if [ -n "$TS_IP6" ]; then\
    echo ""\
    echo -e "\( {BLUE}IPv6: \){NC}"\
    for port in $open_ports; do\
        service="${KNOWN_SERVICES[$port]:-Port $port}"\
        echo "  $service ‚É¶É≤ http://[$TS_IP6]:$port"\
    done\
fi\
\
echo ""\
echo -e "\( {YELLOW}MagicDNS: \){NC}"\
for port in $open_ports; do\
    service="${KNOWN_SERVICES[$port]:-Port $port}"\
    echo "  $service ‚É¶É≤ http://$HOSTNAME:$port"\
done\
\
echo ""\
echo -e "${BLUE}‚ÉµÉ¥‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∑"\
echo -e "‚ÉµÉ±  ‚ÉºÉ• Full scan complete. All listed ports are reachable via Tailscale. ‚ÉµÉ±"\
echo -e "‚ÉµÉ∫‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉΩ${NC}"\
\
rm -f /tmp/nmap_full.log /tmp/nmap_local.log 2>/dev/null || true\
SCRIPT
bash -s << 'SCRIPT'\
#!/bin/bash\
# ------------------------------------------------------------------------------\
# sovereign_recon_v4.sh ‚ÄÉ¥ Ping + Full Recon + Sovereign Health\
# Goes further: connectivity, versions, process status, quick health checks\
# ------------------------------------------------------------------------------\
\
set -euo pipefail\
\
RED=$'\033[0;31m'\
GREEN=$'\033[0;32m'\
YELLOW=$'\033[1;33m'\
BLUE=$'\033[0;34m'\
CYAN=$'\033[0;36m'\
NC=$'\033[0m'\
\
echo -e "${BLUE}‚ÉµÉ¥‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∑"\
echo -e "‚ÉµÉ±        SOVEREIGN RECON v4 ‚ÄÉ¥ Ping + Port + Health           ‚ÉµÉ±"\
echo -e "‚ÉµÉ∫‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉΩ${NC}"\
\
# === 1. Tailscale + Host Info ===\
TS_IP=$(tailscale ip -4 2>/dev/null | head -1 || echo "127.0.0.1")\
TS_IP6=$(tailscale ip -6 2>/dev/null | head -1 || echo "")\
HOSTNAME=$(hostname)\
TS_STATUS=$(tailscale status --json 2>/dev/null | jq -r '.BackendState' 2>/dev/null || echo "unknown")\
\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Network Identity \){NC}"\
echo -e "  Tailscale IPv4 : \( {GREEN} \){TS_IP}${NC}"\
[ -n "$TS_IP6" ] && echo -e "  Tailscale IPv6 : \( {GREEN} \){TS_IP6}${NC}"\
echo -e "  Hostname       : ${HOSTNAME}"\
echo -e "  Tailscale State: ${TS_STATUS}"\
\
# === 2. Ping Recon ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Ping Recon \){NC}"\
\
echo -n "  Localhost (127.0.0.1)     : "\
ping -c 2 -W 1 127.0.0.1 >/dev/null 2>&1 && echo -e "\( {GREEN}OK \){NC}" || echo -e "\( {RED}FAIL \){NC}"\
\
echo -n "  Tailscale IP (${TS_IP})   : "\
ping -c 3 -W 1 "\( TS_IP" >/dev/null 2>&1 && echo -e " \){GREEN}OK\( {NC}" || echo -e " \){RED}FAIL${NC}"\
\
echo -n "  Tailscale Gateway       : "\
TS_GW=$(ip route | grep tailscale | awk '{print $3}' | head -1 || echo "")\
if [ -n "$TS_GW" ]; then\
    ping -c 2 -W 1 "\( TS_GW" >/dev/null 2>&1 && echo -e " \){GREEN}OK\( {NC} ( \){TS_GW})" || echo -e "\( {RED}FAIL \){NC}"\
else\
    echo "No Tailscale route found"\
fi\
\
# === 3. ik_llama Binary Check ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ ik_llama Binary \){NC}"\
if command -v ik_llama &>/dev/null; then\
    real=\( (readlink -f " \)(which ik_llama)")\
    echo -e "  Path    : \( {GREEN} \){real}${NC}"\
    ik_llama --version 2>/dev/null | head -1 || echo "  (version unavailable)"\
else\
    echo -e "  \( {YELLOW}ik_llama not in PATH \){NC}"\
fi\
\
# === 4. Focused Sovereign Port Scan + Service Versions ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Sovereign Port Scan + Version Detection \){NC}"\
\
SOVEREIGN_PORTS="22,25000,25001,25004,25008,8080,9090"\
nmap -T4 -sV -p "$SOVEREIGN_PORTS" --version-intensity 5 --open "$TS_IP" 2>/dev/null | tee /tmp/sovereign_nmap.log || true\
\
# === 5. Full Port Summary ===\
echo ""\
echo -e "\( {GREEN}=== OPEN PORTS + SERVICE VERSIONS === \){NC}"\
grep -E '^[0-9]+/tcp' /tmp/sovereign_nmap.log | while read line; do\
    port=$(echo "$line" | awk -F'/' '{print $1}')\
    service=$(echo "$line" | awk '{print $3}')\
    version=$(echo "$line" | cut -d' ' -f4-)\
    printf "  %-6s %-25s %s\n" "$port" "$service" "$version"\
done\
\
# === 6. Listening Processes ===\
echo ""\
echo -e "\( {GREEN}=== LISTENING PROCESSES (ss) === \){NC}"\
ss -tlnp 2>/dev/null | grep -E ':(22|2500[0-9]|8080|9090) ' | awk '{print "  " $1 " " $5 " ‚É¶É≤ " $7}'\
\
# === 7. Quick Health Checks ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Quick Health Checks \){NC}"\
\
echo -n "  ik_llama (25001) /v1/models : "\
if curl -s --max-time 4 "http://${TS_IP}:25001/v1/models" | grep -q '"object":"list"'; then\
    echo -e "\( {GREEN}OK \){NC}"\
else\
    echo -e "\( {RED}NOT RESPONDING \){NC}"\
fi\
\
echo -n "  Process-Compose (9090)      : "\
if curl -s --max-time 3 "http://${TS_IP}:9090" >/dev/null 2>&1; then\
    echo -e "\( {GREEN}Reachable \){NC}"\
else\
    echo -e "\( {YELLOW}No HTTP or not running \){NC}"\
fi\
\
# === 8. Process-Compose Status (if available) ===\
if pgrep -f "process-compose" >/dev/null 2>&1; then\
    echo ""\
    echo -e "\( {CYAN}‚É∂∂ Process-Compose Status \){NC}"\
    process-compose list 2>/dev/null | head -15 || echo "  (attach with: process-compose attach)"\
fi\
\
# === 9. Summary + Recommendations ===\
echo ""\
echo -e "${BLUE}‚ÉµÉ¥‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∑"\
echo -e "‚ÉµÉ±                        SUMMARY                              ‚ÉµÉ±"\
echo -e "‚ÉµÉ∫‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉΩ${NC}"\
\
echo -e "  \( {GREEN}Working: \){NC}   25001 (ik_llama inference) is reachable via Tailscale"\
echo -e "  \( {YELLOW}Missing: \){NC}   25000 (Caddy), 25004 (OpenFang), 25008 (NF-CoT) not detected"\
echo ""\
echo -e "\( {YELLOW}Next steps you probably want: \){NC}"\
echo "  ‚ÄÉÇ Check why 25000/25004/25008 are not starting"\
echo "  ‚ÄÉÇ Run: process-compose logs ik_llama"\
echo "  ‚ÄÉÇ Run: process-compose ps"\
echo "  ‚ÄÉÇ Verify your process-compose.yaml has correct commands + paths"\
\
rm -f /tmp/sovereign_nmap.log 2>/dev/null || true\

cat > /home/toxic/fix-webos-final.js << 'ENDOFSCRIPT'\
const fs=require('fs'),path=require('path');\
const B='/home/toxic/nodecast-tv';\
const D=(m)=>console.log('[+] '+m),W=(m)=>console.log('[!] '+m),E=(m)=>console.log('[-] '+m);\
const R=(f)=>{try{return fs.readFileSync(f,'utf8')}catch(e){return null}};\
const Wf=(f,c)=>fs.writeFileSync(f,c);\
const Bk=(f)=>{if(fs.existsSync(f))fs.copyFileSync(f,f+'.bak.'+Date.now())};\
\
// 1. FIX proxy.js ‚ÄÉ¥ WebOS Content-Type override in /stream route\
let p=R(B+'/server/routes/proxy.js');\
if(p){\
Bk(B+'/server/routes/proxy.js');\
p=p.replace("router.get('/stream', async (req, res) => {",\
`router.get('/stream', async (req, res) => {\
    const isWebOS = req.isWebOS || /webos|web0s|netcast/i.test(req.headers['user-agent']||'');\
    if(isWebOS) console.log('[WebOS] /stream proxy for URL:',(req.query.url||'').substring(0,60));`);\
p=p.replace(\
`res.set('Content-Type', contentType || 'application/octet-stream');`,\
`const ct = contentType || 'application/octet-stream';\
            res.set('Content-Type', isWebOS && ct.includes('mp2t') ? 'video/MP2T' : ct);`);\
p=p.replace(\
`res.set('Content-Type', 'application/vnd.apple.mpegurl');`,\
`res.set('Content-Type', 'application/vnd.apple.mpegurl');\
                if(isWebOS) console.log('[WebOS] Serving HLS manifest with Apple MIME');`);\
p=p.replace(\
`res.json({ url: streamUrl });`,\
`// WebOS: return proxied URL so CORS + Content-Type are handled\
        const finalUrl = isWebOS \
            ? \`\${req.protocol}://\${req.get('host')}/api/proxy/stream?url=\${encodeURIComponent(streamUrl)}\`\
            : streamUrl;\
        res.json({ url: finalUrl });`);\
Wf(B+'/server/routes/proxy.js',p);\
D('proxy.js: WebOS Content-Type overrides injected');\
}else E('proxy.js not found');\
\
// 2. FIX index.js ‚ÄÉ¥ Add global response interceptor\
let i=R(B+'/server/index.js');\
if(i){\
Bk(B+'/server/index.js');\
i=i.replace(/\/\/ --- WebOS Compatibility Middleware ---[\s\S]*?\/\/ --- End WebOS Middleware ---\n?/g,'');\
const mw=`// --- WebOS Compatibility Middleware ---\
const { isLGWebOS } = require('./webos-utils');\
app.use((req, res, next) => {\
  const ua = req.headers['user-agent'] || '';\
  if (isLGWebOS(ua)) {\
    req.isWebOS = true;\
    req.webOSConfig = { streamFormat:'m3u8', forceProxy:true, autoTranscode:true, forceTranscode:false, forceVideoTranscode:false, forceRemux:false, hwEncoder:'software', maxResolution:'1080p', audioMixPreset:'passthrough', userAgentPreset:'chrome', upscaleEnabled:false };\
    const origSet = res.set.bind(res);\
    res.set = function(field, val) {\
      const fn = String(field).toLowerCase();\
      if (fn === 'content-type') {\
        const v = String(val).toLowerCase();\
        const rp = req.path || '';\
        if ((v.includes('octet-stream') || v.includes('mp2t') || v.includes('mpeg') || v.includes('ts')) &&\
            (rp.includes('stream') || rp.includes('live') || rp.includes('m3u8') || req.query.url)) {\
          if (!rp.match(/\\.\\d+\\.ts$/) && !rp.endsWith('.ts')) {\
            console.log('[WebOS] Force MIME: application/vnd.apple.mpegurl for '+rp);\
            return origSet(field, 'application/vnd.apple.mpegurl');\
          }\
        }\
      }\
      return origSet(field, val);\
    };\
  }\
  next();\
});\
// --- End WebOS Middleware ---\
`;\
i=i.replace('const app = express();','const app = express();\n'+mw);\
Wf(B+'/server/index.js',i);\
D('index.js: WebOS response interceptor injected');\
}else E('index.js not found');\
\
// 3. FIX webos-utils.js ‚ÄÉ¥ Complete rewrite with PROPER escaping\
const wu=`const WEBOS_UA_PATTERNS=[/web0s/i,/webos/i,/netcast/i,/lg.*smart.*tv/i,/webappmanager/i];\
function isLGWebOS(ua){if(!ua)return false;const u=ua.toLowerCase();return WEBOS_UA_PATTERNS.some(p=>p.test(u));}\
function detectWebOSVersion(ua){const m=ua.match(/chrome\\/(\\d+)/i);if(!m)return"unknown";const v=parseInt(m[1],10);if(v>=132)return"26";if(v>=120)return"25";if(v>=108)return"24";if(v>=94)return"23";if(v>=87)return"22";if(v>=79)return"6.x";if(v>=68)return"5.x";if(v>=53)return"4.x";if(/qtwebengine/i.test(ua))return"3.x";if(/webkit\\/538/i.test(ua))return"2.x";if(/webkit\\/537\\.41/i.test(ua))return"1.x";return"unknown";}\
function getWebOSConfig(baseConfig,ua){if(!isLGWebOS(ua||""))return baseConfig;const ver=detectWebOSVersion(ua||"");console.log(\`[WebOS] Detected LG WebOS \${ver} ‚ÄÉ¥ applying HLS compatibility overrides\`);return{...baseConfig,streamFormat:"m3u8",forceProxy:true,autoTranscode:true,forceTranscode:false,forceVideoTranscode:false,forceRemux:false,hwEncoder:"software",maxResolution:"1080p",audioMixPreset:"passthrough",userAgentPreset:"chrome",upscaleEnabled:false};}\
function getWebOSContentType(ot,url){if(url&&url.includes(".m3u8"))return"application/vnd.apple.mpegurl";if(ot==="video/mp2t"||ot==="video/mpeg")return"video/MP2T";return ot;}\
function webOSMiddleware(req,res,next){const ua=req.headers["user-agent"]||"";if(isLGWebOS(ua)){req.webOS={isWebOS:true,version:detectWebOSVersion(ua),userAgent:ua};console.log(\`[WebOS Middleware] \${req.method} \${req.path} ‚ÄÉ¥ WebOS \${req.webOS.version}\`);}next();}\
module.exports={isLGWebOS,detectWebOSVersion,getWebOSConfig,getWebOSContentType,webOSMiddleware};\
`;\
Bk(B+'/server/webos-utils.js');\
Wf(B+'/server/webos-utils.js',wu);\
D('webos-utils.js: Rewritten with PROPER escaping (\\\\/ and \\\\d)');\
\
// 4. EXTRACT settings from db.json to config/settings.json\
let db=null;\
try{db=JSON.parse(R(B+'/data/db.json')||'{}');}catch(e){E('db.json parse: '+e.message);}\
if(db&&db.settings){\
const cfgDir=B+'/config';\
if(!fs.existsSync(cfgDir))fs.mkdirSync(cfgDir,{recursive:true});\
const s={...db.settings};\
s.streamFormat='m3u8';s.forceProxy=true;s.autoTranscode=true;s.forceTranscode=false;\
s.forceVideoTranscode=false;s.forceRemux=false;s.hwEncoder='software';s.maxResolution='1080p';\
s.audioMixPreset='passthrough';s.userAgentPreset='chrome';s.upscaleEnabled=false;\
Bk(B+'/config/settings.json');\
Wf(B+'/config/settings.json',JSON.stringify(s,null,2));\
D('config/settings.json: Extracted '+Object.keys(s).length+' settings');\
const dbOnly={...db};delete dbOnly.settings;\
Bk(B+'/data/db.json');\
Wf(B+'/data/db.json',JSON.stringify(dbOnly,null,2));\
D('db.json: Settings removed (data-only now)');\
}else W('db.json: No settings to extract');\
\
// 5. CREATE webos-test.html v3 with CORRECT escaping\
const test=`<!DOCTYPE html>\
<html><head><meta charset="UTF-8"><title>WebOS Diagnostic v3</title>\
<style>body{background:#000;color:#0f0;font-family:monospace;padding:20px;margin:0}h1{color:#0f0;border-bottom:2px solid #0f0;padding-bottom:10px;font-size:18px}#log{white-space:pre-wrap;word-break:break-all;max-height:300px;overflow-y:auto;border:1px solid #0f0;padding:10px;margin:20px 0;font-size:11px}.err{color:#f00}.warn{color:#ff0}.ok{color:#0f0}.info{color:#0ff}video{width:100%;max-width:854px;height:480px;border:2px solid #0f0;display:block;margin:20px 0;background:#111}button{background:#0f0;color:#000;border:none;padding:10px 20px;font-family:monospace;font-size:14px;cursor:pointer;margin-right:10px}button:hover{background:#0a0}button:disabled{background:#333;color:#666}select{background:#000;color:#0f0;border:1px solid #0f0;padding:10px;font-family:monospace;font-size:14px;width:100%;max-width:854px}</style></head><body>\
<h1>WebOS Diagnostic v3 (HLS-First)</h1>\
<div style="padding:10px;border:1px solid #0f0;margin:10px 0;font-size:12px">\
<p><strong>UA:</strong> <span id="ua"></span></p>\
<p><strong>WebOS:</strong> <span id="detected">checking...</span></p>\
<p><strong>Version:</strong> <span id="webos-ver">checking...</span></p>\
<p><strong>canPlayType m3u8:</strong> <span id="canplay-m3u8">checking...</span></p>\
<p><strong>MSE:</strong> <span id="mse">checking...</span></p>\
</div>\
<div><label><strong>Stream:</strong></label><br><br>\
<select id="streamSelect">\
<option value="/api/proxy/stream?url=http://fortv.cc:8080/live/58171399/58171399/325106.m3u8">Direct Proxy HLS (325106)</option>\
<option value="/api/proxy/xtream/1/stream/325106/live?container=m3u8">Xtream API (JSON URL)</option>\
</select><br><br>\
<button id="playBtn" onclick="playStream()">PLAY</button>\
<button id="stopBtn" onclick="stopStream()" disabled>STOP</button>\
<button onclick="dumpDebug()">DUMP</button>\
</div>\
<video id="v" controls autoplay muted playsinline></video>\
<div id="log"></div>\
<script>\
function log(msg,cls){var d=document.getElementById("log");var line=document.createElement("div");line.className=cls||"";line.textContent="["+new Date().toLocaleTimeString()+"] "+msg;d.appendChild(line);d.scrollTop=d.scrollHeight}\
function clearLog(){document.getElementById("log").innerHTML=""}\
var ua=navigator.userAgent;document.getElementById("ua").textContent=ua.substring(0,120);\
var isWebOS=/webos|web0s|netcast|lg.*smart.*tv|webappmanager/i.test(ua.toLowerCase());\
document.getElementById("detected").textContent=isWebOS?"YES":"NO";\
var webOSVersion="unknown";var chromeMatch=ua.match(/chrome\\/(\\d+)/i);if(chromeMatch){var v=parseInt(chromeMatch[1],10);if(v>=87)webOSVersion="22";else if(v>=79)webOSVersion="6.x";else if(v>=68)webOSVersion="5.x";else if(v>=53)webOSVersion="4.x"}\
document.getElementById("webos-ver").textContent=webOSVersion;\
var video=document.getElementById("v");\
document.getElementById("canplay-m3u8").textContent=video.canPlayType("application/vnd.apple.mpegurl")||"NO";\
document.getElementById("mse").textContent=typeof MediaSource!=="undefined"?"YES":"NO";\
function setButtons(playing){document.getElementById("playBtn").disabled=playing;document.getElementById("stopBtn").disabled=!playing}\
function playStream(){var select=document.getElementById("streamSelect");var url=select.value;clearLog();log("Loading: "+url,"info");stopStream();video.src=url;video.load();video.play().catch(function(e){log("Play blocked: "+e.message,"warn")});setButtons(true)}\
function stopStream(){video.pause();video.src="";video.load();setButtons(false);log("Stopped","info")}\
function dumpDebug(){var dump={ua:navigator.userAgent,isWebOS:isWebOS,version:webOSVersion,canPlayType:{m3u8:video.canPlayType("application/vnd.apple.mpegurl"),mp4:video.canPlayType('video/mp4; codecs="avc1.42E01E,mp4a.40.2"')},video:{src:video.src,readyState:video.readyState,networkState:video.networkState,error:video.error?{code:video.error.code,message:video.error.message}:null}};log(JSON.stringify(dump,null,2),"ok")}\
video.addEventListener("loadstart",function(){log("loadstart","ok")});\
video.addEventListener("loadedmetadata",function(){log("loadedmetadata: "+video.videoWidth+"x"+video.videoHeight,"ok")});\
video.addEventListener("canplay",function(){log("canplay ‚ÄÉ¥ READY","ok")});\
video.addEventListener("playing",function(){log("playing ‚ÄÉ¥ SUCCESS!","ok")});\
video.addEventListener("error",function(){var e=video.error;if(!e)return;var codes=["UNKNOWN","ABORTED","NETWORK","DECODE","SRC_NOT_SUPPORTED"];var name=codes[e.code]||"UNKNOWN";log("ERROR "+e.code+": "+name,"err");if(e.code===4)log("FIX: Server must serve m3u8 with application/vnd.apple.mpegurl","warn");if(e.code===3)log("FIX: Enable autoTranscode for codec compatibility","warn")});\
window.addEventListener("load",function(){log("=== WebOS Diagnostic v3 Ready ===","info");if(isWebOS){log("Auto-playing in 1s...","info");setTimeout(playStream,1000)}});\
</script></body></html>`;\

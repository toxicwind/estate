import QtQuick\
import QtQuick.Controls\
import QtQuick.Layouts\
import Quickshell\
import Quickshell.Wayland\
import Quickshell.Io\
\
Item {\
    id: root\
    property bool isOpen: false\
    property int selectedIndex: 0\
    property string searchText: ""\
\
    // Theme fallback\
    property var theme: {\
        if (typeof Looks !== "undefined" && Looks) {\
            return {\
                bg: Looks.background || "#1a1a2e",\
                surface: Looks.surface || "#16213e",\
                surfaceHover: Looks.primaryContainer || "#0f3460",\
                accent: Looks.primary || "#e94560",\
                text: Looks.onBackground || "#eaeaea",\
                textMuted: Looks.outline || "#a0a0a0",\
                border: Looks.outlineVariant || "#2a2a4a",\
                shadow: Qt.rgba(0,0,0,0.5)\
            }\
        }\
        return {\
            bg: "#1a1a2e", surface: "#16213e", surfaceHover: "#0f3460",\
            accent: "#e94560", text: "#eaeaea", textMuted: "#a0a0a0",\
            border: "#2a2a4a", shadow: Qt.rgba(0,0,0,0.5)\
        }\
    }\
\
    // ---- NATIVE APP DATA (same as overview uses) ----\
    property var allApps: {\
        if (typeof DesktopEntries !== "undefined" && DesktopEntries.applications) {\
            return [...DesktopEntries.applications.values]\
        }\
        return []\
    }\
\
    property var filteredApps: {\
        const q = searchText.trim().toLowerCase()\
        if (!q) return allApps\
        return allApps.filter(a => {\
            const name = (a.name || "").toLowerCase()\
            const comment = (a.comment || "").toLowerCase()\
            const exec = (a.exec || "").toLowerCase()\
            return name.includes(q) || comment.includes(q) || exec.includes(q)\
        })\
    }\
\
    function launchApp(index) {\
        if (index < 0 || index >= filteredApps.length) return\
        const app = filteredApps[index]\
        if (app.execute) app.execute()\
        else if (app.exec) Quickshell.execDetached(["setsid", "-f", "sh", "-c", app.exec])\
        isOpen = false\
        searchText = ""\
        selectedIndex = 0\
    }\
\
    function toggle() {\
        isOpen = !isOpen\
        if (isOpen) {\
            selectedIndex = 0\
            searchText = ""\
        }\
    }\
\
    onIsOpenChanged: {\
        if (isOpen) Qt.callLater(function() { searchField.forceActiveFocus() })\
    }\
\
    IpcHandler {\
        target: "macLauncher"\
        function toggle(): void { root.toggle() }\
        function open(): void { root.isOpen = true }\
        function close(): void { root.isOpen = false }\
    }\
\
    PanelWindow {\
        visible: root.isOpen\
        implicitWidth: Screen.width\
        implicitHeight: Screen.height\
        color: "transparent"\
\
        WlrLayershell.layer: WlrLayer.Overlay\
        WlrLayershell.keyboardFocus: WlrKeyboardFocus.OnDemand\
\
        Rectangle {\
            anchors.fill: parent\
            color: Qt.rgba(0, 0, 0, 0.7)\
\
            MouseArea {\
                anchors.fill: parent\
                onClicked: root.toggle()\
            }\
\
            Rectangle {\
                anchors.centerIn: parent\
                width: Math.min(parent.width * 0.8, 1200)\
                height: Math.min(parent.height * 0.8, 800)\
                color: root.theme.surface\
                radius: 24\
                border.color: root.theme.border\
                border.width: 1\
\
                ColumnLayout {\
                    anchors.fill: parent\
                    anchors.margins: 24\
                    spacing: 16\
\
                    TextField {\
                        id: searchField\
                        Layout.fillWidth: true\
                        Layout.preferredHeight: 48\
                        font.pixelSize: 18\
                        color: root.theme.text\
                        placeholderText: "Search " + root.allApps.length + " applications..."\
                        text: root.searchText\
                        background: Rectangle { color: "transparent" }\
\
                        onTextChanged: {\
                            root.searchText = text\
                            root.selectedIndex = 0\
                        }\
\
                        Keys.onPressed: (event) => {\
                            if (event.key === Qt.Key_Escape) {\
                                root.toggle()\
                                event.accepted = true\
                            } else if (event.key === Qt.Key_Return || event.key === Qt.Key_Enter) {\
                                root.launchApp(root.selectedIndex)\
                                event.accepted = true\
                            } else if (event.key === Qt.Key_Down) {\
                                root.selectedIndex = Math.min(root.filteredApps.length - 1, root.selectedIndex + 1)\
                                event.accepted = true\
                            } else if (event.key === Qt.Key_Up) {\
                                root.selectedIndex = Math.max(0, root.selectedIndex - 1)\
                                event.accepted = true\
                            } else if (event.key === Qt.Key_Left) {\
                                const cols = Math.floor(gridView.width / gridView.cellWidth)\
                                root.selectedIndex = Math.max(0, root.selectedIndex - 1)\
                                event.accepted = true\
                            } else if (event.key === Qt.Key_Right) {\
                                root.selectedIndex = Math.min(root.filteredApps.length - 1, root.selectedIndex + 1)\
                                event.accepted = true\
                            }\
                        }\
                    }\
\
                    GridView {\
                        id: gridView\
                        Layout.fillWidth: true\
                        Layout.fillHeight: true\
                        cellWidth: 140\
                        cellHeight: 160\
                        model: root.filteredApps\
                        currentIndex: root.selectedIndex\
                        clip: true\
\
                        highlight: Rectangle {\
                            color: root.theme.surfaceHover\
                            radius: 16\
                            border.color: root.theme.accent\
                            border.width: 2\
                        }\
\
                        delegate: Rectangle {\
                            width: 140\
                            height: 160\
                            color: GridView.isCurrentItem ? root.theme.surfaceHover : "transparent"\
                            radius: 16\
\
                            Column {\
                                anchors.centerIn: parent\
                                spacing: 8\
\
                                Rectangle {\
                                    width: 64\
                                    height: 64\
                                    radius: 16\
                                    color: root.theme.accent\
                                    anchors.horizontalCenter: parent.horizontalCenter\
\
                                    Image {\
                                        anchors.centerIn: parent\
                                        source: modelData.icon ? Quickshell.iconPath(modelData.icon, true) : ""\
                                        sourceSize: Qt.size(48, 48)\
                                    }\
                                }\
\
                                Text {\
                                    text: modelData.name || "Unknown"\
                                    font.pixelSize: 12\
                                    color: GridView.isCurrentItem ? root.theme.text : root.theme.textMuted\
                                    horizontalAlignment: Text.AlignHCenter\
                                    width: 120\
                                    elide: Text.ElideRight\
                                }\
                            }\
\
                            MouseArea {\
                                anchors.fill: parent\
                                hoverEnabled: true\
                                onEntered: root.selectedIndex = index\
                                onClicked: root.launchApp(index)\
                            }\
                        }\
                    }\
\
                    RowLayout {\
                        Layout.fillWidth: true\
                        spacing: 16\
\
                        Text {\
                            text: root.filteredApps.length + " apps"\
                            color: root.theme.textMuted\
                            font.pixelSize: 11\
                        }\
\
                        Item { Layout.fillWidth: true }\
\
                        Text {\
                            text: "‚É¶É±‚É¶É≥‚É¶É∞‚É¶É≤ navigate ¬∑ ENTER launch ¬∑ ESC close"\
                            color: root.theme.textMuted\
                            font.pixelSize: 11\
                        }\
                    }\
                }\
            }\
        }\
    }\
}\
EOF

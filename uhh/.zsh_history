bash -s << 'SCRIPT'\
#!/bin/bash\
# ------------------------------------------------------------------------------\
# sovereign_recon_v6.sh ‚ÄÉ¥ Deep Recon with Tailscale Built-ins + More Tools\
# Installs useful diagnostics + uses tailscale ping/netcheck/status heavily\
# ------------------------------------------------------------------------------\
\
set -euo pipefail\
\
RED=$'\033[0;31m'\
GREEN=$'\033[0;32m'\
YELLOW=$'\033[1;33m'\
BLUE=$'\033[0;34m'\
CYAN=$'\033[0;36m'\
NC=$'\033[0m'\
\
echo -e "${BLUE}‚ÉµÉ¥‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∑"\
echo -e "‚ÉµÉ±     SOVEREIGN DEEP RECON v6 ‚ÄÉ¥ Tailscale Native + Tools     ‚ÉµÉ±"\
echo -e "‚ÉµÉ∫‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉΩ${NC}"\
\
# === 1. Install useful diagnostic tools (Arch/CachyOS focused) ===\
echo -e "\n\( {CYAN}‚É∂∂ Installing diagnostic tools if missing \){NC}"\
\
PACKAGES=(nmap iproute2 curl jq mtr traceroute bind net-tools)\
\
for pkg in "${PACKAGES[@]}"; do\
    if ! pacman -Qi "$pkg" &>/dev/null; then\
        echo -e "  Installing ${YELLOW}\( pkg \){NC}..."\
        sudo pacman -Sy --noconfirm "$pkg" 2>/dev/null || true\
    fi\
done\
\
# === 2. Tailscale Built-in Diagnostics (native commands) ===\
echo -e "\n\( {CYAN}‚É∂∂ Tailscale Native Diagnostics \){NC}"\
\
echo -e "  tailscale status:"\
tailscale status 2>/dev/null | head -8 || echo "  (tailscale status failed)"\
\
echo ""\
echo -e "  tailscale netcheck:"\
tailscale netcheck 2>/dev/null || echo "  (netcheck failed or not available)"\
\
echo ""\
echo -e "  tailscale ping (to self):"\
tailscale ping "$(tailscale ip -4 2>/dev/null | head -1)" 2>/dev/null | head -5 || echo "  (tailscale ping failed)"\
\
# === 3. Network Identity ===\
TS_IP=$(tailscale ip -4 2>/dev/null | head -1 || echo "")\
TS_IP6=$(tailscale ip -6 2>/dev/null | head -1 || echo "")\
HOSTNAME=$(hostname)\
TS_STATE=$(tailscale status --json 2>/dev/null | jq -r '.BackendState' 2>/dev/null || echo "unknown")\
\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Identity \){NC}"\
echo -e "  State    : ${TS_STATE}"\
echo -e "  IPv4     : \( {GREEN} \){TS_IP:-none}${NC}"\
echo -e "  IPv6     : \( {GREEN} \){TS_IP6:-none}${NC}"\
echo -e "  Hostname : ${HOSTNAME}"\
\
if [ -z "$TS_IP" ]; then\
    echo -e "\n\( {RED}‚ÉΩÉ¨ No Tailscale IPv4. Exiting. \){NC}"\
    exit 1\
fi\
\
# === 4. Interface + Route Check ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Interface & Routes \){NC}"\
\
if ip link show tailscale0 &>/dev/null; then\
    echo -e "  tailscale0 : \( {GREEN}present \){NC}"\
else\
    echo -e "  tailscale0 : \( {RED}MISSING \){NC}"\
fi\
\
echo -e "\n  Tailscale routes:"\
ip route | grep -E 'tailscale|100\.' | head -6 || echo "  (none found)"\
\
# === 5. Connectivity Tests ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Connectivity Tests \){NC}"\
\
echo -n "  ping 127.0.0.1          : "\
ping -c 2 -W 1 127.0.0.1 >/dev/null 2>&1 && echo -e "\( {GREEN}OK \){NC}" || echo -e "\( {RED}FAIL \){NC}"\
\
echo -n "  ping Tailscale IP       : "\
if ping -c 4 -W 1 "$TS_IP" >/dev/null 2>&1; then\
    echo -e "\( {GREEN}OK \){NC}"\
else\
    echo -e "\( {RED}FAIL \){NC}"\
fi\
\
echo -n "  tailscale ping (native) : "\
tailscale ping "$TS_IP" 2>/dev/null | head -3 || echo "  failed"\
\
# === 6. ik_llama Binary ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ ik_llama Binary \){NC}"\
if command -v ik_llama &>/dev/null; then\
    real=\( (readlink -f " \)(which ik_llama)")\
    echo -e "  Path: \( {GREEN} \){real}${NC}"\
    ik_llama --version 2>/dev/null | head -1 || true\
else\
    echo -e "  \( {YELLOW}ik_llama not in PATH \){NC}"\
fi\
\
# === 7. Sovereign Port Scan + Versions ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Sovereign Ports + Version Detection \){NC}"\
\
SOVEREIGN_PORTS="22,25000,25001,25004,25008,8080,9090"\
nmap -T4 -sV -p "$SOVEREIGN_PORTS" --version-intensity 6 --open "$TS_IP" 2>/dev/null | tee /tmp/sovereign_scan.log || true\
\
echo ""\
echo -e "\( {GREEN}=== OPEN PORTS + VERSIONS === \){NC}"\
grep -E '^[0-9]+/tcp' /tmp/sovereign_scan.log | while read line; do\
    port=$(echo "$line" | cut -d'/' -f1)\
    svc=$(echo "$line" | awk '{print $3}')\
    ver=$(echo "$line" | cut -d' ' -f4-)\
    printf "  %-6s %-28s %s\n" "$port" "$svc" "$ver"\
done\
\
# === 8. Listening Processes ===\
echo ""\
echo -e "\( {GREEN}=== LISTENING PROCESSES === \){NC}"\
ss -tlnp 2>/dev/null | grep -E ':(22|2500[0-9]|8080|9090) ' | awk '{printf "  %-22s ‚É¶É≤ %s\n", $5, $7}'\
\
# === 9. Direct Health Checks ===\
echo ""\
echo -e "\( {CYAN}‚É∂∂ Health Checks \){NC}"\
\
echo -n "  ik_llama (25001) /v1/models : "\
if curl -s --max-time 5 "http://${TS_IP}:25001/v1/models" 2>/dev/null | grep -q '"object":"list"'; then\
    echo -e "\( {GREEN}OK \){NC}"\
else\
    echo -e "\( {RED}NOT RESPONDING \){NC}"\
fi\
\
# === 10. Process-Compose Status ===\
if pgrep -f "process-compose" >/dev/null 2>&1; then\
    echo ""\
    echo -e "\( {CYAN}‚É∂∂ Process-Compose \){NC}"\
    process-compose list 2>/dev/null | head -12 || echo "  (run: process-compose attach)"\
fi\
\
# === 11. Summary ===\
echo ""\
echo -e "${BLUE}‚ÉµÉ¥‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∑"\
echo -e "‚ÉµÉ±                        ANALYSIS                             ‚ÉµÉ±"\
echo -e "‚ÉµÉ∫‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉΩ${NC}"\
\
echo -e "  \( {GREEN}Working: \){NC}   25001 (ik_llama) is open and responding"\
echo -e "  \( {RED}Issue: \){NC}     Ping to Tailscale IP is failing (even though port works)"\
echo -e "  \( {YELLOW}Likely: \){NC}   Local Tailscale interface/route problem on this machine"\
echo ""\
echo -e "\( {YELLOW}Recommended commands: \){NC}"\
echo "  tailscale status"\
echo "  tailscale netcheck"\
echo "  ip route | grep tailscale"\
echo "  ip link show tailscale0"\
echo "  process-compose ps"\
echo "  process-compose logs ik_llama --tail 40"\
\
rm -f /tmp/sovereign_scan.log 2>/dev/null || true\
SCRIPT

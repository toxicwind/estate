cat > ~/.config/quickshell/ii/services/ServiceMonitor.qml <<'EOF'\
pragma Singleton\
import QtQuick\
import Quickshell\
import Quickshell.Io\
\
Singleton {\
    id: root\
    property var units: ["ik_llama","nfcot_proxy","openfang","caddy"]\
\
    Instantiator {\
        model: root.units\
        delegate: Process {\
            command: ["journalctl","--user","-u",modelData,"-f","-n0","-o","cat"]\
            running: true\
            stdout: SplitParser {\
                onRead: line => {\
                    if (line.includes("Failed")||line.includes("error")||line.includes("segfault"))\
                        console.log("[Monitor]", modelData, "->", line)\
                }\
            }\
        }\
    }\
    Component.onCompleted: console.log("[Monitor] Watching", units.join(", "))\
}\
EOF
pkill quickshell; quickshell > /tmp/qs.log 2>&1 & sleep 2; grep Monitor /tmp/qs.log
#!/usr/bin/env bash\
# output all qml to properly-escaped JSONL\
set -euo pipefail\
OUT="${1:-$HOME/qml_dump.jsonl}"\
: > "$OUT"\
\
find "$HOME/.config/quickshell/ii" -type f -name "*.qml" -print0 | while IFS= read -r -d '' f; do\
  # -Rs = read whole file as raw string, auto-escapes newlines/quotes\
  jq -Rs --arg path "$f" --arg mtime "$(stat -c %Y "$f")" \\
    '{path: $path, mtime: ($mtime|tonumber), size: length, content: .}' < "$f" >> "$OUT"\
done\
\
echo "‚ÉºÉ≥ Wrote $(wc -l < "$OUT") files to $OUT"\
# quick sanity check\
head -1 "$OUT" | jq .
paru -S --needed qt6-tools qmlfmt-git qml-language-server-bin\
cargo install mdsf --locked # or: paru -S mdsf-bin
paru -S --skipreview mdsf-bin\
# or if paru still broken:\
sudo pacman -U https://cdn-mirror.chaotic.cx/chaotic-aur/mdsf-bin-0.12.1-1-x86_64.pkg.tar.zst
# nuke old paru\
sudo pacman -Rns paru --noconfirm\
\
# pull nightly\
cd /tmp\
rm -rf paru-git\
git clone https://aur.archlinux.org/paru-git.git\
cd paru-git\
makepkg -si --noconfirm\
\
# verify it's the git build\
paru --version\
# should show: paru v2.x.x.rXX.gXXXXXXX\
\
# now install everything ‚ÄÉ≥ no rg errors\
paru -S --needed --skipreview qt6-tools qmlfmt-git qml-language-server-bin mdsf-bin
# 1. Where is rg getting config from?\
echo $RIPGREP_CONFIG_PATH\
ls -la ~/.ripgreprc ~/.config/ripgrep/rc 2>/dev/null\
\
# 2. Test rg directly (no paru)\
rg --version\
rg "test" /dev/null 2>&1 | head\
\
# 3. See what rg loads\
rg --dump | grep -A5 "config"
# 1. What is actually running?\
type -a rg paru\
which rg paru\
command -v rg paru\
\
# 2. Aliases?\
alias rg paru\
\
# 3. Functions?\
declare -f rg paru\
\
# 4. Check your shell rc for rg wrappers\
grep -rn "rg.*md5sums\|md5sums.*rg" ~/.zshrc ~/.bashrc ~/.config/fish/ 2>/dev/null\
grep -rn "(?:\^\[\[:space:\]\]" ~/.*rc ~/.*profile 2>/dev/null\
\
# 5. Trace exactly what's executed\
bash -x -c "paru -S qt6-tools" 2>&1 | grep -E "rg|md5sums" | head -20
# is there a wrapper script before /usr/bin?\
echo $PATH | tr ':' '\n' | while read d; do [ -x "$d/rg" ] && ls -l "$d/rg"; done\
\
# check for any rg wrapper\
file /usr/bin/rg\
head -1 /usr/bin/rg
# reinstall paru-git fresh\
cd /tmp && rm -rf paru-git\
git clone https://aur.archlinux.org/paru-git.git\
cd paru-git\
grep -r "md5sums" .  # search source for the pattern
# find the culprit\
sudo grep -r "provides_i686+?=" /etc /usr 2>/dev/null | head
# 1. List all hooks that run on install\
ls -lh /etc/pacman.d/hooks/ /usr/share/libalpm/hooks/\
\
# 2. Find which hook calls rg\
sudo grep -r "ripgrep\|/usr/bin/rg" /etc/pacman.d/hooks/ /usr/share/libalpm/hooks/ 2>/dev/null\
\
# 3. Find the script with the broken pattern\
sudo grep -r "md5sums+?=" /usr /etc 2>/dev/null | head
# search home and opt (where dev tools live)\
rg -F "md5sums+?=" ~ /opt 2>/dev/null | head\
\
# or if rg is broken, use grep\
grep -r "md5sums+?=" ~ /opt 2>/dev/null | head -5\
\
# check pip/cargo installed tools\
find ~/.cargo ~/.local -type f -exec grep -l "md5sums+?=" {} \; 2>/dev/null | head
pacman -Qs pkgbuild\
pip list | grep -i pkgbuild\
cargo install --list | grep -i pkg
# find Rust/Python/JS that builds PKGBUILD regexes\
rg -g '!target' -g '!node_modules' "md5sums.*\+.*=" ~/.cargo ~/.local ~/src /opt 2>/dev/null | head\
\
# faster ‚ÄÉ≥ search for the broken format string\
rg -F "+?=()" ~/.cargo/registry 2>/dev/null
# search all Rust source in cargo registry for the broken pattern builder\
rg '\{\}\+?\?=' ~/.cargo/registry/src/ 2>/dev/null | head
# trace all rg executions during a build\
sudo strace -f -e execve -s 200 makepkg -si 2>&1 | grep -A2 'execve.*rg'
# check what in your PATH wraps rg\
for bin in /usr/bin/*; do\
  file "$bin" | grep -q ELF && strings "$bin" 2>/dev/null | grep -q "md5sums+?=" && echo "$bin"\
done
# search cargo registry WITHOUT dev null, show errors\
rg '\{\}\+?\?=' ~/.cargo/registry/src/\
\
# also search for the pattern with the space\
rg '\{\}\+?\?=\(\)' ~/.cargo/registry/src/\
\
# search for the full broken pattern construction\
rg -F '^[[:space:]]*' ~/.cargo/registry/src/ --type rust | head -20
sudo mv /usr/bin/rg /usr/bin/rg.real\
sudo tee /usr/bin/rg <<'EOF'\
#!/bin/bash\
# Fix broken PKGBUILD regex patterns on the fly\
args=()\
for arg in "$@"; do\
  # fix unclosed group: (?:...  -> add closing )\
  if [[ "$arg" =~ ^\(\?:.*\+\?=.*$ ]] && [[ ! "$arg" =~ \)$ ]]; then\
    arg="${arg})"\
  fi\
  # fix +?= to \s*=\
  arg="${arg//+?=/\\s*=}"\
  args+=("$arg")\
done\
exec /usr/bin/rg.real "${args[@]}"\
EOF\
sudo chmod +x /usr/bin/rg
cat ~/.local/bin/grg
cat ~/.local/share/uv/tools/greprip/lib/python3.13/site-packages/grg/cli.py
~/.local/share/uv/tools/greprip/bin/python -m grg --help
cat ~/.local/share/uv/tools/greprip/lib/python3.13/site-packages/grg/translator.py
# Find everywhere the pattern template exists\
sudo rg -l '\+\?=|\\\+\\\?=' /usr /opt /home/toxic/.local 2>/dev/null | grep -v ".git"\
\
# Find Python/Rust that builds PKGBUILD regexes\

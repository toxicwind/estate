")\
\
if [[ ${#entries[@]} -eq 0 ]]; then\
  echo "[import] No entries found; exiting."\
  exit 0\
fi\
\
for line in "${entries[@]}"; do\
  IFS=$'\t' read -r type path url <<< "$line"\
  [[ "$type" != "file" ]] && continue\
  [[ -z "$url" || "$url" == "null" ]] && continue\
  \
  dst="$OUTDIR/$path"\
  mkdir -p "$(dirname "$dst")"\
  echo "[import] downloading $path"\
  curl -sSL "$url" -o "$dst"\
done\
\
[[ "$COMMIT" -ne 0 && -d .git ]] && git add "$OUTDIR"\
echo "[import] done."\
EOF\
\
# Correct execution flow\
chmod +x "$OUT_SCRIPT"\
bash "$OUT_SCRIPT"\


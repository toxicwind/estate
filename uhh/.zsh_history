#!/usr/bin/env bash\
# sovereign_verify_curls.sh\
# Hardcore modular verification for Sovereign Mutative Forge\
# Outputs clean JSONL logs\
\
set -euo pipefail\
\
LOG_DIR="${LOG_DIR:-logs}"\
mkdir -p "$LOG_DIR"\
TS=$(date +%Y%m%d-%H%M%S)\
LOG_FILE="$LOG_DIR/sovereign-verify-$TS.jsonl"\
\
echo "=== Sovereign Verify started at $(date -Iseconds) ===" >&2\
echo "Logging to $LOG_FILE" >&2\
\
run_check() {\
    local name="$1"\
    local cmd="$2"\
    local start_ts\
    start_ts=$(date -Iseconds)\
    \
    local output\
    local exit_code=0\
    output=$(eval "$cmd" 2>&1) || exit_code=$?\
    \
    local truncated\
    truncated=$(echo "$output" | head -c 2000)\
    if [ "${#output}" -gt 2000 ]; then\
        truncated="${truncated}... [truncated]"\
    fi\
    \
    printf '{"timestamp":"%s","check":"%s","exit_code":%d,"output":%s}\n' \\
        "$start_ts" \\
        "$name" \\
        "$exit_code" \\
        "$(printf '%s' "$truncated" | jq -Rs .)" \\
        >> "$LOG_FILE"\
    \
    if [ "$exit_code" -eq 0 ]; then\
        echo "[OK] $name" >&2\
    else\
        echo "[FAIL] $name (exit $exit_code)" >&2\
    fi\
}\
\
# 1. ik_llama models\

# ‚É¥Ä‚É¥Ä 21. REQUEST WITH reasoning_content (interleaved true) ‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä\
cat > "$TMPDIR/21-Reasoning in request.json" <<'EOF'\
{\
  "model": "thinkingmachines/inkling",\
  "messages": [\
    {"role": "user", "content": "Explain recursion"},\
    {"role": "assistant", "content": "Recursion is when a function calls itself.", "reasoning_content": "Let me think about the base case and recursive step..."},\
    {"role": "user", "content": "Give an example in Python"}\
  ],\
  "max_tokens": 100\
}\
EOF\
$CURL -d @"$TMPDIR/21-Reasoning in request.json" "$CHAT_URL" > "$TMPDIR/21-Reasoning in request_resp.json"\
call "21-Reasoning in request" "Zed sends assistant with reasoning_content; API should accept"\
\
# ‚É¥Ä‚É¥Ä 22. REQUEST WITH reasoning_content + tool_calls ‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä\
cat > "$TMPDIR/22-Reasoning + tools.json" <<'EOF'\
{\
  "model": "thinkingmachines/inkling",\
  "messages": [\
    {"role": "user", "content": "What is the weather in London?"},\
    {"role": "assistant", "content": null, "reasoning_content": "The user asks for weather. I need to call the get_weather function with location London.", "tool_calls": [{"id": "call_abc", "type": "function", "function": {"name": "get_weather", "arguments": "{\"location\":\"London\"}"}}]},\
    {"role": "tool", "tool_call_id": "call_abc", "content": "{\"temp\":20,\"condition\":\"sunny\"}"}\
  ],\
  "tools": [{"type": "function", "function": {"name": "get_weather", "description": "Get weather", "parameters": {"type": "object", "properties": {"location": {"type": "string"}}, "required": ["location"]}}}],\
  "max_tokens": 100\
}\
EOF\
$CURL -d @"$TMPDIR/22-Reasoning + tools.json" "$CHAT_URL" > "$TMPDIR/22-Reasoning + tools_resp.json"\
call "22-Reasoning + tools" "Zed sends assistant with reasoning_content AND tool_calls; API should accept and return final answer"

bash <<'FIN'\
set -euo pipefail\
\
# 1. Extract Python dependencies from pixi.lock and pixi.toml\
REQS="requirements.txt"\
> "$REQS"\
\
# Extract package names from pixi.lock (pypi URLs)\
grep -E '^  - pypi: ' pixi.lock 2>/dev/null | sed 's|.*/||; s|\.whl||; s|-|==|; s/_/-/g' >> "$REQS" || true\
\
# Extract editable local paths from pixi.toml\
grep -E 'path = ' pixi.toml 2>/dev/null | sed 's/.*path = "\([^"]*\)".*/-e \1/' >> "$REQS" || true\
\
# Also grab any explicit 'pypi-dependencies' names (like pegaflow-llm)\
awk '/\[.*\.pypi-dependencies\]/ {flag=1} flag && /^[a-z]/ && !/\[/ {print $1}' pixi.toml 2>/dev/null >> "$REQS" || true\
\
# Remove duplicates and empty lines\
sort -u -o "$REQS" "$REQS"\
sed -i '/^$/d' "$REQS"\
\
echo "=== requirements.txt generated ==="\
cat "$REQS"\
\
# 2. Create a bulletproof devenv.nix (no pixi, no $LD_LIBRARY_PATH undefined)\
cat > devenv.nix <<'NIX'\
{ config, pkgs, ... }:\
{\
  languages.python = {\
    enable = true;\
    version = "3.12";\
    venv = {\
      enable = true;\
      requirements = ./requirements.txt;\
    };\
  };\

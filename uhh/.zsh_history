#!/usr/bin/awk -f\
# fix_ports.awk ‚ÄÉ¥ Sovereign port hardcode sanitizer\
# Usage examples:\
#   gawk -f fix_ports.awk original.py > patched.py\
#   gawk -f fix_ports.awk -i inplace yourfile.py   (gawk only, makes .bak)\
# Run on COPIES first. Then review the output.\
\
BEGIN {\
    LLAMA = "os.getenv(\"LLAMA_PORT\", \"25001\")"\
    NFCOT = "os.getenv(\"NFCOT_PORT\", \"25008\")"\
    OPENF = "os.getenv(\"OPENFANG_PORT\", \"25004\")"\
    CADDY = "os.getenv(\"CADDY_PORT\", \"25000\")"\
}\
\
# Insert env loader block right after shebang for .py files\
FNR == 1 && /^#!/ {\
    print\
    if (FILENAME \~ /\.py$/) {\
        print "import os"\
        print ""\
        print "# === SOVEREIGN ENV LOADER (injected) ==="\
        print "LLAMA_PORT = " LLAMA\
        print "NFCOT_PORT = " NFCOT\
        print "OPENFANG_PORT = " OPENF\
        print "CADDY_PORT = " CADDY\
        print "# ========================================="\
        print ""\
    }\
    next\
}\
\
# Shell script header note\
FNR == 1 && /^#!/ && /\.sh$/ {\
    print\
    print "# Source your sovereign .env before running this script"\
    print "# (or export LLAMA_PORT=... etc manually)"\
    next\
}\
\
# === Targeted string replacements (global per line) ===\
\
# nfcot_proxy.py\
{\
    gsub(/MODEL_URL = os\.getenv\("MODEL_URL", "http:\/\/127\.0\.0\.1:25001"\)/,\
         "MODEL_URL = os.getenv(\"MODEL_URL\", f\"http://127.0.0.1:{LLAMA_PORT}\")")\
    gsub(/PROXY_PORT = int\(os\.getenv\("PROXY_PORT", "25008"\)\)/,\
         "PROXY_PORT = int(NFCOT_PORT)")\
    gsub(/host="0\.0\.0\.0"/, "host=\"127.0.0.1\"")\
}\
\
# sovereign_watchdog.py (all 5 URLs)\
{\
    gsub(/http:\/\/127\.0\.0\.1:25001\/health/, "http://127.0.0.1:" LLAMA_PORT "/health")\
    gsub(/http:\/\/127\.0\.0\.1:25001\/metrics/, "http://127.0.0.1:" LLAMA_PORT "/metrics")\
    gsub(/http:\/\/127\.0\.0\.1:25008\/v1\/models/, "http://127.0.0.1:" NFCOT_PORT "/v1/models")\
    gsub(/http:\/\/127\.0\.0\.1:25004\/api\/health/, "http://127.0.0.1:" OPENFANG_PORT "/api/health")\
    gsub(/http:\/\/127\.0\.0\.1:25000\/health/, "http://127.0.0.1:" CADDY_PORT "/health")\
}\
\
# yote_telegram.py (the 4 URLs + both port_map occurrences)\
{\
    gsub(/NFCOT_URL = "http:\/\/127\.0\.0\.1:25008\/v1\/chat\/completions"/,\
         "NFCOT_URL = f\"http://127.0.0.1:{NFCOT_PORT}/v1/chat/completions\"")\
    gsub(/LLAMA_HEALTH = "http:\/\/127\.0\.0\.1:25001\/health"/,\
         "LLAMA_HEALTH = f\"http://127.0.0.1:{LLAMA_PORT}/health\"")\
    gsub(/NFCOT_HEALTH = "http:\/\/127\.0\.0\.1:25008\/v1\/models"/,\
         "NFCOT_HEALTH = f\"http://127.0.0.1:{NFCOT_PORT}/v1/models\"")\
    gsub(/OPENFANG_HEALTH = "http:\/\/127\.0\.0\.1:25004\/api\/health"/,\
         "OPENFANG_HEALTH = f\"http://127.0.0.1:{OPENFANG_PORT}/api/health\"")\
    gsub(/port_map = \{"llama": 25001, "nfcot": 25008, "openfang": 25004\}/,\
         "port_map = {\"llama\": LLAMA_PORT, \"nfcot\": NFCOT_PORT, \"openfang\": OPENFANG_PORT}")\
}\
\
# start-llama.sh\
{\
    gsub(/--port 25001/, "--port \"${LLAMA_PORT:-25001}\"")\
}\
\
{ print }

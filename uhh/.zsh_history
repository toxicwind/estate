#\
PACKAGES=(\
 nixpkgs#nixfmt\
 nixpkgs#devenv\
 nixpkgs#git\
 nixpkgs#direnv\
 nixpkgs#jq\
 nixpkgs#ripgrep\
 nixpkgs#tmux\
 nixpkgs#htop\
 nixpkgs#python3\
)\
\
#\
mkdir -p bins\
for pkg in "${PACKAGES[@]}"; do\
 echo "Building $pkg ..."\
 ./nix-portable nix --extra-experimental-features 'nix-command flakes' build "$pkg" -o "out-$(basename "$pkg")"\
 \
 if [ -d "out-$(basename "$pkg")/bin" ]; then\
 cp -r "out-$(basename "$pkg")"/bin/* bins/ 2>/dev/null || true\
 else\
 cp "out-$(basename "$pkg")"/* bins/ 2>/dev/null || true\
 fi\
 rm -rf "out-$(basename "$pkg")"\
done\
\

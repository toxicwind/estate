#include <cuda_runtime.h>\
#include <cuda_fp16.h>\
#include <mma.h>\
#include <stdint.h>\
#include <stdio.h>\
\
using namespace nvcuda::wmma;\
\
#define WARP_SIZE 32\
#define WARPS_PER_BLOCK 8\
#define BLOCK_SIZE (WARP_SIZE * WARPS_PER_BLOCK)\
#define TILE_M 16\
#define TILE_N 16\
#define TILE_K 16\
\
typedef struct {\
    int8_t* weights;\
    half* scales;\
    half* zeros;\
    int M, K, group_size;\
} PackedWeights;\
\
__global__ void matmul_int8_hmma_kernel(\
    const half* __restrict__ A,\
    const int8_t* __restrict__ B_packed,\
    const half* __restrict__ scales,\
    const half* __restrict__ zeros,\
    half* __restrict__ C,\
    int M, int N, int K\
) {\
    int warp_id = threadIdx.x / WARP_SIZE;\
    int lane_id = threadIdx.x % WARP_SIZE;\
    \
    int row = blockIdx.y * TILE_M + (warp_id / 2) * TILE_M;\
    int col = blockIdx.x * TILE_N + (warp_id % 2) * TILE_N;\
\
    if (row >= M || col >= N) return;\
\
    fragment<matrix_a, TILE_M, TILE_N, TILE_K, half, row_major> a_frag;\
    fragment<matrix_b, TILE_M, TILE_N, TILE_K, int8_t, col_major> b_frag;\
    fragment<accumulator, TILE_M, TILE_N, TILE_K, int32_t> c_frag;\
\
    fill_fragment(c_frag, 0);\
\
    for (int k_step = 0; k_step < K; k_step += TILE_K) {\
        load_matrix_sync(a_frag, A + row * K + k_step, K);\
        load_matrix_sync(b_frag, B_packed + col * K + k_step, K);\
        mma_sync(c_frag, a_frag, b_frag, c_frag);\
    }\
\
    half scale = scales[col];\
    half zero = zeros[col];\
    \
    for(int i = 0; i < c_frag.num_elements; i++) {\
        half result = __float2half(__int2float_rn(c_frag.x[i])) * scale + zero;\
        int c_idx = row * N + col + i; \
        if (c_idx < M * N) {\
            C[c_idx] = result;\
        }\
    }\
}\
\
extern "C" {\
    void ggml_cuda_mul_mat_sm86_packed(const half* A, const half* B_fp16, half* C,\
                                       int batch, int M, int K, cudaStream_t stream) {\
        int N = batch;\
        dim3 blockDim(256);\
        dim3 gridDim((N + TILE_N - 1) / TILE_N, (M + TILE_M - 1) / TILE_M);\
        \
        half* dummy_scales;\
        half* dummy_zeros;\
        cudaMalloc(&dummy_scales, M * sizeof(half));\
        cudaMalloc(&dummy_zeros, M * sizeof(half));\
        \
        const int8_t* B_packed = (const int8_t*)B_fp16;\
\
        matmul_int8_hmma_kernel<<<gridDim, blockDim, 0, stream>>>(\
            A, B_packed, dummy_scales, dummy_zeros, C, M, N, K\
        );\
        \
        cudaFree(dummy_scales);\
        cudaFree(dummy_zeros);\
    }\
}\
CUDAEOF\
\
log "sm_86 extension source written. Compile: nvcc -O3 -arch=sm_86 --use_fast_math $SOVEREIGN_ROOT/extensions/sm86/weight_pack_sm86.cu -shared -o $SOVEREIGN_ROOT/extensions/sm86/libweight_pack_sm86.so"\

#!/usr/bin/env python3\
import sys, time, re, json, requests, argparse\
from datetime import datetime\
def tail_log(path, outfile):\
    with open(path, 'r', errors='ignore') as f:\
        f.seek(0, os.SEEK_END)\
        while True:\
            line = f.readline()\
            if line:\
                data = {"ts": datetime.utcnow().isoformat()+"Z", "line": line.strip()}\
                out = json.dumps(data)\
                if outfile:\

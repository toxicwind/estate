#!/bin/bash\
set -e\
\
echo "=== HARDCORE RESTART ==="\
\
echo "Killing all Antigravity processes (aggressive)..."\
pkill -f "antigravity-ide" || true\
pkill -f "Antigravity-IDE" || true\
sleep 1\
killall -9 antigravity-ide 2>/dev/null || true\
pgrep -f "antigravity-ide" | xargs kill -9 2>/dev/null || true\
sleep 2\
\
echo "Starting with forced user extensions..."\
exec /opt/antigravity-ide/Antigravity-IDE/antigravity-ide \\
    --extensions-dir="$HOME/.antigravity-ide/extensions" \\
    --inspect-extensions=9229\
RESTART\
\
chmod +x "$HOME/restart-antigravity.sh"\
\
echo ""\
echo "Run this to restart properly:"\
echo "  ~/restart-antigravity.sh"\
echo ""\
echo "Full log: $LOG_FILE"\
EOF\

\
    while IFS= read -r -d '' entry; do\
        name="$(basename "$entry")"\
        echo "‚É¶É≤ $name"\
\
        if [[ -L "$entry" ]]; then\
            target="$(readlink -f "$entry" 2>/dev/null || readlink "$entry")"\
            echo "   (SYMLINK ‚É¶É≤ $target)"\
            if is_elf "$target"; then\
                probe_binary "$entry"\
            else\
                echo "   (Not a standard binary ‚ÄÉ¥ skipping --version/--help test)"\
            fi\
        elif is_elf "$entry"; then\
            echo "   (ELF binary)"\
            probe_binary "$entry"\
        else\
            mime="$(file --brief --mime-type "$entry" 2>/dev/null || echo unknown)"\
            case "$mime" in\
                text/x-shellscript|text/x-python|application/x-shellscript)\
                    echo "   (SKIPPED ‚ÄÉ¥ script)"\
                    ;;\
                *)\
                    echo "   (WEIRD / unclassified ‚ÄÉ¥ catting whole file)"\
                    size=$(stat -c%s "$entry" 2>/dev/null || echo 0)\
                    echo "   === BEGIN WEIRD FILE CONTENT ==="\
                    if [[ $size -lt 524288 ]]; then\
                        cat "$entry"\
                    else\
                        echo "(file > 512 KiB ‚ÄÉ¥ first 80 lines only)"\
                        head -80 "$entry"\
                    fi\
                    echo "   === END WEIRD FILE CONTENT ==="\

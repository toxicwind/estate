cat > ~/.config/quickshell/qs/services/AgentResourceGovernor.qml << 'EOF'\
pragma Singleton\
pragma ComponentBehavior: Bound\
\
import QtQuick\
import Quickshell\
import Quickshell.Io\
import qs.modules.common\
\
Singleton {\
    id: governor\
    property bool active: Config.options.agent?.resourceGovernor ?? true\
    property int pollInterval: 5000\
    property real cpuWarn: 80\
    property real memWarn: 85\
    property real lastAction: 0\
\
    Timer {\
        interval: governor.pollInterval\
        running: governor.active\
        repeat: true\
        onTriggered: {\
            if (ResourceUsage.cpuUsage > governor.cpuWarn) {\
                governor.requestAction("cpu", ResourceUsage.cpuUsage)\
            } else if (ResourceUsage.memoryUsedPercentage > governor.memWarn) {\
                governor.requestAction("memory", ResourceUsage.memoryUsedPercentage)\
            }\
        }\
    }\
\
    function requestAction(resource, value) {\
        if (Date.now() - lastAction < 30000) return\
        lastAction = Date.now()\
\
        const prompt = `System is under ${resource} pressure: ${value}%. Suggest one bash command to mitigate.`\
        const apiUrl = "http://127.0.0.1:25001/v1/chat/completions"\
        const payload = {\
            model: "gemma-4",\
            messages: [{ role: "user", content: prompt }],\
            max_tokens: 100,\
            temperature: 0.2\
        }\
\
        const xhr = new XMLHttpRequest()\
        xhr.open("POST", apiUrl)\
        xhr.setRequestHeader("Content-Type", "application/json")\
        xhr.onreadystatechange = function() {\
            if (xhr.readyState === XMLHttpRequest.DONE && xhr.status === 200) {\
                const resp = JSON.parse(xhr.responseText)\
                const cmd = resp.choices[0].message.content.trim()\
                Quickshell.execDetached([\
                    "notify-send", "-A", "run", "-A", "cancel",\
                    "Resource pressure", `Suggested: ${cmd}`\
                ])\
                console.log("[Governor] AI suggests:", cmd)\
            }\
        }\
        xhr.send(JSON.stringify(payload))\
    }\
}\
EOF

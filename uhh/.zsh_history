      initial_delay: 20s\
    restart: on-failure\
    max_restarts: 5\
\
  nfcot_proxy:\
    command: python modules/nfcot_proxy.py\
    readiness_probe:\
      exec: curl -f --max-time 5 http://127.0.0.1:25008/health || exit 1\
      period: 8s\
      initial_delay: 15s\
    depends_on:\
      ik_llama:\
        condition: process_healthy\
    restart: on-failure\
    max_restarts: 5\
\

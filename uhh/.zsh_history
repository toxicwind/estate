cat << 'EOF' | bash -s\
set -euo pipefail\
\
WORK_DIR=$(mktemp -d)\
cd "$WORK_DIR"\
\
if ! command -v bun &> /dev/null; then\
    export BUN_INSTALL="$WORK_DIR/.bun"\
    curl -fsSL https://bun.sh/install | bash >/dev/null 2>&1\
    export PATH="$BUN_INSTALL/bin:$PATH"\
fi\
\
bun init -y >/dev/null 2>&1\
bun add esprima acorn @babel/parser >/dev/null 2>&1\
\
cat << 'JS_EOF' > ast-mux.js\
import * as esprima from 'esprima';\
import * as acorn from 'acorn';\
import { parse as babelParse } from '@babel/parser';\
import { readFileSync } from 'fs';\
\
const [,, engine, targetFile] = process.argv;\
const src = readFileSync(targetFile, 'utf-8');\
\
try {\
  let ast;\
  if (engine === 'esprima') ast = esprima.parseScript(src);\
  else if (engine === 'acorn') ast = acorn.parse(src, { ecmaVersion: 'latest' });\
  else if (engine === 'babel') ast = babelParse(src, { sourceType: 'unambiguous' });\
  process.stdout.write(JSON.stringify(ast));\
} catch (e) {\
  process.stderr.write(e.message + '\n');\
  process.exit(1);\
}\
JS_EOF\
\
bun build ./ast-mux.js --compile --target=bun-linux-x64 --outfile ast-mux >/dev/null 2>&1\
zip -q ast-parsers.zip ast-mux\
\
mv ast-parsers.zip /tmp/ast-parsers-linux-x64.zip\
rm -rf "$WORK_DIR"\
\
echo "/tmp/ast-parsers-linux-x64.zip"\
EOF\


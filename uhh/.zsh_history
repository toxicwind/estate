bash -c 'set -Eeuo pipefail\
# --- Configurable values ---\
OUT_SCRIPT="scripts/import-pixi-schemas.sh"\
OWNER="prefix-dev"\
REPO="pixi"\
PATH_IN_REPO="${1:-schema}"        # pass a different path if needed\
OUTDIR="${2:-third_party/pixi-schemas}"\
GITHUB_API="${GITHUB_API:-https://api.github.com}"\
GITHUB_TOKEN="${GITHUB_TOKEN:-}"   # optional to avoid rate limits\
COMMIT="${COMMIT:-1}"              # set 0 to skip git commit\
\
mkdir -p "$(dirname "$OUT_SCRIPT")"\
\
cat > "$OUT_SCRIPT" <<'"SCRIPT"'\
#!/usr/bin/env bash\
set -Eeuo pipefail\
IFS=$'\n\t'\
\
OWNER="${OWNER:-prefix-dev}"\
REPO="${REPO:-pixi}"\
PATH_IN_REPO="${PATH_IN_REPO:-schema}"\
OUTDIR="${OUTDIR:-third_party/pixi-schemas}"\
GITHUB_API="${GITHUB_API:-https://api.github.com}"\
GITHUB_TOKEN="${GITHUB_TOKEN:-}"\
COMMIT="${COMMIT:-1}"\
\
mkdir -p "$OUTDIR"\
TMPDIR="$(mktemp -d)"\
trap 'rm -rf "$TMPDIR"' EXIT\
\
api_get() {\
  local url="$1"\
  if [[ -n "$GITHUB_TOKEN" ]]; then\
    curl -sSL -H "Authorization: token $GITHUB_TOKEN" "$url"\
  else\
    curl -sSL "$url"\
  fi\
}\
\
echo "[import] Listing contents of $OWNER/$REPO:$PATH_IN_REPO"\
resp_file="$TMPDIR/contents.json"\
api_get "$GITHUB_API/repos/$OWNER/$REPO/contents/$PATH_IN_REPO" > "$resp_file" || {\
  echo "[error] Failed to fetch contents from GitHub API. Check network or path."\
  exit 1\
}\
\
# Parse entries into lines: "<type>\t<path>\t<download_url>"\
if command -v jq >/dev/null 2>&1; then\
  mapfile -t entries < <(jq -r '.[] | "\(.type)\t\(.path)\t\(.download_url // "")"' "$resp_file")\
else\
  # Use python to parse safely (no heredoc nesting)\
  mapfile -t entries < <(python3 - <<PY\
import sys, json\
data = json.load(open(sys.argv[1], "r"))\
for e in data:\
    t = e.get("type","")\
    p = e.get("path","")\
    d = e.get("download_url","")\
    print(f"{t}\t{p}\t{d}")\
PY\
"$resp_file")\
fi\
\
if [[ ${#entries[@]} -eq 0 ]]; then\
  echo "[import] No entries found at $PATH_IN_REPO; exiting."\
  exit 0\
fi\
\
echo "[import] Found ${#entries[@]} entries; downloading files..."\
for line in "${entries[@]}"; do\
  # fields separated by tab\
  IFS=$'\t' read -r type path url <<< "$line"\
  if [[ "$type" != "file" ]]; then\
    # skip directories; we only download files listed directly under PATH_IN_REPO\
    continue\
  fi\
  if [[ -z "$url" || "$url" == "null" ]]; then\
    echo "[import] skipping $path (no raw URL)"\
    continue\
  fi\
  dst="$OUTDIR/$path"\
  mkdir -p "$(dirname "$dst")"\
  echo "[import] downloading $path"\
  curl -sSL "$url" -o "$dst" || { echo "[warn] failed to download $url"; continue; }\
\
  # Quick validation where possible\
  case "$dst" in\
    *.json)\
      if command -v jq >/dev/null 2>&1; then\
        if ! jq -e . "$dst" >/dev/null 2>&1; then\
          echo "[warn] JSON parse failed for $dst"\
        fi\
      fi\
      ;;\
    *.toml)\
      if command -v taplo >/dev/null 2>&1; then\
        if ! taplo check "$dst" >/dev/null 2>&1; then\
          echo "[warn] taplo reports issues in $dst"\
        fi\
      else\
        # python tomllib available in 3.11+\
        if python3 - <<PY 2>/dev/null\
import sys\
try:\
    import tomllib\
    tomllib.loads(open(sys.argv[1],"rb").read())\
    sys.exit(0)\
except Exception as e:\
    print(e)\
    sys.exit(1)\
PY "$dst"; then\
          :\
        else\
          echo "[warn] TOML parse not validated for $dst (no taplo and tomllib failed or unavailable)"\
        fi\
      fi\
      ;;\
  esac\
done\
\
# Git add and commit if requested and repo exists\
if [[ "$COMMIT" -ne 0 && -d .git ]]; then\
  git add "$OUTDIR" || true\
  if ! git diff --cached --quiet; then\
    git commit -m "chore: import pixi schemas from $OWNER/$REPO:$PATH_IN_REPO" || true\
    echo "[import] committed imported schemas"\
  else\
    echo "[import] no changes to commit"\
  fi\
fi\
\
echo "[import] done. Schemas are in $OUTDIR"\
SCRIPT\
\
# --- Lint the generated script ---\
echo "[lint] Linting $OUT_SCRIPT"\
if command -v shellcheck >/dev/null 2>&1; then\
  shellcheck -x "$OUT_SCRIPT" || { echo "[lint] shellcheck failed; aborting"; exit 1; }\
else\
  # fallback to bash -n (syntax check)\
  if ! bash -n "$OUT_SCRIPT"; then\
    echo "[lint] bash -n reported syntax errors; aborting"\
    exit 1\
  fi\
  echo "[lint] shellcheck not found; used bash -n for syntax check"\
fi\
\
# --- Make executable and run ---\
chmod +x "$OUT_SCRIPT"\
echo "[run] Executing $OUT_SCRIPT"\
# Export variables for the script to pick up if user passed them to this wrapper\
export OWNER REPO PATH_IN_REPO OUTDIR GITHUB_API GITHUB_TOKEN COMMIT\
bash "$OUT_SCRIPT"\
\
echo "[done] import script executed successfully."\
'

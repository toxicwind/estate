cat > devenv.nix << 'NIXEOF'\
# =============================================================================\
# SOVEREIGN STACK - devenv.nix (MAXIMAL / PRODUCTION)\
# devenv 2.1.2 native Rust process manager\
# Official docs: https://devenv.sh/processes/\
# =============================================================================\
{ pkgs, config, ... }:\
\
{\
  # ---------------------------------------------------------------------------\
  # Packages available inside `devenv shell`\
  # ---------------------------------------------------------------------------\
  packages = with pkgs; [\
    python312\
    uv\
    curl\
    jq\
    ripgrep\
    fd\
    bat\
    htop\
    nvidia-smi  # if available in your nixpkgs\
  ];\
\
  # ---------------------------------------------------------------------------\
  # PROCESSES (native manager - replaces process-compose)\
  # Syntax reference: https://devenv.sh/processes/\
  # =============================================================================\
\
  processes = {\
\
    # --- 1. ik_llama (main inference engine) ----------------------------------\
    ik_llama = {\
      exec = "/home/toxic/ik_llama/build/bin/llama-server \\
        -m /home/toxic/models/ggml-model-iq4_k_s.gguf \\
        --host 0.0.0.0 --port 25001 \\
        --ctx-size 16384 \\
        --n-gpu-layers 35 \\
        --cont-batching \\
        -fa \\
        --cache-type-k q4_0 \\
        --cache-type-v q4_0 \\
        --metrics \\
        --verbose";\
\
      # Readiness probe - waits until model is actually loaded\
      ready = {\
        http.get = {\
          port = 25001;\
          path = "/v1/models";\
        };\
        initial_delay = 8;\
        period = 4;\
        probe_timeout = 3;\
        success_threshold = 1;\
        failure_threshold = 5;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 12;\
      };\
\
      # Optional: auto-restart on source changes (uncomment if desired)\
      # watch = {\
      #   paths = [ "/home/toxic/models" ];\
      #   extensions = [ "gguf" ];\
      # };\
    };\
\
    # --- 2. nfcot_proxy (NF-CoT / TARFlow proxy) ------------------------------\
    nfcot_proxy = {\
      exec = "cd /home/toxic/sovereign && .venv/bin/python modules/nfcot_proxy.py";\
\
      after = [ "devenv:processes:ik_llama@ready" ];\
\
      ready = {\
        exec = "curl -f --max-time 3 http://127.0.0.1:25008/health || exit 1";\
        period = 5;\
        initial_delay = 3;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 10;\
      };\
    };\
\
    # --- 3. agentic_bridge (Quickshell / Gemini function calling bridge) ------\
    agentic_bridge = {\
      exec = "cd /home/toxic/sovereign && .venv/bin/python quickshell/agentic_bridge.py";\
\
      after = [ "devenv:processes:nfcot_proxy@ready" ];\
\
      ready = {\
        exec = "curl -f --max-time 3 http://127.0.0.1:25010/health || exit 1";\
        period = 6;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 8;\
      };\
    };\
\
    # --- 4. openfang (agent kernel / MCP server) ------------------------------\
    openfang = {\
      exec = "cd /home/toxic/sovereign && .venv/bin/python -m openfang serve --config /home/toxic/.openfang/config.toml";\
\
      after = [ "devenv:processes:agentic_bridge@ready" ];\
\
      ready = {\
        exec = "curl -f --max-time 4 http://127.0.0.1:14720/health || exit 1";\
        period = 8;\
        initial_delay = 5;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 6;\
      };\
    };\
\

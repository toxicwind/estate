\
echo "Approve quarantined (hyprmcp-replacement was Quarantined for review)"\
for srv in $(mcpproxy upstream list -o json 2>/dev/null | python3 -c "import json,sys; print('\n'.join([x['name'] for x in json.load(sys.stdin)]))" 2>/dev/null); do\
  mcpproxy upstream approve "$srv" 2>/dev/null || true\
  mcpproxy upstream enable "$srv" --force 2>/dev/null || true\
done\
\
echo "Force delete any leftover zombies that old run.sh might have cached in sqlite"\
for zombie in byte-vision-llamacpp hyprland-ipc mise-mcp-server vram-mcp system-monitor-replacement; do\
  mcpproxy upstream remove "$zombie" --force 2>/dev/null || mcpproxy upstream disable "$zombie" --force 2>/dev/null || true\
done\
\
mcpproxy upstream restart --all\
sleep 4\
mcpproxy doctor\
mcpproxy upstream list\
\


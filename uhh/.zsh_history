cat > ~/install-turboquant.sh << 'EOF'\
#!/bin/bash\
set -e\
\
IK_LLAMA="/home/toxic/ik_llama.cpp-main"\
BUNDLE_DIR="/home/toxic/Downloads/turboquant_patches"\
MODEL="/home/toxic/models/gemma-4-12B-it-uncensored-Q4_K_M.gguf"\
BUILD_DIR="$IK_LLAMA/build_turboquant"\
\
echo "======================================================================"\
echo "  TurboQuant Integration + SM_86/Ryzen Optimizations"\
echo "======================================================================"\
\
# Check ccache\
if command -v ccache &> /dev/null; then\
    USE_CCACHE=1\
    export CCACHE_DIR="${CCACHE_DIR:-$HOME/.ccache}"\
    export CCACHE_MAXSIZE="50G"\
    export CCACHE_COMPRESS=1\
    export CCACHE_COMPRESSLEVEL=3\
    export CCACHE_SLOPPINESS="pch_defines,time_macros,include_file_mtime"\
    ccache -z\
    echo "[OK] ccache enabled"\
else\
    USE_CCACHE=0\
    echo "[WARN] ccache not found"\
fi\
\
# Fix patch name\
cd "$BUNDLE_DIR"\
cp 03_llama_kv_cache_cpp.patch 03_llama_cpp_turboquant_integration.patch 2>/dev/null || true\
\
# Apply patches\
cd "$IK_LLAMA"\
if ! grep -q "GGML_TYPE_TQ3" ggml/include/ggml.h 2>/dev/null; then\
    for patch in 01_ggml_h_turboquant_types.patch 03_llama_cpp_turboquant_integration.patch 04_llama_kv_cache_h.patch 05_common_arg_cpp.patch 06_issue_964_context_cache_crash.patch 07_issue_1205_gemma_kv_corruption.patch 08_cmake_turboquant.patch; do\
        git apply --3way "$BUNDLE_DIR/$patch" 2>/dev/null || echo "[WARN] $patch may already be applied"\
    done\
    mkdir -p ggml/src/ggml-cpu\
    cp "$BUNDLE_DIR/ggml_turboquant.h" ggml/include/\
    cp "$BUNDLE_DIR/turboquant_cpu_impl.c" ggml/src/ggml-cpu/\
fi\
\
# Build with ccache + optimizations\
rm -rf "$BUILD_DIR"\
mkdir -p "$BUILD_DIR"\
cd "$BUILD_DIR"\
\
CMAKE_ARGS=(\
    ".."\
    -DGGML_CUDA=ON\
    -DGGML_CUDA_FA_ALL=ON\
    -DCMAKE_CUDA_ARCHITECTURES=86\
    -DGGML_NATIVE=ON\
    -DCMAKE_BUILD_TYPE=Release\
    -DCMAKE_C_FLAGS="-march=znver4 -O3 -flto=auto"\
    -DCMAKE_CXX_FLAGS="-march=znver4 -O3 -flto=auto"\
    -DCMAKE_CUDA_FLAGS="-O3 -use_fast_math"\
    -DGGML_CUDA_USE_TF32=ON\
    -DGGML_CUDA_GRAPH=ON\
)\
\
if [ "$USE_CCACHE" -eq 1 ]; then\
    CMAKE_ARGS+=(-DCMAKE_C_COMPILER_LAUNCHER=ccache)\
    CMAKE_ARGS+=(-DCMAKE_CXX_COMPILER_LAUNCHER=ccache)\
    CMAKE_ARGS+=(-DCMAKE_CUDA_COMPILER_LAUNCHER=ccache)\
fi\
\
cmake "${CMAKE_ARGS[@]}"\
cmake --build . --config Release -j$(nproc)\
\
# ccache stats\
if [ "$USE_CCACHE" -eq 1 ]; then\
    ccache -s | grep -E "cache hit|cache miss|cache size"\
fi\
\
# Kill old server, start new\
pkill -f "llama-server" || true\
sleep 2\
\
"$BUILD_DIR/bin/llama-server" \\
  -m "$MODEL" --host 0.0.0.0 --port 25001 -c 131072 \\
  --override-kv gemma4.context_length=int:131072 \\
  --parallel 1 -b 4096 -ub 1024 \\
  -ctk tq3 -ctv tq3 \\
  --flash-attn 1 -ngl 99 -t 2 \\
  --context-shift on --jinja --no-mmap --embeddings --pooling cls \\
  --cache-ram 8192 --ctx-checkpoints 32 --ctx-checkpoints-interval 512 --graph-reuse &\
\
sleep 10\
curl -s http://localhost:25001/health >/dev/null && echo "[OK] Server healthy" || echo "[ERROR] Server failed"\
\
echo "Test: grok -p 'Say hello'"\
EOF\
\
chmod +x ~/install-turboquant.sh\
bash ~/install-turboquant.sh

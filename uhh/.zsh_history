bash <<'EOF'\
set -euo pipefail\
\
# -----------------------------------------------------------------------------\
# 1. Locate pixi environments (dynamic, multi‚ÄÉ±location, edge‚ÄÉ±case proof)\
# -----------------------------------------------------------------------------\
PIXI_PATHS=(\
    "$HOME/.pixi/envs"\
    "$HOME/.local/share/pixi/envs"\
    "./.pixi/envs"\
    "${PIXI_PROJECT_ROOT:-}/.pixi/envs"\
)\
PIXI_ENVS_DIR=""\
for p in "${PIXI_PATHS[@]}"; do\
    if [ -d "$p" ] && [ -n "$(find "$p" -maxdepth 1 -type d -not -path "$p" | head -1)" ]; then\
        PIXI_ENVS_DIR="$p"\
        break\
    fi\
done\
\
if [ -z "$PIXI_ENVS_DIR" ]; then\
    echo "ERROR: No pixi environments found in any of: ${PIXI_PATHS[*]}"\
    echo "Create one with: pixi init && pixi install"\
    exit 1\
fi\
\
# Collect environment names (ignore empty dirs)\
mapfile -t PIXI_ENVS < <(find "$PIXI_ENVS_DIR" -maxdepth 1 -type d -not -path "$PIXI_ENVS_DIR" -exec basename {} \; | sort -u)\
if [ ${#PIXI_ENVS[@]} -eq 0 ]; then\
    echo "ERROR: Found $PIXI_ENVS_DIR but no subdirectories (environments)"\
    exit 1\
fi\
echo "‚ÉºÉ≥ Found pixi environments: ${PIXI_ENVS[*]}"\
\
# -----------------------------------------------------------------------------\
# 2. Generate a flawless devenv.nix (proper Nix syntax, no undefined vars)\
# -----------------------------------------------------------------------------\
cat > devenv.nix <<NIX\
{ config, ... }:\
\
let\
  envMap = {\
$(for e in "${PIXI_ENVS[@]}"; do echo "    $e = \"$PIXI_ENVS_DIR/$e\";"; done)\
  };\
  pixiPath = envMap.\${config.name} or (throw "No pixi env for '\${config.name}'");\
in {\
  languages.python.enable = false;\
  env = {\
    LD_LIBRARY_PATH = "/run/opengl-driver/lib:/run/opengl-driver-32/lib:\${LD_LIBRARY_PATH:-}";\
    CUDA_HOME = pixiPath;\
    VLLM_TARGET_DEVICE = "cuda";\
    TORCH_CUDA_ARCH_LIST = "8.6";\
  };\
  enterShell = ''\
    export VIRTUAL_ENV="\${pixiPath}"\
    export PATH="\${pixiPath}/bin:\$PATH"\
    ln -sfn "\${pixiPath}" "\$DEVENV_ROOT/.venv" 2>/dev/null || true\
    echo "‚ÉºÉ≥ Python: \$(which python)"\
    echo "‚ÉºÉ≥ Environment: ${config.name} -> \${pixiPath}"\
  '';\
}\
NIX\
\
echo "‚ÉºÉ≥ Generated devenv.nix"\
\
# -----------------------------------------------------------------------------\
# 3. Validate Nix syntax (fail fast on error)\
# -----------------------------------------------------------------------------\
if ! nix-instantiate --parse devenv.nix >/dev/null 2>&1; then\
    echo "ERROR: Nix syntax validation failed. Output:"\
    nix-instantiate --parse devenv.nix 2>&1 | head -10\
    exit 1\
fi\
echo "‚ÉºÉ≥ Nix syntax valid"\
\
# -----------------------------------------------------------------------------\
# 4. Check if devenv is available, else attempt to install (edge case)\
# -----------------------------------------------------------------------------\
if ! command -v devenv >/dev/null 2>&1; then\
    echo "WARNING: 'devenv' not found. Attempting to install via nix..."\
    if command -v nix >/dev/null 2>&1; then\
        nix profile install nixpkgs#devenv\
    else\
        echo "ERROR: Neither 'devenv' nor 'nix' found. Please install devenv first."\
        exit 1\
    fi\
fi\
\
# -----------------------------------------------------------------------------\
# 5. Test the first environment (non‚ÄÉ±interactive)\
# -----------------------------------------------------------------------------\
FIRST="${PIXI_ENVS[0]}"\
echo "‚É¶É≤ Testing environment: $FIRST"\
if ! devenv shell "$FIRST" --command python --version >/dev/null 2>&1; then\
    echo "ERROR: 'devenv shell $FIRST' failed. Try running manually."\
    exit 1\
fi\
echo "‚ÉºÉ≥ Test passed"\
\
# -----------------------------------------------------------------------------\
# 6. Enter the shell (replaces current process)\
# -----------------------------------------------------------------------------\
echo "ÉøÉÆÉ© Entering '$FIRST' shell. Run 'devenv up' when ready."\
exec devenv shell "$FIRST"\
EOF
bash <<'EOF'\
set -euo pipefail\
\
# -----------------------------------------------------------------------------\
# 1. Locate pixi environments (project-local first, then global)\
# -----------------------------------------------------------------------------\
PROJECT_PIXI="./.pixi/envs"\
GLOBAL_PIXI="$HOME/.pixi/envs"\
PIXI_ENVS_DIR=""\
\
if [ -d "$PROJECT_PIXI" ] && [ -n "$(ls -A "$PROJECT_PIXI" 2>/dev/null)" ]; then\
    PIXI_ENVS_DIR="$PROJECT_PIXI"\
    echo "‚ÉºÉ≥ Using project-local pixi envs: $PIXI_ENVS_DIR"\
elif [ -d "$GLOBAL_PIXI" ] && [ -n "$(ls -A "$GLOBAL_PIXI" 2>/dev/null)" ]; then\
    PIXI_ENVS_DIR="$GLOBAL_PIXI"\
    echo "‚ÉºÉ≥ Using global pixi envs: $PIXI_ENVS_DIR"\
else\
    echo "‚É∫ÉÄÔ∏ÉØ  No existing pixi environments found."\
    if [ -f "pixi.toml" ]; then\
        echo "‚É¶É≤ Creating environments from pixi.toml (this may take a while)..."\
        pixi install || { echo "‚ÉΩÉ¨ pixi install failed"; exit 1; }\
        # After install, they will be in ./.pixi/envs\
        PIXI_ENVS_DIR="$PROJECT_PIXI"\
        echo "‚ÉºÉ≥ Environments created in $PIXI_ENVS_DIR"\
    else\
        echo "‚ÉΩÉ¨ No pixi.toml found. Run 'pixi init' first."\
        exit 1\
    fi\
fi\
\
# -----------------------------------------------------------------------------\
# 2. List environment names (subdirectories of PIXI_ENVS_DIR)\
# -----------------------------------------------------------------------------\
mapfile -t PIXI_ENVS < <(find "$PIXI_ENVS_DIR" -maxdepth 1 -type d -not -path "$PIXI_ENVS_DIR" -exec basename {} \; | sort -u)\
if [ ${#PIXI_ENVS[@]} -eq 0 ]; then\
    echo "‚ÉΩÉ¨ No environment subdirectories found in $PIXI_ENVS_DIR"\
    exit 1\
fi\

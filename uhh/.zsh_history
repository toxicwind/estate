# Fixed recon script with proper JSONL parsing and actor extraction\
cat > "$SCRIPT_DIR/thgl_live_recon.py" << 'EOT'\
#!/usr/bin/env python3\
import os, sys, re, json, time, requests, argparse\
from datetime import datetime\
\
def extract_from_jsonl(path):\
    results = {"apis": set(), "actors": []}\
    if not os.path.exists(path):\
        return results\
    with open(path, 'r', encoding='utf-8', errors='ignore') as f:\
        for line in f:\
            line = line.strip()\
            if not line:\
                continue\
            # Try to parse as JSON\
            try:\
                data = json.loads(line)\
                # Extract lat/lng if present (your actual format)\
                if "lat" in data and "lng" in data:\
                    results["actors"].append({\
                        "lat": float(data["lat"]),\
                        "lng": float(data["lng"]),\
                        "type": data.get("type", "unknown"),\
                        "name": data.get("name", "")\
                    })\
                # Extract any URL-looking strings from the line (clean)\
                for word in re.findall(r'https?://[^\s"\'<>]+', line):\
                    # Filter out obviously bad URLs\
                    if not any(bad in word for bad in ['\\', '${', '`']):\
                        results["apis"].add(word)\
            except json.JSONDecodeError:\
                # If not JSON, still scan for URLs\
                for word in re.findall(r'https?://[^\s"\'<>]+', line):\
                    if not any(bad in word for bad in ['\\', '${', '`']):\
                        results["apis"].add(word)\
    return results\
\
def main():\
    parser = argparse.ArgumentParser()\
    parser.add_argument("--log", default="/tmp/thgl_analysis.jsonl")\
    parser.add_argument("--live", action="store_true")\
    args = parser.parse_args()\
    \
    extracted = extract_from_jsonl(args.log)\
    print(f"APIs found: {len(extracted['apis'])}")\
    print(f"Actors found: {len(extracted['actors'])}")\
    \
    if args.live:\
        print("Entering live probe loop (Ctrl+C to stop)...")\
        while True:\
            for url in list(extracted["apis"])[:20]:  # limit to first 20 to avoid spam\
                try:\
                    r = requests.get(url, timeout=3, headers={"User-Agent": "THGL-Recon/1.0"})\
                    if r.status_code < 400:\
                        print(f"[LIVE] {url} -> {r.status_code}")\
                except:\
                    pass\
            time.sleep(5)\
    else:\
        # Just print first 10 APIs and first 5 actors\
        for url in list(extracted["apis"])[:10]:\
            print(f"API: {url}")\
        for actor in extracted["actors"][:5]:\
            print(f"Actor: {actor['type']} at ({actor['lat']}, {actor['lng']})")\
\
if __name__ == "__main__":\
    main()\
EOT\

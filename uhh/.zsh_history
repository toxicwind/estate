if [ -n "$LS_PID" ]; then\
    echo "Language server PID: $LS_PID"\
    # Extract the port and token\
    cat /proc/$LS_PID/cmdline | tr '\0' '\n' | grep -E "extension_server_port|csrf_token"\
else\
    echo "No language server process found. Start Antigravity IDE first."\
fi

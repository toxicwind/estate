echo "=== Sovereign Verify finished ===" >&2\
echo "JSONL log written to: $LOG_FILE" >&2\
echo\
echo "=== QUICK SUMMARY ==="\
echo "Total checks logged: $(wc -l < "$LOG_FILE")"\
echo "Any failures: $(grep -c '"exit_code":[^0]' "$LOG_FILE" || echo 0)"\
ENDOFSCRIPT

#include <cuda_runtime.h>\
#include <cuda_fp16.h>\
#include <mma.h>\
#include <stdint.h>\
\
using namespace nvcuda::wmma;\
\
#define WARP_SIZE 32\
#define WARPS_PER_BLOCK 8\
#define BLOCK_SIZE (WARP_SIZE * WARPS_PER_BLOCK)\
#define TILE_M 16\
#define TILE_N 16\
#define TILE_K 16\
\
typedef struct {\
    int8_t* weights;\
    half* scales;\
    half* zeros;\
    int M, K, group_size;\
} PackedWeights;\
\
__global__ void matmul_int8_hmma_kernel(\
    const half* __restrict__ A,\
    const int8_t* __restrict__ B_packed,\
    const half* __restrict__ scales,\
    const half* __restrict__ zeros,\
    half* __restrict__ C,\
    int M, int N, int K\
) {\
    int warp_id = threadIdx.x / WARP_SIZE;\
    int lane = threadIdx.x % WARP_SIZE;\
\
    int row = blockIdx.y * TILE_M + (warp_id / 2) * TILE_M;\
    int col = blockIdx.x * TILE_N + (warp_id % 2) * TILE_N;\
\
    if (row >= M || col >= N) return;\
\
    fragment<matrix_a, TILE_M, TILE_N, TILE_K, half, row_major> a_frag;\
    fragment<matrix_b, TILE_M, TILE_N, TILE_K, half, col_major> b_frag;  // dequantized to half on the fly\
    fragment<accumulator, TILE_M, TILE_N, TILE_K, half> c_frag;\
\
    fill_fragment(c_frag, 0.0f);\
\
    for (int k = 0; k < K; k += TILE_K) {\
        // Load A\
        half a_tile[TILE_M * TILE_K];\
        // (simplified load for demo ‚ÄÉ¥ expand in production)\
        load_matrix_sync(a_frag, a_tile, TILE_K);\
\
        // Load + dequant B (INT8 -> half on the fly)\
        half b_tile[TILE_K * TILE_N];\
        // (dequant + swizzle logic here ‚ÄÉ¥ kept minimal for compile)\
        load_matrix_sync(b_frag, b_tile, TILE_N);\
\
        mma_sync(c_frag, a_frag, b_frag, c_frag);\
    }\
\
    // Store\
    half c_tile[TILE_M * TILE_N];\
    store_matrix_sync(c_tile, c_frag, TILE_N, mem_row_major);\
\
    // Simplified store (expand with proper indexing in full version)\
    for (int i = 0; i < TILE_M * TILE_N; i++) {\
        int idx = row * N + col + i;\
        if (idx < M * N) C[idx] = c_tile[i];\
    }\
}\
\
extern "C" {\
    void ggml_cuda_mul_mat_sm86_packed(const half* A, const half* B_fp16, half* C,\
                                       int batch, int M, int K, cudaStream_t stream) {\
        dim3 grid((M + TILE_M - 1) / TILE_M, (batch + TILE_N - 1) / TILE_N);\
        dim3 block(BLOCK_SIZE);\
        matmul_int8_hmma_kernel<<<grid, block, 0, stream>>>(A, (const int8_t*)B_fp16, nullptr, nullptr, C, M, batch, K);\
    }\
}\
FIXED_KERNEL

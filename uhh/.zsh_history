# optionally add new replacements for byte-vision and vram if they want, but they already have replacements? Actually they don't have replacements for byte-vision and vram in the list; they have system-monitor-replacement for vram? That might be a different thing. We'll add mcp-gpu-server for vram and for byte-vision we'll add a server that connects to their llama-server.
# 1. Remove the 4 dead upstreams\
mcpproxy upstream remove byte-vision-llamacpp hyprland-ipc mise-mcp-server vram-mcp --force\
\
# 2. Approve the two replacements that are already quarantined\
mcpproxy upstream approve hyprmcp-replacement --force\
mcpproxy upstream approve system-monitor-replacement --force\
\
# 3. Add a real replacement for byte-vision-llamacpp using your llama-server\
#    We'll use mcp-openai (connects to any OpenAI‚ÄÉ±compatible endpoint)\
mcpproxy upstream add local-llm --transport stdio -- uvx mcp-openai\
#    Set the base URL to your llama-server\
mcpproxy upstream set-env local-llm OPENAI_BASE_URL=http://localhost:25100/v1\
\
# 4. Add a real replacement for vram-mcp (GPU monitoring)\
mcpproxy upstream add gpu-monitor --transport stdio -- uvx mcp-gpu-server\
\
# 5. Restart all servers\
mcpproxy upstream restart --all\
\
# 6. Run doctor to verify\
mcpproxy doctor
# 1. Remove the 4 dead servers (use --yes, not --force)\
mcpproxy upstream remove byte-vision-llamacpp --yes\
mcpproxy upstream remove hyprland-ipc --yes\
mcpproxy upstream remove mise-mcp-server --yes\
mcpproxy upstream remove vram-mcp --yes\
\
# 2. Approve the quarantined replacements (no --force needed)\
mcpproxy upstream approve hyprmcp-replacement\
mcpproxy upstream approve system-monitor-replacement\
\
# 3. Add a real replacement for byte-vision-llamacpp using your llama-server on port 25100\
#    Use mcp-openai with OPENAI_BASE_URL set via --env\
mcpproxy upstream add local-llm --transport stdio --env OPENAI_BASE_URL=http://localhost:25100/v1 -- uvx mcp-openai\
\
# 4. Add a real replacement for vram-mcp (GPU monitoring)\
mcpproxy upstream add gpu-monitor --transport stdio -- uvx mcp-gpu-server\
\
# 5. (Optional) If you want to keep mise-mcp-server, we can add official mise-mcp instead:\
# mcpproxy upstream add mise-mcp --transport stdio --env MISE_EXPERIMENTAL=1 -- mise mcp\
\
# 6. Restart all servers\
mcpproxy upstream restart --all\
\
# 7. Verify\
mcpproxy doctor
./run.sh
#!/usr/bin/env bash\
set -euo pipefail\
CONFIG="$HOME/.mcpproxy/mcp_config.json"\
SECRETS="$HOME/.secrets"\
BACKUP="$CONFIG.bak-$(date +%s)"\
echo "Backup $CONFIG -> $BACKUP"\
cp "$CONFIG" "$BACKUP" 2>/dev/null || true\
rm -f ~/.zcompdump* 2>/dev/null || true\
rm -f ~/sovereign/run.sh\
touch "$SECRETS"\
chmod 600 "$SECRETS"\
\
# Secrets - no replace, and fix port to 25100 as user said raw llama-server at 25100\
grep -q "^SCOUT_BASE_URL=" "$SECRETS" && sed -i 's|^SCOUT_BASE_URL=.*|SCOUT_BASE_URL=http://127.0.0.1:25100|' "$SECRETS" || echo "SCOUT_BASE_URL=http://127.0.0.1:25100" >> "$SECRETS"\
grep -q "^LLAMACPP_URL=" "$SECRETS" && sed -i 's|^LLAMACPP_URL=.*|LLAMACPP_URL=http://127.0.0.1:25100|' "$SECRETS" || echo "LLAMACPP_URL=http://127.0.0.1:25100" >> "$SECRETS"\
grep -q "^CONTEXT7_API_KEY=" "$SECRETS" || echo "CONTEXT7_API_KEY=ctx7sk-b016659f-ff81-4e96-8d1e-066b9194c845" >> "$SECRETS"\
grep -q "^SCOUT_API_KEY=" "$SECRETS" || echo "SCOUT_API_KEY=sk-local" >> "$SECRETS"\
grep -q "^SCOUT_MODEL=" "$SECRETS" || echo "SCOUT_MODEL=local" >> "$SECRETS"\
grep -q "^PROMETHEUS_URL=" "$SECRETS" || echo "PROMETHEUS_URL=http://localhost:25105" >> "$SECRETS"\
grep -q "^QDRANT_URL=" "$SECRETS" || echo "QDRANT_URL=http://localhost:6333" >> "$SECRETS"\
\
cat > "$CONFIG" << 'ENDJSON'\

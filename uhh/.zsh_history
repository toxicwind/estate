local wezterm = require 'wezterm'\
local config = wezterm.config_builder()\
local act = wezterm.action\
\
-- ============================================================\
-- DISPLAY (NVIDIA + Hyprland ‚ÄÉ¥ Native WebGpu Pipeline)\
-- ============================================================\
config.enable_wayland = true\
config.front_end = "WebGpu"\
config.animation_fps = 120\
config.max_fps = 120\
\
-- ============================================================\
-- FONT ISOLATION (Bypass poisoned system font scan)\
-- ============================================================\
config.font_locator = 'ConfigDirsOnly'\
config.font_dirs = { wezterm.config_dir .. '/fonts' }\
config.font = wezterm.font_with_fallback({\
  { family = "JetBrains Mono", weight = "Medium" },\
  { family = "SF Mono", weight = "Medium" },\
})\
config.font_size = 12.0\
config.warn_about_missing_glyphs = false\
\
-- ============================================================\
-- WINDOW & PADDING (The "X-Box" Fix: Force NONE)\
-- ============================================================\
config.window_decorations = "NONE"\
config.window_padding = { left = 16, right = 16, top = 12, bottom = 12 }\
config.window_background_opacity = 0.88\
config.text_background_opacity = 1.0\
config.adjust_window_size_when_changing_font_size = false\
\
-- ============================================================\
-- APPLE iOS DARK COLOURS\
-- ============================================================\
local apple = {\
  bg = '#1c1c1e', bg2 = '#2c2c2e', bg3 = '#3a3a3c',\
  fg = '#f5f5f7', fg2 = '#8e8e93', fg3 = '#636366',\
  blue = '#0a84ff', green = '#30d158', red = '#ff453a',\
  orange = '#ff9f0a', purple = '#bf5af2', pink = '#ff375f',\
  teal = '#64d2ff', yellow = '#ffd60a', sep = '#48484a',\
}\
config.colors = {\
  foreground = apple.fg, background = apple.bg,\
  cursor_bg = apple.blue, cursor_fg = apple.bg, cursor_border = apple.blue,\
  selection_fg = apple.bg, selection_bg = apple.blue,\
  scrollbar_thumb = apple.bg3, split = apple.sep,\
  ansi = { apple.fg2, apple.red, apple.green, apple.yellow, apple.blue, apple.purple, apple.teal, apple.fg },\
  brights = { apple.fg3, '#ff6961', '#5cdb6d', '#ffcc00', '#5ac8fa', '#da8ff6', '#7ee6ff', '#ffffff' },\
  indexed = { [16] = apple.orange, [17] = apple.pink },\
}\
\
-- ============================================================\
-- TAB BAR\
-- ============================================================\
config.use_fancy_tab_bar = false\
config.tab_bar_at_bottom = true\
config.hide_tab_bar_if_only_one_tab = true\
config.show_tab_index_in_tab_bar = false\
config.switch_to_last_active_tab_when_closing_tab = true\
\
config.colors.tab_bar = {\
  background = apple.bg,\
  active_tab = { bg_color = apple.bg2, fg_color = apple.blue, intensity = 'Bold' },\
  inactive_tab = { bg_color = apple.bg, fg_color = apple.fg3 },\
  inactive_tab_hover = { bg_color = apple.bg2, fg_color = apple.fg2 },\
  new_tab = { bg_color = apple.bg, fg_color = apple.fg3 },\
  new_tab_hover = { bg_color = apple.bg2, fg_color = apple.blue },\
}\
\
wezterm.on('format-tab-title', function(tab, tabs, panes, config, hover, max_width)\
  local pane = tab.active_pane\
  local cwd = pane.current_working_dir and pane.current_working_dir.file_path or ''\
  local dir = cwd:match('([^/]+)/?$') or pane.title or 'wezterm'\
  dir = dir:gsub('^' .. (os.getenv('HOME') or ''), '~')\
  if #dir > 20 then dir = dir:sub(1, 18) .. '‚Ä¶' end\
  local bg = tab.is_active and apple.bg2 or apple.bg\
  local fg = tab.is_active and apple.blue or (hover and apple.fg2 or apple.fg3)\
  local ind = tab.is_active and '‚É∂É≠ ' or ' '\
  return {\
    { Background = { Color = bg } },\
    { Foreground = { Color = apple.red } }, { Text = "‚É∑ÉØ " },\
    { Foreground = { Color = fg } }, { Text = ind .. dir .. ' ' },\
  }\
end)\
\
-- ============================================================\
-- STATUS BAR\
-- ============================================================\
wezterm.on('update-status', function(window, pane)\
  local date = wezterm.strftime('%H:%M')\
  local host = wezterm.hostname():match('^([^.]+)') or ''\
  window:set_right_status(wezterm.format({\
    { Foreground = { Color = apple.fg2 } }, { Text = ' ' .. host .. ' ' },\
    { Foreground = { Color = apple.blue } }, { Text = date .. ' ' },\
  }))\
end)\
\
-- ============================================================\
-- KEYS\
-- ============================================================\
config.keys = {\
  { key = 't', mods = 'CTRL|SHIFT', action = act.SpawnTab 'CurrentPaneDomain' },\
  { key = 'w', mods = 'CTRL|SHIFT', action = act.CloseCurrentPane { confirm = true } },\
  { key = 'Tab', mods = 'CTRL', action = act.ActivateTabRelative(1) },\
  { key = 'Tab', mods = 'CTRL|SHIFT', action = act.ActivateTabRelative(-1) },\
  { key = 'd', mods = 'CTRL|SHIFT', action = act.SplitVertical { domain = 'CurrentPaneDomain' } },\
  { key = 'D', mods = 'CTRL|SHIFT', action = act.SplitHorizontal { domain = 'CurrentPaneDomain' } },\
  { key = 'z', mods = 'CTRL|SHIFT', action = act.TogglePaneZoomState },\
  { key = 'h', mods = 'CTRL|SHIFT', action = act.ActivatePaneDirection 'Left' },\
  { key = 'j', mods = 'CTRL|SHIFT', action = act.ActivatePaneDirection 'Down' },\
  { key = 'k', mods = 'CTRL|SHIFT', action = act.ActivatePaneDirection 'Up' },\
  { key = 'l', mods = 'CTRL|SHIFT', action = act.ActivatePaneDirection 'Right' },\
  { key = 'f', mods = 'CTRL|SHIFT', action = act.ToggleFullScreen },\
  { key = 'Enter', mods = 'ALT', action = act.ToggleFullScreen },\
  { key = 'Space', mods = 'CTRL|SHIFT', action = act.ActivateCopyMode },\
  { key = 'v', mods = 'CTRL|SHIFT', action = act.PasteFrom 'Clipboard' },\
  { key = 'f', mods = 'CTRL|ALT', action = act.Search 'CurrentSelectionOrEmptyString' },\
  { key = 'u', mods = 'CTRL|SHIFT', action = act.ScrollByPage(-1) },\
  { key = 'PageDown', mods = 'CTRL|SHIFT', action = act.ScrollByPage(1) },\
  { key = 'k', mods = 'CTRL|SHIFT', action = act.ClearScrollback 'ScrollbackAndViewport' },\
  -- Uncomment this only after you have git cloned the plugin:\
  -- { key = 'p', mods = 'CTRL|SHIFT', action = cmdpicker.build_action() },\
}\
\
-- ============================================================\
-- MISC\
-- ============================================================\
config.check_for_updates = false\
config.automatically_reload_config = true\
config.enable_csi_u_key_encoding = true\
config.default_prog = { 'zsh', '-l' }\
config.audible_bell = 'Disabled'\
config.exit_behavior = 'Close'\
config.status_update_interval = 5000\
config.window_close_confirmation = 'NeverPrompt'\
\
return config\
EOF

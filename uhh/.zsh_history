#!/bin/bash\
set -euo pipefail\
\
SOVEREIGN_ROOT="/home/toxic/sovereign"\
TEMP_CLEANUP="/home/toxic/sovereign_temp_cleanup"\
BACKUP_DIR="$SOVEREIGN_ROOT/backups/$(date +%Y%m%d_%H%M%S)"\
LOG_FILE="$SOVEREIGN_ROOT/meta_fixer.log"\
VENV_DIR="$SOVEREIGN_ROOT/venv"\
\
mkdir -p "$BACKUP_DIR" "$TEMP_CLEANUP" "$SOVEREIGN_ROOT/logs" "$SOVEREIGN_ROOT/extensions/sm86"\
\
# Empty the log if it exists to start fresh\
> "$LOG_FILE"\
\
log_header() {\
    echo -e "\n========================================================================" | tee -a "$LOG_FILE"\
    echo "‚É∫ÉπÔ∏ÉØ  [$1] - $(date '+%H:%M:%S')" | tee -a "$LOG_FILE"\
    echo "========================================================================" | tee -a "$LOG_FILE"\
}\
\
# The Engine Bay: Executes, logs live, and catches every single dropped spanner.\
execute_task() {\
    local task_name="$1"\
    shift\
    echo -e "\n---> RUNNING: $task_name" | tee -a "$LOG_FILE"\
    echo "CMD: $@" | tee -a "$LOG_FILE"\
    echo "----------------------------------------" | tee -a "$LOG_FILE"\
    \
    # Run the command, pipe both stdout and stderr to tee\
    set +e\
    "$@" 2>&1 | tee -a "$LOG_FILE"\
    local status=${PIPESTATUS[0]}\
    set -e\
    \
    if [ $status -ne 0 ]; then\
        echo "----------------------------------------" | tee -a "$LOG_FILE"\
        echo "‚ÉΩÉ¨ FATAL: '$task_name' threw a rod. Exit code: $status" | tee -a "$LOG_FILE"\
        echo "Check the terminal output above or $LOG_FILE." | tee -a "$LOG_FILE"\
        exit $status\
    else\
        echo "----------------------------------------" | tee -a "$LOG_FILE"\
        echo "‚ÉºÉ• SUCCESS: $task_name" | tee -a "$LOG_FILE"\
    fi\
}\
\
log_header "Sovereign Meta-Fixer Final v7 (Maximal TPS / Unfiltered Output)"\
\
# 1. CLEANUP (Safe loop, no dev/null)\
log_header "Backing up and sweeping the bay"\
for item in "$SOVEREIGN_ROOT"/*; do\
    if [ -e "$item" ]; then\
        base=$(basename "$item")\
        if [[ "$base" != "fix.sh" && "$base" != "process-compose.yml" && "$base" != "Caddyfile" && "$base" != "config.toml" && "$base" != "venv" && "$base" != "logs" && "$base" != "backups" && "$base" != "tests" && "$base" != "modules" && "$base" != "extensions" && "$base" != "sovereign_meta_fixer_final.sh" && "$base" != "meta_fixer.log" ]]; then\
            execute_task "Moving $base to temp" mv "$item" "$TEMP_CLEANUP/"\
        fi\
    fi\
done\
\
# 2. VENV & DEPENDENCIES\
log_header "Wiring the virtual environment"\
if [ ! -d "$VENV_DIR" ]; then\
    execute_task "Creating Python VENV" python3 -m venv "$VENV_DIR"\
fi\
source "$VENV_DIR/bin/activate"\
\
execute_task "Installing core tooling (Live Output)" pip install --upgrade pip ruff black mypy pytest requests responses numpy\
\
# 3. WRITE CUDA KERNEL\
log_header "Forging sm_86 INT8 HMMA Kernel"\
cat > "$SOVEREIGN_ROOT/extensions/sm86/weight_pack_sm86.cu" << 'CUDAEOF'\
#include <cuda_runtime.h>\
#include <cuda_fp16.h>\
#include <mma.h>\
#include <stdint.h>\
#include <stdio.h>\
\
using namespace nvcuda::wmma;\
\
#define WARP_SIZE 32\
#define WARPS_PER_BLOCK 8\
#define BLOCK_SIZE (WARP_SIZE * WARPS_PER_BLOCK)\
#define TILE_M 16\
#define TILE_N 16\
#define TILE_K 16\
\
__global__ void matmul_int8_hmma_kernel(\
    const half* __restrict__ A,\
    const int8_t* __restrict__ B_packed,\
    half* __restrict__ C,\
    int M, int N, int K\
) {\
    int warp_id = threadIdx.x / WARP_SIZE;\
    int lane_id = threadIdx.x % WARP_SIZE;\
    \
    int row = blockIdx.y * TILE_M + (warp_id / 2) * TILE_M;\
    int col = blockIdx.x * TILE_N + (warp_id % 2) * TILE_N;\
\
    if (row >= M || col >= N) return;\
\
    fragment<matrix_a, TILE_M, TILE_N, TILE_K, int8_t, row_major> a_frag;\
    fragment<matrix_b, TILE_M, TILE_N, TILE_K, int8_t, col_major> b_frag;\
    fragment<accumulator, TILE_M, TILE_N, TILE_K, int32_t> c_frag;\
\
    fill_fragment(c_frag, 0);\
\
    __shared__ int8_t A_smem[WARPS_PER_BLOCK][TILE_M][TILE_K];\
    __shared__ int32_t C_smem[WARPS_PER_BLOCK][TILE_M][TILE_N];\
\
    for (int k = 0; k < K; k += TILE_K) {\
        // Fast lane-strided FP16 to INT8 conversion into shared memory\
        for(int i = lane_id; i < 256; i += 32) {\
            int ar = i / 16;\
            int ac = i % 16;\
            if (row + ar < M && k + ac < K) {\
                half a_val = A[(row + ar) * K + (k + ac)];\
                A_smem[warp_id][ar][ac] = (int8_t)__half2int_rn(a_val); \
            } else {\
                A_smem[warp_id][ar][ac] = 0;\
            }\
        }\
        __syncwarp();\
\
        load_matrix_sync(a_frag, &A_smem[warp_id][0][0], TILE_K);\
        load_matrix_sync(b_frag, B_packed + col * K + k, K);\
        \
        mma_sync(c_frag, a_frag, b_frag, c_frag);\
        __syncwarp();\
    }\
\
    store_matrix_sync(&C_smem[warp_id][0][0], c_frag, TILE_N, mem_row_major);\
    __syncwarp();\
\
    // Fast lane-strided INT32 to FP16 global memory writeout\
    for(int i = lane_id; i < 256; i += 32) {\
        int cr = i / 16;\
        int cc = i % 16;\
        int out_row = row + cr;\
        int out_col = col + cc;\
        \
        if (out_row < M && out_col < N) {\
            C[out_row * N + out_col] = __int2half_rn(C_smem[warp_id][cr][cc]);\
        }\
    }\
}\
\
extern "C" {\
    void ggml_cuda_mul_mat_sm86_packed(const half* A, const half* B_fp16, half* C,\
                                       int batch, int M, int K, cudaStream_t stream) {\
        dim3 grid((M + TILE_M - 1) / TILE_M, (batch + TILE_N - 1) / TILE_N);\
        dim3 block(BLOCK_SIZE);\
        matmul_int8_hmma_kernel<<<grid, block, 0, stream>>>(A, (const int8_t*)B_fp16, C, M, batch, K);\
    }\
}\
CUDAEOF\
echo "Kernel written." | tee -a "$LOG_FILE"\
\
# 4. COMPILE CUDA KERNEL (With verbose PTXAS telemetry for register tuning)\
log_header "Compiling CUDA Kernel (Maximal Optimization)"\
execute_task "nvcc compilation" nvcc -O3 -arch=sm_86 --use_fast_math -Xptxas -O3,-v "$SOVEREIGN_ROOT/extensions/sm86/weight_pack_sm86.cu" -shared -o "$SOVEREIGN_ROOT/extensions/sm86/libweight_pack_sm86.so"\

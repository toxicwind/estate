# GENERATED ‚ÄÉ¥ do not edit. Source: stack/modules/*.yaml\
# Regenerate: ./stack/build-compose.sh\
version: "0.5"\
is_strict: false\
processes:\
YAML\
\
shopt -s nullglob\
for mod in "$SOV"/stack/modules/*.yaml; do\
  echo "  # --- $(basename "$mod") ---" >> "$OUT"\
  # if file starts with 'processes:' strip it, keep its children as-is (already indented 2)\
  if head -n1 "$mod" | grep -qE '^processes:\s*$'; then\
    tail -n +2 "$mod" >> "$OUT"\
  else\
    # file is `service:` at col 0 -> indent 2 to put under outer processes:\
    sed 's/^/  /' "$mod" >> "$OUT"\
  fi\
  echo "" >> "$OUT"\
done\
echo "‚ÉºÉ• wrote $OUT"\
cat "$OUT"\
SH\

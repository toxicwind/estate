#!/usr/bin/env bash\
set -Eeuo pipefail\
\
MANIFEST="manifest.json"\
OUTDIR="./import_root"\
\
# Ensure manifest exists\
if [[ ! -f "$MANIFEST" ]]; then\
    echo "{\"error\": \"No manifest\"}" > "$MANIFEST"\
fi\
\
# Process the stack\
jq -r ".[] | \"\(.type)\t\(.path)\t\(.url)\"" "$MANIFEST" | while IFS=$'\t' read -r type path url; do\
    [[ "$type" != "file" ]] && continue\
    [[ -z "$url" || "$url" == "null" ]] && continue\
    \
    dst="$OUTDIR/$path"\
    mkdir -p "$(dirname "$dst")"\
    \
    echo "[import] downloading $path"\
    curl -sSL --fail "$url" -o "$dst" || echo "[!] Download failed: $path"\
done\
EOF\
chmod +x /opt/sovereign/import_stack.sh'\


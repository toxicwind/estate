#!/usr/bin/env python3\
import subprocess\
import pathlib\
import time\
import os\
\
HOME = pathlib.Path("/home/toxic")\
MODEL = HOME / "models" / "Qwen3.6-27B-Heretic-UD" / "heretic-UD-27B-Q5_K_XL.gguf"\
SERVER = HOME / "sovereign" / "bin" / "llama-server"\
\
CONTEXTS = [8192, 16384, 32768, 65536]\
\
def kill_existing():\
    subprocess.run(["pkill", "-f", str(SERVER)], capture_output=True)\
    subprocess.run(["pkill", "-f", "ollama"], capture_output=True)\
    subprocess.run(["pkill", "-f", "llama-server"], capture_output=True)\
    time.sleep(2)\
\
print("=== Max Context Test (llama-server) ===\n")\
\
for ctx in CONTEXTS:\
    kill_existing()\
\
    cmd = [\
        str(SERVER),\
        "--model", str(MODEL),\
        "-ngl", "99",\
        "-c", str(ctx),\
        "-fa",\
        "--cache-type-k", "q4_0",\
        "--cache-type-v", "q4_0",\
        "--host", "0.0.0.0",\
        "--port", "8080",\
        "--threads", str(os.cpu_count() or 8),\
    ]\
\
    print(f">>> Testing ctx={ctx}")\
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)\
\
    time.sleep(5)\
    if proc.poll() is None:\
        print(f"    STARTED OK\n")\
        proc.terminate()\
        time.sleep(1)\
    else:\
        output = proc.stdout.read() if proc.stdout else ""\
        print("    FAILED\n")\
        print(output[-2500:])\
        break\

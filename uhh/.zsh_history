#!/bin/bash\
set -euo pipefail\
\
PR_URL="https://github.com/kaofelix/greprip/pull/1"\
REPO="kaofelix/greprip"\
PR_NUM="1"\
\
# Create a temp directory for comparison\
TMP_DIR=$(mktemp -d)\
cd "$TMP_DIR"\
\
echo "=== Setting up tools in $TMP_DIR ==="\
\
# 1. Ensure GitHub CLI is installed\
if ! command -v gh &>/dev/null; then\
    echo "‚ÉΩÉ¨ gh not found. Please install GitHub CLI first."\
    exit 1\
fi\
\
# 2. Install gh-llm extension\
echo "Installing gh-llm..."\
gh extension install github/gh-llm 2>/dev/null || echo "gh-llm already installed"\
\

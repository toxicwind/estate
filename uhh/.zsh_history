cat > ~/.local/share/uv/tools/greprip/lib/python3.13/site-packages/grg/cli.py << 'EOF'\
"""CLI entry point for grg."""\
\
import subprocess\
import sys\
from .translator import translate_grep_args\
\
def main():\
    grep_args = sys.argv[1:]\
    rg_args = translate_grep_args(grep_args)\
    cmd = ["rg"] + rg_args\
    # Log to a file\
    with open("/tmp/grg.log", "w") as f:\
        f.write(f"grep_args: {grep_args}\n")\
        f.write(f"rg_cmd: {cmd}\n")\
    # Run with stdout/stderr captured to avoid pager\
    result = subprocess.run(cmd, capture_output=True, text=True)\
    # Print output to actual stdout/stderr\
    sys.stdout.write(result.stdout)\
    sys.stderr.write(result.stderr)\
    sys.exit(result.returncode)\
\
if __name__ == "__main__":\
    main()\
EOF\

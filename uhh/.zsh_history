{ config, ... }:\
\
let\
  envMap = {\
$(for e in "${PIXI_ENVS[@]}"; do echo "    $e = \"$PIXI_ENVS_DIR/$e\";"; done)\
  };\
  pixiPath = envMap.\${config.name} or (throw "No pixi env for '\${config.name}'");\
in {\
  languages.python.enable = false;\
  env = {\
    LD_LIBRARY_PATH = "/run/opengl-driver/lib:/run/opengl-driver-32/lib:\${LD_LIBRARY_PATH:-}";\
    CUDA_HOME = pixiPath;\
    VLLM_TARGET_DEVICE = "cuda";\
    TORCH_CUDA_ARCH_LIST = "8.6";\
  };\
  enterShell = ''\
    export VIRTUAL_ENV="\${pixiPath}"\
    export PATH="\${pixiPath}/bin:\$PATH"\
    ln -sfn "\${pixiPath}" "\$DEVENV_ROOT/.venv" 2>/dev/null || true\
    echo "‚ÉºÉ≥ Python: \$(which python)"\
    echo "‚ÉºÉ≥ Environment: ${config.name} -> \${pixiPath}"\
  '';\
}\
NIX\
\
echo "‚ÉºÉ• Generated devenv.nix"\
\
# -----------------------------------------------------------------------------\
# 4. Validate Nix syntax\
# -----------------------------------------------------------------------------\
if ! nix-instantiate --parse devenv.nix >/dev/null 2>&1; then\
    echo "‚ÉΩÉ¨ Nix syntax error:"\
    nix-instantiate --parse devenv.nix 2>&1 | head -10\
    exit 1\
fi\
echo "‚ÉºÉ• Nix syntax valid"\
\
# -----------------------------------------------------------------------------\
# 5. Ensure devenv is available\
# -----------------------------------------------------------------------------\
if ! command -v devenv >/dev/null 2>&1; then\
    echo "‚É∫ÉÄÔ∏ÉØ  'devenv' not found. Installing via nix..."\
    nix profile install nixpkgs#devenv || { echo "‚ÉΩÉ¨ Failed to install devenv"; exit 1; }\
fi\
\
# -----------------------------------------------------------------------------\
# 6. Test the first environment\
# -----------------------------------------------------------------------------\
FIRST="${PIXI_ENVS[0]}"\
echo "‚É¶É≤ Testing environment: $FIRST"\
if ! devenv shell "$FIRST" --command python --version >/dev/null 2>&1; then\

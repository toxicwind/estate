    })\
\
    Timer {\
        interval: 10000\
        running: true\
        repeat: true\
        onTriggered: {\
            const active = ToplevelManager.activeToplevel\
            const appId = active?.appId?.toLowerCase() ?? ""\
            const className = active?.className?.toLowerCase() ?? ""\
\
            let detected = "unknown"\
            if (appId.includes("code") || className.includes("code")) detected = "coding"\
            else if (appId.includes("steam") || appId.includes("lutris")) detected = "gaming"\
            else if (appId.includes("bitwig") || appId.includes("reaper")) detected = "music"\
            else if (appId.includes("firefox") || appId.includes("chrome")) detected = "browsing"\
\
            if (detected !== "unknown" && detected !== currentActivity) {\
                currentActivity = detected\
                const cmd = profiles[detected]?.exec\
                if (cmd) {\
                    console.log("[Predictor] Switching to", detected)\
                    Quickshell.execDetached(["bash", "-c", cmd])\
                    Ipc.send("activityChanged", detected)\
                }\
            }\
        }\
    }\
}\
EOF\
\
# ServiceMonitor.qml\
cat > ~/.config/illogical-impulse/services/ServiceMonitor.qml << 'EOF'\
pragma Singleton\
pragma ComponentBehavior: Bound\
\
import QtQuick\
import Quickshell\
import Quickshell.Io\
\
Singleton {\
    id: monitor\
    property var watchedUnits: ["ik_llama", "openfang", "nfcot_proxy", "caddy"]\
\
    Component.onCompleted: {\
        for (const unit of watchedUnits) {\
            startJournalFollow(unit)\
        }\
    }\
\
    function startJournalFollow(unit) {\
        const proc = Process {\
            command: ["journalctl", "--user", "-u", unit, "-f", "-o", "cat", "--lines=0"]\
            running: true\
            stdout: SplitParser {\
                onRead: function(line) {\
                    if (line.includes("Failed") || line.includes("error") || line.includes("segfault")) {\
                        console.log("[Monitor] Error in", unit, "->", line)\
                        Ipc.send("serviceError", { unit: unit, line: line })\
                        Quickshell.execDetached(["openfang", "hand", "run", "sovereign-healer"])\
                    }\
                }\
            }\
        }\
    }\
}\
EOF\
\
echo "‚ÉºÉ• Three service QML files created in ~/.config/illogical-impulse/services/"
SHELL=~/.config/illogical-impulse/shell.qml\
\
# Backup first\
cp "$SHELL" "$SHELL.bak"\
\
# Remove any previous partial additions (if any)\
sed -i '/---- Sovereign Agent Services ----/,/---- /d' "$SHELL"\
\
# Add the new imports and instantiation just before the last '}' of the root item?\
# Simpler: append at end of file but inside the root object. We'll add after the last Component.onCompleted or at end.\
# Let's use a safer approach: add after any existing imports.\
grep -q "import \"./services/AgentResourceGovernor.qml\"" "$SHELL" || {\
    # Find the line with the last import and insert after it\
    LINE=$(grep -n "^import" "$SHELL" | tail -1 | cut -d: -f1)\
    if [ -n "$LINE" ]; then\
        sed -i "$LINE a\\\
import \"./services/AgentResourceGovernor.qml\" as AgentResourceGovernor\\\
import \"./services/ActivityPredictor.qml\" as ActivityPredictor\\\
import \"./services/ServiceMonitor.qml\" as ServiceMonitor" "$SHELL"\
    else\
        # No imports? Add at top\
        sed -i '1i\\
import "./services/AgentResourceGovernor.qml" as AgentResourceGovernor\\
import "./services/ActivityPredictor.qml" as ActivityPredictor\\
import "./services/ServiceMonitor.qml" as ServiceMonitor\
' "$SHELL"\
    fi\
}\
\
# Add instantiation (ensure it runs only once)\
if ! grep -q "AgentResourceGovernor;" "$SHELL"; then\
    # Find a good place: after the main root item creation or inside Component.onCompleted\
    # Assume there's a Component.onCompleted somewhere\
    if grep -q "Component.onCompleted:" "$SHELL"; then\
        sed -i '/Component.onCompleted: {/a\        AgentResourceGovernor;\n        ActivityPredictor;\n        ServiceMonitor;' "$SHELL"\
    else\
        # Add a new Component.onCompleted at the end of the root object\
        echo 'Component.onCompleted: { AgentResourceGovernor; ActivityPredictor; ServiceMonitor; }' >> "$SHELL"\
    fi\
fi\
\
echo "‚ÉºÉ• Updated $SHELL"
CONFIG=~/.config/illogical-impulse/config.json\
if ! grep -q '"agent"' "$CONFIG"; then\
    # Add agent section after ai section\
    sed -i '/"ai": {/,/}/!b; /}/i\    "agent": {\n        "resourceGovernor": true\n    },' "$CONFIG"\
    echo "‚ÉºÉ• Added agent config to $CONFIG"\
else\
    echo "‚É§πÔ∏ÉØ Agent config already present"\
fi
# Kill existing Quickshell process\
pkill -f "quickshell" || true\
sleep 1\
\
# Start fresh\
nohup quickshell > /tmp/quickshell.log 2>&1 &\
sleep 2\
\
# Check if it's running\
if pgrep -f "quickshell" > /dev/null; then\
    echo "‚ÉºÉ• Quickshell restarted successfully"\
    echo "Logs: tail -f /tmp/quickshell.log"\
else\
    echo "‚ÉΩÉ¨ Quickshell failed to start. Check /tmp/quickshell.log"\
fi
# Check logs for our service init messages\
tail -30 /tmp/quickshell.log | grep -E "Governor|Predictor|Monitor|AgentResource"
\
# 2. Add imports and instantiation to shell.qml if not already present\
SHELL=~/.config/quickshell/qs/shell.qml\
if ! grep -q "AgentResourceGovernor" "$SHELL"; then\
    echo '// ---- Sovereign Agent Services ----' >> "$SHELL"\
    echo 'import "services/AgentResourceGovernor.qml" as AgentResourceGovernor' >> "$SHELL"\
    echo 'import "services/ActivityPredictor.qml" as ActivityPredictor' >> "$SHELL"\
    echo 'import "services/ServiceMonitor.qml" as ServiceMonitor' >> "$SHELL"\
    echo '' >> "$SHELL"\
    echo 'Component.onCompleted: {' >> "$SHELL"\
    echo '    AgentResourceGovernor' >> "$SHELL"\
    echo '    ActivityPredictor' >> "$SHELL"\
    echo '    ServiceMonitor' >> "$SHELL"\
    echo '}' >> "$SHELL"\
    echo '// ---------------------------------' >> "$SHELL"\
    echo "‚ÉºÉ• Added service imports to $SHELL"\
else\
    echo "‚É§π<fe0f> Services already imported in $SHELL"\
fi\
\
# 3. Add config toggle for governor (if missing)\
CONFIG=~/.config/illogical-impulse/config.json\
if ! grep -q '"agent":' "$CONFIG"; then\
    sed -i '/"ai": {/,/}/!b; /}/i\    "agent": {\n        "resourceGovernor": true\n    },' "$CONFIG"\
    echo "‚ÉºÉ• Added agent config to $CONFIG"\
else\
    echo "‚É§π<fe0f> Agent config already present in $CONFIG"\
fi\
\
echo ""\
echo "=== Done ==="\
echo "Restart quickshell: quickshell --replace &"\

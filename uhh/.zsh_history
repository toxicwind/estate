#!/bin/bash\
DEST_DIR="/home/toxic/projects"\
PROJECT_NAME=$(basename "$PWD")\
TIMESTAMP=$(date +%Y%m%d_%H%M%S)\
OUTPUT_FILE="$DEST_DIR/${PROJECT_NAME}_${TIMESTAMP}.zip"\
mkdir -p "$DEST_DIR"\
zip -r "$OUTPUT_FILE" . \\
    -x "build/*" "*/build/*" \\
    -x "build_release/*" "*/build_release/*" \\
    -x "target/*" "*/target/*" \\
    -x ".git/*" "*/.git/*" \\
    -x "node_modules/*" "*/node_modules/*" \\
    -x "dist/*" "*/dist/*" \\

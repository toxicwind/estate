#!/usr/bin/env bash\
# alias_audit.sh ‚ÄÉ¥ Test every suspicious alias in your current ~/.zshrc\
# Run with: bash alias_audit.sh\
\
set -euo pipefail\
\
echo "=== ALIAS AUDIT ‚ÄÉ¥ Testing targets from ~/.zshrc ==="\
echo ""\
\
# Extract aliases that look suspicious\
ALIASES_TO_TEST=(\
    "grep"\
    "find"\
    "q"\
    "pamcan"\
    "celar"\
    "claer"\
    "sovereign-logs"\
    "openfang-logs"\
    "openfang-status"\
    "openfang-restart"\
    "sovereign-array"\
    "sovereign-up"\
    "sovereign-down"\
)\
\
for alias_name in "${ALIASES_TO_TEST[@]}"; do\
    # Get what the alias actually points to\
    expansion=$(alias "$alias_name" 2>/dev/null | sed "s/alias $alias_name='//;s/'$//" || echo "NOT DEFINED")\
\
    if [[ "$expansion" == "NOT DEFINED" ]]; then\
        printf "%-18s ‚É¶É≤ %-40s [NOT DEFINED IN CURRENT SHELL]\n" "$alias_name" ""\
        continue\
    fi\
\
    # Extract the first word (the actual command being called)\
    target=$(echo "$expansion" | awk '{print $1}')\
\
    # Check if the target command exists\
    if command -v "$target" &>/dev/null; then\
        status="EXISTS"\
        # Try to get --help or first few lines of output\
        help_output=$($target --help 2>&1 | head -4 || echo "no --help output")\
        printf "%-18s ‚É¶É≤ %-40s [%s]\n" "$alias_name" "$expansion" "$status"\
        echo "    ‚É¥É¥‚É¥Ä $help_output"\
    else\
        printf "%-18s ‚É¶É≤ %-40s [MISSING / BROKEN]\n" "$alias_name" "$expansion"\
    fi\
done\
\
echo ""\
echo "=== Summary ==="\
echo "Any line showing [MISSING / BROKEN] is actively dangerous or useless."\
echo "Run this script, then we delete the ones that are broken."
echo "=== Current PATH (after my change) ==="\
echo "$PATH" | tr ':' '\n'\
\
echo ""\
echo "=== Which sovereign-related commands are now missing? ==="\
for cmd in sovereign openfang llama-server llama-cli sovereign-up openfang-start; do\
    if command -v "$cmd" &>/dev/null; then\
        printf "%-22s ‚É¶É≤ %s\n" "$cmd" "$(command -v $cmd)"\
    else\
        printf "%-22s ‚É¶É≤ MISSING\n" "$cmd"\
    fi\
done\
\
echo ""\
echo "=== Check the directories that used to be in your old PATH ==="\
for dir in ~/.grok/bin ~/go/bin ~/.pixi/bin ~/.local/bin ~/bin /home/toxic/sovereign/bin ~/.openfang/bin; do\
    if [ -d "$dir" ]; then\
        count=$(ls "$dir" 2>/dev/null | wc -l)\
        printf "%-30s ‚É¶É≤ exists (%d items)\n" "$dir" "$count"\
    else\
        printf "%-30s ‚É¶É≤ does not exist\n" "$dir"\
    fi\
done
#!/usr/bin/env bash\
# full_path_audit.sh ‚ÄÉ¥ Comprehensive bin audit (help/version + dupes + hashes)\
\
set -uo pipefail\
\
OLD_PATHS=(\
    "/home/toxic/sovereign/bin"\
    "/home/toxic/.openfang/bin"\
    "/home/toxic/.local/bin"\
    "/home/toxic/bin"\
    "/home/toxic/.cargo/bin"\
    "/home/toxic/.grok/bin"\
    "/home/toxic/go/bin"\
    "/home/toxic/.pixi/bin"\
)\
\
declare -A cmd_map   # command -> full path\
declare -A hash_map  # full path -> sha256\
\
echo "=== FULL PATH AUDIT (help/version + duplicates + hashes) ==="\
echo ""\
\
for dir in "${OLD_PATHS[@]}"; do\
    [ -d "$dir" ] || { echo "‚É∫ÉÄÔ∏ÉØ  Missing: $dir"; continue; }\
\
    echo "Scanning \( dir ( \)(ls "$dir" 2>/dev/null | wc -l) items)..."\
\
    for bin in "$dir"/*; do\
        [ -x "$bin" ] || continue\
        cmd=$(basename "$bin")\
\
        # Hash\
        hash=$(sha256sum "$bin" 2>/dev/null | awk '{print $1}')\
        hash_map["$bin"]=$hash\
\
        # Track duplicates\
        if [[ -n "${cmd_map[$cmd]}" ]]; then\
            echo "   ‚É∫ÉÄÔ∏ÉØ  DUPLICATE: $cmd"\
            echo "       ‚É¶É≤ $bin"\
            echo "       ‚É¶É≤ ${cmd_map[$cmd]}"\
        else\
            cmd_map[$cmd]="$bin"\
        fi\
\
        # Test --version and --help (with timeout)\
        echo -n "   $cmd "\
        if timeout 1.5s "$bin" --version >/dev/null 2>&1; then\
            echo -n "[--version OK] "\
        else\
            echo -n "[--version FAIL] "\
        fi\
\
        if timeout 1.5s "$bin" --help >/dev/null 2>&1; then\
            echo "[--help OK]"\
        else\
            echo "[--help FAIL]"\
        fi\
    done\
done\
\
echo ""\
echo "=== SUMMARY ==="\
echo "Total unique commands found: ${#cmd_map[@]}"\
echo "Directories with binaries: \( (for d in " \){OLD_PATHS[@]}"; do [ -d "$d" ] && echo "$d"; done | wc -l)"\
\
echo ""\
echo "=== Recommendation for PATH ==="\
echo "Keep these in order (sovereign-first):"\
echo "/home/toxic/sovereign/bin:/home/toxic/.openfang/bin:/home/toxic/.local/bin:/home/toxic/bin:/home/toxic/.cargo/bin:/home/toxic/.grok/bin:/home/toxic/go/bin:/home/toxic/.pixi/bin:\$PATH"\
\
echo ""\
echo "Audit complete. Paste this output if you want me to generate the final .zshrc with exactly the right PATH."
bash -s << 'AUDIT'\

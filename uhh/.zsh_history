#!/usr/bin/env bash\
set -e\
\
api_get() {\
  local url="$1"\
  if [[ -n "$GITHUB_TOKEN" ]]; then\
    curl -sSL -H "Authorization: token $GITHUB_TOKEN" "$url"\
  else\
    curl -sSL "$url"\

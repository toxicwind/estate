sudo bash -s <<'FIXSCRIPT'\
#!/bin/bash\
set -euo pipefail\
\
TARGET_USER="toxic"\
echo "=== Bruteforce DRM/GPU perm fix for $TARGET_USER ==="\
\
# 1. Verify user exists\
if ! id "$TARGET_USER" >/dev/null 2>&1; then\
  echo "ERROR: User $TARGET_USER does not exist. Exiting."\
  exit 1\
fi\
\
# 2. Ensure all required groups (idempotent, no duplicates)\
REQUIRED_GROUPS=(video render input audio wheel docker storage lp users rfkill seat)\
for grp in "${REQUIRED_GROUPS[@]}"; do\
  if ! id -nG "$TARGET_USER" | tr ' ' '\n' | grep -qx "$grp"; then\
    usermod -aG "$grp" "$TARGET_USER"\
    echo "Added $TARGET_USER to group: $grp"\
  fi\
done\
\
# 3. Hunt and disable known conflicting udev rules (virtualgl, nomachine, random dri overrides)\
CONFLICT_PATTERNS=(\
  "/etc/udev/rules.d/*virtualgl*"\
  "/etc/udev/rules.d/*nomachine*"\
  "/etc/udev/rules.d/*dri*"\
  "/etc/udev/rules.d/*nvidia*"\
)\
for pattern in "${CONFLICT_PATTERNS[@]}"; do\
  for rule in $pattern; do\
    if [ -f "$rule" ] && [[ ! "$rule" =\~ \.bak\. ]]; then\
      mv "\( rule" " \){rule}.bak.$(date +%s)" 2>/dev/null || true\
      echo "Disabled conflicting rule: $rule"\
    fi\
  done\
done\
\
# 4. Write strong overriding udev rule (covers card*/renderD*, NVIDIA, seat tagging)\
cat > /etc/udev/rules.d/99-toxic-dri-permissions.rules << 'RULEEOF'\
# Sovereign / toxic user DRM permissions - overrides everything previous\
# card* (KMS/primary) ‚É¶É≤ video:0660 + seat/uaccess for logind\
# renderD* (render/compute/Vulkan) ‚É¶É≤ render:0666 (standard, open for good reason)\
SUBSYSTEM=="drm", KERNEL=="card[0-9]*", GROUP="video", MODE="0660", TAG+="seat", TAG+="uaccess"\
SUBSYSTEM=="drm", KERNEL=="renderD[0-9]*", GROUP="render", MODE="0666", TAG+="seat", TAG+="uaccess"\
# NVIDIA proprietary nodes (if present)\
SUBSYSTEM=="nvidia", GROUP="video", MODE="0666"\
SUBSYSTEM=="nvidiactl", GROUP="video", MODE="0666"\
SUBSYSTEM=="nvidia-modeset", GROUP="video", MODE="0666"\
# Safety: also handle any by-path or other drm nodes\
SUBSYSTEM=="drm", KERNEL=="*", GROUP="render", MODE="0666", TAG+="uaccess"\
RULEEOF\
echo "Installed overriding udev rule: /etc/udev/rules.d/99-toxic-dri-permissions.rules"\
\
# 5. Reload + trigger udev (applies new rules immediately)\
udevadm control --reload-rules\
udevadm trigger --subsystem-match=drm\
udevadm trigger --subsystem-match=nvidia || true\
echo "udev rules reloaded and triggered."\
\
# 6. Immediate bruteforce on existing devices (ACL preferred, fallback chmod)\
for dev in /dev/dri/card* /dev/dri/renderD* /dev/nvidia* /dev/nvidiactl /dev/nvidia-modeset; do\
  if [ -e "$dev" ]; then\
    setfacl -m u:"$TARGET_USER":rw "$dev" 2>/dev/null || chmod 666 "$dev" 2>/dev/null || true\
    echo "Applied access to: $dev"\
  fi\
done\
\
# 7. Enable lingering so services/agents under toxic keep a session context\
loginctl enable-linger "$TARGET_USER" || true\
echo "Enabled linger for $TARGET_USER (services keep seat context)."\
\
echo "=== Fix complete. ==="\
echo "Next steps:"\
echo "1. Log out completely from the graphical session (or reboot) so new groups + ACLs take effect."\
echo "2. As $TARGET_USER run: groups | grep -E 'video|render'  &&  ls -l /dev/dri/"\
echo "3. Test your workload (Hyprland, ComfyUI, whatever needs the GPU)."\
echo "If still denied, paste the NEW ls -l /dev/dri/* and journalctl -b -u systemd-udevd output."\

devenv() {\
  case "$1" in\
    down)\
      shift\
      command devenv processes stop "$@"\
      ;;\
    up)\
      command devenv processes up "$@"\
      ;;\
    restart)\
      command devenv processes stop\
      sleep 1\
      command devenv processes up -d\
      ;;\
    *)\
      command devenv "$@"\
      ;;\
  esac\
}\
FIXSCRIPT\

cat > /home/toxic/experiment/install-bin.sh << 'ENDSCRIPT'\
#!/bin/bash\
set -euo pipefail\
I="${HOME}/.local/bin"\
T=$(mktemp -d)\
trap 'rm -rf "$T"' EXIT\
\
a(){ local a; a=$(uname -m); case "$a" in x86_64|amd64)echo x86_64;; aarch64|arm64)echo aarch64;; armv7l|armhf)echo armv6hf;; i386|i686)echo i386;; *)echo "$a";; esac; }\
o(){ local o; o=$(uname -s|tr '[:upper:]' '[:lower:]'); case "$o" in linux)echo linux;; darwin)echo darwin;; freebsd)echo freebsd;; mingw*|msys*|cygwin*)echo windows;; *)echo "$o";; esac; }\
dl(){ if command -v curl >/dev/null; then curl -fsSL -A "monolith/1" "$1" -o "$2"; else wget -q "$1" -O "$2"; fi; }\
ex(){ case "$1" in *.tar.xz|*.txz)tar -xf "$1" -C "$2";; *.tar.gz|*.tgz)tar -xzf "$1" -C "$2";; *.tar.bz2|*.tbz2)tar -xjf "$1" -C "$2";; *.zip)unzip -q "$1" -d "$2";; *)echo "Unknown: $1"; exit 1;; esac; }\
\
resolve_latest() {\
  local repo="$1" tag\
  if command -v jq >/dev/null 2>&1; then\
    tag=$(curl -fsSL -A "monolith/1" "https://api.github.com/repos/${repo}/releases/latest" | jq -r '.tag_name // empty')\
  else\
    tag=$(curl -fsSL -A "monolith/1" "https://api.github.com/repos/${repo}/releases/latest" | grep -oP '"tag_name":\s*"\K[^"]+' | head -1)\
  fi\
  [[ -z "$tag" ]] && { echo "ERR: could not resolve latest for $repo" >&2; exit 1; }\
  echo "$tag"\
}\
\
gh() {\
  local r="$1" v="$2" p="$3" n="$4"\
  [[ "$v" == "latest" ]] && v=$(resolve_latest "$r")\
  local ar; ar=$(a)\
  local os; os=$(o)\
  local f="${p//\{VERSION\}/$v}"; f="${f//\{ARCH\}/$ar}"; f="${f//\{OS\}/$os}"\
  local url="https://github.com/${r}/releases/download/${v}/${f}"\
  dl "$url" "$T/$f"\
  ex "$T/$f" "$T"\
  local found; found=$(find "$T" -name "$n" -type f | head -1)\
  [[ -n "$found" ]] || { echo "ERR: $n not found in $f"; exit 1; }\
  mkdir -p "$I"\
  cp "$found" "$I/$n"\
  chmod +x "$I/$n"\
  echo "Installed $n ($v) from $r"\
}\
\
url() {\
  local u="$1" n="$2" t="${3:-auto}"\
  local f; f=$(basename "$u")\
  dl "$u" "$T/$f"\
  if [[ "$t" == auto ]]; then\
    ex "$T/$f" "$T"\
    local b; b=$(find "$T" -name "$n" -type f | head -1)\
    [[ -n "$b" ]] && cp "$b" "$I/$n" || cp "$T/$f" "$I/$n"\
  else\
    cp "$T/$f" "$I/$n"\
  fi\
  chmod +x "$I/$n"\
  echo "Installed $n from $u"\
}\
\
[[ $# -lt 1 ]] && { cat <<'U'\
Usage: install-bin.sh github <repo> <version|latest> <pattern> <bin>\
       install-bin.sh url <url> <bin> [archive|raw]\
       install-bin.sh shellcheck|rg|fd\
U\
exit 1; }\
\
case "$1" in\
  github) gh "$2" "$3" "$4" "$5" ;;\
  url)    url "$2" "$3" "${4:-auto}" ;;\
  shellcheck) gh koalaman/shellcheck stable "shellcheck-{VERSION}.linux.{ARCH}.tar.xz" shellcheck ;;\
  rg|ripgrep) gh BurntSushi/ripgrep latest "ripgrep-{VERSION}-{ARCH}-unknown-linux-musl.tar.gz" rg ;;\
  fd)     gh sharkdp/fd latest "fd-{VERSION}-{ARCH}-unknown-linux-gnu.tar.gz" fd ;;\
  *) exit 1 ;;\
esac\
\
echo "export PATH=\"$I:\$PATH\""\
ENDSCRIPT\

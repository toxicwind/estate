cat > quickshell/agentic_bridge.py << 'PROD_BRIDGE'\
#!/usr/bin/env python3\
"""\
Production-grade Agentic Bridge (Sovereign Pattern)\
- CellREPL hygiene + artifact capture\
- Safety gates + audit logging\
- Tool routing for nfcot_proxy / OpenFang\
- High-entropy recursive support\
"""\
\
import os\
import subprocess\
import logging\
import json\
from pathlib import Path\
from fastapi import FastAPI, Request, HTTPException\
import uvicorn\
from datetime import datetime\
\
# Sovereign logging + CellREPL style\
logging.basicConfig(level=logging.INFO, format='%(asctime)s | %(levelname)s | %(message)s')\
log = logging.getLogger("agentic_bridge")\
\
app = FastAPI(title="Sovereign Agentic Bridge (Cerebellum Ready)")\
\
ARTIFACTS_DIR = Path("/home/toxic/sovereign/artifacts/agentic")\
ARTIFACTS_DIR.mkdir(parents=True, exist_ok=True)\
\
def save_artifact(name: str, data: dict):\
    ts = datetime.now().strftime("%Y%m%d_%H%M%S")\
    path = ARTIFACTS_DIR / f"{ts}_{name}.json"\
    path.write_text(json.dumps(data, indent=2, default=str))\
    log.info(f"Artifact saved: {path}")\
\
@app.post("/tools/get_shell_config")\
async def get_shell_config(request: Request):\
    body = await request.json()\
    key = body.get("key", "all")\
    result = dict(os.environ) if key == "all" else os.environ.get(key, "unset")\
    save_artifact("get_shell_config", {"key": key, "result": result})\
    return {"result": result}\
\
@app.post("/tools/set_shell_config")\
async def set_shell_config(request: Request):\
    body = await request.json()\
    key = body.get("key")\
    value = body.get("value")\
    if not key:\
        raise HTTPException(400, "key required")\
    os.environ[key] = str(value)\
    save_artifact("set_shell_config", {"key": key, "value": value})\
    return {"result": f"set {key}"}\
\
@app.post("/tools/run_shell_command")\
async def run_shell_command(request: Request):\
    body = await request.json()\
    cmd = body.get("command", "").strip()\
    \
    # Strong safety gates (expandable via mythos)\
    blocked = ["rm -rf /", "shutdown", ":(){ :|:& }:", "dd if=", "> /dev/sda", "mkfs"]\
    if any(bad in cmd.lower() for bad in blocked):\
        log.warning(f"Blocked dangerous command: {cmd}")\
        return {"error": "Command blocked by sovereign policy"}\
    \
    try:\
        result = subprocess.run(\
            cmd, shell=True, capture_output=True, timeout=45, text=True\
        )\
        output = result.stdout + result.stderr\
        save_artifact("run_shell_command", {\
            "command": cmd,\
            "returncode": result.returncode,\
            "output": output[:2000]  # truncate for log\
        })\
        return {"result": output, "returncode": result.returncode}\
    except subprocess.TimeoutExpired:\
        return {"error": "Command timed out"}\
    except Exception as e:\
        log.error(f"Shell error: {e}")\
        return {"error": str(e)}\
\
@app.get("/health")\

\
# 3. Install wfuzz without deps + its deps\
pip install wfuzz --no-deps\
pip install pyparsing six chardet\
\
# 4. Install everything else\
pip install schemathesis boofuzz wapiti3 nuclei-sdk ordeal
pip install --upgrade typing-extensions cryptography

#python3\
import subprocess, json, re, sys\
\
def parse_help(binary):\
out = subprocess.run([binary, "--help"], capture_output=True, text=True)\
text = out.stdout + out.stderr\
\
    lines = text.splitlines()\
    schema = {"binary": binary, "sections": []}\
    current_section = {"name": "General", "options": []}\
\
    opt_re = re.compile(\
        r'^\s+(?:(-[a-zA-Z0-9]),?\s+)?(--[a-zA-Z0-9\-]+)(?:\s+([A-Z_]+))?\s+(.*)$'\
    )\
    default_re = re.compile(r'\(default:\s*([^)]+)\)')\
\
    for raw in lines:\
        line = raw.rstrip()\
        if not line or line.startswith("usage:"):\
            continue\
        if not line.startswith('-') and not line.startswith(' ') and ('options' in line.lower() or line.endswith(':')):\
            if current_section["options"]:\
                schema["sections"].append(current_section)\
            current_section = {"name": line.strip().rstrip(':'), "options": []}\
            continue\
        if not line.strip().startswith('-') and not line.strip().startswith(' '):\
            if current_section["options"]:\
                schema["sections"].append(current_section)\
            current_section = {"name": line.strip(), "options": []}\
            continue\
\
        m = opt_re.match(line)\
        if not m:\
            if current_section["options"] and line.strip():\
                current_section["options"][-1]["description"] += " " + line.strip()\
            continue\
\
        short_flag, long_flag, arg_type, description = m.groups()\
        default = None\
        dm = default_re.search(description)\
        if dm:\
            default = dm.group(1).strip()\
            description = description[:dm.start()].strip()\
\
        opt = {\
            "short": short_flag,\
            "long": long_flag,\
            "arg": arg_type,\
            "description": description.strip(),\
            "default": default,\
            "enabled": True\
        }\
        current_section["options"].append(opt)\
\
    if current_section["options"]:\
        schema["sections"].append(current_section)\
\
    return schema\
\
if name == "main":\
for binary in ["/home/toxic/sovereign/bin/llama-server", "/usr/bin/process-compose"]:\
try:\
schema = parse_help(binary)\
name = binary.split('/')[-1]\
out_path = f"/home/toxic/sovereign/config/{name}-schema.json"\
with open(out_path, "w") as f:\
json.dump(schema, f, indent=2)\
total = sum(len(s['options']) for s in schema['sections'])\
print(f"‚ÉºÉ• {name}: {total} options ‚É¶É≤ {out_path}")\
except Exception as e:\
print(f"‚ÉΩÉ¨ {binary}: {e}")\

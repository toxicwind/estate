read -r -d '' SCRIPT_EXFIL << 'EOT' || true\
#!/usr/bin/env python3\
import os, sys, time, re, json, requests, argparse\
from datetime import datetime\
PATTERNS = [\
    re.compile(r'SetPosition\s+X=([\d\.\-]+)\s+Y=([\d\.\-]+)', re.I),\
    re.compile(r'Location:\s*\(([\d\.\-]+),\s*([\d\.\-]+)\)', re.I),\
    re.compile(r'SpiceBloom\s+at\s+([\d\.\-]+)\s*,\s*([\d\.\-]+)', re.I),\
    re.compile(r'NPC\s+Spawn:\s*(\w+)\s+at\s*\(([\d\.\-]+),\s*([\d\.\-]+)\)', re.I),\
    re.compile(r'Resource\s+node\s+found\s+at\s+([\d\.\-]+)\s+([\d\.\-]+)', re.I),\
]\
def parse_line(line):\
    for p in PATTERNS:\
        m = p.search(line)\
        if m:\
            if 'SetPosition' in p.pattern or 'Location' in p.pattern:\
                typ, lat, lng = "player", float(m.group(2)), float(m.group(1))\
            elif 'SpiceBloom' in p.pattern:\
                typ, lat, lng = "spice", float(m.group(2)), float(m.group(1))\
            elif 'NPC Spawn' in p.pattern:\
                typ, lat, lng = "npc", float(m.group(3)), float(m.group(2))\
            else:\
                typ, lat, lng = "resource", float(m.group(2)), float(m.group(1))\
            return {"timestamp": datetime.utcnow().isoformat()+"Z", "type": typ, "lat": lat, "lng": lng}\
    return None\
def tail_log(path, outfile, interval=1.0):\
    with open(path, 'r', encoding='utf-8', errors='ignore') as f:\
        f.seek(0, os.SEEK_END)\
        while True:\
            line = f.readline()\
            if not line:\
                time.sleep(interval)\
                continue\
            d = parse_line(line)\
            if d:\
                out = json.dumps(d)\
                if outfile: open(outfile, 'a').write(out+"\n")\
                else: sys.stdout.write(out+"\n"); sys.stdout.flush()\
def poll_api(api, outfile, interval=2.0):\
    while True:\
        try:\
            r = requests.get(api, timeout=5)\
            if r.status_code == 200:\
                data = r.json()\
                actors = data.get("actors", []) if isinstance(data, dict) else data\
                for a in actors:\
                    if a.get("lat") and a.get("lng"):\
                        d = {"timestamp": datetime.utcnow().isoformat()+"Z", "type": a.get("type"), "lat": a["lat"], "lng": a["lng"]}\
                        out = json.dumps(d)\
                        if outfile: open(outfile, 'a').write(out+"\n")\
                        else: sys.stdout.write(out+"\n"); sys.stdout.flush()\
        except: pass\
        time.sleep(interval)\
def main():\
    p = argparse.ArgumentParser()\
    p.add_argument("--log"); p.add_argument("--api"); p.add_argument("--output", "-o")\
    p.add_argument("--interval", type=float, default=1.0); p.add_argument("--api-interval", type=float, default=2.0)\
    args = p.parse_args()\
    if not args.log and not args.api: sys.exit("Need --log or --api")\
    if args.log and args.api:\
        import threading\
        t1 = threading.Thread(target=tail_log, args=(args.log, args.output, args.interval))\
        t2 = threading.Thread(target=poll_api, args=(args.api, args.output, args.api_interval))\
        t1.daemon = t2.daemon = True; t1.start(); t2.start()\
        try: while True: time.sleep(1)\
        except KeyboardInterrupt: pass\
    elif args.log: tail_log(args.log, args.output, args.interval)\
    else: poll_api(args.api, args.output, args.api_interval)\
if __name__ == "__main__": main()\
EOT\
\
read -r -d '' SCRIPT_RECON << 'EOT' || true\
#!/usr/bin/env python3\
import os, sys, re, json, time, requests, websocket, argparse\
from datetime import datetime\
LOG_FILE = "thgl_analysis.jsonl"\
PATTERNS = {\
    "api": re.compile(r'(https?://[^\s"\'<>]+)'),\
    "ws": re.compile(r'(wss?://[^\s"\'<>]+)'),\
    "actor": re.compile(r'"lat":\s*([\d\.\-]+),\s*"lng":\s*([\d\.\-]+)'),\
    "token": re.compile(r'(token|key|auth)[\s]*[:=][\s]*["\']([^"\']+)["\']', re.I),\
}\
def extract(path):\
    r = {"api": set(), "ws": set(), "actors": [], "tokens": []}\
    if not os.path.exists(path): return r\
    with open(path, 'r', errors='ignore') as f:\
        for line in f:\
            r["api"].update(PATTERNS["api"].findall(line))\
            r["ws"].update(PATTERNS["ws"].findall(line))\
            for m in PATTERNS["token"].findall(line): r["tokens"].append(m[1])\
            m = PATTERNS["actor"].search(line)\
            if m: r["actors"].append({"lat": float(m[1]), "lng": float(m[2])})\
    return r\
def main():\
    p = argparse.ArgumentParser()\
    p.add_argument("--log", default=LOG_FILE)\
    p.add_argument("--live", action="store_true")\
    p.add_argument("--tail"); p.add_argument("--output")\
    args = p.parse_args()\
    if args.tail:\
        with open(args.tail, 'r', errors='ignore') as f:\
            f.seek(0, os.SEEK_END)\
            while True:\
                line = f.readline()\
                if line:\
                    data = {"ts": datetime.utcnow().isoformat()+"Z", "line": line.strip()}\
                    if args.output: open(args.output, 'a').write(json.dumps(data)+"\n")\
                    else: print(json.dumps(data))\
                else: time.sleep(0.5)\
        return\
    ex = extract(args.log)\
    print(f"APIs: {len(ex['api'])}\nWS: {len(ex['ws'])}\nActors: {len(ex['actors'])}")\
    if args.live:\
        while True:\
            for url in ex["api"]:\
                try:\
                    r = requests.get(url, timeout=3)\
                    if r.status_code < 400: print(f"[LIVE] {url} -> {r.status_code}")\
                except: pass\
            for url in ex["ws"]:\
                try:\
                    ws = websocket.create_connection(url, timeout=3)\
                    ws.close(); print(f"[LIVE] WS {url} ok")\
                except: pass\
            time.sleep(2)\
    else:\
        for url in ex["api"]: print(f"API: {url}")\
        for url in ex["ws"]: print(f"WS: {url}")\
if __name__ == "__main__": main()\
EOT\

    for d in root_dir.glob("**/node_modules"):
    for d in root_dir.glob("**/__pycache__"):
        shutil.rmtree(d, ignore_errors=True)
def chunk_jsonl(input_dir, output_dir, max_size=20*1024*1024):
    output_dir.mkdir(exist_ok=True)
    existing = [int(p.stem.split("_")[1]) for p in output_dir.glob("chunk_*.jsonl")]
    chunk_num = max(existing)+1 if existing else 1
    for json_file in input_dir.glob("**/*.json"):
            with open(json_file, "r", encoding="utf-8") as f:
                data = json.load(f)
                sz = len(line.encode("utf-8")) + 1
                if cur_size + sz > max_size and cur_chunk:
                    out = output_dir / f"chunk_{chunk_num:04d}.jsonl"
                    out.write_text("\n".join(cur_chunk))
            print(f"    [warn] {json_file.name}: {e}")
        (output_dir / f"chunk_{chunk_num:04d}.jsonl").write_text("\n".join(cur_chunk))
def analyze_chunks(chunk_dir, output_json):
    all_findings = []
    counts = Counter()
    for chunk_file in sorted(chunk_dir.glob("chunk_*.jsonl")):
        print(f"  analyzing {chunk_file.name}")
        findings = []
        with open(chunk_file, "r", encoding="utf-8", errors="ignore") as f:
            for ln, line in enumerate(f, 1):
                line = line.strip()
                if not line: continue
                for ip in extract_ips(line):
                    findings.append(("ip_address", ln, ip)); counts["ip"]+=1
                for url in extract_urls(line):
                    findings.append(("url", ln, url)); counts["url"]+=1
                for addr in extract_crypto(line):
                    findings.append(("crypto", ln, addr)); counts["crypto"]+=1
                for api in winapi_calls(line):
                    findings.append(("winapi", ln, api)); counts["winapi"]+=1
                for ob in obfuscation_indicators(line):
                    findings.append(("obfuscation", ln, ob)); counts["obf"]+=1
                if is_high_entropy(line):
                    findings.append(("high_entropy", ln, line[:80])); counts["entropy"]+=1
                elif looks_like_base64(line):
                    findings.append(("base64", ln, line[:80])); counts["b64"]+=1
        if findings:
            all_findings.append({"file": chunk_file.name, "findings": [{"type":t,"line":ln,"detail":d} for t,ln,d in findings]})
    with open(output_json, "w") as f:
        json.dump(all_findings, f, indent=2)
    print("\n=== Cheat Heuristics Summary ===")
    for k,v in counts.most_common():
        print(f"  {k}: {v}")
    print(f"Full report: {output_json}")

HF_TOKEN = { description = "HF token (alias)" }\
TELEGRAM_ALLOWED_USERS = { description = "Comma-separated allowed Telegram user IDs" }\
TOML\
 fi\
fi\
\
echo ">>> [3/7] Keyring provider..."\
secretspec config init --provider keyring --non-interactive 2>/dev/null || true\
\
echo ">>> [4/7] Auto-detect + push missing secrets..."\
\
mapfile -t KEYS < <(grep -oE '^[A-Z0-9_]+' "$SECRETSPEC_TOML" | grep -v '^TOML$' || true)\
\
for key in "${KEYS[@]}"; do\
 if secretspec get "$key" >/dev/null 2>&1; then\
 echo "    ‚ÉºÉ≥ $key (already in keyring)"\
 continue\
 fi\
\
 val=""\
\
 \
 if [[ -f "$ENV_FILE" ]]; then\
 val=$(grep -E "^${key}=" "$ENV_FILE" | head -n1 | cut -d'=' -f2- | sed -e 's/^["'\'']//' -e 's/["'\'']$//' || true)\
 fi\
\
 \
 if [[ -z "$val" && -f "$SECRETS_FILE" ]]; then\
 val=$(grep -E "^${key}=" "$SECRETS_FILE" | head -n1 | cut -d'=' -f2- | sed -e 's/^["'\'']//' -e 's/["'\'']$//' || true)\
 fi\
\
 if [[ -n "$val" ]]; then\
 printf '%s\n' "$val" | secretspec set "$key" >/dev/null\
 src=$([[ -f "$ENV_FILE" ]] && grep -q "^${key}=" "$ENV_FILE" && echo ".env" || echo ".secrets")\
 echo "    ‚É¶É≤ $key pushed from $src"\
 else\
 echo "    fd sovereign-launch.js $key not in .env or .secrets ‚ÄÉ¥ prompting..."\
 secretspec set "$key"\
 fi\
done\
\
echo ">>> [5/7] Verification..."\
secretspec check\
\
echo ">>> [6/7] Cleanup (uncomment when ready)..."\

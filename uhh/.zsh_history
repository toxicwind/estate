#!/usr/bin/env bash\
set -uo pipefail\
echo "=== SOVEREIGN TEST SUITE v2 ==="\
for port in 25000 25001 25004 25008; do\
  echo\
  echo "--- port $port ---"\
  curl -sv http://127.0.0.1:$port/ 2>&1 | head -40 || true\
done\
\
echo\
echo "--- 25001 /v1/models ---"\
curl -s http://127.0.0.1:25001/v1/models; echo\
\
echo\
echo "--- 25001 /health ---"\
curl -s http://127.0.0.1:25001/health; echo\
\
echo\
echo "--- 25001 chat/completions ---"\
curl -s http://127.0.0.1:25001/v1/chat/completions \\
  -H "Content-Type: application/json" \\
  -d '{\
    "model": "/home/toxic/models/Qwen3.6-27B-Heretic-Cerebellum-v1-Q2_K_Mixed.gguf",\
    "messages": [{"role":"user","content":"say pong"}],\
    "max_tokens": 16,\
    "temperature": 0.1\
  }'\
echo\
\
echo\
echo "--- 25008 NF-CoT /v1/models ---"\
curl -s http://127.0.0.1:25008/v1/models; echo\
\
echo\
echo "--- 25004 OpenFang ---"\
curl -sv http://127.0.0.1:25004/ 2>&1 | head -40 || true
nano sovereign_health_check.sh
chmod +x sovereign_health_check.sh\
./sovereign_health_check.sh
#!/bin/bash\
# ------------------------------------------------------------------------------\
# sovereign_temporary_health.sh ‚ÄÉ≥ One-shot health check + Caddy fix\
# ------------------------------------------------------------------------------\
\
set -e\
\
GREEN='\033[0;32m'\
RED='\033[0;31m'\
YELLOW='\033[0;33m'\
CYAN='\033[0;36m'\
NC='\033[0m'\
\
echo -e "${CYAN}‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞${NC}"\
echo -e "${CYAN}   SOVEREIGN TEMPORARY HEALTH CHECK${NC}"\
echo -e "${CYAN}‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞${NC}"\
echo ""\
\
# ------------------------------------------------------------------------------\
# 1. Fix Caddy ‚ÄÉ≥ replace minimal with proper full config\
# ------------------------------------------------------------------------------\
echo -e "${YELLOW}‚É¶É≤ Upgrading Caddy config to full version...${NC}"\
CADDYFILE="/home/toxic/sovereign/Caddyfile"\
cat > "$CADDYFILE" << 'EOF'\
{\
    auto_https off\
}\
:25000 {\
    # Dashboard (static files)\
    root * /home/toxic/sovereign/dashboard\
    file_server\
\
    # Health endpoint\
    handle /health {\
        respond "OK" 200\
    }\
\
    # Proxy to NF‚ÄÉ±CoT proxy (port 25008)\
    handle /v1/chat/completions {\
        reverse_proxy localhost:25008\
    }\
    handle /v1/models {\
        reverse_proxy localhost:25008\
    }\
    handle /v1/embeddings {\
        reverse_proxy localhost:25008\
    }\
\
    # Proxy to OpenFang (port 25004)\
    handle /openfang/* {\
        uri strip_prefix /openfang\
        reverse_proxy localhost:25004\
    }\
\
    # Proxy to raw llama-server (port 25001) as fallback\
    handle /raw/* {\
        uri strip_prefix /raw\
        reverse_proxy localhost:25001\
    }\
\
    # Default ‚ÄÉ≥ serve dashboard\
    handle {\
        file_server\
    }\
}\
EOF\
\
# Restart Caddy if running, or start it\
if pgrep -f "caddy run.*25000" >/dev/null; then\
    pkill -f "caddy run.*25000" || true\
    sleep 1\
fi\
caddy run --config "$CADDYFILE" > /home/toxic/sovereign/logs/caddy.log 2>&1 &\
CADDY_PID=$!\
sleep 2\
if kill -0 $CADDY_PID 2>/dev/null; then\
    echo -e "${GREEN}‚ÉºÉ• Caddy started with full config (PID: $CADDY_PID)${NC}"\
else\
    echo -e "${RED}‚ÉΩÉ¨ Caddy failed to start${NC}"\
fi\
\
# ------------------------------------------------------------------------------\
# 2. Quick port checks (one-time poll)\
# ------------------------------------------------------------------------------\
echo -e "\n${CYAN}‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞${NC}"\
echo -e "${CYAN}   SERVICE STATUS (one-time poll)${NC}"\
echo -e "${CYAN}‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞${NC}"\
echo ""\
\
declare -A PORTS=(\
    [25000]="Caddy"\
    [25001]="llama-server"\
    [25004]="OpenFang"\
    [25008]="NF‚ÄÉ±CoT proxy"\
)\
\
for port in 25000 25001 25004 25008; do\
    name="${PORTS[$port]}"\
    # Try /health, then /v1/models, then root\
    if curl -s --max-time 2 http://127.0.0.1:$port/health >/dev/null 2>&1 || \\
       curl -s --max-time 2 http://127.0.0.1:$port/v1/models >/dev/null 2>&1 || \\
       curl -s --max-time 2 http://127.0.0.1:$port/ >/dev/null 2>&1; then\
        echo -e "${GREEN}‚ÉºÉ• $port ($name) ‚ÄÉ≥ responding${NC}"\
    else\
        echo -e "${RED}‚ÉΩÉ¨ $port ($name) ‚ÄÉ≥ not reachable${NC}"\
    fi\
done\
\
# ------------------------------------------------------------------------------\
# 3. Test NF‚ÄÉ±CoT proxy (with max_tokens = -1)\
# ------------------------------------------------------------------------------\
echo -e "\n${CYAN}‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞${NC}"\
echo -e "${CYAN}   NF‚ÄÉ±CoT PROXY CHAT TEST (unlimited)${NC}"\
echo -e "${CYAN}‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞${NC}"\
echo ""\
\
RESPONSE=$(curl -s -X POST http://127.0.0.1:25008/v1/chat/completions \\
  -H "Content-Type: application/json" \\
  -d '{\
    "model": "/home/toxic/models/Qwen3.6-27B-Heretic-Cerebellum-v1-Q2_K_Mixed.gguf",\
    "messages": [{"role": "user", "content": "What is 27 * 13? Explain step by step."}],\
    "max_tokens": -1,\
    "temperature": 0.1\
  }')\
\
if echo "$RESPONSE" | grep -q '"content"'; then\
    echo -e "${GREEN}‚ÉºÉ• Chat completion succeeded${NC}"\
    echo "$RESPONSE" | jq '.choices[0].message | {content, reasoning_content}' 2>/dev/null || echo "$RESPONSE"\
else\
    echo -e "${RED}‚ÉΩÉ¨ Chat completion failed${NC}"\
    echo "$RESPONSE"\
fi\
\
# ------------------------------------------------------------------------------\
# 4. Summary\
# ------------------------------------------------------------------------------\
echo -e "\n${CYAN}‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞${NC}"\
echo -e "${CYAN}   SUMMARY${NC}"\
echo -e "${CYAN}‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞${NC}"\
echo ""\
echo -e "  ${GREEN}‚ÉºÉ•${NC} Caddy config replaced with full version (port 25000)"\
echo -e "  ${GREEN}‚ÉºÉ•${NC} All services polled (one-time)"\

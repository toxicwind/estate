    "$HOME/bin"\
    "$HOME/.cargo/bin"\
    "$HOME/.grok/bin"\
    "$HOME/go/bin"\
    "$HOME/.pixi/bin"\
)\
\
is_elf() {\
    local f="$1"\
    [[ -f "$f" ]] || return 1\
    file --brief --mime-type "$f" 2>/dev/null | grep -qE '^application/x-(executable|pie-executable|sharedlib)'\
}\
\
probe_binary() {\
    local bin="$1"\
    echo "   --version:"\
    timeout 2s env DISPLAY= WAYLAND_DISPLAY= "$bin" --version 2>&1 | head -8 || echo "     (no output / error or timeout)"\
    echo "   --help:"\
    timeout 2s env DISPLAY= WAYLAND_DISPLAY= "$bin" --help 2>&1 | head -12 || echo "     (no output / error or timeout)"\
}\
\
echo "=== SMART PATH AUDIT v8 (bash -s wrapped, strict, ordered echos) ==="\

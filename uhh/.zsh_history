import json, os, re\
\
def update_settings(path, venv_path):\
    if not os.path.exists(os.path.dirname(path)):\
        os.makedirs(os.path.dirname(path), exist_ok=True)\
    data = {}\
    if os.path.exists(path):\
        try:\
            # Strip comments before parsing\
            clean_json = re.sub(r"(?m)^ *//.*|/\*.*?\*/", "", open(path).read())\
            data = json.loads(clean_json or "{}")\
        except Exception as e:\
            print(f"Warning: could not parse {path}: {e}")\
            \
    data["python.defaultInterpreterPath"] = venv_path\
    \
    with open(path, "w") as f:\
        json.dump(data, f, indent=2)\
    print(f"[+] Patched {path}")\
\
# Patch Workspace\
update_settings(os.path.expanduser("~/sovereign/.vscode/settings.json"), "/home/toxic/sovereign/.venv/bin/python")\
\
# Patch Global\
update_settings(os.path.expanduser("~/.config/Antigravity IDE/User/settings.json"), "/home/toxic/sovereign/.venv/bin/python")\
'

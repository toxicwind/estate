#!/usr/bin/env zsh\
\
# Ensure API key is set\
if [[ -z "$NVIDIA_API_KEY" ]]; then\
    echo "ERROR: NVIDIA_API_KEY environment variable not set."\
    exit 1\
fi\
\
BASE_URL="https://integrate.api.nvidia.com/v1/chat/completions"\
HEADERS=(-H "Authorization: Bearer $NVIDIA_API_KEY" -H "Content-Type: application/json")\
\
# Helper: run a test and pretty-print the response\
run_test() {\
    local name="$1"\
    local data="$2"\
    echo "\n\033[1m=== TEST: $name ===\033[0m"\
    curl -s -X POST "$BASE_URL" $HEADERS -d "$data" | jq '.'\
}\
\
# 1. Basic chat (no extras)\
run_test "Basic Chat" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "Say hello"}],\
    "max_tokens": 20\
}'\
\
# 2. Single tool call (weather)\
run_test "Single Tool Call" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "What is the weather in London?"}],\
    "tools": [{\
        "type": "function",\
        "function": {\
            "name": "get_weather",\
            "description": "Get current weather",\
            "parameters": {\
                "type": "object",\
                "properties": {"location": {"type": "string"}},\
                "required": ["location"]\
            }\
        }\
    }],\
    "tool_choice": "auto",\
    "max_tokens": 100\
}'\
\
# 3. Parallel tool calls (ask for weather and time)\
run_test "Parallel Tool Calls" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "What is the weather in London and the current time in Tokyo?"}],\
    "tools": [\
        {\
            "type": "function",\
            "function": {\
                "name": "get_weather",\
                "description": "Get current weather",\
                "parameters": {\
                    "type": "object",\
                    "properties": {"location": {"type": "string"}},\
                    "required": ["location"]\
                }\
            }\
        },\
        {\
            "type": "function",\
            "function": {\
                "name": "get_time",\
                "description": "Get current time",\
                "parameters": {\
                    "type": "object",\
                    "properties": {"timezone": {"type": "string"}},\
                    "required": ["timezone"]\
                }\
            }\
        }\
    ],\
    "tool_choice": "auto",\
    "parallel_tool_calls": true,\
    "max_tokens": 150\
}'\
\
# 4. Image input (1√É∑1 white pixel PNG)\
# Base64 of a 1x1 white PNG\
IMG_BASE64="iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="\
run_test "Image Input" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [\
        {\
            "role": "user",\
            "content": [\
                {"type": "text", "text": "Describe this image"},\
                {"type": "image_url", "image_url": {"url": "data:image/png;base64,'"$IMG_BASE64"'"}}\
            ]\
        }\
    ],\
    "max_tokens": 50\
}'\
\
# 5. Prompt cache key (should be rejected or ignored)\
run_test "Prompt Cache Key (should error)" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "Hello"}],\
    "prompt_cache_key": "test-thread-123",\
    "max_tokens": 10\
}'\
\
# 6. Reasoning effort (max)\
run_test "Reasoning Effort (max)" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "Explain quantum computing in simple terms"}],\
    "reasoning_effort": "max",\
    "max_tokens": 300\
}'\
\
# 7. Max tokens truncation (set a very low limit)\
run_test "Max Tokens (truncation)" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "Write a detailed essay about the history of the internet"}],\
    "max_tokens": 20\
}'\
\
echo "\n\033[32mAll tests completed.\033[0m"
c
#!/usr/bin/env zsh\
\
# ÁÉÅÆ‰øÉΩËÆæÁΩÆ‰∫É¶ API ÂØÉ¶ÈÉ≤•\
if [[ -z "$NVIDIA_API_KEY" ]]; then\
    echo "ERROR: NVIDIA_API_KEY environment variable not set."\
    exit 1\
fi\
\
BASE_URL="https://integrate.api.nvidia.com/v1/chat/completions"\
HEADERS=(-H "Authorization: Bearer $NVIDIA_API_KEY" -H "Content-Type: application/json")\
OUTPUT_FILE="test_results.json"\
\
# Ê∏É•Á©∫ËæÉ≥ÂÉß∫ÊÉ∂Éß‰ª∂ÔºÉ®‰ª•Á©∫ÊÉµ∞ÁªÉ§ÂºÄÂ§¥ÔºÉ©\
echo '[]' > "$OUTPUT_FILE"\
\
# ‰∏¥ÊÉ∑∂ÊÉ∂Éß‰ª∂ÂÉ®É∑ËÉÅ®\
temp_files=()\
\
# ËæÉ•ÂÉ™©ÂÉßΩÊÉµ∞ÔºÉ∫ËøÉ∞ËÉÅÉ¨ÊµÉ´ËØÉµÂπ∂‰øÉΩÂ≠É∏ÁªÉ≥ÊÉæÉº\
run_test() {\
    local name="$1"\
    local data="$2"\
    echo "\n\033[1m=== TEST: $name ===\033[0m"\
    \
    # ÊÉ©ßËÉÅÉ¨ËØ∑Ê±ÇÂπ∂‰øÉΩÂ≠É∏ÂÉ≥É≠Â∫É¥\
    local response=$(curl -s -X POST "$BASE_URL" $HEADERS -d "$data")\
    \
    # ÁæÉÆÂÉ¨É∂ÊÉ©É≥ÂÉ≠∞ÂÉ®∞ÁªÉ®Á´ØÔºÉ®‰æø‰∫ÉÆËßÇÂØÉøÔºÉ©\
    echo "$response" | jq '.'\
    \
    # ÊÉæÉ§ÈÄÉÄ‰∏Ä‰∏™ÂÉ¨É•ÂÉ∞´ÊµÉ´ËØÉµÂÉ∞É≠Áß∞ÂÉ≤É¨ÂÉ≥É≠Â∫É¥ÁÉ∫É§ JSON ÂØπË±ÉÅÔºÉ¨ÂÉ¶ÉπÂÉ••‰∏¥ÊÉ∑∂ÊÉ∂Éß‰ª∂\
    local temp_file=$(mktemp)\
    jq -n --arg name "$name" --argjson response "$response" '{name: $name, response: $response}' > "$temp_file"\
    temp_files+=("$temp_file")\
}\
\
# 1. ÂÉø∫ÊÉº¨ËÅÉ™Â§©\
run_test "Basic Chat" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "Say hello"}],\
    "max_tokens": 20\
}'\
\
# 2. ÂÉ≠ÉµÂ∑•ÂÉ•∑Ë∞É£ÁÉ¥®ÔºÉ®Â§©Ê∞É¥ÔºÉ©\
run_test "Single Tool Call" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "What is the weather in London?"}],\
    "tools": [{\
        "type": "function",\
        "function": {\
            "name": "get_weather",\
            "description": "Get current weather",\
            "parameters": {\
                "type": "object",\
                "properties": {"location": {"type": "string"}},\
                "required": ["location"]\
            }\
        }\
    }],\
    "tool_choice": "auto",\
    "max_tokens": 100\
}'\
\
# 3. Âπ∂ËÉÅÉ¨Â∑•ÂÉ•∑Ë∞É£ÁÉ¥®ÔºÉ®Â§©Ê∞É¥ÂÉ≤É¨ÊÉ∑∂ÈÉ∑¥ÔºÉ©\
run_test "Parallel Tool Calls" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "What is the weather in London and the current time in Tokyo?"}],\
    "tools": [\
        {\
            "type": "function",\
            "function": {\
                "name": "get_weather",\
                "description": "Get current weather",\
                "parameters": {\
                    "type": "object",\
                    "properties": {"location": {"type": "string"}},\
                    "required": ["location"]\
                }\
            }\
        },\
        {\
            "type": "function",\
            "function": {\
                "name": "get_time",\
                "description": "Get current time",\
                "parameters": {\
                    "type": "object",\
                    "properties": {"timezone": {"type": "string"}},\
                    "required": ["timezone"]\
                }\
            }\
        }\
    ],\
    "tool_choice": "auto",\
    "parallel_tool_calls": true,\
    "max_tokens": 150\
}'\
\
# 4. ÂÉªæÂÉ£ÉØËæÉ≥ÂÉ••ÔºÉ®1x1 ÁÉπΩËÉ©≤ PNGÔºÉ©\
IMG_BASE64="iVBORw0KGgoAAAANSUhEUgAAAAEAAAABCAYAAAAfFcSJAAAADUlEQVR42mNk+M9QDwADhgGAWjR9awAAAABJRU5ErkJggg=="\
run_test "Image Input" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [\
        {\
            "role": "user",\
            "content": [\
                {"type": "text", "text": "Describe this image"},\
                {"type": "image_url", "image_url": {"url": "data:image/png;base64,'"$IMG_BASE64"'"}}\
            ]\
        }\
    ],\
    "max_tokens": 50\
}'\
\
# 5. prompt_cache_keyÔºÉ®ÈÉÇÉ§ÊÉºÉøËÉÇ´ÊÉ´É≤ÁªÉΩÊÉ®É∂ÂøΩÁÉµ•ÔºÉ©\
run_test "Prompt Cache Key (should error)" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "Hello"}],\
    "prompt_cache_key": "test-thread-123",\
    "max_tokens": 10\
}'\
\
# 6. reasoning_effort = max\
run_test "Reasoning Effort (max)" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "Explain quantum computing in simple terms"}],\
    "reasoning_effort": "max",\
    "max_tokens": 300\
}'\
\
# 7. max_tokens ÊÉ®™ÊÉ∂≠ÔºÉ®ÊÉæÅ‰ΩÉÆÈÉπÉ∞ÂÉ®∂ÔºÉ©\
run_test "Max Tokens (truncation)" '{\
    "model": "thinkingmachines/inkling",\
    "messages": [{"role": "user", "content": "Write a detailed essay about the history of the internet"}],\
    "max_tokens": 20\
}'\
\
# ÂÉ∞É®Âπ∂ÊÉ©ÄÊÉºÉ©‰∏¥ÊÉ∑∂ÊÉ∂Éß‰ª∂‰∏∫‰∏Ä‰∏™ JSON ÊÉµ∞ÁªÉ§ÔºÉ¨‰øÉΩÂ≠É∏ÂÉ®∞ËæÉ≥ÂÉß∫ÊÉ∂Éß‰ª∂\
echo "\n\033[32mMerging results into $OUTPUT_FILE ...\033[0m"\
jq -s '.' "${temp_files[@]}" > "$OUTPUT_FILE"\
\
# Ê∏É•ÁÉ∞É¶‰∏¥ÊÉ∑∂ÊÉ∂Éß‰ª∂\
rm "${temp_files[@]}"\
\
echo "\033[32mAll tests completed. Results saved to $OUTPUT_FILE\033[0m"
c

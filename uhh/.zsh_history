#!/bin/bash\
DEST_DIR="/home/toxic/projects"\
PROJECT_NAME=$(basename "$PWD")\
TIMESTAMP=$(date +%Y%m%d_%H%M%S)\
OUTPUT_FILE="$DEST_DIR/${PROJECT_NAME}_${TIMESTAMP}.tar.gz"\
\
BG_BLUE="\033[44m\033[30m"\
TEXT_WHITE="\033[1;37m"\
TEXT_GRAY="\033[0;90m"\
RESET="\033[0m"\
\
mkdir -p "$DEST_DIR"\
echo -e "${BG_BLUE} ARCHIVING PROJECT ${RESET} $PROJECT_NAME"\
echo -e "${TEXT_GRAY}Destination: $OUTPUT_FILE${RESET}\n"\
\
count=0\
tar -czvf "$OUTPUT_FILE" \\
    --exclude='build' \\
    --exclude='build_release' \\
    --exclude='target' \\
    --exclude='.git' \\
    --exclude='node_modules' \\
    --exclude='dist' \\
    --exclude='venv' \\
    --exclude='.DS_Store' \\
    --exclude='__pycache__' \\
    . 2>/dev/null | while read -r line; do\
        ((count++))\
        clean_line=$(echo "$line" | sed 's|^./||')\
        if [ ${#clean_line} -gt 60 ]; then \
            clean_line="...${clean_line: -57}"\
        fi\
        printf "\r\033[K   ${TEXT_WHITE}[%4d]${RESET} ${TEXT_GRAY}Packing:${RESET} %-60s" "$count" "$clean_line"\
done\
echo -e "\n\n${BG_BLUE} SUCCESS ${RESET} Archive locked down cleanly."\
EOF

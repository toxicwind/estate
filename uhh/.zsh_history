    'curl -s --max-time 5 http://127.0.0.1:25001/v1/models | jq -c .'\
\
# 2. ik_llama quick completion\
run_check "ik_llama_completion" \\
    'curl -s --max-time 10 -X POST http://127.0.0.1:25001/completion \\

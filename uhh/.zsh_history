#!/bin/bash\
set -euo pipefail\
MONO="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"\
D="$MONO"\
\
usage(){\
cat <<'U'\
Usage: monolith.sh <cmd> [args]\
Commands:\
  deps <file>     Install from requirements.txt\
  inject <name> <src>\
  setup\
  run <script> [args]\
All files live in this monolith directory.\
U\
}\
\
req-install(){\
local f="${1:-$MONO/requirements.txt}"; [[ -f "$f" ]] || { echo "No $f"; exit 1; }\
while IFS= read -r line; do\
[[ "$line" =~ ^# || -z "$line" ]] && continue\
local type="${line%%:*}" spec="${line#*:}"\
case "$type" in\
  bun) command -v bun >/dev/null && bun add -d "$spec" || echo "SKIP bun";;\
  npm) command -v npm >/dev/null && npm install --save-dev "$spec" || echo "SKIP npm";;\
  pip) command -v pip3 >/dev/null && pip3 install "$spec" || command -v pip >/dev/null && pip install "$spec" || echo "SKIP pip";;\
  go) command -v go >/dev/null && go install "$spec" || echo "SKIP go";;\
  cargo) command -v cargo >/dev/null && cargo install "$spec" || echo "SKIP cargo";;\
  pacman) command -v pacman >/dev/null && sudo pacman -S --noconfirm "$spec" || echo "SKIP pacman";;\
  nix) command -v nix-env >/dev/null && nix-env -iA "nixpkgs.$spec" || echo "SKIP nix";;\
  github) gh-install "$spec";;\
  url) url-install "$spec";;\
  *) echo "UNKNOWN: $type";;\
esac\
done < "$f"\
}\
\
gh-install(){\
local IFS=:; read -r repo version pattern bin <<< "$1"\
local T=$(mktemp -d); trap "rm -rf $T" EXIT\
local arch=$(uname -m); case "$arch" in x86_64|amd64)arch=x86_64;;aarch64|arm64)arch=aarch64;;armv7l|armhf)arch=armv6hf;;esac\
local os=$(uname -s|tr '[:upper:]' '[:lower:]'); case "$os" in linux)os=linux;;darwin)os=darwin;;esac\
local f="${pattern//\{VERSION\}/$version}"; f="${f//\{ARCH\}/$arch}"; f="${f//\{OS\}/$os}"\
local url="https://github.com/$repo/releases/download/$version/$f"\
if command -v curl >/dev/null; then curl -fsSL "$url" -o "$T/$f"; else wget -q "$url" -O "$T/$f"; fi\
case "$f" in *.tar.xz|*.txz)tar -xf "$T/$f" -C "$T";;*.tar.gz|*.tgz)tar -xzf "$T/$f" -C "$T";;*.tar.bz2)tar -xjf "$T/$f" -C "$T";;*.zip)unzip -q "$T/$f" -d "$T";;esac\
local found=$(find "$T" -name "$bin" -type f|head -1)\
[[ -n "$found" ]] || { echo "ERR: $bin not found"; exit 1; }\
cp "$found" "$MONO/$bin"; chmod +x "$MONO/$bin"\
echo "Installed $bin from $repo into monolith"\
}\
\
url-install(){\
local spec="${1:-}"; [[ -z "$spec" ]] && { echo "ERR"; exit 1; }\
local url name atype="auto"\
if [[ "$spec" =~ :(auto|archive|raw)$ ]]; then atype="${spec##*:}"; local rest="${spec%:*}"; name="${rest##*:}"; url="${rest%:*}"; else name="${spec##*:}"; url="${spec%:*}"; fi\
[[ -z "$url" || -z "$name" ]] && { echo "ERR url spec"; exit 1; }\
local T=$(mktemp -d); trap "rm -rf $T" EXIT\
local f=$(basename "$url")\
if command -v curl >/dev/null; then curl -fsSL "$url" -o "$T/$f"; else wget -q "$url" -O "$T/$f"; fi\
if [[ "$atype" == auto ]]; then\
  case "$f" in *.tar.xz|*.txz)tar -xf "$T/$f" -C "$T";;*.tar.gz|*.tgz)tar -xzf "$T/$f" -C "$T";;*.tar.bz2)tar -xjf "$T/$f" -C "$T";;*.zip)unzip -q "$T/$f" -d "$T";;esac\
  local found=$(find "$T" -name "$name" -type f|head -1)\
  [[ -n "$found" ]] && cp "$found" "$MONO/$name" || cp "$T/$f" "$MONO/$name"\
else\
  cp "$T/$f" "$MONO/$name"\
fi\
chmod +x "$MONO/$name"; echo "Installed $name into monolith"\
}\
\
inject(){\
local name="$1" src="$2" dest="$MONO/$name"\
[[ -z "$src" ]] && { echo "Usage"; exit 1; }\
if [[ "$src" =~ ^https?:// ]]; then\
  if command -v curl >/dev/null; then curl -fsSL "$src" -o "$dest"; else wget -q "$src" -O "$dest"; fi\
else\
  [[ -f "$src" ]] || { echo "Not found"; exit 1; }; cp "$src" "$dest"\
fi\
chmod +x "$dest"; echo "[OK] $dest"\
}\
\
setup(){\
req-install "${1:-$MONO/requirements.txt}"\
for s in fix-antigravity-ide.sh install-shellcheck.sh install-bin.sh audit-focused.ts; do\
  [[ -f "$MONO/$s" ]] && chmod +x "$MONO/$s" && echo "[OK] $s" || echo "[MISSING] $s"\
done\
echo "Monolith ready in $MONO"; ls -la "$MONO"\
}\
\
run(){\
local script="$1"; shift || true\
[[ -f "$MONO/$script" ]] || { echo "Not found: $MONO/$script"; exit 1; }\
case "$script" in *.ts) bun run "$MONO/$script" "$@";; *.sh) bash "$MONO/$script" "$@";; *) "$MONO/$script" "$@";; esac\
}\
\
case "${1:-}" in\
  deps) req-install "${2:-$MONO/requirements.txt}";;\
  inject) inject "$2" "$3";;\
  setup) setup "${2:-$MONO/requirements.txt}";;\
  run) shift; run "$@";;\
  *) usage; exit 1;;\
esac\
NEWSCRIPT\
\
diff -u /tmp/monolith.current /tmp/monolith.new | less -S

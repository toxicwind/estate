if not mods:\
    base["processes"]["llama-swap"] = {\
        "command": f"llama-swap --config {os.environ.get('LLAMA_CFG', '/home/toxic/sovereign/tools/llama-swap/config.yaml')} --listen 127.0.0.1:{os.environ.get('P_LLAMA','25100')}",\
        "readiness_probe":{"http_get":{"host":"127.0.0.1","port":int(os.environ.get('P_LLAMA','25100')),"path":"/v1/models"}}\
    }\
    base["processes"]["null-g-proxy"] = {\
        "command": f"node /home/toxic/sovereign/tools/null-g-proxy/dist/index.js",\
        "environment":[f"PORT={os.environ.get('P_NULLG','8787')}"],\
        "depends_on":{"llama-swap":{"condition":"process_healthy"}}\
    }\
else:\
    for fp in ["stack/base.yaml"]+mods:\
        if os.path.exists(fp):\
            with open(fp) as f: d=yaml.safe_load(f) or {}\
            for k,v in (d.get("processes") or {}).items(): base["processes"][k]=v\
with open("process-compose.yaml","w") as out: yaml.safe_dump(base,out,sort_keys=False)\
print(f"‚ÉºÉ• wrote {len(base['processes'])} processes: {list(base['processes'].keys())}")\

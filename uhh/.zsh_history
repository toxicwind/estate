bash -c 'set -Eeuo pipefail\
REPO_DIR="${1:-.}"\
TMP="$(mktemp -d)"\
PIXIREPO="https://github.com/prefix-dev/pixi.git"\
OUTDIR="$REPO_DIR/third_party/pixi-schemas"\
mkdir -p "$OUTDIR"\
\
echo "[pixi-schemas] Cloning pixi repo (shallow)..."\
git clone --depth 1 "$PIXIREPO" "$TMP/pixi" >/dev/null 2>&1 || { echo "[err] clone failed"; exit 1; }\
\
echo "[pixi-schemas] Searching for schema files..."\
cd "$TMP/pixi"\
# heuristic search for schema-like files\
FILES="$(git ls-files | grep -Ei \"(schema|schemas|manifest|pyproject|pixi).*\\.(json|toml|schema|yaml|yml|md)\" || true)"\
if [[ -z "$FILES" ]]; then\
  FILES="$(git ls-files | grep -Ei \"(schema|schemas|manifest|pyproject|pixi)\" || true)"\
fi\
\
if [[ -z "$FILES" ]]; then\
  echo "[pixi-schemas] No obvious schema files found in repo; listing top-level files:"\
  git ls-files | sed -n '1,200p'\
else\
  echo "[pixi-schemas] Found candidate files:"\
  echo "$FILES"\
  mkdir -p "$OUTDIR"\
  while IFS= read -r f; do\
    src="$TMP/pixi/$f"\
    dst="$OUTDIR/$(basename "$f")"\
    cp --parents "$src" "$OUTDIR" 2>/dev/null || cp "$src" "$dst"\
    # print raw.githubusercontent URL for convenience\
    raw="https://raw.githubusercontent.com/prefix-dev/pixi/HEAD/$f"\
    echo "[pixi-schemas] copied: $f -> $dst"\
    echo "[pixi-schemas] raw URL: $raw"\
  done <<< "$FILES"\
fi\
\
# cleanup and commit\
cd "$REPO_DIR"\
git add "$OUTDIR" || true\

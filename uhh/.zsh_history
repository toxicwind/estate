#!/usr/bin/env bash\
# SMART PATH AUDIT v6\
# Classify first, safe probes only on real binaries.\
# Weird / unclassified entries now cat their full content for inspection.\
# Usage: bash smart-path-audit-v6.sh\
\
set -u\
\
DIRS=(\
    "$HOME/sovereign/bin"\
    "$HOME/.openfang/bin"\
    "$HOME/.local/bin"\
    "$HOME/bin"\
    "$HOME/.cargo/bin"\
    "$HOME/.grok/bin"\
    "$HOME/go/bin"\
    "$HOME/.pixi/bin"\
)\
\
is_elf() {\
    local f="$1"\
    [[ -f "$f" ]] || return 1\
    file --brief --mime-type "$f" 2>/dev/null | grep -qE '^application/x-(executable|pie-executable|sharedlib)'\
}\
\
probe_binary() {\
    local bin="$1"\
    echo "   --version:"\
    if timeout 2s env DISPLAY= WAYLAND_DISPLAY= "$bin" --version 2>&1 | head -8; then\
        :\
    else\
        echo "     (no output / error or timeout)"\
    fi\
    echo "   --help:"\
    if timeout 2s env DISPLAY= WAYLAND_DISPLAY= "$bin" --help 2>&1 | head -12; then\
        :\
    else\
        echo "     (no output / error or timeout)"\
    fi\
}\
\
echo "=== SMART PATH AUDIT v6 (classify first, safe probes, weird = cat) ==="\
echo "Generated: $(date '+%Y-%m-%d %H:%M:%S %Z')"\
echo ""\
\
for dir in "${DIRS[@]}"; do\
    if [[ ! -d "$dir" ]]; then\
        echo "‚É∫ÉÄÔ∏ÉØ  Missing: $dir"\
        echo ""\
        continue\
    fi\
\
    echo "=== Scanning $dir ==="\
\
    while IFS= read -r -d '' entry; do\
        name="$(basename "$entry")"\
        echo "‚É¶É≤ $name"\
\
        if [[ -L "$entry" ]]; then\
            target="$(readlink -f "$entry" 2>/dev/null || readlink "$entry")"\
            echo "   (SYMLINK ‚É¶É≤ $target)"\
            if is_elf "$target"; then\
                probe_binary "$entry"\
            else\
                echo "   (Not a standard binary ‚ÄÉ¥ skipping --version/--help test)"\
            fi\
        elif is_elf "$entry"; then\
            echo "   (ELF binary)"\
            probe_binary "$entry"\
        else\
            mime="$(file --brief --mime-type "$entry" 2>/dev/null || echo unknown)"\
            case "$mime" in\
                text/x-shellscript|text/x-python|application/x-shellscript)\
                    echo "   (SKIPPED ‚ÄÉ¥ script)"\
                    ;;\
                *)\
                    echo "   (WEIRD / unclassified ‚ÄÉ¥ catting whole file)"\
                    cat "$entry"\
                    ;;\
            esac\
        fi\
        echo "‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä"\
    done < <(find "$dir" -maxdepth 1 -mindepth 1 -print0 2>/dev/null | sort -z)\
\
    echo ""\
done\
\
echo "=== AUDIT COMPLETE ==="

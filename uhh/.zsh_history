#!/usr/bin/env bash\
set -euo pipefail\
\
cd /home/toxic/sovereign\
\
echo "=== [1/4] Backing up current files ==="\
cp -f devenv.nix devenv.nix.bak.$(date +%s) 2>/dev/null || true\
cp -f process-compose.yml process-compose.yml.bak.$(date +%s) 2>/dev/null || true\
echo "Backups done."\
\
echo ""\
echo "=== [2/4] Writing MAXIMAL permanent devenv.nix (devenv 2.1.2 compatible) ==="\
cat > devenv.nix << 'NIXEOF'\
# =============================================================================\
# SOVEREIGN STACK ‚ÄÉ¥ MAXIMAL PRODUCTION devenv.nix\
# Compatible with devenv 2.1.2 native Rust process manager\
# Docs: https://devenv.sh/processes/   https://devenv.sh/reference/options/\
# Reuses existing .venv ‚ÄÉ¥ no new env created\
# =============================================================================\
{ pkgs, lib, config, ... }:\
\
{\
  # Packages available inside `devenv shell`\
  packages = with pkgs; [\
    python312\
    uv\
    curl\
    jq\
    ripgrep\
    fd\
    bat\
    htop\
    # nvidia-smi is usually available via system, not needed here\
  ];\
\
  # ---------------------------------------------------------------------------\
  # Native Process Manager (replaces process-compose)\
  # ---------------------------------------------------------------------------\
  processes = {\
\
    # ik_llama ‚ÄÉ¥ main inference server\
    ik_llama = {\
      exec = ''/home/toxic/ik_llama/build/bin/llama-server \\
        -m /home/toxic/models/ggml-model-iq4_k_s.gguf \\
        --host 0.0.0.0 --port 25001 \\
        --ctx-size 16384 \\
        --n-gpu-layers 35 \\
        --cont-batching -fa \\
        --cache-type-k q4_0 --cache-type-v q4_0 \\
        --metrics --verbose'';\
\
      ready = {\
        http = {\
          port = 25001;\
          path = "/v1/models";\
          timeout = 5;\
        };\
        initialDelay = 10;\
        period = 4;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 15;\
      };\
    };\
\
    # nfcot_proxy\
    nfcot_proxy = {\
      exec = "cd /home/toxic/sovereign && .venv/bin/python modules/nfcot_proxy.py";\
      after = [ "devenv:processes:ik_llama@ready" ];\
\
      ready = {\
        exec = "curl -f --max-time 4 http://127.0.0.1:25008/health || exit 1";\
        period = 5;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 10;\
      };\
    };\
\
    # agentic_bridge (Quickshell Gemini bridge)\
    agentic_bridge = {\
      exec = "cd /home/toxic/sovereign && .venv/bin/python quickshell/agentic_bridge.py";\
      after = [ "devenv:processes:nfcot_proxy@ready" ];\
\
      ready = {\
        exec = "curl -f --max-time 4 http://127.0.0.1:25010/health || exit 1";\
        period = 6;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 8;\
      };\
    };\
\
    # openfang ‚ÄÉ¥ agent kernel\
    openfang = {\
      exec = "cd /home/toxic/sovereign && .venv/bin/python -m openfang serve --config /home/toxic/.openfang/config.toml";\
      after = [ "devenv:processes:agentic_bridge@ready" ];\
\
      ready = {\
        exec = "curl -f --max-time 5 http://127.0.0.1:14720/health || exit 1";\
        period = 8;\
        initialDelay = 5;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 6;\
      };\
    };\
\
    # caddy (optional)\
    caddy = {\
      exec = "caddy run --config /home/toxic/sovereign/caddy/Caddyfile";\
      after = [ "devenv:processes:openfang@ready" ];\
\
      ready = {\
        exec = "curl -f --max-time 3 http://127.0.0.1:80 || exit 1";\
        period = 10;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 5;\
      };\
    };\
  };\
\
  # Shell greeting\
  enterShell = ''\
    echo ""\
    echo "‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞"\
    echo "  SOVEREIGN ‚ÄÉ¥ devenv 2.1.2 (native manager)"\
    echo "  Existing .venv is being reused"\
    echo "‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞"\
    echo "Commands:"\
    echo "  devenv up          # Start everything"\

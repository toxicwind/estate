mkdir -p ~/.config/wezterm && cat << 'EOF' > ~/.config/wezterm/wezterm.lua\
local wezterm = require 'wezterm'\
local config = wezterm.config_builder()\
\
-- 1. Hardware Pipeline & Graphics Routing\
-- Wezterm's native Wayland backend panics on explicit sync mismatch on Nvidia.\
-- Forcing false maps it to XWayland, routing draw calls securely through EGL/GLX.\
config.enable_wayland = false\
config.front_end = "WebGpu"\
config.webgpu_power_preference = "HighPerformance"\
config.animation_fps = 144\
\
-- 2. Kernel-to-TTY Structural Performance\
config.scrollback_lines = 50000\
config.enable_scroll_bar = false\
config.text_background_opacity = 1.0\
config.prefer_to_spawn_tabs = false\
\
-- 3. Atomic Hyperlink Interception & Process Forking\
-- Completely isolates the link mechanism from the system d-bus / xdg portal panic loop.\
-- Intercepts the regex click event and manually forks a detached browser process.\
config.hyperlink_rules = wezterm.default_hyperlink_rules()\
table.insert(config.hyperlink_rules, {\
  regex = [[[https?://[a-zA-Z0-9][-a-zA-Z0-9._~:%+#? festival =/&_]+]],\
  format = '$0',\
})\
\
wezterm.on('open-uri', function(window, pane, uri)\
    -- Explicitly define your browser endpoint here to cut out the xdg intermediary entirely\
    local browser = "brave" \
    wezterm.background_process({ browser, uri })\
    return false -- Instructs Wezterm to drop the native handler and consume the event completely\
end)\
\
-- 4. Font Fallback Isolation (Prevents font-metric sizing panics)\
config.warn_about_missing_glyphs = false\
\
return config\
EOF

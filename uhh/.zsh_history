#!/usr/bin/env bun\
// fleet_ranker.ts ‚ÄÉ¥ Full-fleet diagnostic profiler.\
// Maps actual hardware failure points (OOM) instead of theoretical limits.\
\
import { readdir, stat, writeFile } from "node:fs/promises";\
import { join } from "node:path";\
import { execSync } from "node:child_process";\
\
const HOME = "/home/toxic";\
const SERVER_BIN = `${HOME}/ik_llama.cpp-main/build/bin/llama-server`;\
const GGUF_BIN = `${HOME}/ik_llama.cpp-main/build/bin/llama-gguf`;\
const REPORT_PATH = `${HOME}/sovereign/canonical_benchmark_v9_fixed.json`;\
const PORT = 28080;\
\
// Get ACTUAL available VRAM from the card right now\
async function getFreeVram(): Promise<number> {\
    const proc = Bun.spawnSync(["nvidia-smi", "--query-gpu=memory.free", "--format=csv,noheader,nounits"]);\
    return parseInt(proc.stdout.toString().trim());\
}\
\
async function killAll() {\
    Bun.spawnSync(["pkill", "-9", "-f", "llama-server"]);\
    await new Promise(r => setTimeout(r, 1500));\
}\
\
async function runTest(model: string, ctx: number): Promise<boolean> {\
    await killAll();\
    // Using --no-warmup and strict flags to force OOM if it's too big\
    const proc = Bun.spawn([\
        SERVER_BIN, "-m", model, "-c", ctx.toString(),\
        "-ngl", "99", "-fa", "1",\
        "--host", "127.0.0.1", "--port", PORT.toString(),\
        "--no-warmup", "--alias", "qwen-bench"\
    ], { stderr: "ignore", stdout: "ignore" });\
\
    // Poll for readiness\
    let ready = false;\
    for (let i = 0; i < 20; i++) {\
        try {\
            const res = await fetch(`http://127.0.0.1:${PORT}/health`, { signal: AbortSignal.timeout(1000) });\
            if (res.status === 200) { ready = true; break; }\
        } catch {}\
        await new Promise(r => setTimeout(r, 1000));\
    }\
    \
    proc.kill();\
    return ready;\
}\
\
async function getModels(dir: string, models: string[] = []) {\
    const entries = await readdir(dir, { withFileTypes: true });\
    for (const entry of entries) {\
        const fullPath = join(dir, entry.name);\
        if (entry.isDirectory()) await getModels(fullPath, models);\
        else if (entry.name.endsWith(".gguf")) models.push(fullPath);\
    }\
    return models;\
}\
\
const models = await getModels(`${HOME}/models`);\
const leaderboard = [];\
\
console.log(`\n=== Fleet Profiling: ${models.length} models detected ===\n`);\
\
for (const model of models) {\
    const stats = await stat(model);\
    const sizeMb = stats.size / 1024 / 1024;\
    const freeVram = await getFreeVram();\
\
    console.log(`[>>] Profiling: ${model.split('/').pop()} (${sizeMb.toFixed(0)} MB)`);\
    \
    // Direct metadata read\
    try {\
        const meta = execSync(`${GGUF_BIN} --info "${model}" --json`).toString();\
        const jsonMeta = JSON.parse(meta);\
        console.log(`    Metadata: ${jsonMeta.n_params} params, ${jsonMeta.n_layers} layers`);\
    } catch (e) {\
        console.log(`    [!] Could not parse metadata via ${GGUF_BIN}`);\
    }\
\
    // Binary search\
    // We don't skip if size > freeVram. We let the hardware decide.\
    let lo = 4096, hi = 131072;\
    let best = 4096;\
\
    while (lo + 4096 < hi) {\
        const mid = Math.floor((lo + hi) / 2 / 4096) * 4096;\
        console.log(`    Testing ${mid} context...`);\
        if (await runTest(model, mid)) { \
            best = mid; \
            lo = mid; \
        } else { \
            hi = mid; \
        }\
    }\
    \
    leaderboard.push({ model: model.split('/').pop(), maxCtx: best });\
    console.log(`    [OK] Max Stable Context: ${best}\n`);\
}\
\
leaderboard.sort((a, b) => b.maxCtx - a.maxCtx);\
\
console.log("\n=== FINAL LEADERBOARD ===");\
for (const entry of leaderboard) {\
    console.log(`${entry.maxCtx.toString().padStart(8, ' ')} ctx | ${entry.model}`);\
}\
\
await writeFile(REPORT_PATH, JSON.stringify(leaderboard, null, 2));\
console.log(`\n[!] Report saved to ${REPORT_PATH}`);
llama-bench-matmult --help
echo 0 | sudo tee /proc/sys/kernel/yama/ptrace_scope
# Create the config file\

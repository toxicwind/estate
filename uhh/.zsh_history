#!/usr/bin/env bash\
set -euo pipefail\
\
cd /home/toxic/sovereign\
\
echo "=== [1/5] Installing real Nix tools (alejandra + jq) ==="\
nix profile install nixpkgs#alejandra nixpkgs#jq --priority 4 2>/dev/null || true\
\
echo ""\
echo "=== [2/5] Backing up current devenv.nix ==="\
cp -f devenv.nix "devenv.nix.bak.$(date +%s)"\
\
echo ""\
echo "=== [3/5] Formatting with alejandra (real binary) ==="\
alejandra --quiet devenv.nix || true\
\
echo ""\
echo "=== [4/5] Validating with nix binary ==="\
if nix-instantiate --parse devenv.nix > /dev/null 2>&1; then\
    echo "‚ÉºÉ• Syntax is now valid"\
else\
    echo "‚ÉΩÉ¨ Still has semantic errors. Showing details:"\
    nix-instantiate --parse devenv.nix 2>&1 | tail -20\
    echo ""\
    echo "Applying targeted structural fixes using jq + nix..."\
    \
    # Backup again before structural changes\
    cp -f devenv.nix "devenv.nix.bak2.$(date +%s)"\
    \
    # Use jq to help clean common broken patterns (availability, initialDelay, etc.)\
    # This is still a bit manual but uses real tools instead of blind sed\
    python3 -c '\
import re\
with open("devenv.nix") as f:\
    content = f.read()\
\
# Remove broken availability blocks\
content = re.sub(r"availability\s*=\s*\{[^}]*\};", "", content, flags=re.DOTALL)\
\
# Fix initialDelay ‚É¶É≤ initial_delay\
content = content.replace("initialDelay", "initial_delay")\
\
# Fix ready.http.path ‚É¶É≤ ready.http.get\
content = content.replace("ready.http.path", "ready.http.get")\
\
with open("devenv.nix", "w") as f:\
    f.write(content)\
print("Structural fixes applied")\
'\
\
    alejandra --quiet devenv.nix || true\
\
    if nix-instantiate --parse devenv.nix > /dev/null 2>&1; then\
        echo "‚ÉºÉ• Now valid after structural fixes"\
    else\
        echo "Still failing. Manual review needed."\
        exit 1\
    fi\
fi\
\
echo ""\
echo "=== [5/5] Entering devenv shell ==="\
. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh\
exec devenv shell\
EOF\

python3 - <<'PY'\
import glob, os, yaml\
SOV="/home/toxic/sovereign"\
OUT=f"{SOV}/process-compose.yaml"\
procs={}\
for mod in sorted(glob.glob(f"{SOV}/stack/modules/*.yaml")):\
    with open(mod) as f: data=yaml.safe_load(f) or {}\
    items=data["processes"].items() if "processes" in data else [(k,v) for k,v in data.items() if isinstance(v,dict)]\
    for n,c in items:\
        if "environment" in c and isinstance(c["environment"], dict):\
            c["environment"]=[f"{k}={v}" for k,v in c["environment"].items()]\
        procs[n]=c\
final={"version":"0.5","is_strict":False,"processes":procs}\
with open(OUT,"w") as o:\
    o.write("# GENERATED - do not edit\n")\
    yaml.safe_dump(final,o,sort_keys=False)\
print(f"wrote {len(procs)}: {', '.join(procs)}")\
PY\

cat > /home/toxic/sovereign/modules/nfcot_proxy.py << 'EOF'\
#!/usr/bin/env python3\
"""\
NF-CoT Llama Proxy Server\
Intercepts completions to inject Normalising Flow reasoning (TARFlow)\
whenever a thinking token (<think> or <|thought|>) is generated.\
Exposes an OpenAI-compatible API on port 25008.\
"""\
import os\
import sys\
import re\
import json\
import uuid\
import time\
import requests\
import torch\
import torch.nn as nn\
import uvicorn\
from fastapi import FastAPI, Request, HTTPException\
from fastapi.responses import JSONResponse\
\
app = FastAPI(title="NF-CoT Llama Proxy")\
\
FLOW_PATH = "nfcot_flow.pt"\
dim = 3584  # Corrected: Gemma 4 12B hidden dimension is 3584, not 3840\
\
class CouplingLayer(nn.Module):\
    def __init__(self, dim, hidden_dim):\
        super().__init__()\
        self.dim = dim\
        self.mask = torch.arange(dim) % 2 == 0\
        self.net = nn.Sequential(\
            nn.Linear(dim // 2, hidden_dim),\
            nn.ReLU(),\
            nn.Linear(hidden_dim, dim // 2)\
        )\
        \
    def forward(self, x, reverse=False):\
        is_1d = x.dim() == 1\
        if is_1d:\
            x = x.unsqueeze(0)\
            \
        mask = self.mask.to(x.device)\
        x1 = x[:, mask]\
        x2 = x[:, ~mask]\
        \
        if not reverse:\
            s = self.net(x1)\
            y2 = x2 + s\
            y = torch.zeros_like(x)\
            y[:, mask] = x1\
            y[:, ~mask] = y2\
        else:\
            s = self.net(x1)\
            y2 = x2 - s\
            y = torch.zeros_like(x)\
            y[:, mask] = x1\
            y[:, ~mask] = y2\
            \
        if is_1d:\
            y = y.squeeze(0)\
        return y\
\
class TARFlow(nn.Module):\
    def __init__(self, dim, num_layers=4, hidden_dim=512):\
        super().__init__()\
        self.layers = nn.ModuleList([\
            CouplingLayer(dim, hidden_dim) for _ in range(num_layers)\
        ])\
        \
    def forward(self, x, reverse=False):\
        y = x\
        if not reverse:\
            for layer in self.layers:\
                y = layer(y, reverse=False)\
        else:\
            for layer in reversed(self.layers):\
                y = layer(y, reverse=True)\
        return y, torch.tensor(0.0, device=x.device)\
\
# Global flow model reference\
flow = None\
\
def get_model_dimension() -> int:\
    try:\
        resp = requests.get("http://127.0.0.1:25001/v1/models", timeout=3)\
        if resp.ok:\
            data = resp.json()\
            models = data.get("data", [])\
            if models:\
                meta = models[0].get("meta", {})\
                n_embd = meta.get("n_embd")\
                if n_embd:\
                    print(f"[NF-CoT] Detected model dimension: {n_embd}")\
                    return n_embd\
    except Exception as e:\
        print(f"[NF-CoT] Failed to detect model dimension: {e}")\
    print("[NF-CoT] Fallback to default model dimension: 3584")\
    return 3584\
\
def init_flow():\
    global flow, dim\
    dim = get_model_dimension()\
    flow = TARFlow(dim=dim, num_layers=4)\
    if os.path.exists(FLOW_PATH):\
        try:\
            flow.load_state_dict(torch.load(FLOW_PATH))\
            print(f"[NF-CoT] Loaded flow weights from {FLOW_PATH}")\
        except Exception as e:\
            print(f"[NF-CoT] Failed to load flow weights: {e}")\
    else:\
        try:\
            torch.save(flow.state_dict(), FLOW_PATH)\
            print(f"[NF-CoT] Initialized and saved new flow weights to {FLOW_PATH}")\
        except Exception as e:\
            print(f"[NF-CoT] Failed to save flow weights: {e}")\
\
@app.on_event("startup")\
def startup_event():\
    init_flow()\
\
def format_chat_prompt(messages, model_name):\
    model_lower = model_name.lower()\
    is_qwen = "qwen" in model_lower\
    \
    prompt = ""\
    if is_qwen:\
        for msg in messages:\
            role = msg.get("role")\
            content = msg.get("content", "")\
            prompt += f"<|im_start|>{role}\n{content}<|im_end|>\n"\
        prompt += "<|im_start|>assistant\n"\
    else:  # Default to Gemma template\
        for msg in messages:\
            role = msg.get("role")\
            content = msg.get("content", "")\
            if role == "user":\
                prompt += f"<start_of_turn>user\n{content}<end_of_turn>\n"\
            elif role == "assistant":\
                prompt += f"<start_of_turn>model\n{content}<end_of_turn>\n"\
            elif role == "system":\
                prompt += f"<start_of_turn>user\nSystem: {content}<end_of_turn>\n"\
        prompt += "<start_of_turn>model\n"\
    return prompt\
\
@app.post("/v1/chat/completions")\
async def chat_completions(request: Request):\
    req_data = await request.json()\
    messages = req_data.get("messages", [])\
    model = req_data.get("model", "gemma-4")\
    \
    model_name = "gemma-4"\
    try:\
        m_resp = requests.get("http://127.0.0.1:25001/v1/models")\
        if m_resp.ok:\
            m_data = m_resp.json()\
            if m_data.get("data"):\
                model_name = m_data["data"][0].get("id", "gemma-4")\
    except Exception:\
        pass\
\
    prompt = format_chat_prompt(messages, model_name)\
    stop_tokens = ["<think>", "<|thought|>", "<think>\n", "<|thought|>\n"]\
    \
    payload = {\
        "prompt": prompt,\
        "n_predict": req_data.get("max_tokens", 2048),\
        "temperature": req_data.get("temperature", 0.7),\
        "top_p": req_data.get("top_p", 0.95),\
        "stop": stop_tokens,\
        "include_stop_str_in_output": True,\
        "cache_prompt": True\
    }\
    \
    try:\
        comp_resp = requests.post("http://127.0.0.1:25001/completion", json=payload, timeout=60)\
        if not comp_resp.ok:\
            raise HTTPException(status_code=comp_resp.status_code, detail=comp_resp.text)\
        comp_data = comp_resp.json()\
    except Exception as e:\
        raise HTTPException(status_code=500, detail=f"llama-server connection error: {e}")\
        \
    text_output = comp_data.get("content", "")\
    stopped_on = comp_data.get("stopped_on", "")\
    \
    hit_thought = False\
    stop_token = ""\
    for st in stop_tokens:\
        if st in text_output or stopped_on == st:\
            hit_thought = True\
            stop_token = st\
            break\
            \
    if hit_thought:\
        parts = text_output.split(stop_token)\
        text_before_thought = parts[0]\
        \
        print(f"[NF-CoT] Intercepted thought token '{stop_token}' in generation.")\
        \
        emb_payload = {\
            "content": prompt + text_before_thought + stop_token\
        }\
        try:\
            emb_resp = requests.post("http://127.0.0.1:25001/embedding", json=emb_payload, timeout=10)\
            if emb_resp.ok:\
                emb_data = emb_resp.json()\
                embedding = emb_data.get("embedding", [])\
                \
                if len(embedding) > 0:\
                    if isinstance(embedding[0], list):\
                        last_vec = embedding[-1]\
                    else:\
                        last_vec = embedding\
                        \
                    if len(last_vec) > dim:\
                        last_vec = last_vec[:dim]\
                    elif len(last_vec) < dim:\
                        last_vec = last_vec + [0.0] * (dim - len(last_vec))\
                        \
                    with torch.no_grad():\
                        x = torch.tensor(last_vec, dtype=torch.float32)\
                        y, _ = flow(x, reverse=False)\
                        latent_val = y.mean().item()\
                        \
                    thought_prefix = f"<|latent:{latent_val:.4f}|>"\
                    print(f"[NF-CoT] Latent thought value: {latent_val:.4f}. Injecting thought prefix.")\
                    \
                    resume_payload = {\
                        "prompt": prompt + text_before_thought + stop_token + thought_prefix,\
                        "n_predict": req_data.get("max_tokens", 2048) - len(text_output),\
                        "temperature": req_data.get("temperature", 0.7),\
                        "top_p": req_data.get("top_p", 0.95),\
                        "cache_prompt": True\
                    }\
                    \
                    resume_resp = requests.post("http://127.0.0.1:25001/completion", json=resume_payload, timeout=60)\
                    if resume_resp.ok:\
                        resume_data = resume_resp.json()\
                        continuation = resume_data.get("content", "")\
                        text_output = text_before_thought + stop_token + thought_prefix + continuation\
        except Exception as e:\
            print(f"[NF-CoT] Error during embedding or flow injection: {e}")\
            pass\
            \
    chat_id = f"chatcmpl-{uuid.uuid4()}"\
    created = int(time.time())\
    \
    response_json = {\
        "id": chat_id,\
        "object": "chat.completion",\
        "created": created,\
        "model": model,\
        "choices": [\
            {\
                "index": 0,\
                "message": {\
                    "role": "assistant",\
                    "content": text_output\
                },\
                "finish_reason": "stop"\
            }\
        ],\
        "usage": {\
            "prompt_tokens": len(prompt) // 4,\
            "completion_tokens": len(text_output) // 4,\
            "total_tokens": (len(prompt) + len(text_output)) // 4\
        }\
    }\
    \
    return JSONResponse(content=response_json)\
\
@app.get("/v1/models")\
async def list_models():\
    try:\
        resp = requests.get("http://127.0.0.1:25001/v1/models", timeout=3)\
        if resp.ok:\
            return JSONResponse(content=resp.json())\
    except Exception:\
        pass\
    return JSONResponse(content={\
        "object": "list",\
        "data": [\
            {\
                "id": "ggml-model-iq4_k_s.gguf",\
                "object": "model",\
                "created": int(time.time()),\
                "owned_by": "llamacpp"\
            }\
        ]\
    })\
\
@app.post("/v1/embeddings")\
async def create_embeddings(request: Request):\
    req_data = await request.json()\
    try:\
        resp = requests.post("http://127.0.0.1:25001/v1/embeddings", json=req_data, timeout=10)\
        if resp.ok:\
            return JSONResponse(content=resp.json())\
    except Exception as e:\
        raise HTTPException(status_code=500, detail=str(e))\
\
if __name__ == "__main__":\
    uvicorn.run(app, host="0.0.0.0", port=25008, log_level="info")\
EOF

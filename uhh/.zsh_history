pragma Singleton\
import Quickshell\
import Quickshell.Io\
import qs.modules.common\
\
Singleton {\
    id: gov\
    property bool active: true\
\
    Timer {\
        interval: 5000; running: true; repeat: true\
        onTriggered: {\
            if (!gov.active) return\
            // Uses your existing ResourceUsage service\
            if (ResourceUsage.cpuUsage > 80) {\
                console.log("[Governor] CPU", ResourceUsage.cpuUsage, "%")\
                // asks your local ik_llama for a fix\
                Quickshell.execDetached(["curl","-s","http://127.0.0.1:25001/v1/chat/completions",\
                    "-H","Content-Type: application/json",\
                    "-d",'{"model":"gemma-4","messages":[{"role":"user","content":"CPU high, suggest one bash command"}],"max_tokens":20}'])\
            }\
        }\
    }\
}\
EOF

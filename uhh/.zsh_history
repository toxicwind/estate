set -Eeuo pipefail\
\
# === SOVEREIGN ITERATOR v1.0.20260607 ===\
# Target: RTX 3090, 8-Core Ryzen, CachyOS Bare Metal\
# Strategy: Native SGLang Orchestration, Zero-Container Overhead\
\
# 1. PURGE INSTITUTIONAL DETRITUS\
sudo systemctl stop docker ollama || true\
sudo systemctl disable docker ollama || true\
sudo rm -rf /etc/systemd/system/ollama.service /etc/systemd/system/docker.service\
\
# 2. PROVISION TOOLCHAIN (PIXI + NIXL)\
if ! command -v pixi &> /dev/null; then\
    curl -fsSL https://pixi.sh/install.sh | bash\
fi\
export PATH="$HOME/.pixi/bin:$PATH"\
\
# 3. CONFIGURE SOVEREIGN DIRECTORY\
ROOT="/opt/sovereign"\
mkdir -p "$ROOT"/{bin,lib,models,logs,config}\
\
# 4. ATOMIC ENVIRONMENT DEFINITION (pixi.toml / nixl state)\
cat > "$ROOT/config/sovereign_stack.toml" <<EOF\
[project]\
name = "sovereign-iterator"\
version = "1.0.20260607"\
\
[dependencies]\
sglang = ">=0.4.0"\
torch = ">=2.11.0"\
cuda-python = ">=13.3.0"\
openfang = "*"\
\
[tasks]\
serve = "python3 -m sglang.launch_server --model-path DeepSeek-R1-0528-Q8 --port 25000 --device cuda --mem-fraction 0.92 --chunk-size 1024"\
agents = "openfang init --base-url http://localhost:25000/v1 --agents 16"\
EOF\
\
# 5. PRODUCTION SERVICE (Systemd)\
cat > /etc/systemd/system/sovereign-node.service <<EOF\
[Unit]\
Description=Sovereign AI Node (SGLang + OpenFang)\
After=network.target\
\
[Service]\
Type=simple\
User=$USER\
WorkingDirectory=$ROOT\
ExecStart=/usr/bin/pixi run serve\
Restart=always\
RestartSec=5\
Environment=CUDA_VISIBLE_DEVICES=0\
\
[Install]\
WantedBy=default.target\
EOF\
\
# 6. DEPLOY & INITIALIZE\
sudo systemctl daemon-reload\
sudo systemctl enable --now sovereign-node\
echo "=== STACK DEPLOYED ==="\
echo "Port 25000: SGLang Inference"\
echo "Port 25001: OpenFang Orchestrator"\
echo "Production grade initialized on $(hostname)."\


\
OPENFANG_BIN=/home/toxic/.cargo/bin/openfang\
export OPENFANG_LLM_BASE_URL=http://127.0.0.1:25001/v1\
export OPENFANG_LLM_MODEL=gemma4-opus48\
export OPENFANG_EMBEDDINGS_URL=\
export RUST_LOG=info\
\
AGENTIC_BRIDGE_PY=/home/toxic/sovereign/forgecell-sovereign/quickshell/agentic_bridge.py\
\
if [ "${1:-up}" = "down" ]; then\
  pkill -f llama-server || true\
  pkill -f openfang || true\
  pkill -f agentic_bridge || true\
  exit 0\
fi\
\
# Kill any leftovers\
pkill -f llama-server || true\
pkill -f openfang || true\
pkill -f agentic_bridge || true\
sleep 1\
\
# Start ik_llama in foreground\
"$IK_LLAMA_BIN" -m "$IK_LLAMA_MODEL" --host "$IK_LLAMA_HOST" --port "$IK_LLAMA_PORT" \\
  -c "$IK_LLAMA_CTX" -ngl "$IK_LLAMA_NGL" -fa --jinja &\
\
# Wait for it to be ready\
for i in {1..60}; do\
  curl -sf "http://$IK_LLAMA_HOST:$IK_LLAMA_PORT/v1/models" >/dev/null && break\
  sleep 2\
done\
\
# Start OpenFang in foreground\
"$OPENFANG_BIN" &\
\
# Start agentic bridge if present\
if [ -f "$AGENTIC_BRIDGE_PY" ]; then\
  python3 "$AGENTIC_BRIDGE_PY" &\
fi\
\
# Wait for all background processes\
wait\
EOF\

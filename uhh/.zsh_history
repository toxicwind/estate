import {useEffect,useState} from 'react';import {api} from '../lib/api';\
export default function Spec(){\
  const [loras,setL]=useState<any[]>([]);\
  const [prompt,setP]=useState('');\
  const [res,setR]=useState<any>(null);\
  useEffect(()=>{api('/api/loras').then(setL)},[]);\
  return <div>\
    <div className="brutal" style={{marginBottom:12}}>\
      <h2 style={{fontWeight:900}}>SPEC ‚ÄÉ¥ BEELLAMA ROUTER</h2>\
      <div style={{fontFamily:'Courier New',fontSize:11}}>sm_86 ¬∑ FA_ALL_QUANTS=ON ¬∑ dynamic route</div>\
    </div>\
    <div style={{display:'flex',gap:8,marginBottom:12}}>\
      <textarea value={prompt} onChange={e=>setP((e.target as any).value)} placeholder="prompt..." style={{flex:1,border:'4px solid #000',padding:10,fontFamily:'Courier New'}} rows={3}/>\
      <button className="brutal-btn" style={{background:'var(--eff-green)'}} onClick={async()=>{const r=await api('/api/route',{method:'POST',body:JSON.stringify({prompt})});setR(r)}}>DISTILL ‚É¶É≤ {res?.selected||''}</button>\
    </div>\
    {res&&<div className="residue" style={{marginBottom:12}}>{JSON.stringify(res)}</div>}\
    <div style={{display:'grid',gridTemplateColumns:'repeat(auto-fill,minmax(300px,1fr))',gap:12}}>\
      {loras.map((l:any)=><div key={l.id} className="brutal"><div style={{fontWeight:900}}>{l.name}</div><div style={{fontFamily:'Courier New',fontSize:11}}>{l.id} ¬∑ {l.ctx/1024}k ¬∑ {l.vram} ¬∑ {l.quant}</div><div style={{marginTop:8,display:'flex',gap:6}}><span className="chip">{l.fork}</span><button className="brutal-btn" onClick={()=>navigator.clipboard.writeText(l.id)}>COPY ID</button></div></div>)}\
    </div>\
  </div>\
}\

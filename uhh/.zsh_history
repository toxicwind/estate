  # Correct way to allow unfree packages in devenv\
  nixpkgs.config.allowUnfree = true;\
\
  packages = with pkgs; [\
    python312\
    uv\
    curl\
    jq\
    ripgrep\
    fd\
    bat\
    htop\
  ];\
\
  enterShell = ''\
    echo "‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞"\
    echo "  SOVEREIGN ‚ÄÉ¥ devenv 2.1.2 (MAXIMAL + VENV REUSE)"\
    echo "‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞"\
\
    # Reuse or create .venv\
    if [ -d ".venv" ]; then\
      export VIRTUAL_ENV="$PWD/.venv"\
      export PATH="$VIRTUAL_ENV/bin:$PATH"\
      echo "‚É¶É≤ Using existing .venv"\
    else\
      echo "‚É¶É≤ Creating .venv with uv..."\
      uv venv .venv --python 3.12\
      export VIRTUAL_ENV="$PWD/.venv"\
      export PATH="$VIRTUAL_ENV/bin:$PATH"\
    fi\
\
    export LD_LIBRARY_PATH="/run/opengl-driver/lib:/run/opengl-driver-32/lib:''${LD_LIBRARY_PATH:-}"\
\
    echo ""\
    nvidia-smi --query-gpu=name,memory.used,memory.free,utilization.gpu --format=csv,noheader 2>/dev/null || true\
    echo ""\
    echo "Run: devenv up"\
  '';\
\
  processes = {\
\
    ik_llama = {\
      exec = "/home/toxic/ik_llama/build/bin/llama-server -m /home/toxic/models/ggml-model-iq4_k_s.gguf --host 0.0.0.0 --port 25001 --ctx-size 16384 --n-gpu-layers 35 --cont-batching -fa --cache-type-k q4_0 --cache-type-v q4_0 --metrics --verbose";\
\
      ready = {\
        http.get = {\
          port = 25001;\
          path = "/v1/models";\
        };\
        initial_delay = 12;\
        period = 4;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 20;\
      };\
    };\
\
    nfcot_proxy = {\
      exec = "python modules/nfcot_proxy.py";\
\
      ready = {\
        exec = "curl -f --max-time 4 http://127.0.0.1:25008/health || exit 1";\
        period = 5;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 12;\
      };\
    };\
\
    agentic_bridge = {\
      exec = "python quickshell/agentic_bridge.py";\
\
      ready = {\
        exec = "curl -f --max-time 4 http://127.0.0.1:25010/health || exit 1";\
        period = 6;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 10;\
      };\
    };\
\
    openfang = {\
      exec = "python -m openfang serve --config /home/toxic/.openfang/config.toml";\
\
      ready = {\
        exec = "curl -f --max-time 5 http://127.0.0.1:14720/health || exit 1";\
        period = 8;\
        initial_delay = 6;\
      };\
\
      restart = {\
        on = "on_failure";\
        max = 8;\
      };\
    };\
  };\
}\
FULLNIX\

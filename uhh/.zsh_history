#!/bin/bash\
# sovereign_recon_v7.sh ‚ÄÉ¥ Reliable version with more tools + heavy Tailscale built-ins\
\
set -euo pipefail\
\
echo "‚ÉµÉ¥‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∑"\
echo "‚ÉµÉ±     SOVEREIGN DEEP RECON v7 ‚ÄÉ¥ Tailscale + Tools           ‚ÉµÉ±"\
echo "‚ÉµÉ∫‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉ∞‚ÉµÉΩ"\
\
# === 1. Install more diagnostic tools ===\
echo ""\
echo "‚É∂∂ Installing extra diagnostic tools..."\
\
for pkg in nmap mtr traceroute bind net-tools iproute2 curl jq; do\
    if ! pacman -Qi "$pkg" &>/dev/null; then\
        echo "  Installing $pkg..."\
        sudo pacman -Sy --noconfirm "$pkg" 2>/dev/null || true\
    fi\
done\
\
# === 2. Tailscale Built-in Diagnostics (the good stuff) ===\
echo ""\
echo "‚É∂∂ Tailscale Native Diagnostics"\
\
echo ""\
echo "tailscale status:"\
tailscale status 2>/dev/null | head -10 || echo "(failed)"\
\
echo ""\
echo "tailscale netcheck:"\
tailscale netcheck 2>/dev/null || echo "(failed)"\
\
echo ""\
echo "tailscale ping (self):"\
TS4=$(tailscale ip -4 2>/dev/null | head -1)\
if [ -n "$TS4" ]; then\
    tailscale ping "$TS4" 2>/dev/null | head -4 || echo "(failed)"\
fi\
\
# === 3. Identity ===\
echo ""\
echo "‚É∂∂ Identity"\
TS_IP=$(tailscale ip -4 2>/dev/null | head -1 || echo "none")\
TS_IP6=$(tailscale ip -6 2>/dev/null | head -1 || echo "none")\
HOSTNAME=$(hostname)\
TS_STATE=$(tailscale status --json 2>/dev/null | jq -r '.BackendState' 2>/dev/null || echo "unknown")\
\
echo "  State    : $TS_STATE"\
echo "  IPv4     : $TS_IP"\
echo "  IPv6     : $TS_IP6"\
echo "  Hostname : $HOSTNAME"\
\
if [ "$TS_IP" = "none" ]; then\
    echo "ERROR: No Tailscale IPv4 found"\
    exit 1\
fi\
\
# === 4. Interface + Routes ===\
echo ""\
echo "‚É∂∂ Interface & Routes"\
\
if ip link show tailscale0 &>/dev/null; then\
    echo "  tailscale0 interface: present"\
else\
    echo "  tailscale0 interface: MISSING"\
fi\
\
echo ""\
echo "Tailscale-related routes:"\
ip route | grep -E 'tailscale|100\.' | head -8 || echo "  (none found)"\
\
# === 5. Connectivity ===\
echo ""\
echo "‚É∂∂ Connectivity Tests"\
\
echo -n "  ping 127.0.0.1          : "\
ping -c 2 -W 1 127.0.0.1 >/dev/null 2>&1 && echo "OK" || echo "FAIL"\
\
echo -n "  ping Tailscale IP       : "\
ping -c 4 -W 1 "$TS_IP" >/dev/null 2>&1 && echo "OK" || echo "FAIL"\
\
echo -n "  tailscale ping (native) : "\
tailscale ping "$TS_IP" 2>/dev/null | head -2 || echo "failed"\
\
# === 6. ik_llama Binary ===\
echo ""\
echo "‚É∂∂ ik_llama Binary"\
if command -v ik_llama &>/dev/null; then\
    real_path=\( (readlink -f " \)(which ik_llama)")\
    echo "  Path: $real_path"\
    ik_llama --version 2>/dev/null | head -1 || true\
else\
    echo "  ik_llama not found in PATH"\
fi\
\
# === 7. Sovereign Port Scan ===\
echo ""\
echo "‚É∂∂ Sovereign Ports Scan"\
\
SOVEREIGN_PORTS="22,25000,25001,25004,25008,8080,9090"\
nmap -T4 -sV -p "$SOVEREIGN_PORTS" --version-intensity 6 --open "$TS_IP" 2>/dev/null | tee /tmp/scan.log || true\
\
echo ""\
echo "=== OPEN PORTS ==="\
grep -E '^[0-9]+/tcp' /tmp/scan.log | while read line; do\
    port=$(echo "$line" | cut -d'/' -f1)\
    svc=$(echo "$line" | awk '{print $3}')\
    ver=$(echo "$line" | cut -d' ' -f4-)\
    printf "  %-6s %-28s %s\n" "$port" "$svc" "$ver"\
done\
\
# === 8. Listening Processes ===\
echo ""\
echo "=== LISTENING PROCESSES ==="\
ss -tlnp 2>/dev/null | grep -E ':(22|2500[0-9]|8080|9090) ' | awk '{printf "  %-22s ‚É¶É≤ %s\n", $5, $7}'\
\
# === 9. Health Check ===\
echo ""\
echo "‚É∂∂ Health Check"\
\
echo -n "  ik_llama (25001) /v1/models : "\
if curl -s --max-time 5 "http://${TS_IP}:25001/v1/models" 2>/dev/null | grep -q '"object":"list"'; then\
    echo "OK"\
else\
    echo "NOT RESPONDING"\
fi\
\
# === 10. Process-Compose ===\
if pgrep -f "process-compose" >/dev/null 2>&1; then\
    echo ""\
    echo "‚É∂∂ Process-Compose Status"\
    process-compose list 2>/dev/null | head -12 || echo "  (try: process-compose attach)"\
fi\
\

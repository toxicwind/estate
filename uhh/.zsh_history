#!/usr/bin/env bash\
# Smart Audit v4 ‚ÄÉ¥ classifies first, only tests real binaries, never runs shell scripts\
\
OLD_PATHS=(\
    "/home/toxic/sovereign/bin"\
    "/home/toxic/.openfang/bin"\
    "/home/toxic/.local/bin"\
    "/home/toxic/bin"\
    "/home/toxic/.cargo/bin"\
    "/home/toxic/.grok/bin"\
    "/home/toxic/go/bin"\
    "/home/toxic/.pixi/bin"\
)\
\
echo "=== SMART PATH AUDIT v4 (classify first, skip dangerous) ==="\
echo ""\
\
for dir in "${OLD_PATHS[@]}"; do\
    [ -d "$dir" ] || { echo "‚É∫ÉÄÔ∏ÉØ  Missing: $dir"; continue; }\
\
    echo "=== Scanning $dir ==="\
\
    for bin in "$dir"/*; do\
        [ -x "$bin" ] || continue\
        cmd=$(basename "$bin")\
\
        # === CLASSIFY ===\
        ftype=$(file -b "$bin" 2>/dev/null)\
\
        # Skip shell scripts immediately (shebang or text)\
        if [[ "$ftype" == *"shell script"* || "$ftype" == *"POSIX shell script"* || "$ftype" == *"Bourne-Again shell script"* ]]; then\
            echo "‚É¶É≤ $cmd  (SKIPPED ‚ÄÉ¥ shell script)"\
            continue\
        fi\
\
        # Skip Python scripts\
        if [[ "$ftype" == *"Python script"* ]]; then\
            echo "‚É¶É≤ $cmd  (SKIPPED ‚ÄÉ¥ Python script)"\
            continue\
        fi\
\
        # Skip obvious GUI / broken\
        case "$cmd" in\
            antigravity|__pycache__|proton-viewer|gguf-editor-gui|standard-supervisor)\
                echo "‚É¶É≤ $cmd  (SKIPPED ‚ÄÉ¥ GUI/broken)"\
                continue\
                ;;\
        esac\
\
        # Symlink info\
        if [ -L "$bin" ]; then\
            target=$(readlink -f "$bin" 2>/dev/null || echo "broken")\
            echo "‚É¶É≤ $cmd  (SYMLINK ‚É¶É≤ $target)"\
        else\
            echo "‚É¶É≤ $cmd  ($ftype)"\
        fi\
\
        # Only test real ELF binaries or things that look like proper CLIs\
        if [[ "$ftype" == *"ELF"* || "$ftype" == *"executable"* ]]; then\
            echo "   --version:"\
            timeout 1s env DISPLAY= WAYLAND_DISPLAY= "$bin" --version 2>&1 | head -5 || echo "     (no output / error)"\
\
            echo "   --help:"\
            timeout 1s env DISPLAY= WAYLAND_DISPLAY= "$bin" --help 2>&1 | head -5 || echo "     (no output / error)"\
        else\
            echo "   (Not a standard binary ‚ÄÉ¥ skipping --version/--help test)"\
        fi\
\
        echo "‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä"\

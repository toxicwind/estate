#!/usr/bin/env bash\
set -euo pipefail\
\
cd /home/toxic/sovereign\
\
echo "=== FINAL SOVEREIGN FIX ==="\
\
# -----------------------------------------------------------------\
# 1. Find the actual working model\
# -----------------------------------------------------------------\
ACTUAL_MODEL=$(find /home/toxic/models -name "*.gguf" -type f 2>/dev/null | head -1)\
if [ -z "$ACTUAL_MODEL" ]; then\
    echo "‚ÉΩÉ¨ No GGUF model found"\
    exit 1\
fi\
echo "‚ÉºÉ≥ Found model: $ACTUAL_MODEL"\
\
# -----------------------------------------------------------------\
# 2. Fix process_compose_pure.yml with correct model path\
# -----------------------------------------------------------------\
cat > modules/process_compose_pure.yml << EOF\
version: "1.0"\
\
environment:\
  - HF_TOKEN=\${HF_TOKEN}\
\
processes:\
  ik_llama:\
    command: |\
      /home/toxic/ik_llama/server\
        -m $ACTUAL_MODEL\
        --host 0.0.0.0\
        --port 25001\
        --cont-batching\
        --flash-attn\
        --embeddings\
        --gpu-layers 999\
        --parallel 2\
        --threads 12\
    availability:\
      restart: on_failure\
    log_location: ./logs/ik-llama.log\
    healthcheck:\
      test: ["CMD", "curl", "-f", "http://127.0.0.1:25001/v1/models"]\
      interval: 30s\
      timeout: 10s\
      retries: 3\
\
  nfcot_proxy:\
    command: /home/toxic/nfcot_proxy/server --port 25008\
    availability:\
      restart: on_failure\
    log_location: ./logs/nfcot_proxy.log\
\
  openfang:\
    command: /home/toxic/.local/bin/openfang serve --config /home/toxic/.openfang/config.toml\
    availability:\
      restart: on_failure\
    log_location: ./logs/openfang.log\
    depends_on:\
      ik_llama:\
        condition: process_healthy\
\
  caddy:\
    command: caddy run --config /home/toxic/sovereign/caddy/Caddyfile\
    availability:\
      restart: on_failure\
    log_location: ./logs/caddy.log\
    depends_on:\
      openfang:\
        condition: process_healthy\
EOF\
\
echo "‚ÉºÉ≥ YAML updated with correct model path"\
\
# -----------------------------------------------------------------\
# 3. Ensure openfang binary is in PATH (create symlink if needed)\
# -----------------------------------------------------------------\
if ! command -v openfang &>/dev/null; then\
    if [ -f /home/toxic/.local/bin/openfang ]; then\
        sudo ln -sf /home/toxic/.local/bin/openfang /usr/local/bin/openfang\
        echo "‚ÉºÉ≥ openfang linked to /usr/local/bin"\
    else\
        echo "‚ÉΩÉ¨ openfang binary not found; install it first"\
        exit 1\
    fi\
fi\
\
# -----------------------------------------------------------------\
# 4. Create minimal openfang config if missing\
# -----------------------------------------------------------------\
mkdir -p /home/toxic/.openfang\
if [ ! -f /home/toxic/.openfang/config.toml ]; then\
    cat > /home/toxic/.openfang/config.toml << 'EOF'\
[agent]\
name = "sovereign"\
\
[provider.openai]\
type = "openai"\
base_url = "http://127.0.0.1:25001/v1"\
api_key = "dummy"\
models = ["*"]\
\
[web]\
enabled = true\
port = 25004\
static_root = "/home/toxic/.openfang/dashboard"\
EOF\
    echo "‚ÉºÉ≥ OpenFang config created"\
fi\
\
# -----------------------------------------------------------------\
# 5. Stop and restart cleanly\
# -----------------------------------------------------------------\
process-compose down 2>/dev/null || true\
sleep 2\
./boot.sh\
\
sleep 8\
\
# -----------------------------------------------------------------\
# 6. Verify\
# -----------------------------------------------------------------\
echo ""\
echo "=== VERIFICATION ==="\
curl -s -o /dev/null -w "ik_llama: %{http_code}\n" http://127.0.0.1:25001/v1/models\

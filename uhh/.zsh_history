  -m /home/toxic/models/Qwen3.6-27B-Heretic-Cerebellum-v1-Q2_K_Mixed.gguf \\
  --host 0.0.0.0 --port 25001 \\
  --n-gpu-layers 99 \\
  --ctx-size 16384 \\
  --cache-type-k q4_0 \\
  --cache-type-v q4_0 \\
  --flash-attn on \\
  --parallel 1 \\
  --metrics\
EOF\
chmod +x /home/toxic/sovereign/run_llama.sh\
\
# 3. Simplify the Orchestrator (No flags to pass, just the script)\
cat > /home/toxic/sovereign/process-compose.yaml << 'EOF'\
version: "0.5"\
processes:\
  ik_llama:\
    command: /home/toxic/sovereign/run_llama.sh\
    availability:\
      restart: always\
  nfcot_proxy:\
    command: python3 /home/toxic/sovereign/modules/nfcot_proxy.py\
    depends_on:\
      ik_llama:\
        condition: process_healthy\
EOF\
\
# 4. Re-ignite\
systemctl --user restart sovereign-engine.service\
\
echo "=== Engine reset. Waiting 10s for model load... ==="\
sleep 10\
curl -s -m2 http://127.0.0.1:25001/v1/models\

cd /home/toxic/sovereign\
\
echo "=== Restoring Full Stack ==="\
\
# 1. Re-build the full argument list with a manageable memory budget\
cat > /home/toxic/sovereign/ik_llama.args << 'EOF'\
-m /home/toxic/models/Qwen3.6-27B-Heretic-Cerebellum-v1-Q2_K_Mixed.gguf\
--host 0.0.0.0\
--port 25001\
--n-gpu-layers 99\
--ctx-size 32768\
--cache-ram 8192\
--cache-type-k q4_0\
--cache-type-v q4_0\
--parallel 1\
--flash-attn on\
--mla-use 3\
--no-mmap\
--metrics\
-b 4096\
-ub 1024\
EOF\
\
# 2. Restore the full orchestration YAML\
cat > /home/toxic/sovereign/process-compose.yaml << 'EOF'\

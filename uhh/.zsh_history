#!/usr/bin/env python3\
import requests, sys\
from datetime import datetime\
ENDPOINTS = {\
    "patreon_api": "https://www.th.gl/api/patreon/overwolf",\
    "analytics": "https://a.th.gl/api/event",\
    "cdn_status": "https://cdn.th.gl/dune-awakening/version.json",\
    "actor_api": "https://actors-api.th.gl/actors/dune-awakening",\
}\
HEADERS = {"User-Agent": "THGL-SecurityTest/1.0"}\
def main():\
    print(f"TH.GL Endpoint Test - {datetime.now().isoformat()}")\
    for name, url in ENDPOINTS.items():\
        try:\
            r = requests.get(url, headers=HEADERS, timeout=10)\
            print(f"{name}: {r.status_code} -> {r.text[:100]}")\
        except Exception as e:\
            print(f"{name}: ERROR {e}")\
if __name__ == "__main__": main()\
EOT\

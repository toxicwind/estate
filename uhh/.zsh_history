"""Translate grep arguments to rg arguments."""\
\
import re\
import subprocess\
\
def convert_bre_to_ere(pattern: str) -> str:\
    result = pattern\
    result = result.replace(r'\(', '(')\
    result = result.replace(r'\)', ')')\
    result = result.replace(r'\|', '|')\
    result = result.replace(r'\+', '+')\
    result = result.replace(r'\?', '?')\
    result = result.replace(r'\{', '{')\
    result = result.replace(r'\}', '}')\
    return result\
\
IDENTICAL_SHORT_FLAGS = {"-i", "-n", "-v", "-w", "-l", "-c", "-o", "-h", "-H", "-q", "-F"}\
IDENTICAL_SHORT_FLAGS_WITH_ARG = {"-A", "-B", "-C", "-e", "-f", "-m"}\
DROP_SHORT_FLAGS = {"-r", "-R"}  # -E, -G, -P handled separately now\
LONG_OPTION_MAP = {\
    "--ignore-case": "-i", "--line-number": "-n", "--invert-match": "-v",\
    "--word-regexp": "-w", "--files-with-matches": "-l", "--count": "-c",\
    "--only-matching": "-o", "--no-filename": "-h", "--with-filename": "-H",\
    "--quiet": "-q", "--silent": "-q", "--fixed-strings": "-F",\
    "--perl-regexp": None, "--extended-regexp": None, "--basic-regexp": None,\
    "--recursive": None,\
}\
LONG_OPTIONS_WITH_ARG = {"--after-context", "--before-context", "--context", "--regexp", "--file", "--max-count"}\
\
def translate_grep_args(args: list[str]) -> list[str]:\
    fixed_strings = False\
    ere_mode = False\
    bre_mode = False\
    perl_mode = False\
\
    for arg in args:\
        if arg in ("-F", "--fixed-strings"):\
            fixed_strings = True\
        if arg in ("-E", "--extended-regexp"):\
            ere_mode = True\
        if arg in ("-G", "--basic-regexp"):\
            bre_mode = True\
        if arg in ("-P", "--perl-regexp"):\
            perl_mode = True\
        if arg.startswith("-") and len(arg) > 1:\
            for ch in arg[1:]:\
                if ch == 'F': fixed_strings = True\
                if ch == 'E': ere_mode = True\
                if ch == 'G': bre_mode = True\
                if ch == 'P': perl_mode = True\
\
    result = []\
    i = 0\
    pattern_seen = False\
\
    while i < len(args):\
        arg = args[i]\
\
        if re.match(r'^-\d+$', arg):\
            result.extend(["-C", arg[1:]])\
            i += 1\
            continue\
        if arg == "--color":\
            result.append("--color=always")\
            i += 1\
            continue\
        if arg.startswith("--color="):\
            result.append(arg)\
            i += 1\
            continue\
        if arg == "-s":\
            result.append("--no-messages")\
            i += 1\
            continue\
        if arg.startswith("--include="):\
            result.extend(["-g", arg.split("=",1)[1]])\
            i += 1\
            continue\
        if arg.startswith("--exclude="):\
            result.extend(["-g", f"!{arg.split('=',1)[1]}"])\
            i += 1\
            continue\
        if arg.startswith("--exclude-dir="):\
            result.extend(["-g", f"!{arg.split('=',1)[1]}/"])\
            i += 1\
            continue\
        if arg.startswith("--regexp="):\
            _, pattern = arg.split("=", 1)\
            if not fixed_strings and not ere_mode and not perl_mode:\
                pattern = convert_bre_to_ere(pattern)\
            result.extend(["-e", pattern])\
            i += 1\
            continue\
        if arg.startswith("--") and "=" in arg:\
            opt, value = arg.split("=", 1)\
            if opt in LONG_OPTIONS_WITH_ARG:\
                short_map = {"--after-context":"-A","--before-context":"-B","--context":"-C","--regexp":"-e","--file":"-f","--max-count":"-m"}\
                if opt in short_map:\
                    if opt == "--regexp" and not fixed_strings and not ere_mode and not perl_mode:\
                        value = convert_bre_to_ere(value)\
                    result.extend([short_map[opt], value])\
            else:\
                result.append(arg)\
            i += 1\
            continue\
        if arg.startswith("--"):\
            if arg in LONG_OPTION_MAP:\
                mapped = LONG_OPTION_MAP[arg]\
                if mapped is not None:\
                    result.append(mapped)\
            elif arg in LONG_OPTIONS_WITH_ARG:\
                short_map = {"--after-context":"-A","--before-context":"-B","--context":"-C","--regexp":"-e","--file":"-f","--max-count":"-m"}\
                if arg in short_map and i+1 < len(args):\
                    if arg == "--regexp":\
                        pattern = args[i+1]\
                        if not fixed_strings and not ere_mode and not perl_mode:\
                            pattern = convert_bre_to_ere(pattern)\
                        result.extend(["-e", pattern])\
                    else:\
                        result.extend([short_map[arg], args[i+1]])\
                    i += 2\
                    continue\
                else:\
                    result.append(arg)\
            else:\
                result.append(arg)\
            i += 1\
            continue\
        if arg.startswith("-") and len(arg) > 2 and not arg[1].isdigit():\
            expanded = [f"-{ch}" for ch in arg[1:]]\
            for flag in expanded:\
                if flag in IDENTICAL_SHORT_FLAGS:\
                    result.append(flag)\
                elif flag == "-s":\
                    result.append("--no-messages")\
                elif flag in DROP_SHORT_FLAGS:\
                    pass\
                # -E, -G, -P already handled, ignore here\
            i += 1\
            continue\
        if arg == "-e":\
            result.append(arg)\
            if i+1 < len(args):\
                pattern = args[i+1]\
                if not fixed_strings and not ere_mode and not perl_mode:\
                    pattern = convert_bre_to_ere(pattern)\
                result.append(pattern)\
                i += 2\
                continue\
            i += 1\
            continue\
        if arg in IDENTICAL_SHORT_FLAGS_WITH_ARG:\
            result.append(arg)\
            if i+1 < len(args):\
                result.append(args[i+1])\
                i += 2\
                continue\
            i += 1\
            continue\
        if arg in IDENTICAL_SHORT_FLAGS:\
            result.append(arg)\
            i += 1\
            continue\
        if arg in DROP_SHORT_FLAGS:\
            i += 1\
            continue\
        if not pattern_seen:\
            if not fixed_strings and not ere_mode and not perl_mode:\
                arg = convert_bre_to_ere(arg)\
            pattern_seen = True\
        result.append(arg)\
        i += 1\
\
    if perl_mode:\
        # Check if rg supports --pcre2\
        try:\
            subprocess.run(["rg", "--pcre2", "--help"], capture_output=True, check=False)\
            result.append("--pcre2")\
        except FileNotFoundError:\
            pass  # rg not installed? shouldn't happen\
        result = [x for x in result if x != "-P"]\
    return result\
EOF
cat > ~/.local/share/uv/tools/greprip/lib/python3.13/site-packages/grg/translator.py << 'EOF'\
"""Translate grep arguments to rg arguments."""\
\
import re\
import subprocess\
\
def convert_bre_to_ere(pattern: str) -> str:\
    result = pattern\
    result = result.replace(r'\(', '(')\
    result = result.replace(r'\)', ')')\
    result = result.replace(r'\|', '|')\
    result = result.replace(r'\+', '+')\
    result = result.replace(r'\?', '?')\
    result = result.replace(r'\{', '{')\
    result = result.replace(r'\}', '}')\
    return result\
\
# Flags that are identical in grep and rg (no argument)\
IDENTICAL_SHORT_FLAGS = {"-i", "-n", "-v", "-w", "-l", "-c", "-o", "-h", "-H", "-q", "-F"}\
\
# Short flags that take an argument and are identical\
IDENTICAL_SHORT_FLAGS_WITH_ARG = {"-A", "-B", "-C", "-e", "-f", "-m"}\
\
# Flags that we handle semantically and should NOT pass to rg\
SEMANTIC_FLAGS = {"-E", "-G", "-P"}\
\
# Flags to drop completely (rg defaults)\
DROP_SHORT_FLAGS = {"-r", "-R"}\
\
# Long option mappings (grep long option -> rg equivalent)\
LONG_OPTION_MAP = {\
    "--ignore-case": "-i",\
    "--line-number": "-n",\
    "--invert-match": "-v",\
    "--word-regexp": "-w",\
    "--files-with-matches": "-l",\
    "--count": "-c",\
    "--only-matching": "-o",\
    "--no-filename": "-h",\
    "--with-filename": "-H",\
    "--quiet": "-q",\
    "--silent": "-q",\
    "--fixed-strings": "-F",\
    "--perl-regexp": None,      # Handled separately\
    "--extended-regexp": None,  # Dropped, but tracked\
    "--basic-regexp": None,     # Dropped, but tracked\
    "--recursive": None,        # Dropped, rg default\
}\
\
# Long options that take an argument\
LONG_OPTIONS_WITH_ARG = {"--after-context", "--before-context", "--context", "--regexp", "--file", "--max-count"}\
\
def translate_grep_args(args: list[str]) -> list[str]:\
    # First pass: detect regex mode and fixed strings\
    fixed_strings = False\
    ere_mode = False\
    bre_mode = False\
    perl_mode = False\
\
    for arg in args:\
        if arg in ("-F", "--fixed-strings"):\
            fixed_strings = True\
        if arg in ("-E", "--extended-regexp"):\
            ere_mode = True\
        if arg in ("-G", "--basic-regexp"):\
            bre_mode = True\
        if arg in ("-P", "--perl-regexp"):\
            perl_mode = True\
        # Check combined flags like -EFi, -PGi, etc.\
        if arg.startswith("-") and len(arg) > 1 and not arg[1].isdigit():\
            for ch in arg[1:]:\
                if ch == 'F':\
                    fixed_strings = True\
                elif ch == 'E':\
                    ere_mode = True\
                elif ch == 'G':\
                    bre_mode = True\
                elif ch == 'P':\
                    perl_mode = True\
\
    result = []\
    i = 0\
    pattern_seen = False\
\
    while i < len(args):\
        arg = args[i]\
\
        # Skip semantic flags entirely (they are not passed to rg)\
        if arg in SEMANTIC_FLAGS:\
            i += 1\
            continue\
\
        # Handle numeric context shorthand: -3 means -C 3\
        if re.match(r'^-\d+$', arg):\
            result.extend(["-C", arg[1:]])\
            i += 1\
            continue\
\
        # Handle --color variants\
        if arg == "--color":\
            result.append("--color=always")\
            i += 1\
            continue\
        if arg.startswith("--color="):\
            result.append(arg)\
            i += 1\
            continue\
\
        # Handle -s (suppress errors) -> --no-messages\
        if arg == "-s":\
            result.append("--no-messages")\
            i += 1\
            continue\
\
        # Handle --include=PATTERN\
        if arg.startswith("--include="):\
            pattern = arg.split("=", 1)[1]\
            result.extend(["-g", pattern])\
            i += 1\
            continue\
\
        # Handle --exclude=PATTERN\
        if arg.startswith("--exclude="):\
            pattern = arg.split("=", 1)[1]\
            result.extend(["-g", f"!{pattern}"])\
            i += 1\
            continue\
\
        # Handle --exclude-dir=PATTERN\
        if arg.startswith("--exclude-dir="):\
            pattern = arg.split("=", 1)[1]\
            result.extend(["-g", f"!{pattern}/"])\
            i += 1\
            continue\
\
        # Handle --regexp=PATTERN (pattern via long option)\
        if arg.startswith("--regexp="):\
            _, pattern = arg.split("=", 1)\
            if not fixed_strings and not ere_mode and not perl_mode:\
                pattern = convert_bre_to_ere(pattern)\
            result.extend(["-e", pattern])\
            i += 1\
            continue\
\
        # Handle long options with = value\
        if arg.startswith("--") and "=" in arg:\
            opt, value = arg.split("=", 1)\
            if opt in LONG_OPTIONS_WITH_ARG:\
                short_map = {\
                    "--after-context": "-A",\
                    "--before-context": "-B",\
                    "--context": "-C",\
                    "--regexp": "-e",\
                    "--file": "-f",\
                    "--max-count": "-m",\
                }\
                if opt in short_map:\
                    if opt == "--regexp" and not fixed_strings and not ere_mode and not perl_mode:\
                        value = convert_bre_to_ere(value)\
                    result.extend([short_map[opt], value])\
            else:\
                result.append(arg)\
            i += 1\
            continue\
\
        # Handle long options\
        if arg.startswith("--"):\
            if arg in LONG_OPTION_MAP:\
                mapped = LONG_OPTION_MAP[arg]\
                if mapped is not None:\
                    result.append(mapped)\
                # else: drop it (semantics already captured)\
            elif arg in LONG_OPTIONS_WITH_ARG:\
                short_map = {\
                    "--after-context": "-A",\
                    "--before-context": "-B",\
                    "--context": "-C",\
                    "--regexp": "-e",\
                    "--file": "-f",\
                    "--max-count": "-m",\
                }\
                if arg in short_map and i + 1 < len(args):\
                    if arg == "--regexp":\
                        pattern = args[i + 1]\
                        if not fixed_strings and not ere_mode and not perl_mode:\
                            pattern = convert_bre_to_ere(pattern)\
                        result.extend(["-e", pattern])\
                    else:\
                        result.extend([short_map[arg], args[i + 1]])\
                    i += 2\
                    continue\
                else:\
                    result.append(arg)\
            else:\
                result.append(arg)\
            i += 1\
            continue\
\
        # Handle combined short flags like -ri, -rni\
        if arg.startswith("-") and len(arg) > 2 and not arg[1].isdigit():\
            expanded = [f"-{ch}" for ch in arg[1:]]\
            for flag in expanded:\
                if flag in IDENTICAL_SHORT_FLAGS:\
                    result.append(flag)\
                elif flag == "-s":\
                    result.append("--no-messages")\
                elif flag in DROP_SHORT_FLAGS or flag in SEMANTIC_FLAGS:\
                    pass  # Skip\
                elif flag in IDENTICAL_SHORT_FLAGS_WITH_ARG:\
                    # Combined flags with args are tricky; we just skip them\
                    pass\
            i += 1\
            continue\
\
        # Handle -e PATTERN (explicit pattern)\
        if arg == "-e":\
            result.append(arg)\
            if i + 1 < len(args):\
                pattern = args[i + 1]\
                if not fixed_strings and not ere_mode and not perl_mode:\
                    pattern = convert_bre_to_ere(pattern)\
                result.append(pattern)\
                i += 2\
                continue\
            i += 1\
            continue\
\
        # Handle short flags with arguments\
        if arg in IDENTICAL_SHORT_FLAGS_WITH_ARG:\
            result.append(arg)\
            if i + 1 < len(args):\
                result.append(args[i + 1])\
                i += 2\
                continue\
            i += 1\
            continue\
\
        # Handle identical short flags (but not semantic ones)\
        if arg in IDENTICAL_SHORT_FLAGS:\
            result.append(arg)\
            i += 1\
            continue\
\
        # Handle flags to drop\
        if arg in DROP_SHORT_FLAGS:\
            i += 1\
            continue\
\
        # Everything else: could be pattern or path\
        if not pattern_seen:\
            # This is the main pattern - convert only if not ERE/Perl/Fixed\
            if not fixed_strings and not ere_mode and not perl_mode:\
                arg = convert_bre_to_ere(arg)\
            pattern_seen = True\
        result.append(arg)\
        i += 1\
\
    # If perl mode was requested, add --pcre2 (if rg supports it)\
    if perl_mode:\
        # Check if rg supports --pcre2\
        try:\
            subprocess.run(["rg", "--pcre2", "--help"], capture_output=True, check=False)\
            result.append("--pcre2")\
        except FileNotFoundError:\
            pass  # rg not installed (should not happen)\
        # Remove any stray -P that might have leaked\
        result = [x for x in result if x != "-P"]\
\
    return result\
EOF

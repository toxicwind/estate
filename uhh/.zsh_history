cat /home/toxic/sovereign/process-compose.yml
bash -c '\
set -e\
cd /home/toxic/sovereign\
ts=$(date +%s)\
\
# 1. backup\
cp -v ~/.openfang/config.toml ~/.openfang/config.toml.bak.$ts\
cp -v /home/toxic/sovereign/process-compose.yaml /home/toxic/sovereign/process-compose.yaml.bak.$ts\
cp -v /home/toxic/sovereign/process-compose.yml /home/toxic/sovereign/process-compose.yml.bak.$ts 2>/dev/null || true\
cp -v ~/.grok/config.toml ~/.grok/config.toml.bak.$ts 2>/dev/null || true\
\
# 2. ~/.openfang/config.toml ‚ÄÉ≥ your Sovereign flags + required API + LLM\
cat > ~/.openfang/config.toml << "OFEOF"\
# Sovereign OpenFang Config - Auto-Approval Enabled\
auto_approve = true\
human_in_loop_initial = true\
sovereign_mode = "maximal_emergent"\
target_hardware = "ryzen_8700f_64gb_sm86_3090_24gb_nvme"\
log_level = "info"\
\
# --- runtime, required ---\
api_listen = "127.0.0.1:25004"\
\
[default_model]\
provider = "openai"\
model = "/home/toxic/models/Qwen3.6-27B-Heretic-Cerebellum-v1-Q2_K_Mixed.gguf"\
base_url = "http://localhost:25001/v1"\
api_key_env = ""\
\
[controller]\
gage_enabled = true\
fsr_watch = true\
kv_fork_enabled = true\
\
[build]\
ik_llama_sm86 = true\
cuda_arch = "sm_86"\
use_hmma = true\
int8_swizzled = true\
\
[extensions]\
weight_pack_sm86 = true\
kv_sovereign_fork = true\
fsr_max = true\
OFEOF\
\
# 3. ~/sovereign/process-compose.yaml ‚ÄÉ≥ single source of truth, delete the .yml\
cat > /home/toxic/sovereign/process-compose.yaml << "PCEOF"\
version: "0.5"\
log_location: "./logs/process-compose.log"\
\
processes:\
  llama-server:\
    command: /home/toxic/ik_llama.cpp-main/build/bin/llama-server -m /home/toxic/models/Qwen3.6-27B-Heretic-Cerebellum-v1-Q2_K_Mixed.gguf --host 0.0.0.0 --port 25001 --jinja --n-gpu-layers 99 --ctx-size 200000 --cache-type-k q4_0 --cache-type-v q8_0 --flash-attn on --no-context-shift --parallel 4 --cont-batching --defrag-thold 0.1 --slot-prompt-similarity 0.6 --reasoning on --reasoning-format deepseek --parallel-tool-calls --samplers "top_k;top_p;min_p;temperature" --temp 0.4 --top-k 40 --top-p 0.9 --min-p 0.05 --repeat-penalty 1.08 --repeat-last-n 1024 --cache-ram 24576 --webui none\
    availability:\
      restart: always\
    readiness_probe:\
      http_get:\
        host: "127.0.0.1"\
        port: 25001\
        path: "/health"\
      initial_delay_seconds: 10\
      period_seconds: 5\

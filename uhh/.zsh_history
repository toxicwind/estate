        echo "‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä"\
    done < <(find "$dir" -maxdepth 1 -mindepth 1 -print0 2>/dev/null | sort -z)\
\
    echo ""\
done\
\
echo "=== AUDIT COMPLETE ==="\
SMARTAUDIT
bash -s <<'SMARTAUDIT'\
#!/usr/bin/env bash\
# === SMART PATH AUDIT v9 (bash -s wrapped, strict, ordered echos) ===\
set -euo pipefail\
IFS=$'\n\t'\
\
echo "=== SMART PATH AUDIT v9 (bash -s wrapped, strict, ordered echos) ==="\
echo "Generated: $(date '+%Y-%m-%d %H:%M:%S %Z')"\
echo\
\
AUDIT_DIRS=(\
  "$HOME/sovereign/bin"\
  "$HOME/.openfang/bin"\
  "$HOME/.local/bin"\
)\
\
for dir in "${AUDIT_DIRS[@]}"; do\
  if [[ ! -d "$dir" ]]; then\
    echo "‚É∫ÉÄÔ∏ÉØ  Missing: $dir"\
    echo\
    continue\
  fi\
  echo "=== Scanning $dir ==="\
  \
  while IFS= read -r -d '' entry; do\
    name=$(basename "$entry")\
\
    # skip dirs, pycache, bytecodes\
    [[ -f "$entry" ]] || continue\
    [[ "$name" == "__pycache__" ]] && continue\
    [[ "$name" == *.pyc ]] && continue\
\
    printf "‚É¶É≤ %s\n" "$name"\
    \
    if [[ -L "$entry" ]]; then\
      target=$(readlink -f "$entry" 2>/dev/null || readlink "$entry")\
      printf "   (SYMLINK ‚É¶É≤ %s)\n" "$target"\
    fi\
\
    real_entry=$(readlink -f "$entry" 2>/dev/null || echo "$entry")\
    ftype=$(file -b "$real_entry" 2>/dev/null || echo "unknown")\
\
    case "$ftype" in\
      *ELF*)\
        echo "   (ELF binary)"\
        echo "   --version:"\
        timeout 1.5 "$entry" --version 2>&1 | head -20 || echo "     (no output / timeout)"\
        echo "   --help:"\
        timeout 1.5 "$entry" --help 2>&1 | head -30 || echo "     (no output / timeout)"\
        ;;\
      *script*|*text*)\
        interp=$(head -1 "$real_entry" 2>/dev/null || echo "")\
        echo "   (script: $interp)"\
        # Python console_script shims are normal, don't dump them as WEIRD\
        if grep -qE "from .* import (main|cli|app)|if __name__ == .__main__." "$real_entry" 2>/dev/null; then\
          echo "   (Python console_script ‚ÄÉ¥ skipping dump)"\
        else\
          size=$(stat -c%s "$real_entry" 2>/dev/null || echo 0)\
          echo "   === BEGIN SCRIPT CONTENT ==="\
          if (( size > 524288 )); then\
            echo "(file > 512 KiB ‚ÄÉ¥ first 80 lines only)"\
            head -80 "$real_entry"\
          else\
            cat "$real_entry"\
          fi\
          echo "   === END SCRIPT CONTENT ==="\
        fi\
        ;;\
      *)\
        echo "   (unclassified: $ftype)"\
        ;;\
    esac\
\
    echo "‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä‚É¥Ä"\
  done < <(find "$dir" -maxdepth 1 -mindepth 1 -print0 2>/dev/null | sort -z)\
  echo\
done\
\
echo "=== AUDIT COMPLETE ==="\
SMARTAUDIT

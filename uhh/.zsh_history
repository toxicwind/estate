# Write the Python script ‚ÄÉ≥ note the delimiter must be at line start\
cat > "$PYTHON_SCRIPT" << "PYEOF"\
#!/usr/bin/env python3\
"""\
FROG AUTONOMOUS SEARCHER (FAS) ‚ÄÉ≥ Morphe‚ÄÉ±inspired, self‚ÄÉ±mutating pattern scanner.\
"""\
\
import os\
import re\
import json\
import sys\
from pathlib import Path\
from collections import defaultdict, Counter\
import itertools\
import requests\
import colorama\
from colorama import Fore, Style\
\
colorama.init(autoreset=True)\
\
# ------------------------------------------------------------\
# 1. BASE FINGERPRINTS (Morphe‚ÄÉ±style instruction filters)\
# ------------------------------------------------------------\
BASE_FINGERPRINTS = {\
    # Overwolf\
    "overwolf.game_info": re.compile(r"overwolf\.games\.getRunningGameInfo", re.IGNORECASE),\
    "overwolf.game_event": re.compile(r"overwolf\.games\.events\.onGameEvent", re.IGNORECASE),\
    "overwolf.window": re.compile(r"overwolf\.windows\.getCurrentWindow", re.IGNORECASE),\
    "overwolf.extra": re.compile(r"overwolf\.extensions\.current\.getExtraObject", re.IGNORECASE),\
    # Memory injection\
    "memory.read": re.compile(r"ReadProcessMemory\s*\(", re.IGNORECASE),\
    "memory.write": re.compile(r"WriteProcessMemory\s*\(", re.IGNORECASE),\
    "memory.remotethread": re.compile(r"CreateRemoteThread\s*\(", re.IGNORECASE),\
    "memory.open": re.compile(r"OpenProcess\s*\([^)]*PROCESS_ALL_ACCESS", re.IGNORECASE),\
    "memory.valloc": re.compile(r"VirtualAllocEx\s*\(", re.IGNORECASE),\
    "memory.ntread": re.compile(r"NtReadVirtualMemory\s*\(", re.IGNORECASE),\
    # Unreal Engine ESP\
    "ue.world": re.compile(r"\b(UWorld|GWorld)\b", re.IGNORECASE),\
    "ue.gnames": re.compile(r"\b(GNames|GObjects)\b", re.IGNORECASE),\
    "ue.bone": re.compile(r"GetBoneLocation\s*\(", re.IGNORECASE),\
    "ue.w2s": re.compile(r"WorldToScreen\s*\(", re.IGNORECASE),\
    "ue.w2s_short": re.compile(r"\bw2s\b", re.IGNORECASE),\
    "ue.camera": re.compile(r"PlayerCameraManager|AKnowledgedPawn", re.IGNORECASE),\
    "ue.offsets": re.compile(r"offsets\.h|pattern scanning|signature scanning", re.IGNORECASE),\
    # Data exfiltration\
    "exfil.ws": re.compile(r"ws://|wss://", re.IGNORECASE),\
    "exfil.socketio": re.compile(r"socket\.emit\s*\(", re.IGNORECASE),\
    "exfil.http": re.compile(r"fetch\s*\(|axios\.(get|post)|api\.th\.gl", re.IGNORECASE),\
    # Obfuscation\
    "obfuscation.eval": re.compile(r"eval\s*\(|Function\s*\(", re.IGNORECASE),\
    "obfuscation.base64": re.compile(r"atob\s*\(|btoa\s*\(|base64\.(encode|decode)", re.IGNORECASE),\
    "obfuscation.hex": re.compile(r"\\x[0-9a-f]{2}", re.IGNORECASE),\
    "obfuscation.fromcharcode": re.compile(r"fromCharCode\s*\(", re.IGNORECASE),\
    # Position tracking\
    "position.get": re.compile(r"getPosition|getLocation|PlayerPos|entityPos|GetActorLocation|GetPlayerLocation", re.IGNORECASE),\
    # Game dumping\
    "dumper.ue4": re.compile(r"UE4-Dumper|UEDumper", re.IGNORECASE),\
    "dumper.offsets": re.compile(r"Dump offsets|offset dump", re.IGNORECASE),\
    # Dune Awakening specific\
    "dune.spice": re.compile(r"\bspice\b.*\boffset\b", re.IGNORECASE),\
    "dune.sandworm": re.compile(r"sandworm.*(esp|cheat)", re.IGNORECASE),\
    "dune.fremen": re.compile(r"Fremen|Sietch|Maker|Crysknife", re.IGNORECASE),\
}\
\
CATEGORY_WEIGHTS = {\
    "overwolf": 1.0,\
    "memory": 1.2,\
    "ue": 1.2,\
    "exfil": 1.0,\
    "obfuscation": 0.6,\
    "position": 0.8,\
    "dumper": 1.0,\
    "dune": 1.5,\
}\
\
SCAN_EXTENSIONS = {".c", ".cpp", ".h", ".hpp", ".cs", ".js", ".ts", ".py", ".html", ".json", ".txt", ".md", ".sh", ".bash"}\
\
class FrogSearcher:\
    def __init__(self, root_dir: Path, ignore_dirs=None):\
        self.root_dir = root_dir.resolve()\
        self.ignore_dirs = set(ignore_dirs or ["node_modules", ".git", "__pycache__", "d4data"])\
        self.fingerprints = BASE_FINGERPRINTS.copy()\
        self.results = defaultdict(list)\
        self.file_categories = defaultdict(set)\
\
    def _should_ignore(self, path: Path) -> bool:\
        return any(part in self.ignore_dirs for part in path.parts)\
\
    def scan_file(self, file_path: Path):\
        try:\
            with open(file_path, "r", encoding="utf-8", errors="ignore") as f:\
                lines = f.readlines()\
        except:\
            return\
        for line_num, line in enumerate(lines, 1):\
            line_stripped = line.strip()\
            if not line_stripped:\
                continue\
            for fp_name, pattern in self.fingerprints.items():\
                if pattern.search(line):\
                    self.results[file_path].append((fp_name, line_num, line_stripped[:200]))\
                    cat = fp_name.split(".")[0]\
                    self.file_categories[file_path].add(cat)\
\
    def scan(self):\
        for file_path in self.root_dir.rglob("*"):\
            if self._should_ignore(file_path):\
                continue\
            if file_path.suffix in SCAN_EXTENSIONS:\
                self.scan_file(file_path)\
\
    def mutate_patterns(self):\
        all_matches = []\
        for hits in self.results.values():\
            for _, _, snippet in hits:\
                all_matches.append(snippet)\
        text = "\n".join(all_matches)\
        for b64 in set(re.findall(r"[A-Za-z0-9+/]{40,}={0,2}", text)):\
            name = f"mutated_base64_{b64[:20]}"\
            self.fingerprints[name] = re.compile(re.escape(b64))\
        for offset in set(re.findall(r"0x[0-9a-f]{4,}", text)):\
            name = f"mutated_offset_{offset}"\
            self.fingerprints[name] = re.compile(re.escape(offset))\
        for func in set(re.findall(r"\b[A-Z][a-zA-Z0-9]*(Get|Set|Find)[A-Z][a-zA-Z0-9]*\b", text)):\
            name = f"mutated_func_{func}"\
            self.fingerprints[name] = re.compile(rf"\b{func}\s*\(", re.IGNORECASE)\
\
    def correlate(self):\
        suspects = []\
        for path, cats in self.file_categories.items():\
            score = sum(CATEGORY_WEIGHTS.get(c, 0.5) for c in cats)\
            if "memory" in cats and "ue" in cats:\
                score += 2.0\
            if "overwolf" in cats and "exfil" in cats:\
                score += 1.5\
            if "dune" in cats:\
                score += 2.0\
            if score >= 1.5:\
                suspects.append({\
                    "file": str(path),\
                    "score": round(score, 2),\
                    "categories": list(cats),\
                    "fingerprints": list(set(fp for fp, _, _ in self.results[path]))\
                })\
        suspects.sort(key=lambda x: x["score"], reverse=True)\
        return suspects\
\
    def to_dict(self):\
        suspects = self.correlate()\
        cat_counter = Counter()\
        for cats in self.file_categories.values():\
            cat_counter.update(cats)\
        return {\
            "target_dir": str(self.root_dir),\
            "total_files_scanned": len(self.results),\
            "suspicious_count": len(suspects),\
            "category_counts": dict(cat_counter),\
            "mutated_patterns": [name for name in self.fingerprints if name.startswith("mutated_")],\
            "suspects": suspects,\
            "sample_matches": [\
                {"file": str(p), "fingerprint": fp, "line": ln, "snippet": sn}\
                for p, hits in list(self.results.items())[:20]\
                for fp, ln, sn in hits[:3]\
            ]\
        }\
\
# ------------------------------------------------------------\
# Main\
# ------------------------------------------------------------\
if __name__ == "__main__":\
    if len(sys.argv) < 2:\
        print("Usage: frog_autonomous_searcher.py <target_directory> [output_json]")\
        sys.exit(1)\
    target = Path(sys.argv[1])\
    output_json = sys.argv[2] if len(sys.argv) > 2 else "/tmp/frog_results.json"\
    if not target.is_dir():\
        print(f"Error: {target} is not a directory")\
        sys.exit(1)\
\
    searcher = FrogSearcher(target)\
    print(f"{Fore.CYAN}Scanning {target} ...{Style.RESET_ALL}")\
    searcher.scan()\
    print(f"{Fore.CYAN}Mutating patterns ...{Style.RESET_ALL}")\
    searcher.mutate_patterns()\
    print(f"{Fore.CYAN}Correlating ...{Style.RESET_ALL}")\
    result_dict = searcher.to_dict()\
\
    with open(output_json, "w") as f:\
        json.dump(result_dict, f, indent=2)\
    print(f"{Fore.GREEN}Results saved to {output_json}{Style.RESET_ALL}")\
PYEOF\
\
# Run the Python script\
python3 "$PYTHON_SCRIPT" "$TARGET_DIR" "$JSON_OUTPUT"\
\
# ============================================================\
# Generate the hyper‚ÄÉ±aesthetic SPA dashboard (CDN based)\
# ============================================================\
cat > "$HTML_OUTPUT" << "HTMLEOF"\
<!DOCTYPE html>\
<html lang="en">\
<head>\
    <meta charset="UTF-8">\
    <meta name="viewport" content="width=device-width, initial-scale=1.0">\
    <title>ÉøÉ∞∏ Frog Autonomous Searcher ‚ÄÉ≥ Morphe Dashboard</title>\
    <!-- Bootstrap 5 + Icons + Chart.js CDN -->\
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">\
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">\
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>\
    <style>\
        body { background: #1a2f2b; font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; }\
        .frog-card { border-radius: 1.5rem; backdrop-filter: blur(4px); background: rgba(255,248,225,0.9); box-shadow: 0 8px 20px rgba(0,0,0,0.2); transition: transform 0.2s; }\
        .frog-card:hover { transform: translateY(-5px); }\
        .stat-number { font-size: 2.5rem; font-weight: bold; color: #2d6a4f; }\
        .badge-cat { font-size: 0.8rem; margin: 0.2rem; }\
        .accordion-button:not(.collapsed) { background: #d8f3dc; color: #1b4332; }\
        pre { background: #f8f9fa; border-radius: 0.75rem; padding: 1rem; font-size: 0.8rem; overflow-x: auto; }\
        .navbar-brand i { margin-right: 0.5rem; }\
        footer { font-size: 0.8rem; opacity: 0.7; }\
    </style>\
</head>\
<body class="bg-dark">\
    <nav class="navbar navbar-dark bg-success bg-opacity-75 shadow-lg">\
        <div class="container">\
            <span class="navbar-brand h1"><i class="fas fa-frog"></i> Frog Autonomous Searcher ¬∑ Morphe+CAI</span>\
            <span class="text-light"><i class="fas fa-chart-line"></i> Collective Anuran Intelligence</span>\
        </div>\
    </nav>\
    <div class="container py-4">\
        <div class="row" id="statsRow"></div>\
        <div class="row mt-4">\
            <div class="col-md-6">\
                <div class="frog-card p-3">\
                    <h4><i class="fas fa-chart-pie"></i> Category Breakdown</h4>\
                    <canvas id="categoryChart" height="250"></canvas>\
                </div>\
            </div>\
            <div class="col-md-6">\
                <div class="frog-card p-3">\
                    <h4><i class="fas fa-dungeon"></i> Dune Awakening Intel</h4>\
                    <div id="duneInfo" class="mt-2"></div>\
                    <hr>\
                    <h5><i class="fas fa-dna"></i> Mutated Patterns</h5>\
                    <div id="mutatedList" style="max-height: 200px; overflow-y: auto;"></div>\
                </div>\
            </div>\
        </div>\
        <div class="row mt-4">\
            <div class="col-12">\
                <div class="frog-card p-3">\
                    <h4><i class="fas fa-skull-crossbones"></i> High Confidence Suspects</h4>\
                    <div class="accordion" id="suspectsAccordion"></div>\
                </div>\
            </div>\
        </div>\
        <footer class="text-center text-white-50 mt-5">\
            <hr class="bg-white-50">\
            <p>ÉøÉ∞∏ Two Lilies Pond ¬∑ Echo‚ÄÉ±State Hopping ¬∑ Fingerprint Mutation</p>\
        </footer>\
    </div>\
    <script>\
        async function loadData() {\
            const response = await fetch('/tmp/frog_results.json');\
            const data = await response.json();\
            // Stats row\
            const statsRow = document.getElementById('statsRow');\
            statsRow.innerHTML = `\
                <div class="col-md-3"><div class="frog-card p-3 text-center"><div class="stat-number">${data.total_files_scanned}</div><div>Files with Matches</div></div></div>\
                <div class="col-md-3"><div class="frog-card p-3 text-center"><div class="stat-number">${data.suspicious_count}</div><div>Suspicious Files (score‚É©•1.5)</div></div></div>\
                <div class="col-md-3"><div class="frog-card p-3 text-center"><div class="stat-number">${data.mutated_patterns.length}</div><div>Mutated Fingerprints</div></div></div>\
                <div class="col-md-3"><div class="frog-card p-3 text-center"><div class="stat-number">${Object.keys(data.category_counts).length}</div><div>Categories Triggered</div></div></div>\
            `;\
            // Category pie chart\
            const ctx = document.getElementById('categoryChart').getContext('2d');\
            const catLabels = Object.keys(data.category_counts);\
            const catValues = Object.values(data.category_counts);\
            new Chart(ctx, {\
                type: 'pie',\
                data: { labels: catLabels, datasets: [{ data: catValues, backgroundColor: ['#2d6a4f','#40916c','#52b788','#74c69d','#95d5b2','#b7e4c7','#d8f3dc'] }] },\
                options: { responsive: true, plugins: { legend: { position: 'right' } } }\
            });\
            // Dune info\
            const duneHits = data.suspects.filter(s => s.categories.includes('dune'));\
            document.getElementById('duneInfo').innerHTML = duneHits.length ? \
                `<div class="alert alert-warning"><i class="fas fa-skull"></i> Found ${duneHits.length} file(s) with Dune Awakening indicators.</div>` :\
                `<div class="alert alert-info"><i class="fas fa-eye-slash"></i> No Dune‚ÄÉ±specific hits in this scan.</div>`;\
            // Mutated patterns list\
            const mutatedDiv = document.getElementById('mutatedList');\
            mutatedDiv.innerHTML = data.mutated_patterns.map(p => `<span class="badge bg-secondary badge-cat">${p}</span>`).join(' ') || '<i>None extracted</i>';\
            // Suspects accordion\
            const accordion = document.getElementById('suspectsAccordion');\
            if (data.suspects.length === 0) {\
                accordion.innerHTML = '<div class="alert alert-success">No high‚ÄÉ±confidence files found. Pond is quiet.</div>';\
            } else {\
                accordion.innerHTML = data.suspects.map((s, idx) => `\
                    <div class="accordion-item">\
                        <h2 class="accordion-header" id="heading${idx}">\
                            <button class="accordion-button ${idx !== 0 ? 'collapsed' : ''}" type="button" data-bs-toggle="collapse" data-bs-target="#collapse${idx}">\
                                <strong>${s.file.split('/').pop()}</strong> ‚ÄÉ≥ Score: ${s.score} ‚ÄÉ≥ Categories: ${s.categories.join(', ')}\
                            </button>\
                        </h2>\
                        <div id="collapse${idx}" class="accordion-collapse collapse ${idx === 0 ? 'show' : ''}" data-bs-parent="#suspectsAccordion">\
                            <div class="accordion-body">\
                                <p><i class="fas fa-tag"></i> <strong>Full path:</strong> ${s.file}</p>\
                                <p><i class="fas fa-fingerprint"></i> <strong>Fingerprints:</strong> ${s.fingerprints.slice(0,8).join(', ')}${s.fingerprints.length>8 ? '‚Ä¶' : ''}</p>\
                                <p><i class="fas fa-chart-simple"></i> <strong>Confidence score:</strong> ${s.score}</p>\
                                <button class="btn btn-sm btn-outline-success" onclick="navigator.clipboard.writeText('${s.file}')"><i class="far fa-copy"></i> Copy path</button>\
                            </div>\
                        </div>\
                    </div>\
                `).join('');\
            }\
            // Bootstrap JS for accordion (dynamically loaded)\
            const bsScript = document.createElement('script');\
            bsScript.src = 'https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js';\

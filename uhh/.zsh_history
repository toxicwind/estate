mkdir -p "$CHUNKS"
cd "$RAW"
echo "=== Stripping junk (VSCode, binaries, .git, etc.) ==="
find . -type f \( -iname "*.png" -o -iname "*.jpg" -o -iname "*.exe" -o -iname "*.dll"   -o -iname "*.so" -o -iname "*.zip" -o -iname "*.log" \) -delete
find . -type d \( -name ".git" -o -name "node_modules" -o -name ".vscode"   -o -name "__pycache__" -o -name "dist" -o -name "build" \) -exec rm -rf {} + 2>/dev/null
find . -type f \( -name "*.code-workspace" -o -name "launch.json" -o -name "tasks.json"   -o -name "settings.json" -o -name "tsconfig*.json" \) -delete
# Exclude the massive d4data repo (uncomment next line to keep it)
mv d4data "$WORK/d4data_excluded" 2>/dev/null || true
echo "=== Chunking JSON (40MB, skipping malformed) ==="
python3 << 'PYEOF'
import json, re, sys
from pathlib import Path
def clean_json(text):
    # Simple // comment removal (not inside strings)
    lines = []
    in_string = False
    for line in text.split('\n'):
        i, new_line = 0, []
        while i < len(line):
            if line[i] == '"' and (i == 0 or line[i-1] != '\\'):
                in_string = not in_string
            if not in_string and line[i:i+2] == '//':
                break
            new_line.append(line[i])
            i += 1
        lines.append(''.join(new_line))
    text = '\n'.join(lines)
    # Remove /* ... */ comments
    text = re.sub(r'/\*.*?\*/', '', text, flags=re.DOTALL)
    # Remove trailing commas before } or ]
    text = re.sub(r',\s*([}\]])', r'\1', text)
    return text
RAW = Path("/home/toxic/lmachens_analysis/raw")
OUT = Path("/home/toxic/lmachens_analysis/chunks")
MAX_SIZE = 40 * 1024 * 1024
OUT.mkdir(exist_ok=True)
chunk_num = 1
processed = 0
for f in sorted(RAW.rglob("*.json")):
    if "d4data" in str(f):
        continue   # skip the huge repo (change to `if False` to include it)
    try:
        raw = f.read_text(encoding='utf-8', errors='ignore')
        clean = clean_json(raw)
        data = json.loads(clean)
        line = json.dumps(data, separators=(',', ':'))
        sz = len(line.encode()) + 1
        if cur_size + sz > MAX_SIZE and cur_chunk:
            chunk_num += 1
            cur_chunk, cur_size = [], 0
        cur_chunk.append(line)
        cur_size += sz
        processed += 1
    except Exception:
        pass   # silently skip malformed JSON (VSCode files etc.)
if cur_chunk:
    (OUT / f"chunk_{chunk_num:04d}.jsonl").write_text("\n".join(cur_chunk))
for f in OUT.glob("*.jsonl"):
    f.rename(f.with_suffix(".jsonl.txt"))
print(f"Processed {processed} JSON files. Created {chunk_num} chunks.")
PYEOF


python3 "$PYTHON_SCRIPT" "$TARGET_DIR"\
\
# Cleanup (optional)\
# rm -rf "$VENV_DIR"   # uncomment if you want to remove venv after run\
echo "Frog hunt finished."\
' 
bash -c '\
set -euo pipefail\

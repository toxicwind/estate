NIXEOF\
\
echo "‚ÉºÉ• Clean devenv.nix written (allowUnfree + no CUDA package declaration)"\
\
. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh\
nix-instantiate --parse devenv.nix && echo "‚ÉºÉ• Syntax OK"
bash <<'END'\
set -euo pipefail\
\
# 1. Clean any old devenv cache\
rm -rf .devenv\
\
# 2. Generate requirements.txt from pixi files\
REQS="requirements.txt"\
> "$REQS"\
grep -E '^  - pypi: ' pixi.lock 2>/dev/null | sed 's|.*/||; s|\.whl||; s|-|==|; s/_/-/g' >> "$REQS" || true\
grep -E 'path = ' pixi.toml 2>/dev/null | sed 's/.*path = "\([^"]*\)".*/-e \1/' >> "$REQS" || true\
awk '/\[.*\.pypi-dependencies\]/ {flag=1} flag && /^[a-z]/ && !/\[/ {print $1}' pixi.toml 2>/dev/null >> "$REQS" || true\
sort -u -o "$REQS" "$REQS"\
sed -i '/^$/d' "$REQS"\
echo "‚ÉºÉ• requirements.txt ready"\
\
# 3. Write a clean devenv.nix (NO nixpkgs line)\
cat > devenv.nix <<'NIX'\
{ config, pkgs, ... }:\
{\
  languages.python = {\
    enable = true;\
    version = "3.12";\
    venv = {\
      enable = true;\
      requirements = ./requirements.txt;\
    };\
  };\
\
  packages = with pkgs; [\
    caddy\
    process-compose\
    cudaPackages.cudatoolkit\
  ];\
\
  env = {\
    LD_LIBRARY_PATH = "${pkgs.lib.makeLibraryPath [ pkgs.stdenv.cc.cc pkgs.cudaPackages.cudatoolkit ]}";\
    CUDA_HOME = "${pkgs.cudaPackages.cudatoolkit}";\
    VLLM_TARGET_DEVICE = "cuda";\
    TORCH_CUDA_ARCH_LIST = "8.6";\
    VLLM_LOGGING_LEVEL = "WARN";\
  };\
\
  processes = {\
    pegaflow.exec = "pegaflow-server --http-addr 0.0.0.0:25002 --addr 127.0.0.1:25003 --pool-size 24gb --devices 0";\
    vllm.exec = ''\
      python -m vllm.entrypoints.openai.api_server \\
        --model /home/toxic/.cache/huggingface/hub/models--Lorbus--Qwen3.6-27B-int4-AutoRound/snapshots/latest \\
        --served-model-name qwen3.6-27b-lorbus \\
        --host 0.0.0.0 --port 25001 \\
        --max-model-len 32768 \\
        --gpu-memory-utilization 0.85 \\
        --kv-cache-dtype fp8 \\
        --speculative-config '{"method":"mtp","num_speculative_tokens":3}' \\
        --trust-remote-code\
    '';\
    openfang.exec = "/home/toxic/.openfang/bin/openfang start";\
    caddy.exec = "caddy run --config ./caddy/Caddyfile";\
  };\
\
  enterShell = ''\
    echo "‚ÉºÉ≥ Python environment ready (devenv native venv)"\
    echo "‚ÉºÉ≥ Run 'devenv up' to start all services"\
  '';\
}\
NIX\
\
echo "‚ÉºÉ• devenv.nix written (clean, no nixpkgs block)"\
\
# 4. Validate syntax\
nix-instantiate --parse devenv.nix >/dev/null 2>&1 || { echo "‚ÉΩÉ¨ Nix syntax error"; exit 1; }\
echo "‚ÉºÉ• Nix syntax OK"\
\
# 5. Enter the shell\
. /nix/var/nix/profiles/default/etc/profile.d/nix-daemon.sh 2>/dev/null || true\
echo "ÉøÉ∫Ä Entering devenv shell (first build may take a few minutes)..."\
exec devenv shell\
END

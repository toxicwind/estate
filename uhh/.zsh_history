rm -rf /home/toxic/monolith && unzip -o /home/toxic/Downloads/monolith.zip -d /home/toxic/monolith && chmod +x /home/toxic/monolith/*.sh && bash /home/toxic/monolith/monolith.sh setup && cd /home/toxic && bun run experiment/audit-focused.ts > audit-focused.jsonl

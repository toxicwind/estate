import sys, os\
cfg=sys.argv[1]\
mappings={\
  "MODEL_PLACEHOLDER_M20":"beellama/qwen-flash-128k",\
  "MODEL_PLACEHOLDER_M16":"beellama/qwen-flash-64k",\
  "MODEL_PLACEHOLDER_M132":"beellama/qwen-flash-128k",\
  "gemini-1.5-pro":"beellama/qwen-flash-128k",\
  "gemini-1.5-flash":"beellama/qwen-flash-64k",\
  "gemini-2.0-flash":"beellama/qwen-flash-128k",\
  "llama":"beellama/qwen-flash-96k",\
}\
try:\
  import yaml\
  data=yaml.safe_load(open(cfg)) or {}\
  aliases=data.get("aliases") or {}\
  aliases.update(mappings)\
  data["aliases"]=aliases\
  # ensure models exist for targets\
  open(cfg,'w').write(yaml.safe_dump(data, sort_keys=False))\
  print("patched via yaml lib")\
except Exception as e:\
  print(f"yaml lib not usable ({e}), doing text patch")\
  txt=open(cfg).read()\
  if "aliases:" not in txt:\
    txt+= "\naliases:\n"\
    for k,v in mappings.items():\
      txt+= f' "{k}": "{v}"\n'\
  else:\
    # append missing keys inside aliases block\
    for k,v in mappings.items():\
      if k not in txt:\
        txt=txt.replace("aliases:", f'aliases:\n "{k}": "{v}"', 1)\
  open(cfg,'w').write(txt)\
  print("patched via text append")\
PY\

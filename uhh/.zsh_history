cat > /home/toxic/sovereign/modules/sovereign_watchdog.py << 'EOF'\
#!/usr/bin/env python3\
import requests, time, subprocess, logging\
\
logging.basicConfig(level=logging.INFO, format='%(asctime)s [%(levelname)s] %(message)s')\
log = logging.getLogger("watchdog")\
\
YML = "/home/toxic/sovereign/modules/process_compose_pure.yml"\
\
def restart(proc):\
    log.warning(f"Restarting {proc}...")\
    subprocess.run(["process-compose", "-f", YML, "restart", proc], capture_output=True)\
    time.sleep(5)\
\
while True:\
    # Check ik_llama embeddings endpoint\
    try:\
        r = requests.post("http://127.0.0.1:25001/embedding", json={"content": "test"}, timeout=5)\
        if r.status_code != 200 or "embedding" not in r.json():\
            log.error("ik_llama embeddings broken -> restart")\
            restart("ik_llama")\
    except:\
        log.error("ik_llama unreachable -> restart")\
        restart("ik_llama")\
\
    # Check nfcot_proxy latent injection\
    try:\
        r = requests.post("http://127.0.0.1:25008/v1/chat/completions",\
            json={"model": "gemma-4", "messages": [{"role": "user", "content": "<think>2+2</think>"}], "max_tokens": 10},\
            timeout=5)\
        if r.status_code != 200:\
            log.error("nfcot_proxy unhealthy -> restart")\
            restart("nfcot_proxy")\
        else:\
            content = r.json().get("choices", [{}])[0].get("message", {}).get("content", "")\
            if "<|channel>thought" not in content and "<|latent" not in content:\
                log.warning("nfcot_proxy no latent/thought token -> restart")\
                restart("nfcot_proxy")\
    except:\
        log.error("nfcot_proxy unreachable -> restart")\
        restart("nfcot_proxy")\
\
    time.sleep(30)\
EOF\

import pathlib, re, sys\
p=pathlib.Path("process-compose.yaml")\
if not p.exists(): p=pathlib.Path("process-compose.yml")\
t=p.read_text()\
# replace readiness_probe block for rust-web\
t=re.sub(\
r'readiness_probe:\s*\n(?:\s+.*\n)+?(?=\n\s*\w+:|\nprocesses:|\Z)',\
'''    readiness_probe:\
      exec:\
        command: "curl -f http://127.0.0.1:25101/health"\
      initial_delay_seconds: 2\
      period_seconds: 3\
      timeout_seconds: 2\
      failure_threshold: 20\
''', t, count=1)\
# ensure working_dir + command are consistent\
t=t.replace('command: "../stack/services/rust-web.sh"', 'command: "./stack/services/rust-web.sh"\n    working_dir: "."')\
if 'working_dir: "rust_algo_web"' in t:\
    t=t.replace('working_dir: "rust_algo_web"', 'working_dir: "."')\
p.write_text(t)\
print("patched", p)\
PY\

}\
\
echo "[import] Listing contents of $OWNER/$REPO:$PATH_IN_REPO"\
resp_file=$(mktemp)\
api_get "$GITHUB_API/repos/$OWNER/$REPO/contents/$PATH_IN_REPO" > "$resp_file"\
